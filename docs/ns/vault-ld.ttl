@prefix vldp:    <https://relay.interego.xwisee.com/ns/maintainer/vault-ld#> .
@prefix vld:     <https://github.com/The-Knowledge-Graph-Guys/vault-ld#> .
@prefix hmd:     <https://relay.interego.xwisee.com/ns/maintainer/hmd#> .
@prefix iep:     <https://markjspivey-xwisee.github.io/interego/ns/iep#> .
@prefix pgsl:    <https://markjspivey-xwisee.github.io/interego/ns/pgsl#> .
@prefix ieh:     <https://markjspivey-xwisee.github.io/interego/ns/harness#> .
@prefix hydra:   <http://www.w3.org/ns/hydra/core#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

# ══════════════════════════════════════════════════════════════
#  Vault-LD conformance profile (vldp) 0.1
#
#  Vault-LD (github.com/The-Knowledge-Graph-Guys/vault-ld, v0.5, Apache-2.0) is a
#  CONFORMANCE POINT on HyperMarkdown's progressive-enhancement spectrum, NOT a
#  foreign format: rung 1 = the Markdown body, rung 2 = YAML-LD frontmatter, rung
#  3 = shared @context + [[wiki-links]] lifting to RDF, rung 4 = authority-closed
#  :::control affordances — which Vault-LD deliberately has NONE of. So HMD = Vault-LD
#  + rung 4; a Vault-LD note is a control-free HMD document.
#
#  This graph is the profile expressed as DATA: the substrate's general Markdown-vault
#  projection engine (@interego/mdvault) is parameterized by these knobs, and validates
#  its output against vldp:ConformanceShape. Nothing in the engine names Vault-LD; a
#  second dialect is a new profile + shape, no code change. Compliance is therefore a
#  dereferenceable link + a passing SHACL check, not a hardcoded assertion.
# ══════════════════════════════════════════════════════════════

<https://relay.interego.xwisee.com/ns/maintainer/vault-ld>
  a owl:Ontology , vldp:Profile ;
  dcterms:title "Vault-LD conformance profile" ;
  rdfs:label "Vault-LD conformance profile (vldp) 0.1 — rung-<=3 HyperMarkdown" ;
  owl:versionInfo "0.1-draft" ;
  dcterms:creator <mailto:mark.spivey@xwisee.com> ;
  dcterms:modified "2026-07-15"^^xsd:date ;
  dcterms:conformsTo <https://github.com/The-Knowledge-Graph-Guys/vault-ld> ;
  rdfs:seeAlso <https://relay.interego.xwisee.com/ns/maintainer/hmd> ;
  rdfs:comment "A declarative projection profile that makes the general Markdown-vault engine conform to Vault-LD v0.5. Its knobs (below) select the rung ceiling, context-resolution, identity minting, link grammar, and placement predicate; its SHACL shape (vldp:ConformanceShape) verifies the rung-<=3 authority closure on the projected graph." ;
  # ── the knobs (self-describing; the engine reads these) ──
  vldp:maxRung 3 ;
  vldp:contextSource "external" ;
  vldp:forbidInlineContext true ;
  vldp:identityStrategy "vault-ld-4.5" ;
  vldp:linkGrammar "wiki" ;
  vldp:placementPredicate vld:path ;
  vldp:conformanceShape vldp:ConformanceShape ;
  iep:affordance vldp:IngestAffordance .

# ── the EMERGENT affordance: project a vault (discoverable + followable) ──
#
#  Dereferencing this profile reveals a followable operation, NOT an MCP tool: POST a
#  vault bundle to the target and the general engine projects it under this profile.
#  Descriptive DATA only — authority-looking notes are quarantined (never lifted), so no
#  execution authority is imported. NOTE: vldp:ConformanceShape validates a PROJECTED
#  vault graph (the operation's output), never this profile document — so this affordance's
#  own hydra:target/iep:action are not a self-violation.
vldp:IngestAffordance
  a iep:Affordance , hydra:Operation ;
  rdfs:label "Ingest a Vault-LD vault" ;
  rdfs:comment "POST { notes: {path->bytes}, contexts: {path->bytes}, rootContextPath? } to project a Markdown-with-YAML-LD-frontmatter vault into a rung-<=3 Vault-LD graph, with byte-exact content-addressed source atoms, flag-not-drop diagnostics, and a conformance report. In-memory only (no filesystem/network I/O)." ;
  iep:action <urn:mdvault:action:vault-ld:ingest> ;
  hydra:method "POST" ;
  hydra:target <https://relay.interego.xwisee.com/vault/ingest> ;
  hydra:returns vldp:IngestResult .

vldp:Profile a owl:Class ;
  rdfs:label "Projection profile" ;
  rdfs:comment "A named set of knobs (rung ceiling, context source, identity strategy, link grammar, placement predicate) + a conformance shape that make the general Markdown-vault projection engine behave as a specific dialect. Data, not code." ;
  rdfs:subClassOf dcterms:Standard .

vldp:maxRung a owl:DatatypeProperty ;
  rdfs:label "maximum rung" ;
  rdfs:comment "The HyperMarkdown progressive-enhancement ceiling the profile permits. 3 = descriptive data only (no executable affordances); 4 = full HMD. Enforced by vldp:ConformanceShape." ;
  rdfs:range xsd:integer .

vldp:conformanceShape a owl:ObjectProperty ;
  rdfs:label "conformance shape" ;
  rdfs:comment "The SHACL NodeShape a projection's output must satisfy to conform to this profile." .

# ★ The other five knobs, declared. vldp:maxRung and vldp:conformanceShape above were the
# only two of the profile's seven that had definitions — the rest were read by the engine
# and set on the published profile while resolving to nothing, so a reader following one
# learned only that it existed. A knob nobody can look up is configuration by folklore.

vldp:contextSource a owl:DatatypeProperty ;
  rdfs:label "context source" ;
  rdfs:comment "Where the JSON-LD @context comes from when projecting: \"external\" requires a dereferenceable context document, which is what lets a consumer expand the output without trusting the projector. Paired with vldp:forbidInlineContext." ;
  rdfs:range xsd:string .

vldp:forbidInlineContext a owl:DatatypeProperty ;
  rdfs:label "forbid inline context" ;
  rdfs:comment "When true, an inline @context in vault content is refused rather than honoured. An inline context lets the SOURCE redefine what its own terms mean, which would let a note silently rebind a term to a different IRI after the profile had been checked." ;
  rdfs:range xsd:boolean .

vldp:identityStrategy a owl:DatatypeProperty ;
  rdfs:label "identity strategy" ;
  rdfs:comment "Named rule for minting stable IRIs for vault entries, so the same note projects to the same identifier across runs. The value names a versioned strategy (e.g. \"vault-ld-4.5\") rather than describing one, because changing how identity is derived breaks every existing reference and must therefore be a visible version change." ;
  rdfs:range xsd:string .

vldp:linkGrammar a owl:DatatypeProperty ;
  rdfs:label "link grammar" ;
  rdfs:comment "The link syntax the vault is written in, which the projector must parse to recover edges (e.g. \"wiki\" for [[wikilinks]]). Declared as profile DATA rather than detected, because guessing wrong silently produces a graph with no edges instead of an error." ;
  rdfs:range xsd:string .

vldp:placementPredicate a owl:ObjectProperty ;
  rdfs:label "placement predicate" ;
  rdfs:comment "The predicate used to record where an entry sits in the vault's own hierarchy (e.g. vld:path). Named by the profile so a consumer can find structural placement without knowing the projector's conventions." .

vldp:IngestResult a owl:Class ;
  rdfs:label "Ingest Result" ;
  rdfs:comment "What vldp:IngestAffordance returns: the outcome of projecting a vault bundle under this profile — the rung-<=3 graph, the content-addressed source atoms it was built from, and the conformance report for vldp:ConformanceShape. Grounded by construction rather than by subclassing iep:KernelResult, which is the envelope of a KERNEL VERB and carries iep:KernelResultShape; an ingest is an affordance, not a kernel verb, so claiming that superclass would assert a shape this never satisfies." ;
  iep:constructedFrom ( pgsl:Atom iep:ContextDescriptor vldp:ConformanceShape ) .

# ── §6 conformance: the rung-<=3 AUTHORITY CLOSURE, as verifiable SHACL ──
#
#  The load-bearing, verifiable property: a Vault-LD graph is DESCRIPTIVE DATA and must
#  carry no EXECUTION AUTHORITY. Any node typed as an operation/affordance/control, or
#  any triple using an authority predicate, is a violation — regardless of how it got
#  there (a hostile @context remapping an innocent key, a CURIE key, an @type alias).
#  Deprecated cg:/cgh: read-aliases are covered by matching their canonical iep:/ieh:
#  forms in the engine before this shape runs.

vldp:ConformanceShape a sh:NodeShape ;
  rdfs:label "Vault-LD rung-<=3 conformance shape" ;
  rdfs:comment "Validates the rung-<=3 authority closure over a projected Vault-LD graph: no executable operation/affordance/control types, and no authority predicates." ;
  # No node may be an executable operation / affordance / control (a targeted node has an
  # rdf:type, so requiring 0 rdf:type makes every such node a violation).
  sh:targetClass hydra:Operation ;
  sh:targetClass iep:Affordance ;
  sh:targetClass ieh:Affordance ;
  sh:targetClass hmd:Control ;
  sh:property [
    sh:path rdf:type ;
    sh:maxCount 0 ;
    sh:message "Rung-<=3 violation: a Vault-LD graph must not type any node as hydra:Operation / iep:Affordance / ieh:Affordance / hmd:Control (that is rung-4 execution authority)." ;
  ] .

vldp:NoAuthorityPredicatesShape a sh:NodeShape ;
  rdfs:label "no authority predicates" ;
  rdfs:comment "No subject may carry an authority predicate (an operation target/method, a supported operation, an action, or an HMD control edge)." ;
  sh:targetSubjectsOf hydra:target ;
  sh:targetSubjectsOf hydra:method ;
  sh:targetSubjectsOf hydra:operation ;
  sh:targetSubjectsOf hydra:supportedOperation ;
  sh:targetSubjectsOf iep:action ;
  sh:targetSubjectsOf hmd:target ;
  sh:targetSubjectsOf hmd:rel ;
  sh:targetSubjectsOf hmd:control ;
  sh:property [ sh:path hydra:target ;             sh:maxCount 0 ; sh:message "Rung-<=3 violation: hydra:target (execution authority)." ] ;
  sh:property [ sh:path hydra:method ;             sh:maxCount 0 ; sh:message "Rung-<=3 violation: hydra:method." ] ;
  sh:property [ sh:path hydra:operation ;          sh:maxCount 0 ; sh:message "Rung-<=3 violation: hydra:operation." ] ;
  sh:property [ sh:path hydra:supportedOperation ; sh:maxCount 0 ; sh:message "Rung-<=3 violation: hydra:supportedOperation." ] ;
  sh:property [ sh:path iep:action ;               sh:maxCount 0 ; sh:message "Rung-<=3 violation: iep:action." ] ;
  sh:property [ sh:path hmd:target ;               sh:maxCount 0 ; sh:message "Rung-<=3 violation: hmd:target." ] ;
  sh:property [ sh:path hmd:rel ;                  sh:maxCount 0 ; sh:message "Rung-<=3 violation: hmd:rel." ] ;
  sh:property [ sh:path hmd:control ;              sh:maxCount 0 ; sh:message "Rung-<=3 violation: hmd:control." ] ;

  # ★ FOUR PREDICATES THAT ENTAIL A CONTROL WERE NOT SCREENED. hmd.ttl gives six predicates
  # `rdfs:domain hmd:Control` — method, target, expects, returns, condition, rel — so bearing
  # ANY of them entails that the subject is an hmd:Control, which is rung-4 execution
  # authority by this profile's own definition. The list above screened target and rel and
  # missed the other four, while the shape immediately above it claims the closure is closed
  # under entailment. A vault could therefore ship `<note> hmd:method "POST"` and validate
  # clean while entailing a control.
  #
  # Found by auditing the ontologies against hmd.ttl's domain declarations rather than
  # against the list's own apparent completeness — the hydra: half was complete, which is
  # what made the hmd: half look finished.
  sh:targetSubjectsOf hmd:method ;
  sh:targetSubjectsOf hmd:expects ;
  sh:targetSubjectsOf hmd:returns ;
  sh:targetSubjectsOf hmd:condition ;
  sh:property [ sh:path hmd:method ;    sh:maxCount 0 ; sh:message "Rung-<=3 violation: hmd:method (rdfs:domain hmd:Control — bearing it entails a control)." ] ;
  sh:property [ sh:path hmd:expects ;   sh:maxCount 0 ; sh:message "Rung-<=3 violation: hmd:expects (rdfs:domain hmd:Control)." ] ;
  sh:property [ sh:path hmd:returns ;   sh:maxCount 0 ; sh:message "Rung-<=3 violation: hmd:returns (rdfs:domain hmd:Control)." ] ;
  sh:property [ sh:path hmd:condition ; sh:maxCount 0 ; sh:message "Rung-<=3 violation: hmd:condition (rdfs:domain hmd:Control)." ] .

# ── ENTAILMENT closure (semantic-layer authority smuggling) ──
#
#  A direct check misses inference: `MyClass rdfs:subClassOf hydra:Operation` + `x a MyClass`
#  ENTAILS `x a hydra:Operation`; likewise owl:equivalentClass, and rdfs:subPropertyOf /
#  owl:equivalentProperty / owl:sameAs for predicates. So the rung-<=3 closure is closed under
#  entailment: a class reaching an authority class, or a property reaching an authority
#  predicate, is itself authority-bearing. (Reported by a second implementation; the engine
#  enforces this by computing the closure and quarantining every axiom + dependent note.)
vldp:EntailmentAuthorityShape a sh:NodeShape ;
  rdfs:label "no entailed authority (subclass / equivalent / subproperty chains)" ;
  rdfs:comment "Refuses any node whose rdf:type reaches an authority class, or which uses a predicate that reaches an authority predicate, through rdfs:subClassOf / owl:equivalentClass / rdfs:subPropertyOf / owl:equivalentProperty / owl:sameAs chains." ;

  # ★ IT ALSO HAD NO TARGET, so it selected no focus node and could not have fired even if
  # the engine ran SPARQL. Every typed node is the right scope for "does your type reach
  # execution authority", and stating it is what turns the shape below from a declaration
  # into a check. (Found by attributing a passing test's violations and discovering they came
  # from vldp:ConformanceShape, not from here.)
  sh:targetSubjectsOf rdf:type ;

  # ★ THE CLASS-CHAIN BRANCH, IN SHACL CORE — because until now this shape enforced NOTHING.
  #
  # It was sh:sparql-only, and SHACL-SPARQL is not implemented by the engine that runs it, so
  # the anti-authority-smuggling defence was a dereferenceable name over an empty check. The
  # transitive class chain is exactly a zero-or-more alternative path, which SHACL Core has
  # always been able to express and this engine could not evaluate until complex paths landed.
  #
  # ★ COVERAGE IS PARTIAL, AND SAYING SO IS THE POINT. This covers the FIRST of the SPARQL
  # query's three branches — rdf:type reaching an authority class. The other two quantify over
  # "any predicate of this node", and SHACL Core has no wildcard-predicate path (no negated
  # property set, no variable predicate), so they remain SPARQL-only and remain unenforced
  # here. Partial real enforcement beats total pretend enforcement; claiming the whole thing
  # was covered would recreate the facade in a new place.
  sh:property [
    sh:path ( rdf:type [ sh:zeroOrMorePath [ sh:alternativePath (
      rdfs:subClassOf owl:equivalentClass owl:sameAs ) ] ] ) ;
    sh:not [
      sh:in (
        <http://www.w3.org/ns/hydra/core#Operation>
        iep:Affordance
        ieh:Affordance
        hmd:Control
      )
    ] ;
    sh:message "Rung-<=3 violation: rdf:type reaches an execution-authority class through a subClassOf / equivalentClass / sameAs chain." ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "Rung-<=3 violation: execution authority is reachable by RDFS/OWL entailment (a subclass / equivalent-class / subproperty chain to an operation/affordance/control/target/action term)." ;
    sh:select """
      SELECT $this WHERE {
        {
          $this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ?c .
          ?c (<http://www.w3.org/2000/01/rdf-schema#subClassOf>|<http://www.w3.org/2002/07/owl#equivalentClass>|<http://www.w3.org/2002/07/owl#sameAs>)* ?auth .
          FILTER (?auth IN (
              <http://www.w3.org/ns/hydra/core#Operation>,
              <https://markjspivey-xwisee.github.io/interego/ns/iep#Affordance>,
              <https://markjspivey-xwisee.github.io/interego/ns/harness#Affordance>,
              <https://relay.interego.xwisee.com/ns/maintainer/hmd#Control>
            ))
        } UNION {
          $this ?p ?o .
          ?p (<http://www.w3.org/2000/01/rdf-schema#subPropertyOf>|<http://www.w3.org/2002/07/owl#equivalentProperty>|<http://www.w3.org/2002/07/owl#inverseOf>|<http://www.w3.org/2002/07/owl#sameAs>)* ?authp .
          FILTER (?authp IN (
              <http://www.w3.org/ns/hydra/core#target>,
              <http://www.w3.org/ns/hydra/core#method>,
              <http://www.w3.org/ns/hydra/core#operation>,
              <http://www.w3.org/ns/hydra/core#supportedOperation>,
              <https://markjspivey-xwisee.github.io/interego/ns/iep#action>,
              <https://relay.interego.xwisee.com/ns/maintainer/hmd#target>,
              <https://relay.interego.xwisee.com/ns/maintainer/hmd#rel>,
              <https://relay.interego.xwisee.com/ns/maintainer/hmd#control>
            ))
        } UNION {
          # Construct-agnostic floor: RDFS/OWL entailment is IRI-conservative, so a conformant
          # rung-<=3 graph MUST NOT NAME any authority IRI in any position (as object here;
          # predicate/type covered above). This catches every authority-linking axiom
          # (subClassOf / domain / range / inverseOf / onProperty / propertyChain / ...) at once.
          $this ?anyp ?auth .
          FILTER (?auth IN (
              <http://www.w3.org/ns/hydra/core#Operation>,
              <https://markjspivey-xwisee.github.io/interego/ns/iep#Affordance>,
              <https://markjspivey-xwisee.github.io/interego/ns/harness#Affordance>,
              <https://relay.interego.xwisee.com/ns/maintainer/hmd#Control>,
              <http://www.w3.org/ns/hydra/core#target>,
              <http://www.w3.org/ns/hydra/core#method>,
              <http://www.w3.org/ns/hydra/core#operation>,
              <http://www.w3.org/ns/hydra/core#supportedOperation>,
              <https://markjspivey-xwisee.github.io/interego/ns/iep#action>,
              <https://relay.interego.xwisee.com/ns/maintainer/hmd#target>,
              <https://relay.interego.xwisee.com/ns/maintainer/hmd#rel>,
              <https://relay.interego.xwisee.com/ns/maintainer/hmd#control>
            ))
        }
      }
    """ ;
  ] .

# ── SCOPE of the authority closure (boundary made explicit) ──
#
#  The IRI-conservation floor + entailment closure are defined over the SUBMITTED vault
#  graph plus the fixed trusted runtime rules. They EXCLUDE remote owl:imports and external
#  / preloaded ontologies: formal RDFS/OWL semantics include built-in axiomatic vocabulary,
#  and an imported TBox could name authority even when the submitted vault does not. So a
#  rung-<=3 vault must be self-contained — owl:imports is refused. If import reasoning is
#  ever added, every imported ontology MUST be authority-screened before it is trusted.
vldp:NoExternalImportShape a sh:NodeShape ;
  rdfs:label "no unscreened external import" ;
  rdfs:comment "A rung-<=3 vault must be self-contained: owl:imports pulls in an external TBox the authority floor cannot screen, which could name authority for a downstream import-reasoner. Vault-LD composes local context.jsonld (@context), not OWL imports." ;
  sh:targetSubjectsOf owl:imports ;
  sh:property [ sh:path owl:imports ; sh:maxCount 0 ; sh:message "Rung-<=3 violation: owl:imports references an unscreened external ontology; a Vault-LD graph must be self-contained." ] .
