@prefix pgsl: <https://markjspivey-xwisee.github.io/interego/ns/pgsl#>.
@prefix pgslt: <https://markjspivey-xwisee.github.io/interego/ns/pgsl-lexicon#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix dct:  <http://purl.org/dc/terms/>.

# ══════════════════════════════════════════════════════════════
#  PGSL retrieval lexicon
# ══════════════════════════════════════════════════════════════
#
#  The knowledge base behind ontological query expansion, as DATA.
#  It was 101 keys of TypeScript literal inside packages/pgsl, which
#  meant no term could be added without rebuilding the substrate and
#  no other agent could read what this one believed a term related to.
#
#  Standard vocabulary where it exists: a synonym group is a skos:Concept
#  carrying skos:prefLabel (the canonical form the engine keys on) plus
#  skos:altLabel for each member. IS-A is skos:broader. Only partitive
#  and causal relations, which SKOS does not define, are pgsl: terms.
#
#  Read at runtime by packages/pgsl/src/ontological-inference.ts. The
#  frozen tables survive there as FALLBACK_* for unreachable-docs/ns
#  deployments, and a test asserts this file parses back to exactly them.

pgsl:lexicon a pgsl:Lexicon ;
    dct:title "PGSL retrieval lexicon" ;
    rdfs:comment "Synonym, hypernym, meronym and causal relations used to expand query terms during PGSL retrieval." .

pgsl:lexiconScheme a skos:ConceptScheme ;
    dct:title "PGSL retrieval lexicon concept scheme" ;
    rdfs:comment "The scheme every term below belongs to. Stated so a reader who dereferences one concept can find the set it is part of, rather than only the relations it happens to sit on." .

# -- Every concept, typed and in the scheme --
pgslt:ac a skos:Concept ; skos:inScheme pgsl:lexiconScheme .
pgslt:accident a skos:Concept ; skos:inScheme pgsl:lexiconScheme .
