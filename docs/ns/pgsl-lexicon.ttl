# ── Synonym groups (skos:prefLabel = canonical, skos:altLabel = members) ──
pgslt:issue
    skos:prefLabel "issue" ;
    skos:altLabel "problem", "issue", "trouble", "difficulty", "malfunction", "defect", "fault", "error", "bug", "failure", "breakdown", "glitch" .
pgslt:fix
    skos:prefLabel "fix" ;
    skos:altLabel "fix", "repair", "resolve", "solve", "address", "correct", "remedy", "patch", "mend", "restore" .
pgslt:start
    skos:prefLabel "start" ;
    skos:altLabel "start", "begin", "commence", "initiate", "launch", "kick off", "embark" .
pgslt:finish
    skos:prefLabel "finish" ;
    skos:altLabel "finish", "end", "complete", "conclude", "finalize", "wrap up", "close" .
pgslt:like
    skos:prefLabel "like" ;
    skos:altLabel "like", "enjoy", "love", "prefer", "favor", "appreciate", "fond of" .
pgslt:dislike
    skos:prefLabel "dislike" ;
    skos:altLabel "dislike", "hate", "detest", "loathe", "despise", "can't stand" .
pgslt:buy
    skos:prefLabel "buy" ;
    skos:altLabel "buy", "purchase", "acquire", "get", "obtain", "order", "pick up" .
pgslt:travel
    skos:prefLabel "travel" ;
    skos:altLabel "travel", "go", "visit", "trip", "journey", "commute", "drive", "fly", "ride" .
pgslt:say
    skos:prefLabel "say" ;
    skos:altLabel "say", "tell", "mention", "state", "explain", "describe", "report", "discuss", "talk about" .
pgslt:work
    skos:prefLabel "work" ;
    skos:altLabel "work", "function", "operate", "run", "perform", "serve" .
