    skos:prefLabel "not_working" ;
    skos:altLabel "not working", "not functioning", "broken", "malfunctioning", "down", "crashed", "failed", "unresponsive", "out of order" .
pgslt:cost
    skos:prefLabel "cost" ;
    skos:altLabel "cost", "price", "fee", "charge", "expense", "rate", "amount" .
pgslt:big
    skos:prefLabel "big" ;
    skos:altLabel "big", "large", "huge", "enormous", "massive", "substantial", "significant" .
pgslt:small
    skos:prefLabel "small" ;
    skos:altLabel "small", "little", "tiny", "minor", "slight", "minimal" .
