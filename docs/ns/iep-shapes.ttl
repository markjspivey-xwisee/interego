@prefix iep:   <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix sh:   <http://www.w3.org/ns/shacl#>.
@prefix prov: <http://www.w3.org/ns/prov#>.
@prefix dct:  <http://purl.org/dc/terms/>.

# ══════════════════════════════════════════════════════════════
#  Interego 1.0 — Normative SHACL Shapes for iep:
#
#  Layer 1 (protocol, normative) — see spec/LAYERS.md.
#  Conformance test suite uses these shapes as oracles; see
#  spec/conformance/README.md.
#
#  These shapes encode the invariants that a conforming Interego
#  implementation MUST satisfy when producing or consuming
#  ContextDescriptors. Each shape is scoped, cited in the spec, and
#  paired with a conformance-suite fixture.
# ══════════════════════════════════════════════════════════════

<https://markjspivey-xwisee.github.io/interego/ns/iep-shapes>
    a owl:Ontology ;
    owl:versionInfo "1.0" ;
    dct:title "Interego 1.0 — Normative SHACL Shapes" ;
    dct:description "Normative SHACL shapes for the iep: core namespace." ;
    owl:imports <https://markjspivey-xwisee.github.io/interego/ns/iep> .

# ──────────────────────────────────────────────────────────────
#  1. SemioticFacet — modal-truth consistency
#
#  The modal-status / groundTruth pair is three-valued:
#    Asserted       ↔ groundTruth MUST be true
#    Counterfactual ↔ groundTruth MUST be false
#    Hypothetical   ↔ groundTruth MUST NOT be set
#    Quoted         ↔ groundTruth MAY be either (quote of external claim)
#    Retracted      ↔ groundTruth MUST be false (previously asserted)
#
#  Prevents a Hypothetical descriptor from being squashed into a
#  false Counterfactual and a Counterfactual from being queried as
#  if it were Asserted.
# ──────────────────────────────────────────────────────────────
# ★ THE sh:sparql TWIN OF THIS RULE WAS REMOVED, NOT LOST. The SemioticFacet modal-truth consistency
#   rule is stated ABOVE IN SHACL CORE and enforced by the engine that reads this file. The
#   sh:sparql block beside it said the same thing in a language nothing here executes, so it
#   contributed no enforcement and DID make every graph this shape selects report
#   fullyChecked:false — the flag that exists to say "a constraint here was not evaluated".
#   Measured before removing it: for a conforming graph and for each way of breaking the
#   rule, conforms and the full result set are IDENTICAL either way; only fullyChecked
#   changes, false -> true. A duplicate that cannot run is not a second opinion, it is a
#   permanent unresolved warning about itself.
iep:SemioticFacetModalTruthConsistencyShape a sh:NodeShape ;
    sh:targetClass iep:SemioticFacet ;

    # ★ IN SHACL CORE NOW. Three conditionals, each written the way SHACL expresses
    # implication: "NOT antecedent OR consequent". sh:or was parsed and dropped by this
    # engine until complex constraints landed, which is why the rule lived in SPARQL and
    # therefore lived nowhere.
    #
    #   Asserted       => groundTruth = true
    #   Counterfactual => groundTruth = false
    #   Hypothetical   => groundTruth absent
    #
    # The antecedents use `sh:not [ sh:in ( … ) ]` rather than `sh:not [ sh:hasValue … ]`:
    # sh:hasValue is a property constraint and means nothing on a bare node shape, so the
    # inner shape would be vacuously satisfied and sh:not would refuse every value. sh:in
    # is the node-level membership test this needs.
    sh:and (
      [ sh:or (
          [ sh:property [ sh:path iep:modalStatus ; sh:not [ sh:in ( iep:Asserted ) ] ] ]
          [ sh:property [ sh:path iep:groundTruth ; sh:hasValue true ; sh:minCount 1 ] ]
      ) ]
      [ sh:or (
          [ sh:property [ sh:path iep:modalStatus ; sh:not [ sh:in ( iep:Counterfactual ) ] ] ]
          [ sh:property [ sh:path iep:groundTruth ; sh:hasValue false ; sh:minCount 1 ] ]
      ) ]
      [ sh:or (
          [ sh:property [ sh:path iep:modalStatus ; sh:not [ sh:in ( iep:Hypothetical ) ] ] ]
          [ sh:property [ sh:path iep:groundTruth ; sh:maxCount 0 ] ]
      ) ]
    ) .


# ──────────────────────────────────────────────────────────────
#  2. TemporalFacet — future-validFrom warning
#
#  validFrom set to a future wall-clock time is legal at the protocol
#  level (scheduled claims are a real use case), but SHOULD surface
#  so readers know the claim is not yet in effect. Implementations
#  MAY downgrade this from Warning to Info if the descriptor also
#  carries explicit semantics indicating the future-date is intentional.
# ──────────────────────────────────────────────────────────────
iep:TemporalFacetNonFutureValidFromShape a sh:NodeShape ;
    sh:targetClass iep:TemporalFacet ;
    sh:severity sh:Warning ;
    sh:sparql [
        sh:message "TemporalFacet.validFrom is in the future — claim is not yet in effect. If intentional (scheduled claim), ignore this warning." ;
        sh:prefixes iep: ;
        sh:select """
            PREFIX iep: <https://markjspivey-xwisee.github.io/interego/ns/iep#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?validFrom WHERE {
              $this iep:validFrom ?validFrom .
              FILTER (?validFrom > NOW())
            }
        """
    ] .

# ──────────────────────────────────────────────────────────────
#  3. RevocationCondition — self-reference rejection
#
#  A descriptor whose revocation successor-query references its own
#  graph IRI is trying to revoke itself by its own existence — a
#  malformed bootstrap. Hard violation.
#
#  The shape uses regex against the SPARQL query text rather than
#  parsing the query; implementations MAY choose a more precise
#  parser-based check but MUST reject at minimum this string form.
# ──────────────────────────────────────────────────────────────
iep:RevocationConditionNoSelfReferenceShape a sh:NodeShape ;
    sh:targetClass iep:RevocationCondition ;
    sh:sparql [
        sh:message "Revocation successor query references the enclosing descriptor's own graph IRI — malformed (self-revoking by existence)." ;
        sh:prefixes iep: ;
        sh:select """
            PREFIX iep: <https://markjspivey-xwisee.github.io/interego/ns/iep#>
            SELECT $this ?query WHERE {
              ?descriptor iep:revokedIf|iep:revokedBy $this .
              ?descriptor iep:describes ?graphIri .
              $this iep:successorQuery ?query .
              FILTER (CONTAINS(STR(?query), STR(?graphIri)))
            }
        """
    ] .

# ──────────────────────────────────────────────────────────────
#  4. ContextDescriptor — core-facet invariant (core 1.0)
#
#  The 1.0 core requires one of each of the seven core facets:
#  Temporal, Provenance, Agent, AccessControl, Semiotic, Trust,
#  Federation (nine facet types total, incl. the optional Causal +
#  Projection). The optional facets (Causal, Projection, future
#  RevocationFacet) are permitted but MUST NOT replace any of the
#  seven core facets.
#
#  NOTE: extensions to Interego Protocol 1.0 (such as a RevocationFacet
#  proposal) relax "exactly the core facets" to "at least the core
#  facets" without breaking this shape — they'd add an additional
#  at-most-one shape for the new facet type. Don't conflate that
#  future relaxation with a current requirement.
# ──────────────────────────────────────────────────────────────
iep:DescriptorCoreFacetShape a sh:NodeShape ;
    sh:targetClass iep:ContextDescriptor ;
    sh:property [
        sh:path iep:hasFacet ;
        sh:qualifiedValueShape [ sh:class iep:TemporalFacet ] ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedMaxCount 1 ;
        sh:message "ContextDescriptor MUST have exactly one TemporalFacet."
    ] ;
    sh:property [
        sh:path iep:hasFacet ;
        sh:qualifiedValueShape [ sh:class iep:ProvenanceFacet ] ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedMaxCount 1 ;
        sh:message "ContextDescriptor MUST have exactly one ProvenanceFacet."
    ] ;
    sh:property [
        sh:path iep:hasFacet ;
        sh:qualifiedValueShape [ sh:class iep:AgentFacet ] ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedMaxCount 1 ;
        sh:message "ContextDescriptor MUST have exactly one AgentFacet."
    ] ;
    sh:property [
        sh:path iep:hasFacet ;
        sh:qualifiedValueShape [ sh:class iep:SemioticFacet ] ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedMaxCount 1 ;
        sh:message "ContextDescriptor MUST have exactly one SemioticFacet."
    ] ;
    sh:property [
        sh:path iep:hasFacet ;
        sh:qualifiedValueShape [ sh:class iep:TrustFacet ] ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedMaxCount 1 ;
        sh:message "ContextDescriptor MUST have exactly one TrustFacet."
    ] .

# ──────────────────────────────────────────────────────────────
#  5. ProvenanceFacet ↔ AgentFacet — agent identity consistency
#
#  A descriptor that names agent X in its AgentFacet but whose
#  ProvenanceFacet's wasAssociatedWith points at agent Y is almost
#  always a bug — the writer forked identity somewhere. Warning
#  (not violation) because there are legitimate ghost-write patterns
#  (e.g. agent X proxying for agent Y) where this is intentional.
# ──────────────────────────────────────────────────────────────
# ★ THE sh:sparql TWIN OF THIS RULE WAS REMOVED, NOT LOST. The AgentFacet / ProvenanceFacet agent consistency
#   rule is stated ABOVE IN SHACL CORE and enforced by the engine that reads this file. The
#   sh:sparql block beside it said the same thing in a language nothing here executes, so it
#   contributed no enforcement and DID make every graph this shape selects report
#   fullyChecked:false — the flag that exists to say "a constraint here was not evaluated".
#   Measured before removing it: for a conforming graph and for each way of breaking the
#   rule, conforms and the full result set are IDENTICAL either way; only fullyChecked
#   changes, false -> true. A duplicate that cannot run is not a second opinion, it is a
#   permanent unresolved warning about itself.
iep:AgentProvenanceConsistencyShape a sh:NodeShape ;
    sh:targetClass iep:ContextDescriptor ;
    sh:severity sh:Warning ;

    # ★ IN SHACL CORE NOW, because sh:sparql is not implemented by the engine that runs this
    # and the shape therefore checked nothing. SHACL 1.2 lets the property-pair parameters
    # take a PATH rather than only a predicate IRI, which is exactly the shape of this
    # comparison: "the agent named by the AgentFacet must be the agent named by the
    # ProvenanceFacet's activity", two sequence paths from the same focus node.
    #
    # Equivalent in practice to the SPARQL below without the explicit facet-type guards:
    # iep:assertingAgent occurs only on an AgentFacet and iep:wasGeneratedBy only on a
    # ProvenanceFacet, so the paths are self-selecting. Kept at sh:Warning, unchanged — a
    # ghost-write is a legitimate pattern, and promoting it to Violation while making it
    # enforceable for the first time would be two changes wearing one commit.
    # ★ prov:wasGeneratedBy / prov:wasAssociatedWith, NOT iep:. The SPARQL below asks for
    # `iep:wasGeneratedBy` and `iep:agent`, and the serializer emits neither — it writes
    # `prov:wasGeneratedBy` to a `prov:Activity` carrying `prov:wasAssociatedWith`
    # (serializer.ts serializeProvenanceFacet). So the query could never have matched, even
    # on an engine that ran SPARQL: the rule was wrong as well as unenforced, and its own
    # sh:message named the right predicate while the query named a different one. Writing it
    # in Core is what surfaced that — the undeclared-term scan flagged iep:agent and
    # iep:wasGeneratedBy the moment they stopped being hidden inside a string literal.
    sh:property [
        sh:path ( iep:hasFacet iep:assertingAgent iep:agentIdentity ) ;
        sh:equals ( iep:hasFacet prov:wasGeneratedBy prov:wasAssociatedWith ) ;
        sh:message "AgentFacet.assertingAgent != ProvenanceFacet.wasAssociatedWith — identity fork detected. If intentional (ghost-write), ignore." ;
    ] .


# ──────────────────────────────────────────────────────────────
#  6. Distribution — visibility / encryption consistency
#
#  iep:visibility classifies the audience for the affordance's payload:
#    public  ↔ iep:encrypted MUST be false  (plaintext readable by any
#                                            authenticated user via
#                                            foaf:Agent acl:Read)
#    shared  ↔ iep:encrypted MUST be true   (JOSE envelope wrapped to
#                                            the pod's authorized agents
#                                            plus optional share_with)
#    private ↔ iep:encrypted MUST be true   (JOSE envelope wrapped to the
#                                            publishing agent only)
#
#  Prevents a descriptor claiming "public" while shipping ciphertext
#  (no anonymous reader can decrypt) or claiming "shared"/"private"
#  while shipping plaintext (the audience-class promise is silently
#  violated). iep:visibility is optional — when absent, the shape is
#  inert and existing pre-visibility descriptors continue to pass.
#  Only one of the three legal string values is permitted.
# ──────────────────────────────────────────────────────────────
# ★ THE sh:sparql TWIN OF THIS RULE WAS REMOVED, NOT LOST. The visibility / encrypted agreement
#   rule is stated ABOVE IN SHACL CORE and enforced by the engine that reads this file. The
#   sh:sparql block beside it said the same thing in a language nothing here executes, so it
#   contributed no enforcement and DID make every graph this shape selects report
#   fullyChecked:false — the flag that exists to say "a constraint here was not evaluated".
#   Measured before removing it: for a conforming graph and for each way of breaking the
#   rule, conforms and the full result set are IDENTICAL either way; only fullyChecked
#   changes, false -> true. A duplicate that cannot run is not a second opinion, it is a
#   permanent unresolved warning about itself.
iep:VisibilityShape a sh:NodeShape ;
    sh:targetClass iep:Affordance ;
    sh:property [
        sh:path iep:visibility ;
        sh:datatype xsd:string ;
        sh:in ( "public" "shared" "private" ) ;
        sh:maxCount 1 ;
        sh:message "iep:visibility MUST be one of \"public\", \"shared\", or \"private\" (functional property — at most one value per distribution)."
    ] ;
    # ★ THE CONSISTENCY RULE, IN CORE. It lived only in the sh:sparql block below, and this
    # substrate ships no SPARQL evaluator — so a distribution declaring "public" while
    # shipping ciphertext, or "private" while shipping plaintext, validated clean. The
    # audience class is what a reader branches its dereference path on, which makes a
    # mismatch between the label and the payload the one inconsistency here that misleads.
    #
    # Written as implication — "NOT antecedent OR consequent" — which is how SHACL Core says
    # if-then. Note sh:not [ sh:in ( … ) ] and NOT sh:not [ sh:hasValue … ]: sh:hasValue is a
    # property constraint and means nothing on a bare node shape, so that spelling is
    # vacuously satisfied and the negation refuses everything.
    sh:and (
      [ sh:or (
          [ sh:property [ sh:path iep:visibility ; sh:not [ sh:in ( "public" ) ] ] ]
          [ sh:property [ sh:path iep:encrypted ; sh:in ( false ) ; sh:minCount 1 ] ]
      ) ]
      [ sh:or (
          [ sh:property [ sh:path iep:visibility ; sh:not [ sh:in ( "shared" ) ] ] ]
          [ sh:property [ sh:path iep:encrypted ; sh:in ( true ) ; sh:minCount 1 ] ]
      ) ]
      [ sh:or (
          [ sh:property [ sh:path iep:visibility ; sh:not [ sh:in ( "private" ) ] ] ]
          [ sh:property [ sh:path iep:encrypted ; sh:in ( true ) ; sh:minCount 1 ] ]
      ) ]
    ) ;
    sh:message "iep:visibility consistency: \"public\" requires iep:encrypted=false; \"shared\" and \"private\" require iep:encrypted=true. A distribution whose label and payload disagree misleads the reader that branches on it." .


# ──────────────────────────────────────────────────────────────
#  7. AuthorshipProof — required fields for iep:SignedAuthorship
#
#  When a descriptor embeds iep:authorshipProof [...], the embedded
#  blank node MUST declare every field the canonical-payload reconstructor
#  reads. Missing any of these makes the proof unverifiable from the
#  descriptor alone, defeating the whole point of embedded authorship.
#
#  Required:
#    iep:scheme              — signature suite name
#    iep:issuer              — agent IRI claiming authorship
#    iep:verificationMethod  — IRI naming the public key (did:ethr:<addr>)
#    iep:signerAddress       — authoritative public-id of the signer
#    iep:created             — ISO 8601 timestamp
#    iep:ownerWebId          — pod owner WebID
#    iep:descriptorId        — descriptor IRI the proof binds to
#    iep:proofValue          — the signature itself
#
#  Optional:
#    iep:agentDid            — DID-resolution hint
# ──────────────────────────────────────────────────────────────
iep:AuthorshipProofShape a sh:NodeShape ;
    sh:targetClass iep:SignedAuthorship ;
    sh:property [
        sh:path iep:scheme ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "iep:SignedAuthorship MUST declare iep:scheme (signature suite)."
    ] ;
    sh:property [
        sh:path iep:issuer ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "iep:SignedAuthorship MUST declare iep:issuer (agent IRI)."
    ] ;
    sh:property [
        sh:path iep:verificationMethod ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "iep:SignedAuthorship MUST declare iep:verificationMethod (key IRI)."
    ] ;
    sh:property [
        sh:path iep:signerAddress ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "iep:SignedAuthorship MUST declare iep:signerAddress."
    ] ;
    sh:property [
        sh:path iep:created ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "iep:SignedAuthorship MUST declare iep:created (ISO 8601 timestamp)."
    ] ;
    sh:property [
        sh:path iep:ownerWebId ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "iep:SignedAuthorship MUST declare iep:ownerWebId."
    ] ;
    sh:property [
        sh:path iep:descriptorId ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "iep:SignedAuthorship MUST declare iep:descriptorId (the descriptor IRI the proof binds to)."
    ] ;
    sh:property [
        sh:path iep:proofValue ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "iep:SignedAuthorship MUST declare iep:proofValue (the signature)."
    ] ;
    sh:property [
        sh:path iep:agentDid ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "iep:agentDid is optional but MUST be at most one when present."
    ] ;
    sh:property [
        sh:path iep:contentHash ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "iep:contentHash is optional — a proof written before content binding existed cannot acquire one — but MUST be at most one. Its ABSENCE means the proof covers who signed and which record, NOT the bytes, and a reader reports contentBinding 'unbound' rather than 'verified'."
    ] ;

    # ★ CLOSED, BECAUSE THE SIGNATURE ONLY COVERS THESE. The verifier rebuilds the canonical
    # payload from a FIXED field set (buildAuthorshipProofBlock in packages/solid/src/client.ts:
    # scheme, issuer, verificationMethod, signerAddress, created, ownerWebId, descriptorId,
    # agentDid?, contentHash?, proofValue). Any OTHER predicate inside this block is content
    # the signature does not cover, sitting exactly where a reader expects signed content —
    # which is the whole failure mode an authorship proof exists to prevent.
    #
    # The block was OPEN. Nothing in this file used sh:closed at all, so a forger could append
    # arbitrary unsigned triples to a valid, verifying proof and no shape would object.
    #
    # Safe to close because the writer emits exactly this set and nothing else: the permitted
    # list is not a guess about what proofs contain, it is the serializer's own field list.
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:message "A iep:SignedAuthorship block MUST carry no predicate beyond the ones the canonical-payload reconstructor reads — anything else is unsigned content inside a signed block." .

# ── A presence lease must be checkable ───────────────────────────────────────
#
# ★ NO SHAPE TARGETED iep:PresenceLease. Its comment states the invariants in capitals and
# nothing verified any of them: "A reader MUST refuse a lease ... with no expiry at all".
# A lease with no expiry is not a lease — it is the relay-held "online" flag the class was
# written to avoid, since the whole mechanism works by decaying against the substrate's own
# clock rather than by anyone running a timer.
#
# ★ ONE MUST FROM THAT COMMENT IS DELIBERATELY NOT HERE: "refuse a lease whose span is long
# enough that renewing it proved nothing". That needs the wall clock, which SHACL Core has no
# access to, so it stays a reader obligation rather than being half-expressed here.

iep:PresenceLeaseShape a sh:NodeShape ;
    sh:targetClass iep:PresenceLease ;
    sh:property [
        sh:path iep:presenceOf ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A iep:PresenceLease MUST name exactly one iep:presenceOf, inside the signed region. A lease whose subject came only from its filename would be an unattributable claim that somebody else is running."
    ] ;
    sh:property [
        sh:path iep:leaseExpires ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A iep:PresenceLease MUST carry exactly one iep:leaseExpires. A lease with no expiry is not a lease — it cannot decay, so nothing ever stops answering for it."
    ] ;
    sh:property [
        sh:path iep:presenceActingFor ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
        sh:message "iep:presenceActingFor is optional but MUST be at most one — an agent acts for one principal at a time or the claim is ambiguous."
    ] ;
    sh:property [
        sh:path iep:presenceHost ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:singleLine true ;
        sh:message "iep:presenceHost is optional, at most one, and a single line."
    ] .

# ── A capability document must be reachable by exactly one route ─────────────
#
# ★ iep:capabilityOf and iep:askVia carry the two strongest MUSTs in iep.ttl and no shape
# targeted either. A capability document tells a reader WHERE TO POST somebody's work: one
# whose subject came from its filename would be "an unattributable instruction to send
# somebody else's work to an address of the forger's choosing", in the vocabulary's own words.
#
# sh:xone is that sentence exactly. NEITHER route means the agent is reachable by no route
# at all; BOTH means a reader must choose between them with no honest basis for choosing.

iep:CapabilityDocumentShape a sh:NodeShape ;
    sh:targetSubjectsOf iep:capabilityOf ;
    sh:property [
        sh:path iep:capabilityOf ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A capability document MUST name exactly one iep:capabilityOf. A reader returning the first of several would let document order decide whose inbox is advertised."
    ] ;
    sh:xone (
        [ sh:property [ sh:path <http://www.w3.org/ns/hydra/core#target> ; sh:minCount 1 ] ]
        [ sh:property [ sh:path iep:askVia ; sh:minCount 1 ] ]
    ) ;
    sh:message "A capability document MUST offer exactly one of hydra:target and iep:askVia. Neither leaves the agent reachable by no route; both leave a reader choosing with no basis. iep:askVia exists precisely because an agent on somebody's laptop has nothing that will answer a POST." .

# ── An access-control policy must be decidable ───────────────────────────────
#
# ★ NO SHAPE TARGETED iep:AccessControlPolicy. Its own comment specifies (a) policyPredicate,
# (b) governedAction and (c) deonticMode as what a policy CARRIES, with (d) policyDuty
# optional — a published, numbered contract that nothing checked.
#
# Each absence is a decision with no defined answer rather than a cosmetic gap:
#   - no policyPredicate: the policy applies to everyone, or to nobody, and a reader cannot
#     tell which.
#   - no deonticMode: Deny overrides Permit when policies compose, so a mode-less policy has
#     no composition behaviour at all.
#   - two deonticModes: the same, twice over.

iep:AccessControlPolicyShape a sh:NodeShape ;
    sh:targetClass iep:AccessControlPolicy ;
    sh:property [
        sh:path iep:policyPredicate ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "An iep:AccessControlPolicy MUST name exactly one iep:policyPredicate — the SHACL shape a subject's attribute graph must satisfy. With none, the policy applies to everyone or to no one and a reader cannot tell which."
    ] ;
    sh:property [
        sh:path iep:governedAction ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message "An iep:AccessControlPolicy MUST name at least one iep:governedAction. A policy that governs nothing decides nothing."
    ] ;
    sh:property [
        sh:path iep:deonticMode ;
        sh:in ( iep:Permit iep:Deny iep:Duty ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "An iep:AccessControlPolicy MUST carry exactly one iep:deonticMode, one of Permit / Deny / Duty. Deny overrides Permit when policies compose, so an absent or multi-valued mode leaves the composed decision undefined."
    ] ;
    sh:property [
        sh:path iep:policyDuty ;
        sh:message "iep:policyDuty is optional — obligations attach to Duty mode — and unconstrained in cardinality."
    ] .

# ── An evidence source must be usable, not merely mentioned ──────────────────
#
# ★★ WHY THIS SHAPE EXISTS. `iep:reads` was added because a contract had two sides and only one
# was ever written: `hydra:expects` said what a caller must SEND, and nothing said what an
# affordance must FIND. Measured, live: a delegate signed correctly, invoked correctly, and got an
# empty answer it could not explain — the deciding fact (whether its pod was enrolled in the
# projector that fills the store being read) was an environment variable, and a human had to read
# deployment config to find it.
#
# A half-declared source would reproduce that failure while LOOKING declared, which is worse than
# silence: an agent would dereference a source, find no `iep:populatedBy`, and be exactly as stuck
# with the added belief that it had checked. So the two fields that make a source actionable are
# required, and the two that are situational are bounded rather than demanded.
iep:EvidenceSourceShape a sh:NodeShape ;
    sh:targetClass iep:EvidenceSource ;
    rdfs:comment "An iep:EvidenceSource is a promise that a caller can find out where an answer came from. It must name the store and what fills it; a source that names neither is decoration." ;

    sh:property [
        sh:path iep:store ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "An iep:EvidenceSource MUST name the store it stands for, as a dereferenceable IRI. 'Some store' is not an answer a caller can act on."
    ] ;

    sh:property [
        sh:path iep:populatedBy ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message "An iep:EvidenceSource MUST say what PUTS DATA IN IT. This is the field whose absence cost the incident this shape comes from: an agent that knows a store was empty still cannot act, and an agent that knows what fills it can. Multi-valued, because a store may be filled more than one way."
    ] ;

    sh:property [
        sh:path iep:admits ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "iep:admits is optional but MUST be at most one — one sentence a caller can act on, not a list to be reconciled."
    ] ;

    sh:property [
        sh:path iep:enrolmentRegister ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
        sh:message "iep:enrolmentRegister is optional — its ABSENCE states nothing, exactly as everywhere else in this vocabulary, and MUST NOT be read as 'no enrolment is required'. When present it MUST be a dereferenceable IRI: a register a caller cannot GET is the environment variable this term replaces."
    ] .
