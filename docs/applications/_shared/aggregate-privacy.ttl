@prefix agg:  <https://markjspivey-xwisee.github.io/interego/applications/_shared/aggregate-privacy#>.
@prefix iep:  <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix prov: <http://www.w3.org/ns/prov#>.
@prefix dct:  <http://purl.org/dc/terms/>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix vann: <http://purl.org/vocab/vann/>.

# ══════════════════════════════════════════════════════════════
#  AGG — Aggregate Privacy 1.0 Ontology
# ══════════════════════════════════════════════════════════════
#
#  The shared vocabulary that applications/_shared/aggregate-privacy
#  ALREADY writes to pods. These terms are not forthcoming: every one
#  of them appears in Turtle handed to publish() today, so each had to
#  dereference at its own authority and none did — the namespace base
#  404'd while eleven terms under it were live on participant pods.
#  Every sibling application vocabulary under docs/applications/ has a
#  <prefix>.ttl + <prefix>.html pair; this was the only one that did
#  not, and nothing could observe that, because the one gate that
#  checks an application namespace resolves was a hand-written list
#  with a single entry in it.
#
#  The prefix is `agg:`, matching AGGREGATE_NS in
#  applications/_shared/aggregate-privacy/index.ts. It is NOT the
#  `aggregate:` of spec/AGGREGATE-PRIVACY.md; the shipped runtime chose
#  `agg:` and the bytes move to the identifier, never the identifier to
#  the bytes — descriptors carrying these terms are already published
#  to participant pods, and renaming the IRI would orphan every one.
#
#  Bundle-shaped terms carry their payload as one agg:bundleJson
#  literal rather than as decomposed triples. That is the runtime's
#  existing choice so the verifier can re-hash the exact bytes it
#  signed; the ontology describes what is written, not what would be
#  tidier.
# ══════════════════════════════════════════════════════════════

<https://markjspivey-xwisee.github.io/interego/applications/_shared/aggregate-privacy#>
    a owl:Ontology ;
    owl:versionInfo "1.0" ;
    dct:title "AGG — Aggregate Privacy 1.0 Ontology" ;
    dct:description "Shared vocabulary for privacy-preserving cohort aggregation across pods: opt-in participation, Merkle-attested counts, homomorphic Pedersen sum and distribution bundles, differential-privacy budget audit logs, and threshold-committee authorization and reconstruction records. Payload terms are carried inside Interego (iep:) typed context descriptors — the descriptor layer supplies identity, provenance, temporal validity and access control; agg: supplies the aggregation domain." ;
    dct:creator [ a foaf:Organization ; foaf:name "Interego" ; foaf:homepage <https://markjspivey-xwisee.github.io/interego/> ] ;
    dct:license <https://opensource.org/licenses/MIT> ;
    vann:preferredNamespacePrefix "agg" ;
    vann:preferredNamespaceUri "https://markjspivey-xwisee.github.io/interego/applications/_shared/aggregate-privacy#" ;
    rdfs:seeAlso <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

# ══════════════════════════════════════════════════════════════
#  Classes
# ══════════════════════════════════════════════════════════════

agg:CohortParticipation a owl:Class ;
    rdfs:label "Cohort participation" ;
    rdfs:comment "A participant's self-asserted, revocable opt-in to a cohort aggregation. Published on the participant's own pod so the aggregator must discover consent rather than assume it; revoked by re-publishing a Counterfactual descriptor at the same IRI." ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/applications/_shared/aggregate-privacy#>.

agg:AttestedHomomorphicSumBundle a owl:Class ;
    rdfs:label "Attested homomorphic sum bundle" ;
    rdfs:comment "A published zk-aggregate result: a homomorphic Pedersen sum over per-contributor commitments plus DP-Laplace noise calibrated to a declared epsilon. Re-verifiable by any auditor against the contributor commitments." ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/applications/_shared/aggregate-privacy#>.

agg:AttestedHomomorphicDistributionBundle a owl:Class ;
    rdfs:label "Attested homomorphic distribution bundle" ;
    rdfs:comment "A published zk-distribution result: per-bucket homomorphic Pedersen sums and per-bucket DP-noised counts over a one-hot bucketing scheme, structurally verifiable bucket by bucket." ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/applications/_shared/aggregate-privacy#>.

agg:SignedBudgetAuditLog a owl:Class ;
    rdfs:label "Signed budget audit log" ;
    rdfs:comment "An operator-signed snapshot of an epsilon budget: the per-query consumption log plus the cumulative spend, signed so the accounting itself is tamper-evident rather than merely honest." ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/applications/_shared/aggregate-privacy#>.

agg:CommitteeAuthorization a owl:Class ;
    rdfs:label "Committee authorization" ;
    rdfs:comment "An operator's signed pre-commitment to the n authorized committee DIDs and the (n, t) threshold, published BEFORE shares are distributed. Cross-checked at audit time against the actual reveal committee, which is what catches an operator improvising a sock-puppet committee." ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/applications/_shared/aggregate-privacy#>.

agg:EncryptedShareDistribution a owl:Class ;
    rdfs:label "Encrypted share distribution" ;
    rdfs:comment "A verifiable Shamir share wrapped in an X25519/nacl envelope keyed to one intended pseudo-aggregator, published as an ordinary descriptor so the recipient collects it through standard pod discovery instead of an out-of-band channel." ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/applications/_shared/aggregate-privacy#>.

agg:CommitteeReconstructionAttestation a owl:Class ;
    rdfs:label "Committee reconstruction attestation" ;
    rdfs:comment "The chain-of-custody record of a threshold reveal: each participating committee member's signature over the bundle commitment, the claimed true sum, the member set and the reveal time, so a regulator can see who actually reconstructed and on which bundle." ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/applications/_shared/aggregate-privacy#>.

# ══════════════════════════════════════════════════════════════
#  Properties
# ══════════════════════════════════════════════════════════════

agg:cohort a owl:ObjectProperty ;
    rdfs:label "cohort" ;
    rdfs:domain agg:CohortParticipation ;
    rdfs:comment "The cohort this participation opts into." ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/applications/_shared/aggregate-privacy#>.

agg:participant a owl:ObjectProperty ;
    rdfs:label "participant" ;
    rdfs:domain agg:CohortParticipation ;
    rdfs:comment "The DID of the agent or person opting in. Also the asserting agent and issuer of the descriptor — participation is self-asserted by construction." ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/applications/_shared/aggregate-privacy#>.

agg:policy a owl:ObjectProperty ;
    rdfs:label "policy" ;
    rdfs:domain agg:CohortParticipation ;
    rdfs:comment "The cohort-aggregation policy descriptor the participant is consenting to. Optional: absent means the participant opted in without binding themselves to a published policy." ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/applications/_shared/aggregate-privacy#>.

agg:bundleJson a owl:DatatypeProperty ;
    rdfs:label "bundle JSON" ;
    rdfs:range xsd:string ;
    rdfs:comment "The verifiable bundle serialized as a single JSON literal. Deliberately opaque to the triple store: the verifier re-hashes these exact bytes, so decomposing them into triples would let a round-trip through any normalizing store silently break every signature over the bundle." ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/applications/_shared/aggregate-privacy#>.
