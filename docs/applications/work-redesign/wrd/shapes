    sh:property [ sh:path wrd:demoRecord ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ;
    sh:property [ sh:path wrd:signedBy ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path wrd:values ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path wrd:seed ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^[0-9a-f]{64}$" ] ;
    sh:property [ sh:path wrd:draws ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
    sh:property [ sh:path wrd:valuationMethod ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path wrd:cashWeeklyDeltaP10 ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:double ] ;
    sh:property [ sh:path wrd:cashWeeklyDeltaP50 ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:double ] ;
