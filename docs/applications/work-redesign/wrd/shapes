    sh:property [ sh:path wrd:payloadJson ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path wrd:status ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "submitted" "countersigned" "declined" "measured" ) ;
        sh:message "A decision version is submitted, countersigned, declined or measured." ] ;
    sh:property [ sh:path wrd:demoRecord ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ;
    sh:property [ sh:path wrd:signedBy ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path wrd:decides ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path wrd:decisionKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "valued" "probe" ) ] ;
    sh:property [ sh:path wrd:boundValuation ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path wrd:valuationHash ; sh:maxCount 1 ; sh:pattern "^[0-9a-f]{64}$" ] ;
    sh:property [ sh:path wrd:comparisonBasis ; sh:maxCount 1 ; sh:in ( "holdout" "staggered" "before-after" ) ] ;
    sh:property [ sh:path wrd:prediction ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
