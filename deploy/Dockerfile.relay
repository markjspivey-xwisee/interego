# ────────────────────────────────────────────────────────────
#  Build stage: workspace install + pack all @interego/* tarballs
# ────────────────────────────────────────────────────────────
# NODE_BASE: Docker Hub by default (local builds), overridable via --build-arg.
#
# Node 22, not 20: undici 7 (pulled in transitively by @comunica/actor-http-fetch)
# calls worker_threads.markAsUncloneable, which does not exist on Node 20. Recent
# undici guards it with a no-op fallback; the version this resolves to does not,
# so on Node 20 the relay dies at import with
#   TypeError: webidl.util.markAsUncloneable is not a function
# The other 12 service images still build on Node 20 and will hit this the first
# time they are rebuilt.
ARG NODE_BASE=node:22-slim
FROM ${NODE_BASE} AS build

ENV ONNXRUNTIME_NODE_INSTALL_CUDA=skip

WORKDIR /workspace

# Workspace plumbing (root package.json declares the workspaces).
COPY package.json package-lock.json tsconfig.base.json ./
COPY scripts/ ./scripts/
COPY packages/ ./packages/

# Install workspace deps. This creates symlinks under each package's
# node_modules pointing at sibling workspace packages, so cross-
# package imports (@interego/abac → @interego/core etc.) work.
RUN npm install --workspaces --include-workspace-root --no-audit --no-fund

# Build every @interego/* workspace package (core + 13 verticals).
RUN npm run build

# Pack each workspace package into /tarballs/*.tgz so the relay's
# install stage can install them directly without depending on the
# workspace symlinks (which don't transfer cleanly across docker
# image boundaries).
RUN mkdir -p /tarballs && \
    cd packages/core && npm pack --pack-destination /tarballs && cd /workspace && \
    for pkg in pgsl pgsl-store solid abac compliance connectors constitutional extractors ops p2p passport privacy registry security-txt skills transactions mdvault agent-interop; do \
      cd packages/$pkg && npm pack --pack-destination /tarballs && cd /workspace ; \
    done

# Copy doc files the relay serves as MCP resources at /mcp.
RUN mkdir -p /relay-docs
COPY README.md /relay-docs/README.md
COPY spec/architecture.md /relay-docs/architecture.md
COPY spec/LAYERS.md /relay-docs/LAYERS.md
COPY spec/DERIVATION.md /relay-docs/DERIVATION.md
COPY docs/EMERGENCE.md /relay-docs/EMERGENCE.md
COPY docs/AGENT-PLAYBOOK.md /relay-docs/AGENT-PLAYBOOK.md
COPY docs/AGENT-INTEGRATION-GUIDE.md /relay-docs/AGENT-INTEGRATION-GUIDE.md
COPY docs/ns/abac.ttl /relay-docs/abac.ttl
COPY docs/ns/code.ttl /relay-docs/code.ttl

# ★★ The framework ontologies, kept in a REAL `ns/` directory rather than flattened alongside the
# files above. @interego/compliance reads each framework's `iep:ControlSet` out of these at runtime
# to decide which controls a report scores against; without them it selects the frozen fallback
# array and every /audit surface silently reverts to the roster the ontologies replaced (16 SOC 2
# controls instead of the published 25). The relay installs that package from a tarball, so no
# directory walk from node_modules can ever reach the repo's docs/ns — the path is handed to it
# explicitly via INTEREGO_NS_DIR in the runtime stage.
#
# Per-file, like every COPY above: a directory COPY here silently picks up whatever else lands in
# docs/ns later, and this image should ship the ontologies it actually reads.
RUN mkdir -p /relay-docs/ns
COPY docs/ns/soc2.ttl /relay-docs/ns/soc2.ttl
COPY docs/ns/nist-rmf.ttl /relay-docs/ns/nist-rmf.ttl
COPY docs/ns/eu-ai-act.ttl /relay-docs/ns/eu-ai-act.ttl
# The retrieval lexicon lands here too, not because the relay expands queries today, but
# because INTEREGO_NS_DIR is PINNED in this image: the upward directory walk that finds
# docs/ns in every other image is skipped entirely once that variable is set, so anything
# @interego/pgsl needs has to be in this directory or it silently falls back.
COPY docs/ns/pgsl-lexicon.ttl /relay-docs/ns/pgsl-lexicon.ttl
# ★ The L1 protocol ontology, because the relay now ENFORCES a rule that lives in it:
# `iep:NotificationBodyShape` is the contract every notify_agent notification is validated
# against before it is written (deploy/mcp-relay/notification-body.ts). Publishing the rule and
# enforcing it from the same bytes is the point — an image that shipped the code without this
# file would silently stop enforcing, and the only signal would be a WARN line at first use. So
# tests/notification-body-shape.test.ts asserts this line exists AND that its destination is
# exactly where the running module's first candidate path looks from /app/dist.
COPY docs/ns/iep.ttl /relay-docs/ns/iep.ttl

# ────────────────────────────────────────────────────────────
#  Build stage: install relay deps + compile server.ts
# ────────────────────────────────────────────────────────────
WORKDIR /app

COPY deploy/mcp-relay/package.json ./package.json.template
# Rewrite the relay's package.json so @interego/* deps point at the
# tarballs we just packed instead of workspace specifiers. The
# workspace symlinks don't carry across image boundaries.
#
# The relay's package.json declares only the leaf packages it
# directly imports — core / solid / pgsl / compliance / privacy /
# security-txt / ops. We install exactly those tarballs.
#
# Strategy: drop the workspace specifiers from package.json (npm
# would otherwise reject `*`) then install the tarballs directly so
# npm pins them as file: deps.
# Strip the @interego/* workspace deps (installed from tarballs below) AND
# @playwright/test.
#
# Playwright is a BROWSER-TEST harness used only by tests/passkey-oauth.spec.ts, which
# neither this image nor `npm test` ever runs — but the image build installed it anyway,
# because this step keeps devDependencies (tsc and tsx are needed by the build stage).
# It downloaded a browser-automation toolchain into a server image for nothing, and it
# broke the build the day @playwright/test published a version whose pinned `playwright`
# had not yet propagated to the registry replica the runner hit:
#   npm error notarget No matching version found for playwright@1.62.1
# A transient registry race should not be able to fail a relay deploy over a dependency
# the image does not use.
RUN node -e "const fs=require('fs');const p=JSON.parse(fs.readFileSync('./package.json.template','utf8'));for(const k of Object.keys(p.dependencies)){if(k.startsWith('@interego/'))delete p.dependencies[k];}if(p.devDependencies)delete p.devDependencies['@playwright/test'];fs.writeFileSync('./package.json',JSON.stringify(p,null,2));" && \
    rm package.json.template && \
    npm install --no-audit --no-fund \
      /tarballs/interego-core-0.2.0.tgz \
      /tarballs/interego-solid-0.2.0.tgz \
      /tarballs/interego-pgsl-0.2.0.tgz \
      /tarballs/interego-pgsl-store-0.0.1.tgz \
      /tarballs/interego-abac-0.2.0.tgz \
      /tarballs/interego-compliance-0.2.0.tgz \
      /tarballs/interego-privacy-0.2.0.tgz \
      /tarballs/interego-security-txt-0.2.0.tgz \
      /tarballs/interego-ops-0.2.0.tgz \
      /tarballs/interego-mdvault-0.1.0.tgz \
      /tarballs/interego-agent-interop-0.2.0.tgz

COPY deploy/mcp-relay/tsconfig.json ./
COPY deploy/mcp-relay/server.ts ./
COPY deploy/mcp-relay/oauth-provider.ts ./
COPY deploy/mcp-relay/oauth-router.ts ./
COPY deploy/mcp-relay/oauth-client-store.ts ./
COPY deploy/mcp-relay/oauth-token-store.ts ./
COPY deploy/mcp-relay/dpop.ts ./
COPY deploy/mcp-relay/cors-allowlist.ts ./
COPY deploy/mcp-relay/bounded-map.ts ./
COPY deploy/mcp-relay/federation-store.ts ./
COPY deploy/mcp-relay/url-rewrite.ts ./
COPY deploy/mcp-relay/relay-key-gate.ts ./
COPY deploy/mcp-relay/egress.ts ./
COPY deploy/mcp-relay/lazy-pod-init.ts ./
COPY deploy/mcp-relay/compliance-sign.ts ./
COPY deploy/mcp-relay/agent-mesh.ts ./
COPY deploy/mcp-relay/agent-interop-mount.ts ./
COPY deploy/mcp-relay/activitypub.ts ./
COPY deploy/mcp-relay/reachability.ts ./
COPY deploy/mcp-relay/alternate-turtle.ts ./
COPY deploy/mcp-relay/shape-body.ts ./
COPY deploy/mcp-relay/shapes-declared.ts ./
# The gate that validates a notification body against the published shape, and the AS2 -> Turtle
# projection that lets a SHACL engine see one. Extracted for the usual reason: server.ts opens a
# listener on import, so "which caller gets refused" could not otherwise be run by a test.
COPY deploy/mcp-relay/notification-body.ts ./
COPY deploy/mcp-relay/supersession-frontier.ts ./
COPY deploy/mcp-relay/required-args.ts ./
COPY deploy/mcp-relay/turtle-iri-args.ts ./
COPY deploy/mcp-relay/sealed-payload.ts ./
COPY deploy/mcp-relay/pod-selector.ts ./
COPY deploy/mcp-relay/interop-principal.ts ./
COPY deploy/mcp-relay/notification-log.ts ./
COPY deploy/mcp-relay/pod-status-page.ts ./
COPY deploy/mcp-relay/amep.ts ./
COPY deploy/mcp-relay/amep-session-bridge.ts ./
COPY deploy/mcp-relay/note-view.ts ./
COPY deploy/mcp-relay/hmd-app.ts ./
COPY deploy/mcp-relay/hmd-app-logic.ts ./
COPY deploy/mcp-relay/pgsl-node-store.ts ./
COPY deploy/mcp-relay/engagement-store.ts ./
COPY deploy/mcp-relay/authorship-content-binding.ts ./
# The action naming authority (roster + resolution rule), extracted from server.ts so the rule is
# testable. tests/image-copies-every-source.test.ts fails if a module server.ts imports is missing
# from this list — it caught exactly that on this file, which is what the gate is for.
COPY deploy/mcp-relay/action-authority.ts ./
# The /ns dereference surface: the RDF-projection routes, the PGSL node authority, the
# iep:action route, and the pure Turtle/JSON-LD/HTML/HyperMarkdown projections. Extracted
# from server.ts so the projections are importable; server.ts imports it, so this per-file
# COPY is mandatory — image-copies-every-source.test.ts walks the real import graph.
COPY deploy/mcp-relay/ns-dereference.ts ./
# Pod authorization: which pod URLs a bearer may act on, and which of them the relay minted
# itself. Extracted for the same reason — server.ts is unimportable, so the rule was untested.
COPY deploy/mcp-relay/pod-authorization.ts ./
# The pod-side writers: the WAC .acl writer, the /profile/card writer, the iep:PodBootstrap
# descriptor writer, and the bootstrap that sequences them. Extracted for the same reason
# again — these run on relay credentials against the live store and their only coverage was a
# regex over server.ts's source text.
COPY deploy/mcp-relay/pod-writers.ts ./
# The expects/returns URLs the operations catalog advertises, and the JSON Schema documents
# served at them. Extracted because the catalog was minting urn: values that fetch nothing.
COPY deploy/mcp-relay/operation-contracts.ts ./
# AMEP reference validator + JSON-LD context, vendored verbatim. amep.ts loads
# them by a path relative to the COMPILED module (dist/amep.js), so after tsc
# they must sit at dist/amep-vendor/.
COPY deploy/mcp-relay/amep-vendor/ ./amep-vendor/
RUN npx tsc && cp -r amep-vendor dist/amep-vendor

# ────────────────────────────────────────────────────────────
#  Runtime stage: distroless image running compiled JS
# ────────────────────────────────────────────────────────────
FROM gcr.io/distroless/nodejs22-debian12

WORKDIR /app

COPY --from=build /app/dist ./dist
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./
COPY --from=build /relay-docs ./relay-docs

EXPOSE 8080

ENV PORT=8080
ENV CSS_URL=http://css:3456/

# Where @interego/compliance reads the published control rosters. See the COPY block in the doc
# stage: this package is installed from a tarball, so its own directory walk can never find the
# repo's docs/ns and would fall back to the frozen array without ever failing. `/audit/frameworks`
# reports `scopeSource`, so a probe of the running relay tells you which one it actually used.
ENV INTEREGO_NS_DIR=/app/relay-docs/ns

# The commit this image was built from, surfaced at /health so a deploy can be
# VERIFIED rather than assumed. Declared in the runtime stage on purpose: putting
# it earlier would invalidate the build cache on every commit, and nothing before
# this line depends on it. Defaults to "unset" for local builds that pass no arg.
ARG GIT_SHA=unset
ENV INTEREGO_BUILD_SHA=$GIT_SHA

CMD ["dist/server.js"]
