# ────────────────────────────────────────────────────────────
#  Foxxi vertical bridge — Railway production deployment.
#
#  Preserves the on-disk repo layout under /app so the bridge's
#  relative imports (`../affordances.ts`, `../src/...`, `../../_shared/...`,
#  `../../learner-performer-companion/src/grounded-answer.js`) work
#  unchanged. The Interego substrate is imported as the `@interego/core`
#  package (now at packages/core/ in the @interego/workspace monorepo),
#  not via relative paths — so a future extraction of the foxxi vertical
#  into its own repo is mechanical. Runs via tsx for the vertical's TS
#  sources (no separate compile step needed for the vertical).
# ────────────────────────────────────────────────────────────

# The runtime keeps the existing cached bridge-base layers. A separate native web build stage
# inherits those layers and copies back ONLY generated public artifacts, not another /app tree.
# Git history, downloaded reasoner/cache and build-only Java never enter the runtime image.
ARG NODE_BASE=node:22-bookworm-slim
FROM ${NODE_BASE} AS bridge-base

ENV ONNXRUNTIME_NODE_INSTALL_CUDA=skip

WORKDIR /app

# Workspace manifests — npm ci requires every declared workspace's
# package.json to exist before it can resolve the tree.
COPY package.json package-lock.json tsconfig.base.json tsconfig.json ./
COPY packages/abac/package.json ./packages/abac/
COPY packages/agent-interop/package.json ./packages/agent-interop/
COPY packages/compliance/package.json ./packages/compliance/
COPY packages/connectors/package.json ./packages/connectors/
COPY packages/constitutional/package.json ./packages/constitutional/
COPY packages/core/package.json ./packages/core/
COPY packages/deployment-config/package.json ./packages/deployment-config/
COPY packages/extractors/package.json ./packages/extractors/
COPY packages/local-node/package.json ./packages/local-node/
COPY packages/mdvault/package.json ./packages/mdvault/
COPY packages/ops/package.json ./packages/ops/
COPY packages/p2p/package.json ./packages/p2p/
COPY packages/passport/package.json ./packages/passport/
COPY packages/pgsl/package.json ./packages/pgsl/
COPY packages/pgsl-store/package.json ./packages/pgsl-store/
COPY packages/pod-federation/package.json ./packages/pod-federation/
COPY packages/privacy/package.json ./packages/privacy/
COPY packages/registry/package.json ./packages/registry/
COPY packages/security-txt/package.json ./packages/security-txt/
COPY packages/skills/package.json ./packages/skills/
COPY packages/solid/package.json ./packages/solid/
COPY packages/transactions/package.json ./packages/transactions/
COPY packages/workspace-client/package.json ./packages/workspace-client/
COPY mcp-server/package.json ./mcp-server/
COPY deploy/mcp-relay/package.json ./deploy/mcp-relay/
COPY deploy/identity/package.json ./deploy/identity/
COPY deploy/validator/package.json ./deploy/validator/
COPY applications/foxxi-content-intelligence/bridge/package.json ./applications/foxxi-content-intelligence/bridge/
COPY applications/agentic-performance-practice/bridge/package.json ./applications/agentic-performance-practice/bridge/
COPY applications/learner-performer-companion/bridge/package.json ./applications/learner-performer-companion/bridge/
COPY applications/agent-collective/bridge/package.json ./applications/agent-collective/bridge/
COPY applications/agent-development-practice/bridge/package.json ./applications/agent-development-practice/bridge/
COPY applications/organizational-working-memory/bridge/package.json ./applications/organizational-working-memory/bridge/
COPY applications/lrs-adapter/bridge/package.json ./applications/lrs-adapter/bridge/
RUN npm ci

# tsx is a root devDependency now (pinned in package.json), so npm ci above installs it and no
# layer below the cached install changes node_modules: the separate install that sat here re-ran
# on every build (24 s) and made the node_modules layer differ each time.

# Copy the bits the bridge transitively needs, preserving relative-path layout:
#   - packages/core/                                  (@interego/core sources)
#   - docs/ns/                                        (ontology TTLs that tools load)
#   - applications/_shared/                           (vertical-bridge + affordance-mcp + aggregate-privacy + scorm + vc-jwt)
#   - applications/foxxi-content-intelligence/        (the vertical itself)
#   - applications/learner-performer-companion/src/   (grounded-answer.ts imported by course-qa.ts)
# All workspace packages — the foxxi vertical imports @interego/core,
# @interego/solid (discover/resolveDid for mesh + federation), @interego/pgsl,
# and @interego/passport. Copy + build the whole set (mirrors Dockerfile.relay)
# so every @interego/* the bridge loads at runtime resolves to its built dist/.
COPY packages/ ./packages/

# ★ The retrieval lexicon, as DATA. @interego/pgsl reads docs/ns/pgsl-lexicon.ttl at runtime
# for query expansion (synonyms, IS-A, part-of, causal relations). Without it the package
# silently selects its frozen FALLBACK_* tables — behaviour is identical today, because the
# published file is generated from them and a test pins that, but the whole point of moving
# the knowledge out of TypeScript is that a deployment reads the published copy. Landing it
# at /app/docs/ns is enough: the package walks up from its own dist/ and finds it there, so
# no INTEREGO_NS_DIR is needed here.
COPY docs/ns/pgsl-lexicon.ttl ./docs/ns/pgsl-lexicon.ttl
COPY docs/ns/ ./docs/ns/
COPY applications/_shared/ ./applications/_shared/
COPY applications/foxxi-content-intelligence/ ./applications/foxxi-content-intelligence/
# The SCORM runtime (window.API / API_1484_11) the bridge puts into the documents of the SCORM
# packages it hosts (src/scorm-hosting.ts): the SCORM player's own file, so there is one runtime.
COPY deploy/foxxi-scorm-player/site/scorm-rte.js ./deploy/foxxi-scorm-player/site/scorm-rte.js
COPY applications/llm-telemetry/ ./applications/llm-telemetry/
# The agentic-performance (agp:) vertical: Foxxi composes its relocated engine
# (transitional re-export shims) + the agp standards-extension capability it
# re-integrates and surfaces. Imported by relative path from the foxxi bridge, so
# the directory must ship in the image (it is not an npm workspace, so npm ci above
# is unaffected; @interego/* still resolves via the root node_modules symlinks).
COPY applications/agentic-performance-practice/ ./applications/agentic-performance-practice/
COPY applications/learner-performer-companion/src/ ./applications/learner-performer-companion/src/
# lrs-adapter provides the TLA Experience Index read-side federator that the
# foxxi bridge composes for foxxi.query_experience_index.
COPY applications/lrs-adapter/src/ ./applications/lrs-adapter/src/
# directory-actions imports the compliance evidence overlay by repository-relative path.
# Its runtime imports use the @interego/* packages already copied above.
COPY integrations/compliance-overlay/src/ ./integrations/compliance-overlay/src/

# Compile all @interego/* packages → their dist/. The foxxi vertical imports
# @interego/core + @interego/solid + @interego/pgsl + @interego/passport, and
# each package's exports map resolves to dist/ — so the package builds are
# load-bearing at runtime (mirrors Dockerfile.relay's package builds).
# The pull request built these packages already; build-ghcr.yml restores them into the context
# and passes PREBUILT=1, and the build below is skipped when they are present. A local build
# without them still builds. (.dockerignore stopped excluding dist/ for this.)
ARG PREBUILT=0
RUN if [ "$PREBUILT" = "1" ] && [ -f packages/registry/dist/index.js ]; then echo "prebuilt packages present; skipping the build"; else (npm run build:core && npm run build:leaves); fi

# Make `@interego/core` resolvable by name. The substrate kernel package
# now lives at packages/core/ (the repo root is @interego/workspace);
# point the symlink at packages/core so Node resolves `@interego/core`
# (from anywhere under /app) to that package.json, whose `exports` map
# points at the dist/ just compiled. npm ci will have created this
# symlink as part of the workspace install — this line is explicit and
# idempotent.
RUN mkdir -p node_modules/@interego \
  && ln -sfn /app/packages/core node_modules/@interego/core \
  && ln -sfn /app/packages/solid node_modules/@interego/solid \
  && ln -sfn /app/packages/pgsl node_modules/@interego/pgsl \
  && ln -sfn /app/packages/passport node_modules/@interego/passport \
  && ln -sfn /app/packages/skills node_modules/@interego/skills \
  && ln -sfn /app/packages/constitutional node_modules/@interego/constitutional


# The pinned upper-ontology sources, already verified on the runner. build-ghcr.yml replaces this
# stage with an image of them that it pushed once for these pins (`--build-context
# upper-seed=docker-image://...`), or with a directory when it has no complete set
# (`upper-seed=<dir>`); see the COPY into .cache/upper below. Built without either, it stays this
# empty stage, the COPY copies nothing, and the build fetches every source from its publisher, as
# a local build always has.
FROM scratch AS upper-seed

# I2IDL-X pages are generated natively from verified publisher evidence and an immutable
# canonical glossary commit. New upstream versions cannot silently enter an image.
FROM bridge-base AS i2idlx-builder
RUN apt-get update \
  && apt-get install -y --no-install-recommends git ca-certificates openjdk-17-jre-headless \
  && rm -rf /var/lib/apt/lists/* \
  && java -version 2>&1 | grep -E 'version "17[.]'
RUN npm ci --prefix applications/foxxi-content-intelligence/i2idlx/app
ENV I2IDL_CLONE=/tmp/i2idlx-canonical-source
# Preserve the handoff's agreed publication baseline instead of stamping every rebuild as new.
ENV I2IDLX_BUILT_DATE=2026-10-08
ENV I2IDLX_MODIFIED=2026-10-19
ENV I2IDLX_NOW=2026-10-19T00:51:00+00:00
RUN npx tsx applications/foxxi-content-intelligence/i2idlx/typescript/prepare-source.ts \
  /app/applications/foxxi-content-intelligence/i2idlx /tmp/i2idlx-canonical-source
# ★ prepare-build-inputs.ts below restores 21 sources that evidence/upper/manifest.json pins by
# SHA-256, and it used to fetch every one from its publisher every time this stage ran rather than
# came from the layer cache. On 2026-10-27 data.europa.eu timed out on ESCO (four attempts in under
# a minute), this stage failed, and the all-or-nothing auto-deploy held back every service; a re-run
# of the same jobs succeeded. CI now fetches and verifies them on the runner and passes them here as
# the upper-seed stage (build-ghcr.yml, "seed: i2idlx-upper"). Nothing is trusted for having been
# kept: refresh-upper.ts checks each file against the manifest's SHA-256 exactly as it checks a
# fresh fetch, and a source the seed does not carry is fetched live as before.
# The COPY makes this stage's layer cache keyed on the seed too. Whenever the seed is not what the
# cached build had (other bytes, or the same bytes from a directory instead of the image), the COPY
# and every step after it run again (the seed step, prepare-build-inputs.ts, build.ts, which reads
# gate.interego.xwisee.com, and the output check), even when bridge-base has not changed and the
# whole stage used to come from the layer cache. That is why CI passes the same image for the same
# pins every time, not whatever its Actions cache holds. The COPY sits after prepare-source.ts, so apt-get, the workbench's npm ci and the clone do
# not run again. .cache never reaches the runtime stage, which copies only site-ts, dist-ts and
# app/build-ts out of this one.
COPY --from=upper-seed / /app/applications/foxxi-content-intelligence/i2idlx/.cache/upper/
# gUFO's persistent URL serves whatever its publisher last committed, and bytes that differ from
# the manifest's pin are refused, so the pinned bytes come from the publisher's own commit
# (tools/seed-pinned-upper.mjs); refresh-upper.ts still checks them against the pin. When the seed
# above carried gUFO, this step finds it already matching and fetches nothing.
RUN node applications/foxxi-content-intelligence/i2idlx/tools/seed-pinned-upper.mjs \
  /app/applications/foxxi-content-intelligence/i2idlx
# Use exactly the golden gate's retained snapshots. Only missing xAPI TTLs and
# byte-pinned upper/ROBOT inputs may be restored; no live --all evidence refresh.
RUN npx tsx applications/foxxi-content-intelligence/i2idlx/typescript/prepare-build-inputs.ts \
  /app/applications/foxxi-content-intelligence/i2idlx
RUN npx tsx applications/foxxi-content-intelligence/i2idlx/typescript/build.ts \
  /app/applications/foxxi-content-intelligence/i2idlx
RUN test -s applications/foxxi-content-intelligence/i2idlx/site-ts/app.html \
  && test -s applications/foxxi-content-intelligence/i2idlx/site-ts/index.html \
  && test -s applications/foxxi-content-intelligence/i2idlx/dist-ts/native-verification.json

FROM bridge-base AS runtime
COPY --from=i2idlx-builder /app/applications/foxxi-content-intelligence/i2idlx/site-ts/ ./applications/foxxi-content-intelligence/i2idlx/site-ts/
COPY --from=i2idlx-builder /app/applications/foxxi-content-intelligence/i2idlx/dist-ts/ ./applications/foxxi-content-intelligence/i2idlx/dist-ts/
COPY --from=i2idlx-builder /app/applications/foxxi-content-intelligence/i2idlx/app/build-ts/ ./applications/foxxi-content-intelligence/i2idlx/app/build-ts/

EXPOSE 6080

ENV PORT=6080
ENV NODE_NO_WARNINGS=1

# Defaults — override via Railway service variables at deploy time.
#
# ────────────────────────────────────────────────────────────
#  Gate-fronted write architecture
# ────────────────────────────────────────────────────────────
#  Pod writes from this bridge go THROUGH the css-gate sidecar, not direct
#  to CSS. The gate (deploy/css-gate/server.mjs) requires
#  `Authorization: Bearer <WRITE_SECRET>` on every POST/PUT/PATCH/DELETE
#  and forwards the buffered request to the underlying CSS instance.
#  Reads (GET/HEAD/OPTIONS) pass through anonymously — CSS storage stays
#  allow-all per Interego's zero-trust storage stance (trust lives at the
#  verifier + reader layer, not at the storage layer).
#
#  Therefore FOXXI_TENANT_POD_URL MUST point at the gate URL (not the raw
#  CSS URL), and FOXXI_POD_WRITE_SECRET MUST be set to match the gate's
#  WRITE_SECRET — otherwise every bridge-originated write 401s at the gate.
# ────────────────────────────────────────────────────────────
ENV FOXXI_TENANT_POD_URL=https://gate.interego.xwisee.com/foxxi/
ENV FOXXI_AUTHORITATIVE_SOURCE=did:web:acme-id.interego.xwisee.com
ENV FOXXI_AUDIENCE=both
ENV BRIDGE_DEPLOYMENT_URL=https://foxxi-bridge.interego.xwisee.com
ENV FOXXI_DASHBOARD_ORIGIN=https://foxxi-dashboard.interego.xwisee.com

# Bearer token presented to css-gate on every pod write. MUST be overridden
# at deploy time with the value matching the gate container's WRITE_SECRET;
# the empty default exists only so the build doesn't bake a secret into the
# image. With this unset, every publish() 401s at the gate and the bridge
# silently produces published=[] on every signed-outcome request.
ENV FOXXI_POD_WRITE_SECRET=

# Stable bridge service identity. 0x-prefixed 32-byte hex ECDSA private key
# whose derived address becomes the bridge's did:key:0x<addr>#bridge —
# used to sign bridge-originated descriptors (snapshots, calibration-flip
# records) with CryptographicallyVerified trust. If unset, an ephemeral key
# is generated at container startup (the bridge logs a warning); the bridge
# still runs, but the signing identity rotates on every restart, so peer
# readers can't establish identity continuity across deployments and
# previously-published bridge-signed descriptors can no longer be linked
# back to a live signer. Override at deploy time for stable identity.
ENV FOXXI_BRIDGE_PRIVATE_KEY=

# Optional workbench writes are disabled until the deployment owner supplies existing pod,
# participant/editor and independently verified owner signing-key bindings. No account creation.
ENV FOXXI_I2IDLX_SHARED_POD_URL=
ENV FOXXI_I2IDLX_PARTICIPANTS=
ENV FOXXI_I2IDLX_EDITORS=
ENV FOXXI_I2IDLX_OWNER_ANCHORS={}
ENV FOXXI_I2IDLX_SITE_DIR=/app/applications/foxxi-content-intelligence/i2idlx/site-ts
ENV FOXXI_I2IDLX_DIST_DIR=/app/applications/foxxi-content-intelligence/i2idlx/dist-ts

# The commit this image was built from, surfaced at /health (mounted by the shared
# createVerticalBridge factory) so a deploy can be VERIFIED rather than assumed.
# build-ghcr.yml already appends GIT_SHA to every image's build-args; without this ARG
# Docker drops it with a warning and the image builds green, so a rollout of this bridge
# could not be distinguished from the old container still serving. Runtime stage on
# purpose: ARG does not cross a FROM, and earlier would bust the cache on every commit.
ARG GIT_SHA=unset
ENV INTEREGO_BUILD_SHA=$GIT_SHA

# Exercise the real tsx entrypoint in the assembled runtime filesystem. This catches
# transitive relative imports that compile in the repo but were omitted from COPY.
# Fixture-only configuration and disabled networking keep the probe self-contained.
COPY tools/smoke-foxxi-container.mjs ./tools/smoke-foxxi-container.mjs
RUN --network=none node tools/smoke-foxxi-container.mjs

CMD ["npx", "tsx", "applications/foxxi-content-intelligence/bridge/server.ts"]
