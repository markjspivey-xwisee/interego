# ────────────────────────────────────────────────────────────
#  Interego validator-as-agent service
#
#  Layer 3 reference implementation of the Layer 2 "validator as
#  first-class federated agent" pattern. See spec/LAYERS.md.
#  Not deployed to the Azure matrix until its rules are wired.
# ────────────────────────────────────────────────────────────
# NODE_BASE: Docker Hub by default (local builds), ACR-imported copy in
# CI via --build-arg — see deploy-azure.yml / Dockerfile.identity.
ARG NODE_BASE=node:20-slim
FROM ${NODE_BASE} AS build

WORKDIR /app

# Copy the lockfile too and use `npm ci` — a reproducible install
# pinned to package-lock.json (same rationale as Dockerfile.identity).
COPY deploy/validator/package.json deploy/validator/package-lock.json ./
RUN npm ci

COPY deploy/validator/tsconfig.json ./
COPY deploy/validator/server.ts ./
RUN npx tsc

# ────────────────────────────────────────────────────────────
#  Runtime stage: distroless image running compiled JS
# ────────────────────────────────────────────────────────────
FROM gcr.io/distroless/nodejs20-debian12

WORKDIR /app

COPY --from=build /app/dist ./dist
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./

EXPOSE 9090

# The commit this image was built from, surfaced at /health so a deploy can be VERIFIED
# rather than assumed. build-ghcr.yml appends GIT_SHA to every image's build-args; without
# this ARG Docker drops it with a warning and the image builds green. This service is not
# on Railway today, so this is pre-emptive — but the alternative is an exemption list, and
# an exemption list is exactly the hand-maintained inclusion list that let five public
# surfaces go uncovered. Runtime stage: ARG does not cross a FROM.
ARG GIT_SHA=unset
ENV INTEREGO_BUILD_SHA=$GIT_SHA

CMD ["dist/server.js"]
