# ────────────────────────────────────────────────────────────
#  Interego substrate demo microsite — Azure Container Apps.
#
#  Static Vite + React SPA. VITE_INTEREGO_BRIDGE_URL is baked at build
#  time so the microsite discovers + invokes the live interego-bridge.
#  nginx serves the bundle on 8080. Self-contained (no @interego imports
#  in the browser — it talks to the bridge over HTTP).
# ────────────────────────────────────────────────────────────

ARG NODE_BASE=node:20-slim
FROM ${NODE_BASE} AS build
WORKDIR /app

ARG VITE_INTEREGO_BRIDGE_URL
ENV VITE_INTEREGO_BRIDGE_URL=${VITE_INTEREGO_BRIDGE_URL}
RUN test -n "$VITE_INTEREGO_BRIDGE_URL" || (echo "VITE_INTEREGO_BRIDGE_URL build-arg is required" >&2 && exit 1)

ARG CACHEBUST=0
RUN echo "cachebust ${CACHEBUST}"

COPY demos/interego-microsite/package.json demos/interego-microsite/vite.config.ts demos/interego-microsite/tsconfig.json demos/interego-microsite/index.html /app/
COPY demos/interego-microsite/src/ /app/src/
RUN npm install --no-audit --no-fund && npm run build

# ────────────────────────────────────────────────────────────
FROM public.ecr.aws/docker/library/nginx:1.27-alpine
# nginx config lives in deploy/nginx-spa.conf — a real file, not an escaped printf.
# It 404s missing assets instead of returning the SPA shell with a 200, and sets HSTS.
COPY deploy/nginx-spa.conf /etc/nginx/conf.d/default.conf
# Bake the commit into /health so a redeploy of THIS image can be verified the same way
# the relay is: GET /health and compare the sha. build-ghcr.yml already passes GIT_SHA to
# every image; before this, only the relay consumed it and every static SPA answered
# /health with the HTML shell — a 200 that meant nothing.
ARG GIT_SHA=unset
RUN sed -i "s|__BUILD_SHA__|${GIT_SHA}|g" /etc/nginx/conf.d/default.conf
# ★ Validate at BUILD time. An nginx syntax error otherwise surfaces only when the
# container starts: the image builds green, CI passes, and the service crash-loops on
# deploy. `nginx -t` turns that into a failed build, where it belongs.
RUN nginx -t
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
