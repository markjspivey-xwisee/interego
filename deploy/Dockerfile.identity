# ────────────────────────────────────────────────────────────
#  Build stage: compile server.ts with tsc
# ────────────────────────────────────────────────────────────
# NODE_BASE defaults to Docker Hub so local `docker build` works
# anonymously; CI overrides it to the ACR-imported copy (--build-arg)
# to dodge Docker Hub's anonymous pull rate limit. See deploy-azure.yml.
ARG NODE_BASE=node:22-slim
FROM ${NODE_BASE} AS build

WORKDIR /app

# Copy the lockfile too and use `npm ci` — a reproducible install
# pinned to package-lock.json. `npm install` without the lockfile
# re-resolves caret ranges on every build, which makes the image
# non-deterministic and "works locally / fails in CI" possible.
COPY deploy/identity/package.json deploy/identity/package-lock.json ./
RUN npm ci

COPY deploy/identity/tsconfig.json ./
COPY deploy/identity/server.ts ./
COPY deploy/identity/cors-allowlist.ts ./
COPY deploy/identity/webfinger.ts ./
COPY deploy/identity/did-parse.ts ./
COPY deploy/identity/timing.ts ./
COPY deploy/identity/derive-userid.ts ./
COPY deploy/identity/resolve-target-userid.ts ./
RUN npx tsc

# ────────────────────────────────────────────────────────────
#  Runtime stage: distroless image running compiled JS
#
#  Distroless drops the Debian userland (no shell, no package
#  manager, ~60MB vs ~200MB for node:22-slim) and dramatically
#  reduces the CVE surface. `node` is the entrypoint, so CMD
#  is just the script path.
# ────────────────────────────────────────────────────────────
FROM gcr.io/distroless/nodejs22-debian12

WORKDIR /app

COPY --from=build /app/dist ./dist
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./

EXPOSE 8090

ENV PORT=8090
ENV CSS_URL=http://css:3456/

# The commit this image was built from, surfaced at /health so a deploy can be VERIFIED
# rather than assumed.
#
# ★ build-ghcr.yml ALREADY appends GIT_SHA=${{ github.sha }} to EVERY image's build-args.
# Without a matching ARG here Docker drops it — an unconsumed build-arg is a WARNING, not
# an error — so this image was handed its own commit sha on every build and threw it away,
# and `tools/railway-redeploy.mjs --verify-url` could only ever read "(no build field)" and
# time out. That is why every identity deploy in this stack's history was unverified, and
# it is how identity came to sit pinned to a commit whose deployment had been created forty
# hours BEFORE that commit existed, with nothing able to say so.
#
# Declared in the RUNTIME stage on purpose: ARG does not cross a FROM, and declaring it
# earlier would invalidate the npm-install and tsc layers on every commit. Same placement
# and same reason as deploy/Dockerfile.relay.
ARG GIT_SHA=unset
ENV INTEREGO_BUILD_SHA=$GIT_SHA

CMD ["dist/server.js"]
