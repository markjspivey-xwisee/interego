# ────────────────────────────────────────────────────────────
#  CSS write-gate — small Node reverse proxy fronting the CSS pod server.
#
#  Transport: undici Pool over HTTP/1.1 by default (allowH2=false). Against
#  Container Apps' internal envoy, ALPN-negotiated h2 produced ECONNRESET
#  storms under sustained load on this pool while the relay (Node fetch,
#  h1) kept working against the same envoy — so we match the relay's
#  working path. Flip UPSTREAM_ALLOW_H2=1 to re-enable h2 once the upstream
#  is wire-confirmed healthy. Streaming bodies are forwarded as-is; the
#  UPSTREAM_REQUEST_BUFFER=1 env var keeps the legacy buffered-body
#  behavior available as an escape hatch.
#
#  Write-gating model:
#    - GET/HEAD/OPTIONS pass through anonymously (reads stay zero-trust at
#      the storage layer).
#    - POST/PUT/PATCH/DELETE require Authorization: Bearer <WRITE_SECRET>
#      (operator) or a per-user bearer verified against IDENTITY_URL;
#      missing or mismatched bearer → 401, request never reaches CSS.
# ────────────────────────────────────────────────────────────

ARG NODE_BASE=node:22-alpine
FROM ${NODE_BASE}

WORKDIR /app

# Install runtime deps (undici) from the committed lockfile with `npm ci`, so the
# image ships the tree that was audited and tested (CI's provisional-play job runs
# `npm ci --prefix deploy/css-gate`). `npm install` without the lock re-resolved
# ^7 at every build, so the shipped undici was whatever was newest that day.
# --omit=dev keeps test tooling out.
COPY deploy/css-gate/package.json deploy/css-gate/package-lock.json /app/
RUN npm ci --omit=dev --no-audit --no-fund

COPY deploy/css-gate/server.mjs /app/server.mjs
COPY deploy/css-gate/provisional-play.mjs /app/provisional-play.mjs

EXPOSE 8080
ENV PORT=8080

# ── Required env vars ───────────────────────────────────────
# WRITE_SECRET — bearer token the gate requires on every mutating request.
# REQUIRED: the gate exits with an error at startup if this is unset, so the
# container will refuse to start without it. MUST match the Foxxi bridge's
# FOXXI_POD_WRITE_SECRET env var; otherwise the bridge's writes get 401'd.
ENV WRITE_SECRET=

# CSS_INTERNAL_URL — upstream CSS origin the gate forwards to.
# REQUIRED: server.mjs exits at startup if unset. Set this to the internal/
# private hostname for CSS (e.g., Azure Container Apps internal DNS such as
# https://interego-css.internal.<env>.azurecontainerapps.io).
ENV CSS_INTERNAL_URL=

# The commit this image was built from, surfaced at /healthz so a deploy can be VERIFIED
# rather than assumed. build-ghcr.yml already appends GIT_SHA to every image's build-args;
# without this ARG Docker drops it with a warning and the image builds green. ★ This
# service is the standing example of the cost: it ran an image predating its own HSTS fix
# for days, and nothing it served could say which build it was. Runtime stage on purpose:
# ARG does not cross a FROM, and earlier would bust the cache on every commit.
ARG GIT_SHA=unset
ENV INTEREGO_BUILD_SHA=$GIT_SHA

CMD ["node", "/app/server.mjs"]

