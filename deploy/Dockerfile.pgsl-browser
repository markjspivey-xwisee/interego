# ────────────────────────────────────────────────────────────
#  Build stage: workspace install + pack @interego/core tarball
# ────────────────────────────────────────────────────────────
ARG NODE_BASE=node:22-slim
FROM ${NODE_BASE} AS build

ENV ONNXRUNTIME_NODE_INSTALL_CUDA=skip

WORKDIR /workspace

COPY package.json package-lock.json tsconfig.base.json ./
COPY scripts/ ./scripts/
COPY packages/ ./packages/

# ★ The retrieval lexicon, as DATA. @interego/pgsl reads docs/ns/pgsl-lexicon.ttl at runtime
# for query expansion (synonyms, IS-A, part-of, causal relations). Without it the package
# silently selects its frozen FALLBACK_* tables — behaviour is identical today, because the
# published file is generated from them and a test pins that, but the whole point of moving
# the knowledge out of TypeScript is that a deployment reads the published copy. Landing it
# at /app/docs/ns is enough: the package walks up from its own dist/ and finds it there, so
# no INTEREGO_NS_DIR is needed here.
COPY docs/ns/pgsl-lexicon.ttl ./docs/ns/pgsl-lexicon.ttl

RUN npm install --workspaces --include-workspace-root --no-audit --no-fund
RUN npm run build

RUN mkdir -p /tarballs && \
    cd packages/core && npm pack --pack-destination /tarballs && cd /workspace && \
    for pkg in pgsl solid security-txt; do \
      cd packages/$pkg && npm pack --pack-destination /tarballs && cd /workspace ; \
    done

# ────────────────────────────────────────────────────────────
#  Build stage: compile the pgsl-browser server against the lib
# ────────────────────────────────────────────────────────────
WORKDIR /app

COPY examples/pgsl-browser/package.json ./package.json.template
# Drop every @interego/* workspace specifier from the pgsl-browser's
# package.json (npm rejects `*` outside a workspace install), then
# install ONLY the tarballs the browser actually imports.
# server.ts pulls @interego/core, @interego/pgsl, @interego/solid,
# @interego/security-txt.
RUN node -e "const fs=require('fs');const p=JSON.parse(fs.readFileSync('./package.json.template','utf8'));if(p.dependencies){for(const k of Object.keys(p.dependencies)){if(k.startsWith('@interego/'))delete p.dependencies[k];}}fs.writeFileSync('./package.json',JSON.stringify(p,null,2));" && \
    rm package.json.template && \
    npm install --no-audit --no-fund \
      /tarballs/interego-core-0.2.0.tgz \
      /tarballs/interego-solid-0.2.0.tgz \
      /tarballs/interego-pgsl-0.2.0.tgz \
      /tarballs/interego-security-txt-0.2.0.tgz

# esbuild build (per the prior README note: pgsl-browser is a demo;
# type drift is tolerated; tsc is reserved for the core library).
COPY examples/pgsl-browser/server.ts ./
COPY examples/pgsl-browser/index.html ./
COPY examples/pgsl-browser/observatory.html ./
RUN npm run build
RUN cp index.html observatory.html dist/

# ────────────────────────────────────────────────────────────
#  Runtime stage: distroless
# ────────────────────────────────────────────────────────────
FROM gcr.io/distroless/nodejs22-debian12

WORKDIR /app

COPY --from=build /app/dist ./dist
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./
COPY --from=build /app/index.html ./
COPY --from=build /app/observatory.html ./

EXPOSE 5000

ENV PORT=5000

# Default neutral example pod slug. Production deployments must
# override POD_NAME with the operator's actual pod slug.
ENV POD_NAME=example-pod

# The commit this image was built from, surfaced at /health so a deploy can be VERIFIED
# rather than assumed. build-ghcr.yml already appends GIT_SHA to every image's build-args;
# without this ARG Docker drops it with a warning and the image builds green, which is how
# twelve of thirteen services ended up unable to report their own build. Runtime stage on
# purpose: ARG does not cross a FROM, and earlier would bust the cache on every commit.
ARG GIT_SHA=unset
ENV INTEREGO_BUILD_SHA=$GIT_SHA

CMD ["dist/server.js"]
