{
  "comment": [
    "CSS server whose STORAGE BACKEND is the PGSL lattice (foundation-first Stage 5).",
    "This IS the live interego-css config (it replaced the former file-backed",
    "examples/multi-agent/css-config.json, which is now legacy):",
    "same import set - initialize-root + location/root (single root storage), allow-all",
    "authorization (content privacy is Interego client-side JWE, NOT ACLs), websockets",
    "notifications, memory resource-locker, suffix identifiers - with ONE change: the file",
    "backend (css:config/storage/backend/file.json) is replaced by the PGSL accessor, which",
    "re-platforms storage off the incoherent AzureFile SMB volume onto managed Postgres. That",
    "removes the STORAGE blocker to CSS multi-replica but does NOT unlock it: see",
    "pgsl-server-redis.json for the locker-level blocker (RedisLocker clears the whole shared",
    "lock namespace on every replica boot AND shutdown) that still pins CSS to one replica.",
    "The Postgres connection string is read from PGSL_PG_CONNSTR by the factory, so no secret",
    "lives in this file. NOTE: componentsjs-generator is BUILD-TIME ONLY - it must not be present",
    "in the runtime node_modules (its newer @comunica/componentsjs collide with CSS's); the",
    "Dockerfile prunes it (and tsx/typescript) from the runtime stage."
  ],
  "@context": [
    "https://linkedsoftwaredependencies.org/bundles/npm/@solid/community-server/^7.0.0/components/context.jsonld",
    "https://linkedsoftwaredependencies.org/bundles/npm/pgsl-css-accessor/^1.0.0/components/context.jsonld"
  ],
  "import": [
    "css:config/app/init/initialize-root.json",
    "css:config/app/main/default.json",
    "css:config/app/variables/default.json",
    "css:config/http/handler/default.json",
    "css:config/http/middleware/default.json",
    "css:config/http/notifications/websockets.json",
    "css:config/http/server-factory/http.json",
    "css:config/http/static/default.json",
    "css:config/identity/access/public.json",
    "css:config/identity/email/default.json",
    "css:config/identity/handler/default.json",
    "css:config/identity/oidc/default.json",
    "css:config/identity/ownership/token.json",
    "css:config/identity/pod/static.json",
    "css:config/ldp/authentication/dpop-bearer.json",
    "css:config/ldp/authorization/allow-all.json",
    "css:config/ldp/handler/default.json",
    "css:config/ldp/metadata-parser/default.json",
    "css:config/ldp/metadata-writer/default.json",
    "css:config/ldp/modes/default.json",
    "css:config/storage/key-value/resource-store.json",
    "css:config/storage/location/root.json",
    "css:config/storage/middleware/default.json",
    "css:config/util/auxiliary/acl.json",
    "css:config/util/identifiers/suffix.json",
    "css:config/util/index/default.json",
    "css:config/util/logging/winston.json",
    "css:config/util/representation-conversion/default.json",
    "css:config/util/resource-locker/memory.json",
    "css:config/util/variables/default.json"
  ],
  "@graph": [
    {
      "@type": "Override",
      "overrideInstance": {
        "@id": "urn:solid-server:default:ConditionsParser"
      },
      "overrideParameters": {
        "@type": "NativeConditionsParser",
        "eTagHandler": {
          "@id": "urn:solid-server:default:ETagHandler"
        }
      }
    },
    {
      "comment": [
        "Resource-lock expiry: 90000 ms instead of css:config/util/resource-locker/memory.json's 6000.",
        "The expiry is a stuck-lock release, not a deadline for the work: when it fires, CSS answers 500",
        "and the locked operation keeps running without its lock (a write is not renewed while it drains",
        "its body). Every request here arrives through css-gate, which waits up to 90 s for a response",
        "head (UPSTREAM_QUEUE_TIMEOUT_MS; headersTimeout 60 s once connected), so a slower operation has",
        "nobody waiting for it and 6 s cut off legitimate work the gate would still have delivered: a",
        "cold root listing (2026-10-22) and any large PUT over a slow client. Same-type override, so only",
        "the expiration changes; the memory locker underneath stays as memory.json defines it."
      ],
      "@type": "Override",
      "overrideInstance": {
        "@id": "urn:solid-server:default:ResourceLocker"
      },
      "overrideParameters": {
        "@type": "WrappedExpiringReadWriteLocker",
        "expiration": 90000
      }
    },
    {
      "comment": "The internal value storage walks every document under /.internal/, including keyless reader counts left in /.internal/locks/ from when LockStorage was pod-backed. Skipping keyless entries keeps them from crashing the hourly expired-entry sweep.",
      "@type": "Override",
      "overrideInstance": {
        "@id": "urn:solid-server:default:KeyValueStorage"
      },
      "overrideParameters": {
        "@type": "KeyedEntriesStorage",
        "source": {
          "@type": "MaxKeyLengthStorage",
          "source": {
            "@id": "urn:solid-server:default:JsonResourceStorage"
          }
        }
      }
    },
    {
      "comment": "Memory mutexes require process-local reader counters. Native cross-process commits remain conditional transactions in PGSL.",
      "@type": "Override",
      "overrideInstance": {
        "@id": "urn:solid-server:default:LockStorage"
      },
      "overrideParameters": {
        "@type": "HashEncodingStorage",
        "source": {
          "@type": "MemoryMapStorage"
        }
      }
    },
    {
      "@type": "Override",
      "overrideInstance": {
        "@id": "urn:solid-server:default:MetadataWriter_Mapped"
      },
      "overrideParameters": {
        "@type": "MappedMetadataWriter",
        "headerMap": [
          {
            "MappedMetadataWriter:_headerMap_key": "urn:npm:solid:community-server:http:location",
            "MappedMetadataWriter:_headerMap_value": "Location"
          },
          {
            "MappedMetadataWriter:_headerMap_key": "http://www.w3.org/2011/http-headers#interego-revision",
            "MappedMetadataWriter:_headerMap_value": "Interego-Revision"
          },
          {
            "MappedMetadataWriter:_headerMap_key": "http://www.w3.org/2011/http-headers#interego-body-digest",
            "MappedMetadataWriter:_headerMap_value": "Interego-Body-Digest"
          },
          {
            "MappedMetadataWriter:_headerMap_key": "http://www.w3.org/2011/http-headers#accept-put",
            "MappedMetadataWriter:_headerMap_value": "Accept-Put"
          }
        ]
      }
    },
    {
      "@type": "Override",
      "overrideInstance": {
        "@id": "urn:solid-server:default:ETagHandler"
      },
      "overrideParameters": {
        "@type": "NativeETagHandler"
      }
    },
    {
      "@type": "Override",
      "overrideInstance": {
        "@id": "urn:solid-server:default:ParallelMiddleware"
      },
      "overrideParameters": {
        "@type": "ParallelHandler",
        "handlers": [
          {
            "@id": "urn:solid-server:default:Middleware_Header"
          },
          {
            "@type": "NativeCapabilityHeaders"
          }
        ]
      }
    },
    {
      "@type": "Override",
      "overrideInstance": {
        "@id": "urn:solid-server:default:OperationHandler"
      },
      "overrideParameters": {
        "@type": "WaterfallHandler",
        "handlers": [
          {
            "@type": "NativeGetOperationHandler",
            "store": {
              "@id": "urn:solid-server:default:ResourceStore"
            },
            "eTagHandler": {
              "@id": "urn:solid-server:default:ETagHandler"
            }
          },
          {
            "@type": "PostOperationHandler",
            "store": {
              "@id": "urn:solid-server:default:ResourceStore"
            }
          },
          {
            "@type": "NativePutOperationHandler",
            "store": {
              "@id": "urn:solid-server:default:ResourceStore"
            },
            "metadataStrategy": {
              "@id": "urn:solid-server:default:MetadataStrategy"
            }
          },
          {
            "@type": "NativeDeleteOperationHandler",
            "store": {
              "@id": "urn:solid-server:default:ResourceStore"
            }
          },
          {
            "@type": "DeleteOperationHandler",
            "store": {
              "@id": "urn:solid-server:default:ResourceStore"
            }
          },
          {
            "@type": "HeadOperationHandler",
            "store": {
              "@id": "urn:solid-server:default:ResourceStore"
            },
            "eTagHandler": {
              "@id": "urn:solid-server:default:ETagHandler"
            }
          },
          {
            "@type": "PatchOperationHandler",
            "store": {
              "@id": "urn:solid-server:default:ResourceStore"
            }
          },
          {
            "@type": "StaticThrowHandler",
            "error": {
              "@type": "MethodNotAllowedHttpError"
            }
          }
        ]
      }
    },
    {
      "comment": "Same DataAccessorBasedStore as the file backend, but with the PGSL accessor.",
      "@id": "urn:solid-server:default:ResourceStore_Backend",
      "@type": "DataAccessorBasedStore",
      "identifierStrategy": {
        "@id": "urn:solid-server:default:IdentifierStrategy"
      },
      "auxiliaryStrategy": {
        "@id": "urn:solid-server:default:AuxiliaryStrategy"
      },
      "accessor": {
        "@id": "urn:pgsl-css:default:PgslDataAccessor"
      },
      "metadataStrategy": {
        "@id": "urn:solid-server:default:MetadataStrategy"
      }
    },
    {
      "comment": "The PGSL-backed DataAccessor. connectionString omitted -> read from PGSL_PG_CONNSTR.",
      "@id": "urn:pgsl-css:default:PgslDataAccessor",
      "@type": "PgslDataAccessorFactory",
      "pod": "css"
    }
  ]
}
