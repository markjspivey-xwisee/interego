# shape: wsp-shapes.ttl
# expect: conforms
# why: THE MISSING CONTROL. Until this file the only wsp:Workspace fixture was workspace-two-conveners, which violates — so nothing proved a clean Workspace conforms, and any new convener or roleProfile violation could not be attributed to the term it names rather than to the class being unsatisfiable.

@prefix wsp:  <https://markjspivey-xwisee.github.io/interego/applications/shared-workspace/wsp#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<https://relay.test/ws/a>
  a wsp:Workspace ;
  dct:title "Alpha" ;
  wsp:convener <https://alice.test/profile#me> ;
  wsp:roleProfile <https://roles.test/p> .
