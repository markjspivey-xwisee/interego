@prefix dct:  <http://purl.org/dc/terms/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<https://relay.test/ws/a>
  a wsp:Workspace ;
  dct:title "Two conveners" ;
  wsp:convener <https://alice.test/profile#me>, <https://bee.test/profile#me> ;
  wsp:roleProfile <https://roles.test/p> .
