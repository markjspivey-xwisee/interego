tla:PerformanceProficiencyFramework a tla:CompetencyFramework , skos:ConceptScheme ;
    rdfs:label "Foxxi Production-Performance Proficiency Framework" ;
    rdfs:comment "A published proficiency scale for on-the-job production performance, using the Dreyfus five-stage model of skill acquisition. The tla:Level individuals below are the dereferenceable scale an ELR competency assertion is measured against (ler:atProficiency)." ;
    dct:source "Dreyfus, S.E. & Dreyfus, H.L. (1980) — A Five-Stage Model of the Mental Activities Involved in Directed Skill Acquisition" ;
    ler:construction "minted" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla> .

tla:LevelNovice a tla:Level , ler:ProficiencyLevel , skos:Concept ;
    rdfs:label "Novice" ;
    rdfs:comment "Rule-bound, relies on instruction. Inferred from training completion only — not yet demonstrated in production." ;
    skos:inScheme tla:PerformanceProficiencyFramework ;
    skos:notation "1" ;
    ler:construction "concept" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla> .

tla:LevelAdvancedBeginner a tla:Level , ler:ProficiencyLevel , skos:Concept ;
    rdfs:label "Advanced Beginner" ;
    rdfs:comment "Has demonstrated the competency in production at least once with an asserted successful outcome; limited situational judgment." ;
    skos:inScheme tla:PerformanceProficiencyFramework ;
    skos:notation "2" ;
    ler:construction "concept" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla> .

tla:LevelCompetent a tla:Level , ler:ProficiencyLevel , skos:Concept ;
    rdfs:label "Competent" ;
    rdfs:comment "Consistent successful production performance over a meaningful sample; plans deliberately and handles the typical case." ;
    skos:inScheme tla:PerformanceProficiencyFramework ;
    skos:notation "3" ;
    ler:construction "concept" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla> .

tla:LevelProficient a tla:Level , ler:ProficiencyLevel , skos:Concept ;
    rdfs:label "Proficient" ;
    rdfs:comment "Reliable, high-quality production performance across many executions; perceives situations holistically." ;
    skos:inScheme tla:PerformanceProficiencyFramework ;
    skos:notation "4" ;
    ler:construction "concept" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla> .

tla:LevelExpert a tla:Level , ler:ProficiencyLevel , skos:Concept ;
    rdfs:label "Expert" ;
    rdfs:comment "Sustained, near-flawless, high-quality production performance at scale; fluid, intuitive mastery." ;
    skos:inScheme tla:PerformanceProficiencyFramework ;
    skos:notation "5" ;
    ler:construction "concept" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla> .

tla:PerformanceProficiencyRollupRule a tla:RollupRule ;
    rdfs:label "Production-performance proficiency roll-up rule" ;
    rdfs:comment "Maps a subject's production-performance evidence to a proficiency level in the Foxxi Production-Performance Proficiency Framework, with a confidence. Cited by every performance-basis ler:CompetencyAssertion the ELR emits." ;
    tla:rollupRule "Given production performance evidence (n executions carrying an asserted outcome, k successes, mean scored quality q in 0..1): reliability is the Wilson score interval lower bound (z=1.96) on k/n, which rises with evidence and FALLS when a failure is added — so it carries both how often the work succeeded and how much of it there is, and no separate execution count is gated on. Expert if reliability>=0.75 and mean quality q is recorded and q>=0.85; Proficient if reliability>=0.6 and mean quality q is recorded and q>=0.7; Competent if reliability>=0.4; Advanced Beginner if k>=1; else Novice. Quality is a FLOOR, not a scale: every value at or above a band's floor ranks alike. A verified credential with no production evidence maps to Competent; training completion only maps to Novice (Hypothetical). The reported confidence IS the reliability above. This rule is DATA: it is parsed at runtime from docs/ns/adl-tla-proficiency.ttl, and this sentence is generated from the same triples the evaluator walks." ;
    skos:inScheme tla:PerformanceProficiencyFramework ;
    ler:construction "minted" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla> .
