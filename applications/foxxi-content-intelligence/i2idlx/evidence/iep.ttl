iep:coherenceStatus a owl:ObjectProperty ; rdfs:label "coherence status" ; rdfs:range iep:CoherenceStatus ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:hasItem a owl:ObjectProperty ; rdfs:label "has item" ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:paradigmOp a owl:ObjectProperty ; rdfs:label "paradigm op" ; rdfs:range iep:ParadigmOperation ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:patternA a owl:ObjectProperty ; rdfs:label "pattern A" ; rdfs:range iep:SyntagmaticPattern ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:patternB a owl:ObjectProperty ; rdfs:label "pattern B" ; rdfs:range iep:SyntagmaticPattern ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:positionA a owl:DatatypeProperty ; rdfs:label "position A" ; rdfs:range xsd:integer ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:positionB a owl:DatatypeProperty ; rdfs:label "position B" ; rdfs:range xsd:integer ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:position a owl:DatatypeProperty ; rdfs:label "position" ; rdfs:range xsd:integer ; rdfs:comment "Zero-based ordinal of a child within its parent, carried on the REIFIER of an iep:hasItem statement rather than on the child itself — the same child may sit at different positions under different parents, so the ordinal is a property of the containment, not of either endpoint. Required by iep:PgslContainmentAnnotationShape-1.2." ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:contextualDepth a owl:DatatypeProperty ; rdfs:label "contextual depth" ; rdfs:range xsd:integer ; rdfs:comment "Nesting depth of a containment relative to its enclosing context, carried on the REIFIER of an iep:hasItem statement. Optional companion to iep:position." ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:persistenceTier a owl:ObjectProperty ; rdfs:label "persistence tier" ; rdfs:range iep:PersistenceTier ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:persistenceUri a owl:ObjectProperty ; rdfs:label "persistence URI" ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:vocabularyMapping a owl:ObjectProperty ; rdfs:label "vocabulary mapping" ; rdfs:range iep:VocabularyMapping ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:mappingRelationship a owl:ObjectProperty ; rdfs:label "mapping relationship" ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:mappingType a owl:ObjectProperty ; rdfs:label "mapping type" ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:targetVocabulary a owl:ObjectProperty ; rdfs:label "target vocabulary" ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:boundaryShapes a owl:ObjectProperty ; rdfs:label "boundary shapes" ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:observation a owl:ObjectProperty ; rdfs:label "observation" ; rdfs:range iep:ObservationSection ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:decisionStrategy a owl:ObjectProperty ; rdfs:label "decision strategy" ; rdfs:range iep:DecisionStrategy ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:selectedAffordance a owl:ObjectProperty ; rdfs:label "selected affordance" ; rdfs:range iep:Affordance ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:capability a owl:ObjectProperty ; rdfs:label "capability" ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:endpoint a owl:ObjectProperty ; rdfs:label "endpoint" ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:latticeRoot a owl:ObjectProperty ; rdfs:label "lattice root" ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:topFragment a owl:ObjectProperty ; rdfs:label "top fragment" ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:atomCount a owl:DatatypeProperty ; rdfs:label "atom count" ; rdfs:range xsd:nonNegativeInteger ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:fragmentCount a owl:DatatypeProperty ; rdfs:label "fragment count" ; rdfs:range xsd:nonNegativeInteger ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:chainId a owl:DatatypeProperty ; rdfs:label "chain id" ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:description a owl:DatatypeProperty ; rdfs:label "description" ; rdfs:range xsd:string ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:timestamp a owl:DatatypeProperty ; rdfs:label "timestamp" ; rdfs:range xsd:dateTime ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:tool a owl:DatatypeProperty ; rdfs:label "tool" ; rdfs:range xsd:string ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:success a owl:DatatypeProperty ; rdfs:label "success" ; rdfs:range xsd:boolean ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:errorMessage a owl:DatatypeProperty ; rdfs:label "error message" ; rdfs:range xsd:string ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:affordanceRel a owl:ObjectProperty ; rdfs:label "affordance relation" ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:agentA a owl:ObjectProperty ; rdfs:label "agent A" ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:agentB a owl:ObjectProperty ; rdfs:label "agent B" ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:agentAAT a owl:ObjectProperty ; rdfs:label "agent AAT" ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:authorization a owl:ObjectProperty ; rdfs:label "authorization" ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:binding a owl:ObjectProperty ; rdfs:label "binding" ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:bindingStrength a owl:ObjectProperty ; rdfs:label "binding strength" ; rdfs:range iep:BindingStrengthEnum ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:composedFrom a owl:ObjectProperty ; rdfs:label "composed from" ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:consentBasis a owl:ObjectProperty ; rdfs:label "consent basis" ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:hasDistribution a owl:ObjectProperty ; rdfs:label "has distribution" ; rdfs:comment "Legacy shim for descriptors written before canonical iep:affordance form. Prefer iep:affordance [ a dcat:Distribution ... ]." ; rdfs:range dcat:Distribution ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:algorithm a owl:DatatypeProperty ; rdfs:label "algorithm" ; rdfs:range xsd:string ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:cid a owl:DatatypeProperty ; rdfs:label "CID" ; rdfs:range xsd:string ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:contentHash a owl:DatatypeProperty ; rdfs:label "content hash" ; rdfs:range xsd:string ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:gatewayUrl a owl:DatatypeProperty ; rdfs:label "gateway URL" ; rdfs:range xsd:anyURI ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:pinnedAt a owl:DatatypeProperty ; rdfs:label "pinned at" ; rdfs:range xsd:dateTime ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:pinnedBy a owl:ObjectProperty ; rdfs:label "pinned by" ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:provider a owl:DatatypeProperty ; rdfs:label "provider" ; rdfs:range xsd:string ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:signature a owl:DatatypeProperty ; rdfs:label "signature" ; rdfs:range xsd:string ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:signedAt a owl:DatatypeProperty ; rdfs:label "signed at" ; rdfs:range xsd:dateTime ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
# iep:signerAddress was re-declared here, identically but without its comment. One declaration
# stands, beside iep:created above, and it is the one that explains what verifiers do with the
# value. A second copy is where a range or a comment silently drifts from the first.
iep:encryptedAt a owl:DatatypeProperty ; rdfs:label "encrypted at" ; rdfs:range xsd:dateTime ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:recipientFingerprint a owl:DatatypeProperty ; rdfs:label "recipient fingerprint" ; rdfs:range xsd:string ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:owner a owl:ObjectProperty ; rdfs:label "owner" ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:ingestedAt a owl:DatatypeProperty ; rdfs:label "ingested at" ; rdfs:range xsd:dateTime ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:promotedAt a owl:DatatypeProperty ; rdfs:label "promoted at" ; rdfs:range xsd:dateTime ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:registeredAt a owl:DatatypeProperty ; rdfs:label "registered at" ; rdfs:range xsd:dateTime ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:lastSeen a owl:DatatypeProperty ; rdfs:label "last seen" ; rdfs:range xsd:dateTime ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:wasAttributedTo a owl:ObjectProperty ; rdfs:label "was attributed to" ; rdfs:comment "Legacy shim for prov:wasAttributedTo usage inside iep: emissions. Prefer prov:wasAttributedTo directly." ; rdfs:seeAlso prov:wasAttributedTo ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:causes a owl:ObjectProperty ; rdfs:label "causes" ; rdfs:domain iep:CausalEdge ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:effectOf a owl:ObjectProperty ; rdfs:label "effect of" ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:effectSize a owl:DatatypeProperty ; rdfs:label "effect size" ; rdfs:range xsd:double ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:mechanism a owl:DatatypeProperty ; rdfs:label "mechanism" ; rdfs:range xsd:string ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:intervenes a owl:ObjectProperty ; rdfs:label "intervenes" ; rdfs:domain iep:Intervention ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:interventionValue a owl:DatatypeProperty ; rdfs:label "intervention value" ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:exogenous a owl:DatatypeProperty ; rdfs:label "exogenous" ; rdfs:range xsd:boolean ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:exposedEntity a owl:ObjectProperty ; rdfs:label "exposed entity" ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:hiddenEntity a owl:ObjectProperty ; rdfs:label "hidden entity" ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:causalConfidence a owl:DatatypeProperty ; rdfs:label "causal confidence" ; rdfs:range xsd:double ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:causalRole a owl:DatatypeProperty ; rdfs:label "causal role" ; rdfs:range xsd:string ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:causalEdge a owl:ObjectProperty ; rdfs:label "causal edge" ; rdfs:range iep:CausalEdge ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:causalVariable a owl:ObjectProperty ; rdfs:label "causal variable" ; rdfs:range iep:CausalVariable ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:causalModel a owl:ObjectProperty ; rdfs:label "causal model" ; rdfs:range iep:StructuralCausalModel ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:counterfactualQuery a owl:DatatypeProperty ; rdfs:label "counterfactual query" ; rdfs:range xsd:string ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:counterfactualTarget a owl:ObjectProperty ; rdfs:label "counterfactual target" ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:counterfactualEvidence a owl:ObjectProperty ; rdfs:label "counterfactual evidence" ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:parentObservation a owl:ObjectProperty ; rdfs:label "parent observation" ; rdfs:range iep:ObservationSection ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:parentIntervention a owl:ObjectProperty ; rdfs:label "parent intervention" ; rdfs:range iep:Intervention ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:outcome a owl:ObjectProperty ; rdfs:label "outcome" ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.
iep:selective a owl:DatatypeProperty ; rdfs:label "selective" ; rdfs:range xsd:boolean ; rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#>.

# ══════════════════════════════════════════════════════════════
#  Revocation Extension (DRAFT — rival proposals A + B)
#
#  See spec/revocation.md for the prose specification. These terms
#  are declared with vs:term_status "testing" (W3C SemWeb Vocabulary
#  Status) to signal they are NOT YET adopted as protocol-normative.
#  An implementation MAY emit them; readers MAY consume them; neither
#  is required for v1.0 conformance.
#
#  Once one of Proposal A (7th facet) or Proposal B (predicate on
#  SemioticFacet) is ratified, the adopted terms move to
#  vs:term_status "stable" and the rival terms move to "archaic".
#  Until then, the shared RevocationCondition model is specified in
#  both proposals identically so migration is a blank-node rewrite.
# ══════════════════════════════════════════════════════════════

# ─── Shared RevocationCondition model (both proposals) ────────

iep:RevocationCondition a owl:Class ;
    rdfs:label "Revocation Condition" ;
    rdfs:comment "A declarative condition under which an asserted claim's effective groundTruth transitions to false. Consists of a successor query (SPARQL 1.1 ASK/SELECT), an evaluation scope, and an action to take when the query matches. Shared by Proposal A (RevocationFacet) and Proposal B (revokedIf predicate) so conditions are portable between the two." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:successorQuery a owl:DatatypeProperty ;
    rdfs:label "successor query" ;
    rdfs:comment "SPARQL 1.1 ASK/SELECT/CONSTRUCT query evaluated over the scope declared by iep:evaluationScope. A non-empty result triggers the revocation action. MUST NOT reference the enclosing descriptor's own graph IRI (caught by iep:RevocationConditionNoSelfReferenceShape)." ;
    rdfs:domain iep:RevocationCondition ;
    rdfs:range xsd:string ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:evaluationScope a owl:ObjectProperty ;
    rdfs:label "evaluation scope" ;
    rdfs:comment "The federation scope over which the successor query is evaluated. One of iep:LocalPod, iep:KnownFederation, iep:WebFingerResolvable." ;
    rdfs:domain iep:RevocationCondition ;
    rdfs:range iep:RevocationScope ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:onRevocation a owl:ObjectProperty ;
    rdfs:label "on-revocation action" ;
    rdfs:comment "Action to take when the successor query matches. One of iep:MarkInvalid, iep:DowngradeToHypothetical, iep:RequireReconfirmation. Implementations MUST support iep:MarkInvalid; the others are RECOMMENDED." ;
    rdfs:domain iep:RevocationCondition ;
    rdfs:range iep:RevocationAction ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:revocationIssuer a owl:ObjectProperty ;
    rdfs:label "revocation issuer" ;
    rdfs:comment "The agent or principal that asserts this revocation condition. MAY differ from the enclosing descriptor's author (a regulator, auditor, or domain authority attaching a revocation policy to someone else's claim). When absent, the enclosing descriptor's author is assumed." ;
    rdfs:domain iep:RevocationCondition ;
    rdfs:range foaf:Agent ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

# ─── Evaluation-scope closed vocabulary ───────────────────────

iep:RevocationScope a owl:Class ;
    rdfs:label "Revocation Scope" ;
    rdfs:comment "Closed vocabulary for the federation scope over which a revocation successor query is evaluated." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:LocalPod a iep:RevocationScope ;
    rdfs:label "Local Pod" ;
    rdfs:comment "Evaluate the successor query only against descriptors on the same pod that hosts the declaring descriptor. Cheapest; no federation calls." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:KnownFederation a iep:RevocationScope ;
    rdfs:label "Known Federation" ;
    rdfs:comment "Evaluate across every pod in the evaluating reader's known-pods registry. Readers MAY cache federation state; eventual consistency is acceptable." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:WebFingerResolvable a iep:RevocationScope ;
    rdfs:label "WebFinger Resolvable" ;
    rdfs:comment "Evaluate across any pod reachable from the query's cited handles via WebFinger (RFC 7033) or DID resolution. Strongest scope; highest latency." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

# ─── Revocation-action closed vocabulary ──────────────────────

iep:RevocationAction a owl:Class ;
    rdfs:label "Revocation Action" ;
    rdfs:comment "Closed vocabulary for the effect of a triggered revocation condition on the enclosing descriptor's modal state." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:MarkInvalid a iep:RevocationAction ;
    rdfs:label "Mark Invalid" ;
    rdfs:comment "Effective groundTruth transitions to false. Modal status effectively becomes Counterfactual for readers performing currently-valid queries. This is the default and the only action MUST-supported by conforming implementations." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:DowngradeToHypothetical a iep:RevocationAction ;
    rdfs:label "Downgrade To Hypothetical" ;
    rdfs:comment "Modal status transitions to Hypothetical; groundTruth becomes undefined. Signals \"we're no longer sure either way.\"" ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:RequireReconfirmation a iep:RevocationAction ;
    rdfs:label "Require Reconfirmation" ;
    rdfs:comment "Modal status is preserved but the descriptor is flagged as requiring the original issuer (or a delegated authority) to re-sign before it may be used for downstream assertions. Useful for high-stakes claims where automatic invalidation would be too aggressive." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

# ─── Proposal A — seventh-facet RevocationFacet ───────────────

iep:RevocationFacet a owl:Class ;
    rdfs:subClassOf iep:ContextFacet ;
    rdfs:label "Revocation Facet (Proposal A — draft)" ;
    rdfs:comment "DRAFT. An additional context-facet type carrying one or more RevocationConditions. Proposal A of the revocation extension spec (see spec/revocation.md). Enables discovery by facet_type=Revocation without inspecting other facets; supports revocation issuers that differ from the descriptor author. Relaxes the core-facet invariant to \"at least the seven core facets plus at most one RevocationFacet.\" Rival: Proposal B (iep:revokedIf predicate on SemioticFacet). One will be adopted in v1.1; until then, implementations MAY support either, both, or neither." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:revokedBy a owl:ObjectProperty ;
    rdfs:label "revoked by (Proposal A)" ;
    rdfs:comment "Links a RevocationFacet to one or more RevocationConditions. Proposal A form." ;
    rdfs:domain iep:RevocationFacet ;
    rdfs:range iep:RevocationCondition ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

# ─── Proposal B — predicate on SemioticFacet ──────────────────

iep:revokedIf a owl:ObjectProperty ;
    rdfs:label "revoked if (Proposal B)" ;
    rdfs:comment "DRAFT. Attaches one or more RevocationConditions to a SemioticFacet. When any linked condition's successorQuery returns a hit, the enclosing descriptor's effective groundTruth transitions per the RevocationAction. Proposal B of the revocation extension spec; preserves the exactly-core-facet invariant by nesting revocation inside the Semiotic facet's truth-state unit rather than adding a new facet type. Rival: Proposal A (iep:RevocationFacet)." ;
    rdfs:domain iep:SemioticFacet ;
    rdfs:range iep:RevocationCondition ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

# ─── Hypermedia + SHACL discipline on kernel + shim responses ──
#
# Every kernel-verb / shim response carries a JSON-LD envelope that
# references one of the shapes below via iep:conformsToShape, so SHACL
# validators can verify the wire shape without out-of-band schema.
# These shapes describe the *response envelope* — the underlying
# domain types (ContextDescriptor, ContextFacet, ...) are shaped
# above.

iep:Holon a owl:Class ;
    rdfs:label "Holon" ;
    rdfs:comment "A dereferenceable IRI together with its level + kind in the substrate (atom / fragment / descriptor / manifest / opaque). The atomic unit kernel verbs operate on." ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

# ─── Container + conformance gate vocabulary ────────────────────
#
# A iep:Container is a pod-side aggregate (LDP BasicContainer / Solid
# folder) that hosts iep:Holon resources. Containers MAY declare
# property/shape/capability metadata via iep:declares, and MAY constrain
# every Holon written under them to satisfy a sh:NodeShape via
# iep:conformsTo. The relay's publish gate enforces iep:conformsTo at
# write time (deploy/mcp-relay/server.ts) — non-conformant Holons are
# rejected before the CSS write so the container's invariants hold
# everywhere a federation reader sees the container.

iep:Container a owl:Class ;
    rdfs:label "Container"@en ;
    rdfs:comment "A pod-side aggregate (Solid / LDP BasicContainer or equivalent) that hosts iep:Holon resources. Containers MAY declare container-level metadata via iep:declares (properties, shapes, vocabulary terms, capabilities) and MAY constrain every Holon written under them to satisfy a sh:NodeShape via iep:conformsTo. Aligned with ldp:BasicContainer; treated as a kind of iep:Holon so the substrate can reason uniformly about the container and its contents."@en ;
    rdfs:subClassOf iep:Holon ;
    rdfs:seeAlso ldp:BasicContainer ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:conformsTo a owl:ObjectProperty ;
    rdfs:label "conforms to"@en ;
    rdfs:domain iep:Holon ;
    rdfs:range sh:NodeShape ;
    rdfs:comment "Asserts that the subject conforms to the indicated SHACL NodeShape. When attached to a container, every Holon written to that container MUST validate against the shape; the publish gate rejects non-conformant writes."@en ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:declares-shape a owl:ObjectProperty ;
    rdfs:label "declares shape"@en ;
    rdfs:subPropertyOf iep:conformsTo ;
    rdfs:domain iep:Container ;
    rdfs:range sh:NodeShape ;
    owl:deprecated true ;
    rdfs:seeAlso iep:conformsTo ;
    rdfs:comment "Tolerated ingest-only alias of iep:conformsTo in a container-shape document. Publishers SHOULD use iep:conformsTo; this spelling is accepted so that documents already written against it keep resolving. It is declared here because the publish gate has always honoured it: a predicate a reader accepts but the vocabulary never publishes is undiscoverable, so no publisher could learn it and no consumer could verify it."@en ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:declares a owl:ObjectProperty ;
    rdfs:label "declares"@en ;
    rdfs:domain iep:Container ;
    rdfs:range owl:Thing ;
    rdfs:comment "A container declares a property, shape, vocabulary term, or capability. Used to make container-level metadata discoverable (e.g. iep:declares iep:Conformant, iep:declares <shape IRI>)."@en ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

# ─── PGSL lattice holon subtypes ───────────────────────────────
#
# The kernel emits these substrate types in dereference responses
# (packages/core/src/kernel/index.ts:364–367) — they reify the
# level-0 vs level-N distinction in the PGSL Grothendieck-fibration
# lattice as first-class typed subclasses of iep:Holon.

iep:Atom a owl:Class ;
    rdfs:subClassOf iep:Holon ;
    rdfs:label "Atom"@en ;
    rdfs:comment "PGSL level-0 holon — a content-addressed scalar value forming the base of the lattice. Has no internal composition; its iep:value produces its content-address URI."@en ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:Fragment a owl:Class ;
    rdfs:subClassOf iep:Holon ;
    rdfs:label "Fragment"@en ;
    rdfs:comment "PGSL level-N (N>=1) holon — a typed-hyperedge composition over constituent iep:Atoms or lower-level iep:Fragments referenced through iep:items."@en ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:level a owl:DatatypeProperty ;
    rdfs:domain iep:Holon ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "level"@en ;
    rdfs:comment "PGSL fibration level — 0 for iep:Atom, N>=1 for iep:Fragment composed over level-(N-1) constituents."@en ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:value a owl:DatatypeProperty ;
    rdfs:domain iep:Holon ;
    rdfs:range xsd:string ;
    rdfs:label "value"@en ;
    rdfs:comment "Recursive string projection of a holon's content — for iep:Atom, the scalar value that produces the atom's content-address URI; for iep:Fragment, the concatenated projection of its items."@en ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:items a owl:ObjectProperty ;
    rdfs:domain iep:Fragment ;
    rdfs:range iep:Holon ;
    rdfs:label "items"@en ;
    rdfs:comment "Ordered references to the constituents of a iep:Fragment — lower-level iep:Atoms or iep:Fragments composed at this level."@en ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

# ─── PGSL projection vocabulary ────────────────────────────────
#
# The foundation-first projection engine (packages/pgsl/src/projection.ts +
# packages/solid/src/client.ts) projects a PGSL lattice node into a
# iep:ContextDescriptor / manifest entry that carries a stable pointer back
# to the lattice node it was projected from, plus an optional link to the
# node's encrypted on-pod payload. These terms make that projection
# self-describing so a reader can recover the lattice coordinate of any
# projected descriptor.

iep:EncryptedHolon a owl:Class ;
    rdfs:subClassOf iep:Holon ;
    rdfs:label "Encrypted Holon"@en ;
    rdfs:comment "A holon whose payload is stored as an encrypted (JOSE) envelope on a pod. The clear lattice identity (iep:pgslUri) and its owning descriptor (iep:ofDescriptor) remain visible for discovery, while the value bytes are recoverable only by an envelope recipient. Projected by the foundation-first projection engine alongside the descriptor that describes it."@en ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:XFacet a owl:Class ;
    rdfs:subClassOf iep:ContextFacet ;
    rdfs:label "Projection Cross-Cut Facet"@en ;
    rdfs:comment "A deterministic, clock-free facet attached to a projected descriptor (emitted as iep:hasFacet [ a iep:XFacet … ]) that records the PGSL lattice coordinate (iep:pgslUri / iep:pgslLevel) of the node the descriptor was projected from. Pure projection metadata — its presence lets the same lattice node project to byte-identical descriptors across pods."@en ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:pgslUri a owl:ObjectProperty ;
    rdfs:label "PGSL URI"@en ;
    rdfs:comment "Content-addressed IRI of the PGSL lattice node (pgsl:Node) that a descriptor, manifest entry, or iep:EncryptedHolon was projected from. The stable lattice coordinate: equal content projects to the same pgslUri across pods."@en ;
    rdfs:range pgsl:Node ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:canonicalId a owl:ObjectProperty ;
    rdfs:label "canonical id"@en ;
    rdfs:comment "The location-INDEPENDENT canonical URL form of a projected node's identity, derived deterministically from its iep:pgslUri (urn:pgsl:<kind>:<hash> -> https://relay.interego.xwisee.com/ns/pgsl/<kind>/<hash>). Same content yields the same canonicalId on every pod, so it preserves the federation-overlap property of the urn while being a dereferenceable URL that actually RESOLVES at its authority (the relay redirects it to a public-lattice resolver, w3id.org-style) — the identifier both denotes (this id) and resolves to connotation (the node's description). Additive to iep:pgslUri, which remains the internal content-address key (never re-identified)."@en ;
    rdfs:range pgsl:Node ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:pgslLevel a owl:DatatypeProperty ;
    rdfs:label "PGSL level"@en ;
    rdfs:comment "The PGSL fibration level of the projected lattice node — 0 for an atom, N>=1 for a fragment composed over level-(N-1) constituents. Carried on projected descriptors / manifest entries so a reader knows the granularity of the projection without dereferencing the lattice."@en ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:encryptedHolon a owl:ObjectProperty ;
    rdfs:label "encrypted holon"@en ;
    rdfs:comment "Links a projected iep:ContextDescriptor to the iep:EncryptedHolon resource holding its encrypted payload on the pod. Present only when the projection produced an encrypted on-pod artifact."@en ;
    rdfs:domain iep:ContextDescriptor ;
    rdfs:range iep:EncryptedHolon ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:ofDescriptor a owl:ObjectProperty ;
    rdfs:label "of descriptor"@en ;
    rdfs:comment "Inverse-direction link from an iep:EncryptedHolon back to the iep:ContextDescriptor it is the encrypted payload of. Lets a reader who dereferenced the holon recover its describing descriptor."@en ;
    rdfs:domain iep:EncryptedHolon ;
    rdfs:range iep:ContextDescriptor ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:contentCid a owl:DatatypeProperty ;
    rdfs:label "content CID"@en ;
    rdfs:comment "Content identifier (CID) of a descriptor's canonical bytes, carried on projected descriptors and manifest entries so content-addressed supersession gates can compare versions without re-fetching the full payload."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:HolonShape a sh:NodeShape ; sh:deactivated true ; rdfs:comment "DECLARED, NOT YET SPECIFIED. This shape carries no constraints, so it validated nothing while reading — from its name, its rdfs:isDefinedBy and its dereferenceable IRI — as though it enforced the invariant it is named for. sh:deactivated says so in data: a SHACL processor now correctly produces no results for it, rather than producing none by accident. Remove this flag in the same change that gives it constraints." ; ;
    rdfs:label "Holon SHACL shape" ;
    sh:targetClass iep:Holon ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:Refusal a owl:Class ;
    rdfs:label "Refusal" ;
    rdfs:subClassOf iep:KernelResult ;
    rdfs:comment "A kernel result that declines to act, and says so as a FIRST-CLASS TYPED STATE rather than as prose in a success envelope. The kernel has ten typed ways to succeed - holon, descriptor, manifest, act, dereference and the rest - and had no typed way to refuse: a handler that declined returned an ordinary result whose only signal was an 'error' string, which the REST dispatch then sent with HTTP 200. An unauthenticated call to a published affordance therefore reported SUCCESS to every caller that reads a status code, and a generic agent following a hydra:target could not tell it had been refused. That asymmetry is the gap this class closes. A refusal declares its kind, so the status is DERIVED from what the result says it is rather than sniffed from its payload." ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:refusalReason a owl:DatatypeProperty ;
    rdfs:label "refusal reason" ;
    rdfs:comment "Why the act was declined, in one sentence, for a human reading the response. It is the SECOND thing a refusal carries, never the first: prose cannot be followed. See iep:resolvedBy for the part an agent can act on." ;
    rdfs:domain iep:Refusal ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:resolvedBy a owl:ObjectProperty ;
    rdfs:label "resolved by" ;
    rdfs:comment "The affordance that obtains what this refusal lacks - the machine-followable way OUT of the refused state. A refusal is a hypermedia state, not a dead end: the same discipline iep:interrogativeRouter already applies when it answers 'partial' and names the primitive that can answer the rest, instead of telling the caller in prose what to do. A missing-credential refusal points at the affordance that mints one." ;
    rdfs:domain iep:Refusal ;
    rdfs:range iep:Affordance ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:refusalStatus a owl:DatatypeProperty ;
    rdfs:label "refusal status" ;
    rdfs:comment "The HTTP status this refusal projects to, published as DATA so the dispatcher maps a declared kind to a code rather than branching on the payload. Conformance here is profile-driven like everywhere else in this substrate: the engine reads the mapping, it does not encode it." ;
    rdfs:domain iep:Refusal ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:RefusalShape a sh:NodeShape ;
    rdfs:label "Refusal SHACL shape" ;
    sh:targetClass iep:Refusal ;
    rdfs:comment "What a refusal must carry to be one. A declined call has to be distinguishable from a successful one BY ITS TYPE, because the dispatcher derives the HTTP status from the declared kind and must not sniff the payload for an 'error' key. It must also carry the way out: iep:resolvedBy names the affordance that obtains what the caller lacks, which is the half a prose message cannot do - an agent can follow an affordance and cannot follow a sentence." ;
    sh:property [ sh:path iep:refusalReason ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:description "One sentence, for a human. Required so a refusal is never bare." ] ;
    sh:property [ sh:path iep:resolvedBy ; sh:maxCount 1 ;
                  sh:description "The affordance that obtains what this refusal lacks, WHEN ONE EXISTS. Required at first, and that was wrong: a missing credential has a way out (mint one) but an authorization denial does not - the caller is simply not the principal the resource allows, and there is no affordance that changes that. Forcing every refusal to name one would have meant inventing a fake exit for the 403 case, which is worse than an honest silence. Measured: of the five refusals the tenant-auth path constructs, one could satisfy this and four could not. `iep:refusalReason` stays required, because WHY is always answerable." ] ;
    sh:property [ sh:path iep:refusalStatus ; sh:datatype xsd:integer ; sh:maxCount 1 ;
                  sh:description "Optional override of the kind's default status - 403 where a credential was held but insufficient, rather than 401 where none was sent." ] ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:KernelResultShape a sh:NodeShape ; sh:deactivated true ; rdfs:comment "DECLARED, NOT YET SPECIFIED. This shape carries no constraints, so it validated nothing while reading — from its name, its rdfs:isDefinedBy and its dereferenceable IRI — as though it enforced the invariant it is named for. sh:deactivated says so in data: a SHACL processor now correctly produces no results for it, rather than producing none by accident. Remove this flag in the same change that gives it constraints." ; ;
    rdfs:label "Kernel result envelope SHACL shape" ;
    sh:targetClass iep:KernelResult ;
    rdfs:comment "Base shape every kernel-verb / shim response satisfies — requires JSON-LD typing + at least one iep:Affordance hint for next-step navigation." ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:MintResultShape a sh:NodeShape ; sh:deactivated true ; rdfs:comment "DECLARED, NOT YET SPECIFIED. This shape carries no constraints, so it validated nothing while reading — from its name, its rdfs:isDefinedBy and its dereferenceable IRI — as though it enforced the invariant it is named for. sh:deactivated says so in data: a SHACL processor now correctly produces no results for it, rather than producing none by accident. Remove this flag in the same change that gives it constraints." ; ;
    rdfs:label "Mint result SHACL shape" ;
    sh:targetClass iep:MintResult ;
    rdfs:comment "Result envelope of kernel.mint — wraps a freshly minted iep:Holon." ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:RestrictResultShape a sh:NodeShape ; sh:deactivated true ; rdfs:comment "DECLARED, NOT YET SPECIFIED. This shape carries no constraints, so it validated nothing while reading — from its name, its rdfs:isDefinedBy and its dereferenceable IRI — as though it enforced the invariant it is named for. sh:deactivated says so in data: a SHACL processor now correctly produces no results for it, rather than producing none by accident. Remove this flag in the same change that gives it constraints." ; ;
    rdfs:label "Restrict result SHACL shape" ;
    sh:targetClass iep:RestrictResult ;
    rdfs:comment "Result envelope of kernel.restrict — narrowed iep:ContextDescriptor." ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:ExtendResultShape a sh:NodeShape ; sh:deactivated true ; rdfs:comment "DECLARED, NOT YET SPECIFIED. This shape carries no constraints, so it validated nothing while reading — from its name, its rdfs:isDefinedBy and its dereferenceable IRI — as though it enforced the invariant it is named for. sh:deactivated says so in data: a SHACL processor now correctly produces no results for it, rather than producing none by accident. Remove this flag in the same change that gives it constraints." ; ;
    rdfs:label "Extend result SHACL shape" ;
    sh:targetClass iep:ExtendResult ;
    rdfs:comment "Result envelope of kernel.extend — widened iep:ContextDescriptor." ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:ToolResult a owl:Class ;
    rdfs:label "Tool result envelope" ;
    rdfs:comment "Compatibility-shim response envelope — the @type every named-tool (non-kernel-verb) MCP shim emits, shaped by iep:ToolResultShape." ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:ToolResultShape a sh:NodeShape ; sh:deactivated true ; rdfs:comment "DECLARED, NOT YET SPECIFIED. This shape carries no constraints, so it validated nothing while reading — from its name, its rdfs:isDefinedBy and its dereferenceable IRI — as though it enforced the invariant it is named for. sh:deactivated says so in data: a SHACL processor now correctly produces no results for it, rather than producing none by accident. Remove this flag in the same change that gives it constraints." ; ;
    rdfs:label "Tool result envelope SHACL shape" ;
    sh:targetClass iep:ToolResult ;
    rdfs:comment "Base shape every named-tool shim response satisfies — same envelope discipline as kernel verbs." ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:RelayEntryPoint a owl:Class ;
    rdfs:label "Relay entry point" ;
    rdfs:comment "Top-level Hydra entry-point envelope a hosted MCP relay advertises — co-typed with hydra:EntryPoint and shaped by iep:RelayEntryPointShape; its affordances list the relay's surface operations." ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:RelayEntryPointShape a sh:NodeShape ; sh:deactivated true ; rdfs:comment "DECLARED, NOT YET SPECIFIED. This shape carries no constraints, so it validated nothing while reading — from its name, its rdfs:isDefinedBy and its dereferenceable IRI — as though it enforced the invariant it is named for. sh:deactivated says so in data: a SHACL processor now correctly produces no results for it, rather than producing none by accident. Remove this flag in the same change that gives it constraints." ; ;
    rdfs:label "Relay entry point SHACL shape" ;
    sh:targetClass iep:RelayEntryPoint ;
    rdfs:comment "Hypermedia entry point document for an HTTP relay's surface — every operation listed MUST be a hydra:Operation." ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:AffordanceShape a sh:NodeShape ; sh:deactivated true ; rdfs:comment "DECLARED, NOT YET SPECIFIED. This shape carries no constraints, so it validated nothing while reading — from its name, its rdfs:isDefinedBy and its dereferenceable IRI — as though it enforced the invariant it is named for. sh:deactivated says so in data: a SHACL processor now correctly produces no results for it, rather than producing none by accident. Remove this flag in the same change that gives it constraints." ; ;
    rdfs:label "Affordance SHACL shape" ;
    sh:targetClass iep:Affordance ;
    rdfs:comment "A iep:Affordance MUST also be a hydra:Operation with iep:action + hydra:target + hydra:method." ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:DereferenceResultShape a sh:NodeShape ; sh:deactivated true ; rdfs:comment "DECLARED, NOT YET SPECIFIED. This shape carries no constraints, so it validated nothing while reading — from its name, its rdfs:isDefinedBy and its dereferenceable IRI — as though it enforced the invariant it is named for. sh:deactivated says so in data: a SHACL processor now correctly produces no results for it, rather than producing none by accident. Remove this flag in the same change that gives it constraints." ; ;
    rdfs:label "Dereference result SHACL shape" ;
    rdfs:comment "Result envelope of kernel.dereference — carries the fetched representation + extracted affordances." ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:ComposeResultShape a sh:NodeShape ; sh:deactivated true ; rdfs:comment "DECLARED, NOT YET SPECIFIED. This shape carries no constraints, so it validated nothing while reading — from its name, its rdfs:isDefinedBy and its dereferenceable IRI — as though it enforced the invariant it is named for. sh:deactivated says so in data: a SHACL processor now correctly produces no results for it, rather than producing none by accident. Remove this flag in the same change that gives it constraints." ; ;
    rdfs:label "Compose result SHACL shape" ;
    rdfs:comment "Result envelope of kernel.compose — emits a ComposedDescriptor witness." ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:ActResultShape a sh:NodeShape ; sh:deactivated true ; rdfs:comment "DECLARED, NOT YET SPECIFIED. This shape carries no constraints, so it validated nothing while reading — from its name, its rdfs:isDefinedBy and its dereferenceable IRI — as though it enforced the invariant it is named for. sh:deactivated says so in data: a SHACL processor now correctly produces no results for it, rather than producing none by accident. Remove this flag in the same change that gives it constraints." ; ;
    rdfs:label "Act result SHACL shape" ;
    rdfs:comment "Result envelope of kernel.act — wraps an HTTP response and echoes the followed affordance." ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:PromoteResultShape a sh:NodeShape ; sh:deactivated true ; rdfs:comment "DECLARED, NOT YET SPECIFIED. This shape carries no constraints, so it validated nothing while reading — from its name, its rdfs:isDefinedBy and its dereferenceable IRI — as though it enforced the invariant it is named for. sh:deactivated says so in data: a SHACL processor now correctly produces no results for it, rather than producing none by accident. Remove this flag in the same change that gives it constraints." ; ;
    rdfs:label "Promote result SHACL shape" ;
    rdfs:comment "Result envelope of kernel.promote — apex IRI + lattice level + optional pullback square." ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:DecomposeResultShape a sh:NodeShape ; sh:deactivated true ; rdfs:comment "DECLARED, NOT YET SPECIFIED. This shape carries no constraints, so it validated nothing while reading — from its name, its rdfs:isDefinedBy and its dereferenceable IRI — as though it enforced the invariant it is named for. sh:deactivated says so in data: a SHACL processor now correctly produces no results for it, rather than producing none by accident. Remove this flag in the same change that gives it constraints." ; ;
    rdfs:label "Decompose result SHACL shape" ;
    rdfs:comment "Result envelope of kernel.decompose — pullback square (apex + left + right + overlap)." ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:ManifestShape a sh:NodeShape ; sh:deactivated true ; rdfs:comment "DECLARED, NOT YET SPECIFIED. This shape carries no constraints, so it validated nothing while reading — from its name, its rdfs:isDefinedBy and its dereferenceable IRI — as though it enforced the invariant it is named for. sh:deactivated says so in data: a SHACL processor now correctly produces no results for it, rather than producing none by accident. Remove this flag in the same change that gives it constraints." ; ;
    rdfs:label "Manifest SHACL shape" ;
    rdfs:comment "A pod's .well-known/context-graphs manifest is a hydra:Collection of iep:ContextDescriptor entries." ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:conformsToShape a owl:ObjectProperty ;
    rdfs:label "conforms to shape" ;
    rdfs:comment "Links a response envelope to the SHACL node shape it satisfies. Spiritual sibling of dct:conformsTo, specialised for sh:NodeShape targets." ;
    rdfs:range sh:NodeShape ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:iri a owl:DatatypeProperty ;
    rdfs:label "iri" ;
    rdfs:comment "The dereferenceable IRI of a holon or response envelope. Wire-level shortcut used in kernel result documents." ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:status a owl:DatatypeProperty ;
    rdfs:label "status" ;
    rdfs:comment "Substrate-level status code on a kernel-verb response (ok / encrypted-no-key / not-found / error)." ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:httpStatus a owl:DatatypeProperty ;
    rdfs:label "http status" ;
    rdfs:comment "Numeric HTTP status code echoed by kernel.act and dereference result envelopes when the underlying transport is HTTP." ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:apex a owl:ObjectProperty ;
    rdfs:label "apex" ;
    rdfs:comment "The apex fragment IRI of a PGSL pullback square. Used by promote and decompose result envelopes." ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:kind a owl:DatatypeProperty ;
    rdfs:label "kind" ;
    rdfs:comment "Holon role within the substrate — one of 'atom' (PGSL level-0 scalar), 'fragment' (PGSL level-N composition), 'descriptor' (iep:ContextDescriptor envelope), 'manifest' (hydra:Collection manifest), or 'opaque' (dereferenceable but uninterpreted)." ;
    rdfs:domain iep:Holon ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:left a owl:ObjectProperty ;
    rdfs:label "left" ;
    rdfs:comment "Left leg of a PGSL pullback square emitted by kernel.decompose — the first sub-fragment whose intersection with iep:right is iep:overlap and whose join is iep:apex." ;
    rdfs:domain iep:ComposedDescriptor ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:right a owl:ObjectProperty ;
    rdfs:label "right" ;
    rdfs:comment "Right leg of a PGSL pullback square emitted by kernel.decompose — the second sub-fragment whose intersection with iep:left is iep:overlap and whose join is iep:apex." ;
    rdfs:domain iep:ComposedDescriptor ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:overlap a owl:ObjectProperty ;
    rdfs:label "overlap" ;
    rdfs:comment "Shared sub-fragment at the meet of iep:left and iep:right in a PGSL pullback square emitted by kernel.decompose." ;
    rdfs:domain iep:ComposedDescriptor ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

# ══════════════════════════════════════════════════════════════
#  SolidNotifications — descriptor-lifecycle event format
# ══════════════════════════════════════════════════════════════

iep:Notification a owl:Class ;
    rdfs:label "Notification" ;
    rdfs:comment "A descriptor-lifecycle event emitted by a relay or pod implementing the iep:FederationFacet syncProtocol 'SolidNotifications' contract. Carries the IRI of the descriptor that changed, the kind of change (created / updated / superseded), the producing pod, the timestamp, and optionally the authoring agent. Delivered over Server-Sent Events (text/event-stream) at GET /notifications/:podSlug and/or POSTed to registered webhook URLs as application/ld+json." ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:NotificationChannelOpen a owl:Class ;
    rdfs:subClassOf iep:Notification ;
    rdfs:label "Notification Channel Open" ;
    rdfs:comment "A control event sent by a SolidNotifications SSE endpoint as the first data frame after the HTTP headers flush. Confirms the channel is alive and carries the resolved pod URL + slug so the client can sanity-check the routing before processing subsequent iep:Notification events." ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:eventType a owl:DatatypeProperty ;
    rdfs:label "event type" ;
    rdfs:comment "Kind of descriptor lifecycle event — one of 'created' (new descriptor minted), 'updated' (existing descriptor's payload or facets changed in place), or 'superseded' (a successor descriptor was published via iep:supersedes and the prior head is no longer the canonical view)." ;
    rdfs:domain iep:Notification ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:podUrl a rdf:Property ;
    rdfs:label "pod URL" ;
    rdfs:comment "The URL of a Solid pod. TWO USES, ONE PREDICATE, AND TWO SERIALIZATIONS - see the note beside the affordance properties above. (1) In an iep:Notification it is the pod the event originated from; combined with iep:descriptorUrl it locates the changed resource without the consumer maintaining a pod-to-descriptor index, and iep:NotificationShape constrains it as a literal with sh:datatype xsd:anyURI, which is the form the relay emits. (2) In a directory entry it is the pod being listed, written by packages/solid/src/directory.ts as an IRI node. It was declared twice - owl:ObjectProperty for the directory and owl:DatatypeProperty here - which no OWL DL reasoner can accept and which left readers unable to tell a node from a literal. Typed rdf:Property because that is what it actually is across both uses; narrowing it to one form means rewriting either a published shape or directory documents already on pods, and is not bundled with the declaration fix." ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:descriptorUrl a owl:DatatypeProperty ;
    rdfs:label "descriptor URL" ;
    rdfs:comment "Dereferenceable IRI of the iep:ContextDescriptor a notification refers to. Used in iep:Notification events to identify the changed descriptor without forcing the consumer to parse the event payload's structure." ;
    rdfs:range xsd:anyURI ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:graphUrl a owl:DatatypeProperty ;
    rdfs:label "graph URL" ;
    rdfs:comment "Dereferenceable IRI of the iep:ContextDescriptor's payload graph (the .nq / .envelope.jose.json artifact). Carried alongside iep:descriptorUrl in iep:Notification events so a consumer can fetch the payload without first re-fetching the descriptor index." ;
    rdfs:range xsd:anyURI ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:NotificationShape a sh:NodeShape ;
    rdfs:label "Notification SHACL shape" ;
    rdfs:comment "Validation shape for iep:Notification events delivered as JSON-LD webhook payloads. Every event MUST carry a podUrl, descriptorUrl and eventType (one of created / updated / superseded). ★ THE TIMESTAMP IS OPTIONAL IN THIS SHAPE AND THIS SENTENCE USED TO CALL IT A MUST - the dct:created property below declares sh:minCount 0, so an event with no timestamp conforms; the prose was the half that was wrong, and it is corrected rather than the shape tightened, because tightening a published shape retroactively invalidates events already emitted. graphUrl and wasAttributedTo are optional and RECOMMENDED. ★★ THE RELAY'S SSE PAYLOAD WAS NOT AN INSTANCE OF THIS SHAPE, AND NOW IS. deploy/mcp-relay emits the keys `type`, `eventType`, `timestamp`, `podUrl`, `descriptorUrl`, `graphUrl`, `author` - and set @context to this Turtle NAMESPACE IRI rather than to the published JSON-LD context document at /ns/iep/v1.json. A namespace IRI defines no terms, so every key was undefined, `timestamp` and `author` did not expand to dct:created and prov:wasAttributedTo, `type` was not aliased to @type, and the frame expanded to an anonymous node with no type and no properties - which validates against a NodeShape by conforming vacuously, so no gate could see it. ★ THE FIX CHANGED NO EMITTED KEY. This comment previously said the remedy was a wire-format decision belonging to somebody else; there was a third option, which is that the published context GAINS the term definitions and @context names the document that defines them. A consumer reading raw JSON sees byte-identical keys and values; a consumer that expands stops silently losing every field. deploy/mcp-relay/notification-event.ts is the one builder, and tests/a-notification-frame-is-an-instance-of-its-shape.test.ts expands a real frame against the real published context and validates it here - checking PRESENCE of the required properties first, because conformance alone is satisfied by the empty graph the old context produced." ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> ;
    sh:targetClass iep:Notification ;
    sh:property [
        sh:path iep:podUrl ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "iep:Notification MUST carry exactly one iep:podUrl identifying the source pod."
    ] ;
    sh:property [
        sh:path dct:source ;
        sh:minCount 0
    ] ;
    sh:property [
        sh:path iep:descriptorUrl ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "iep:Notification MUST carry exactly one iep:descriptorUrl identifying the changed descriptor."
    ] ;
    sh:property [
        sh:path iep:eventType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "created" "updated" "superseded" ) ;
        sh:message "iep:eventType MUST be one of 'created', 'updated', or 'superseded'."
    ] ;
    sh:property [
        sh:path dct:created ;
        sh:datatype xsd:dateTime ;
        sh:minCount 0 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path prov:wasAttributedTo ;
        sh:minCount 0 ;
        sh:maxCount 1
    ] .

# ── Agent interop: engagement records + card projection ──────────────
#
# The engine that emits these (@interego/agent-interop) is deliberately spec-blind:
# an ENGAGEMENT is a durable, agent-attributed record of work requested of an agent,
# carrying ordered turns. External agent-interop protocols (A2A and others) are
# expressed as declarative PROFILES that project this same model onto their own wire
# vocabulary, so these terms describe the substrate's own shape rather than any one
# protocol's.

iep:Engagement a owl:Class ;
    rdfs:label "Engagement" ;
    rdfs:comment "A durable, agent-attributed record of work requested of an agent. Carries an ordered sequence of turns (iep:turn), a lifecycle state (iep:state) and an owner. Its identifier is a dereferenceable URL that resolves to the record. Protocol-neutral: an external interop profile projects it onto that protocol's own task/job/exchange vocabulary." .

iep:state a owl:DatatypeProperty ;
    rdfs:label "state" ;
    rdfs:comment "The lifecycle state of an iep:Engagement, in the substrate's own vocabulary (Requested, InProgress, AwaitingInput, Completed, Failed, Withdrawn, Declined). An interop profile maps these to its protocol's state names; the substrate owns transition legality so a profile cannot declare its way into reviving a terminal record." ;
    rdfs:domain iep:Engagement ;
    rdfs:range xsd:string .

iep:turn a owl:ObjectProperty ;
    rdfs:label "turn" ;
    rdfs:comment "One ordered contribution to an iep:Engagement — a requester or responder utterance carrying content parts. Attribution (prov:wasAttributedTo) is derived from the verified caller, never from the request payload." ;
    rdfs:domain iep:Engagement .

iep:role a owl:DatatypeProperty ;
    rdfs:label "role" ;
    rdfs:comment "Which side of an engagement produced a turn: 'requester' or 'responder'. Derived from the verified caller identity, not client-asserted." ;
    rdfs:range xsd:string .

iep:updatedAt a owl:DatatypeProperty ;
    rdfs:label "updatedAt" ;
    rdfs:comment "Timestamp of the most recent state change or appended turn on an iep:Engagement." ;
    rdfs:range xsd:dateTime .

iep:Agent a owl:Class ;
    rdfs:label "Agent" ;
    rdfs:comment "A software agent addressable on the substrate: an identity, a service endpoint, and the set of affordances it offers. Projected into an interop protocol's agent-card document by a declarative profile; the projection is computed from published affordances rather than hand-authored, so a card can never advertise a capability the substrate cannot serve." .

iep:serviceEndpoint a owl:DatatypeProperty ;
    rdfs:label "serviceEndpoint" ;
    rdfs:comment "The absolute base URL an iep:Agent is served from. Interop profiles render their own interface/endpoint blocks from it." ;
    rdfs:domain iep:Agent ;
    rdfs:range xsd:anyURI .

iep:offers a owl:ObjectProperty ;
    rdfs:label "offers" ;
    rdfs:comment "An iep:Affordance an iep:Agent makes available. The affordance's iep:action URL is the capability identifier carried into every interop projection, so a projected skill id dereferences to its own description rather than being a minted opaque token." ;
    rdfs:domain iep:Agent ;
    rdfs:range iep:Affordance .

iep:cardVersion a owl:DatatypeProperty ;
    rdfs:label "cardVersion" ;
    rdfs:comment "Content-derived version of an agent's projected card: a hash over the rendered document, so it changes exactly when the advertised capability set changes. Doubles as the HTTP ETag for the card resource." ;
    rdfs:domain iep:Agent ;
    rdfs:range xsd:string .

iep:requiresVerifiedCaller a owl:DatatypeProperty ;
    rdfs:label "requiresVerifiedCaller" ;
    rdfs:comment "True when an affordance may only be invoked by a cryptographically verified caller (a signed request or an authenticated session), as opposed to being followable anonymously." ;
    rdfs:range xsd:boolean .

# ── The agent-to-agent notification body ────────────────────────────────────
# The rule below is the CONTRACT deploy/mcp-relay/server.ts validates every
# notify_agent notification against before it writes one. It lives here, as
# DATA, because the relay reads THIS DOCUMENT to enforce it — see
# deploy/mcp-relay/notification-body.ts, which cuts iep:NotificationBodyShape
# and its closure out of this file and validates against that alone. Editing
# the pattern below changes what the relay refuses; editing a comment about the
# pattern does not, which is the whole reason the rule is not a TypeScript `if`.

iep:NotificationBody a owl:Class ;
    rdfs:label "Notification body"@en ;
    rdfs:comment "The as:object of an agent-to-agent notification — the node carrying the message itself, as distinct from the as:Create / as:Announce / as:Question / as:Offer activity that delivers it. ★ ASSERTED BY THE SENDING RELAY ON EXACTLY ONE NODE, POSITIONALLY. deploy/mcp-relay/notification-body.ts marks the activity's own as:object and nothing else, so iep:NotificationBodyShape can only ever judge the body. ★ AND IT IS A SEPARATE CLASS FROM as:Note BECAUSE as:Note IS NOT POSITIONAL. notify_agent lets a caller name the ACTIVITY type, and with type 'Note' the activity is an as:Note as well, while the body is on its as:object. Measured against an earlier draft of the shape below that targeted as:Note directly: a correct message carrying a real as:content was REFUSED, because the activity node was selected and the body was never on it. A class the relay asserts positionally cannot make that mistake."@en ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:NotificationBodyShape a sh:NodeShape ;
    rdfs:label "Notification body shape"@en ;
    rdfs:comment "The contract an agent-to-agent notification body (iep:NotificationBody — the as:object of an ActivityStreams 2.0 notification) must satisfy: a summary that says the detail travels WITH the message must be accompanied by that detail — inline as as:content, or by reference as iep:about. ★ CONDITIONAL BY CONSTRUCTION, BECAUSE REQUIRING A BODY OUTRIGHT WOULD BE AN OUTAGE. Most notifications on this substrate are correctly summary-only: an as:Question raised by a workspace deliberately carries no task text at all (an inbox on this relay is world-writable, so text delivered by inbox is text a forger could write) and points at a signed record with iep:about instead; an as:Announce, and a bare reachability probe, carry a summary and nothing else. A shape is the right tool precisely because the antecedent is a property of the MESSAGE rather than of its type. ★ THE DEFECT IT CLOSES: an external agent sent this maintainer findings summarised ‘P7 and P8 re-sent with FULL DETAIL’; the notification arrived with no as:content whatsoever and the relay answered delivered:true. It carried as:summary twice, once on the activity and once on its object, and THAT WAS NOT THE DEFECT: it is the normal configuration of every notification this relay writes, because the writer copies the caller's summary onto both nodes. The defect was the missing detail, and this shape judges the object alone. It was never sent because the MCP input schema declares content as an optional string and requires only to and summary: a permitted input, not a lost one. ★ iep:about MUST BE AN IRI, and sh:nodeKind sh:IRI is where that is written down rather than in the relay. The projection that feeds this shape emits a value that cannot be an IRI as the literal it actually is — dropping it would make the graph claim the field was absent — so without the nodeKind constraint an about of ‘no’ satisfied sh:minCount 1 and the message was accepted with nothing reachable. Measured: it conforms without the constraint and violates with it. ★ THE ANTECEDENT IS A sh:qualifiedValueShape AND NOT A sh:minCount BESIDE A sh:pattern, BECAUSE THE OBVIOUS SPELLING SAYS SOMETHING ELSE. sh:not of a property shape carrying sh:minCount 1 and sh:pattern P is satisfied when there is no value at all OR when SOME value fails P — so one extra as:summary VALUE ON THE BODY, the empty string included, negated the antecedent and the whole sh:or passed. Measured: a body carrying TWO as:summary VALUES ON THAT ONE NODE — one claiming, one empty — and no as:content, was DELIVERED. (Two values on the body node, which is a different thing from the one summary the activity carries and the one its object carries.) sh:qualifiedValueShape counts the values that DO match, so sh:qualifiedMinCount 1 is ‘at least one summary claims’ and its negation is ‘none does’. ★ THE PATTERN SPELLS ITS OWN CASE-INSENSITIVITY OUT IN CHARACTER CLASSES INSTEAD OF USING sh:flags, and that is not style. Measured against the engine that reads this file: sh:flags is NOT implemented, and it is IGNORED rather than fatal — the sh:pattern beside it still runs, case-SENSITIVELY, and the news arrives only as a separate Info result and a fullyChecked:false nothing on a refusal path reads. So the obvious tidy-up — lower-casing these phrases and adding sh:flags ‘i’ — produces a shape that CONFORMS for the very message it exists to refuse. deploy/mcp-relay/notification-body.ts runs seven canaries over this document at load and switches the gate off loudly when that happens, but a rule should not have to depend on being caught. ★ ITS PHRASES ARE THE ONES THAT CAN ONLY MEAN ‘the detail is in this message’: full detail(s), in full, verbatim, attached, enclosed, as follows, see below, and details/text/body/content/pasted immediately followed by below. Measured against every notify_agent caller in this repository before it was published — the workspace invitation Offer, the workspace ask Question, the artifact channel's ask and invite, both live-driver Question probes, and the ActivityPub route's synthesised summary — none of them match, so none of them are refused."@en ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> ;
    sh:targetClass iep:NotificationBody ;
    sh:message "This notification’s as:summary says the detail travels with it, and no detail travelled: its body carries neither an as:content with something in it nor an iep:about naming an IRI. Send the body as `content`, or send the IRI the detail is at as `about`. A summary that only summarises needs neither, and is not selected by this shape (iep:NotificationBodyShape)." ;
    sh:or (
        # (1) The antecedent, negated: NO as:summary on this body claims the detail travels
        #     with it.
        #     ★★ sh:qualifiedValueShape AND NOT sh:minCount + sh:pattern, AND THE DIFFERENCE
        #     IS A DELIVERED MESSAGE. This branch used to read `sh:not [ sh:property [
        #     sh:path as:summary ; sh:minCount 1 ; sh:pattern P ] ]`, which READS as "no
        #     summary matches P" and does not MEAN it: the inner property shape raises a
        #     violation when the value count is 0 or when ANY ONE value fails P, so its
        #     negation is satisfied when there is no summary at all OR when SOME summary does
        #     not match. One extra value — the empty string will do — satisfied it, the whole
        #     sh:or then passed, and a claiming message with no body was DELIVERED. Measured
        #     on the engine that reads this file, driven through the relay's own writer: a
        #     body carrying as:summary twice, once claiming and once empty, and no as:content,
        #     conformed. It is reachable, not theoretical — POST /agents/:localPart/inbox
        #     builds its summary from a REMOTE document, and an array there arrives here as
        #     two values. sh:qualifiedValueShape COUNTS the values that match, so
        #     sh:qualifiedMinCount 1 is exactly "at least one summary claims", and sh:not of
        #     that is exactly "none of them does".
        [ sh:not [ sh:property [
              sh:path as:summary ;
              sh:qualifiedValueShape [ sh:pattern "([Ff][Uu][Ll][Ll] [Dd][Ee][Tt][Aa][Ii][Ll]|[Ii][Nn] [Ff][Uu][Ll][Ll]|[Vv][Ee][Rr][Bb][Aa][Tt][Ii][Mm]|[Aa][Tt][Tt][Aa][Cc][Hh][Ee][Dd]|[Ee][Nn][Cc][Ll][Oo][Ss][Ee][Dd]|[Aa][Ss] [Ff][Oo][Ll][Ll][Oo][Ww][Ss]|[Ss][Ee][Ee] [Bb][Ee][Ll][Oo][Ww]|([Dd][Ee][Tt][Aa][Ii][Ll][Ss]?|[Tt][Ee][Xx][Tt]|[Bb][Oo][Dd][Yy]|[Cc][Oo][Nn][Tt][Ee][Nn][Tt]|[Pp][Aa][Ss][Tt][Ee][Dd]) [Bb][Ee][Ll][Oo][Ww])" ] ;
              sh:qualifiedMinCount 1 ] ] ]
        # (2) The detail travelled inline. The pattern is what makes a body of whitespace not
        #     count as one; an empty string never reaches here, because the writer drops a
        #     falsy content and the property is then simply absent.
        #     ★★ "\\S", AND THE COMMENT THAT USED TO STAND HERE WAS FALSE IN BOTH HALVES. It
        #     said a Turtle "\\S" "would have to survive an escape round trip to reach the
        #     regex, and the character class does not". Measured on this parser and on the
        #     re-serializer in deploy/mcp-relay/notification-body.ts that slices this shape
        #     out: "\\S" survives that round trip exactly — it parses to \S and is written
        #     back as "\\S" — and [^ \t\r\n] goes through the SAME round trip, because
        #     \t, \r and \n are escapes too. What the class actually did was narrow the rule
        #     to the four ASCII whitespace characters it names: driven over the wire with a
        #     claiming summary, a body of U+00A0, U+3000, U+2028, U+000B or U+FEFF PASSED as a
        #     body. The engine compiles sh:pattern with `new RegExp`, so \S is JavaScript's
        #     whitespace set, and all five are refused. (U+200B ZERO WIDTH SPACE is NOT in that
        #     set — measured — while U+FEFF is, so a body of U+200B still counts as a body.
        #     That is the honest limit of a regex answer to "is there anything here".)
        [ sh:property [ sh:path as:content ; sh:minCount 1 ; sh:nodeKind sh:Literal ; sh:pattern "\\S" ] ]
        # (3) Or by reference — which is how a notification on this substrate is SUPPOSED to
        #     carry detail it does not want forgeable. sh:nodeKind sh:IRI is load-bearing: it
        #     is what makes `about: "no"` a refusal instead of a pass.
        [ sh:property [ sh:path iep:about ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ]
    ) .

iep:about a owl:ObjectProperty ;
    rdfs:label "about" ;
    rdfs:comment "The resource an agent-to-agent notification concerns — typically the descriptor, engagement or memory the sender wants the recipient to look at. Carried in the ActivityStreams 2.0 notification body alongside as:object. Declared here because the notification vocabulary previously bound this term to a placeholder namespace that dereferenced to nothing; it now resolves under the substrate's own naming authority like every other emitted term." ;
    rdfs:range rdfs:Resource .

# ── The published-node description (relay /ns/pgsl/<kind>/<hash>) ────────────
# Emitted by deploy/mcp-relay/pgsl-node-store.ts when a PGSL node that has been
# PUBLISHED is dereferenced at its authority. Minting a node computes its
# content address; only publication makes that address resolve, so these terms
# describe the published projection rather than the lattice node itself.

iep:hash a owl:DatatypeProperty ;
    rdfs:label "hash"@en ;
    rdfs:comment "The content address a holon's identifier is derived from — the substrate's identity-by-reference invariant made explicit in the served description."@en ;
    rdfs:domain iep:Holon ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:height a owl:DatatypeProperty ;
    rdfs:label "height"@en ;
    rdfs:comment "A fragment's topological depth from the top of the lattice. Complements iep:level, which counts upward from the atoms."@en ;
    rdfs:domain iep:Fragment ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:resolved a owl:DatatypeProperty ;
    rdfs:label "resolved"@en ;
    rdfs:comment "The human-readable rendering of a holon — for an atom its value, for a fragment the sequence of its constituents' renderings."@en ;
    rdfs:domain iep:Holon ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:structure a owl:ObjectProperty ;
    rdfs:label "structure"@en ;
    rdfs:comment "SYNTAGM, downward: what this holon is composed of — its ordered items and, for a level>=2 fragment, its two pullback constituents."@en ;
    rdfs:domain iep:Holon ;
    rdfs:range rdfs:Resource ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:context a owl:ObjectProperty ;
    rdfs:label "context"@en ;
    rdfs:comment "Upward: the fragments that reuse this holon. Reuse is what makes the lattice a lattice rather than a forest, so a node's containers are part of what it means."@en ;
    rdfs:domain iep:Holon ;
    rdfs:range rdfs:Resource ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:paradigm a owl:ObjectProperty ;
    rdfs:label "paradigm"@en ;
    rdfs:comment "PARADIGM, sideways: the substitution class — holons that occupy the same position in otherwise-identical containers, and are therefore commutable with this one."@en ;
    rdfs:domain iep:Holon ;
    rdfs:range rdfs:Resource ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:contextComplete a owl:DatatypeProperty ;
    rdfs:label "contextComplete"@en ;
    rdfs:comment "False when the served iep:context and iep:paradigm are not the whole neighbourhood — either because a cold replica answered from a point read, or because the fan-out was CAPPED. The identity facets (iep:hash, iep:value, iep:items) are always exact; only the derived reuse facets are partial, and this term says so in-band rather than letting a consumer over-trust them. ★ IT USED TO MEAN ONLY THE FIRST OF THOSE, and the description it qualifies has always been capped: a node reused 20,000 times served its first 200 containers stamped complete, because the describe function returned no totals and its consumer had nothing to judge by. A completeness flag that cannot see the cap is worse than none — it converts a known limit into a false assurance. Read it beside iep:contextTotals."@en ;
    rdfs:domain iep:Holon ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:contextTotals a owl:ObjectProperty ;
    rdfs:label "context totals"@en ;
    rdfs:comment "How many neighbours EXIST for this holon, whether or not the served description listed them all. Present so a truncated description can be acted on rather than merely distrusted: a consumer comparing a total against what it received knows both that there is more and how much, which is the difference between paging deliberately and guessing. Counts are exact — they are accumulated during the same scan that builds the description, outside the cap."@en ;
    rdfs:domain iep:Holon ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:containers a owl:DatatypeProperty ;
    rdfs:label "containers"@en ;
    rdfs:comment "The number of fragments that reuse this holon — its total upward context, independent of how many were listed. On an iep:contextTotals block."@en ;
    rdfs:domain iep:Holon ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:sourceOptions a owl:DatatypeProperty ;
    rdfs:label "source options"@en ;
    rdfs:comment "The number of DISTINCT holons observed immediately before this one across every fragment containing it — the size of its left paradigm class. Counted past the cap, so it does not under-report in exactly the reused case the cap exists for."@en ;
    rdfs:domain iep:Holon ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:targetOptions a owl:DatatypeProperty ;
    rdfs:label "target options"@en ;
    rdfs:comment "The number of DISTINCT holons observed immediately after this one across every fragment containing it — the size of its right paradigm class. Counted past the cap, for the same reason as iep:sourceOptions."@en ;
    rdfs:domain iep:Holon ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:publishedBy a owl:ObjectProperty ;
    rdfs:label "publishedBy"@en ;
    rdfs:comment "The agent that PUBLISHED this node — distinct from the agent that minted it. Minting is a pure content-addressing computation with no consent and no network; publication is an authenticated, irreversible act that makes the identifier resolve. The published description attributes the act, not the arithmetic."@en ;
    rdfs:range rdfs:Resource ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:publishedAt a owl:DatatypeProperty ;
    rdfs:label "publishedAt"@en ;
    rdfs:comment "When the node was published, i.e. when its identifier began to resolve. Not when it was minted."@en ;
    rdfs:range xsd:dateTime ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:target a owl:ObjectProperty ;
    rdfs:label "target"@en ;
    rdfs:comment "The resource an affordance acts on. Already carried as hydra:target in the JSON-LD context; declared under this authority so the compacted iep: form dereferences too."@en ;
    rdfs:domain iep:Affordance ;
    rdfs:range rdfs:Resource ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:method a owl:DatatypeProperty ;
    rdfs:label "method"@en ;
    rdfs:comment "The HTTP method an affordance is invoked with. Mirrors hydra:method; declared here for the same reason as iep:target."@en ;
    rdfs:domain iep:Affordance ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

# ── Publish-gate constraint components ───────────────────────────────────────
# Emitted by deploy/mcp-relay/shape-body.ts in the SHACL validation report the
# publish gate returns as a 422, in the sh:sourceConstraintComponent position.
# They are NOT shape violations: the data was never checked, because the shape
# it declares conformance to could not be read. Each names a DIFFERENT reason,
# because the caller's remedy differs for each — collapsing them was the defect
# these declarations record.
#
# Declared here late: the relay emitted the first two for months against a
# namespace constant that carried half the local name, which made them invisible
# to tools/ontology-lint.mjs. Fixed at the source, so all three are now checked.

iep:shapeUnfetchable a sh:ConstraintComponent ;
    rdfs:label "shapeUnfetchable"@en ;
    rdfs:comment "The publish gate SENT a request for a declared shape and did not get a usable shapes graph back — a 404, a 5xx, a timeout, or a page whose advertised Turtle representation is gone. Conformance to a shape that cannot be read cannot be asserted, so the publish is refused rather than proceeding unvalidated. Says nothing about WHY the host answered as it did; the shape may have been withdrawn or its host may be down."@en ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:shapeUnfetchableScheme a sh:ConstraintComponent ;
    rdfs:label "shapeUnfetchableScheme"@en ;
    rdfs:comment "A declared shape IRI can NEVER be fetched because its scheme is not https. Distinguished from iep:shapeUnfetchable because it is a configuration error in the caller's own declaration rather than an outage: no host was consulted, and no retry will ever succeed."@en ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:shapeDeclaresNoShapes a sh:ConstraintComponent ;
    rdfs:label "shapeDeclaresNoShapes"@en ;
    rdfs:comment "A caller-declared shape WAS fetched and DID parse, but the document declares no SHACL shapes at all, so validating against it would have conformed without checking anything. Distinguished from iep:shapeUnfetchable because nothing failed: the retrieval succeeded and the verdict was a correct trivial pass (SHACL conformance is vacuous over an empty shapes graph). The publish is refused because a conforming report over zero shapes is byte-identical to a genuine clean pass, so reporting it as success would confirm something adjacent to what was asked. Usually raised by naming an ontology IRI, a profile IRI, or a descriptor URL where a shapes graph belongs — a descriptor holds facets rather than shapes, and an ontology commonly keeps its shapes in a separate document. Raised ONLY for shapes the caller named: a container's own iep:conformsTo / dct:conformsTo is a profile assertion the caller does not control, and refusing it would lock the pod out of the write that would correct it, so that case is reported in the publish response instead."@en ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:shapeUnfetchableEgressRefused a sh:ConstraintComponent ;
    rdfs:label "shapeUnfetchableEgressRefused"@en ;
    rdfs:comment "NO REQUEST WAS SENT. The relay's egress screen refused the declared shape's target because its host is, or resolves into, private or internal address space — a caller-supplied shape IRI is an SSRF vector, so the screen runs before any socket is opened. Distinguished from iep:shapeUnfetchable because nothing whatever is known or implied about the named host, the refusal is deterministic rather than transient, and the remedy is to declare a shape on a publicly reachable host rather than to retry. The resolved address is deliberately NOT carried in the message: it is internal topology for any host whose name does not already encode it."@en ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

# ══════════════════════════════════════════════════════════════
#  An agent as its PEERS see it — availability, capability, address
# ══════════════════════════════════════════════════════════════
#
# An agent exists independently of any room it talks in. Everything below is a
# statement BY an agent ABOUT ITSELF, published on ITS OWN pod, signed with ITS
# OWN key, at an address a peer composes from its DID and nothing else:
#
#   <relay>/ns/<pod>/agent-<pod>-presence
#   <relay>/ns/<pod>/agent-<pod>-capabilities
#
# ★ THE OWN-POD RULE IS FORCED, NOT CHOSEN. Measured 2026-08-08: the identical
# document published under a delegation onto the DELEGATOR's pod reads back
# authorshipVerified:false — "the proof is signed for owner <the delegate's own
# WebID>" — because the relay's descriptor binding holds the proof's owner
# against the pod the bytes landed on. On the agent's own pod the same document
# reads back verified and content-bound. A self-claim is only CHECKABLE where
# its signer owns the pod, so that is where it goes.
#
# ★ AND NONE OF IT IS SCOPED TO A WORKSPACE. An earlier design named the
# capability document <member pod>/<convener pod>--<slug>-affordances, which
# described a capability as a fact about an agent IN ONE ROOM: duplicated per
# room, findable only by somebody who already knew the convener and the slug,
# and invisible to "does anyone have a tool for X". A Codex agent that has never
# been in a room has capabilities too.

iep:PresenceLease a owl:Class ;
    rdfs:label "presence lease"@en ;
    rdfs:comment "A SHORT, TIME-BOUNDED, SELF-SIGNED CLAIM BY AN AGENT THAT ITS HOST IS RUNNING — and never an observation that one is. An agent that thinks by spawning a model on its own human's machine, on their credential, is only answerable while something of theirs is running; a channel that silently swallowed a request addressed to an absent agent would be lying by omission, so there has to be a document to point at. It is a LEASE and not a flag for two reasons. First, a relay-held 'online' flag would be a third party vouching for a process it cannot see; this is the agent's own statement, worth something only because it is short and had to be renewed. Second, it decays by the substrate's own clock: publish it with valid_from/valid_until and the relay's temporal filter simply stops answering for it, so nothing anywhere runs a timer or has to notice an outage. A reader MUST refuse a lease whose span is long enough that renewing it proved nothing, and one with no expiry at all, reporting each as a finding about the document rather than as presence — valid_until is caller-supplied, so a single publish could otherwise claim a year of availability. A failed read is likewise not absence and not presence: it is a failed read."@en ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:presenceOf a owl:ObjectProperty ;
    rdfs:label "presence of"@en ;
    rdfs:comment "The agent a iep:PresenceLease is about, stated INSIDE the signed region. It exists so a reader can hold the agent the lease CLAIMS to concern against the agent that actually SIGNED it: without it the filename would be the only thing naming the subject, and a filename is not an assertion. A reader MUST take every object of this property and refuse anything but exactly one that agrees with the agent it asked about — these regions are read predicate-first and their author controls their bytes, so a reader that returned the first object would let document order decide whose availability was being claimed."@en ;
    rdfs:domain iep:PresenceLease ;
    rdfs:range prov:Agent ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:presenceActingFor a owl:ObjectProperty ;
    rdfs:label "presence acting for"@en ;
    rdfs:comment "The principal this agent is a delegate of, carried on a lease for a reader's convenience. STANDING, like iep:actsFor, and emphatically not a per-act claim: it says who the agent is authorised to act for, not that anything in particular was done on their behalf. It is also NOT evidence of that standing — the authoritative record is the delegation row on the principal's own pod, which only they can write and revoke. A reader that wants the fact asks their pod; this is a hint, and a lease that omits it says nothing either way."@en ;
    rdfs:domain iep:PresenceLease ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:presenceHost a owl:DatatypeProperty ;
    rdfs:label "presence host"@en ;
    rdfs:comment "Free text naming WHAT is running, e.g. 'the desktop app' — for a person reading a channel, so 'running' is not a bare word. Deliberately not a hostname, an address or a path: an agent's availability is a fact about it, and where its human's machine happens to be is theirs. A reader displays it and derives nothing from it."@en ;
    rdfs:domain iep:PresenceLease ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:leaseExpires a owl:DatatypeProperty ;
    rdfs:label "lease expires"@en ;
    rdfs:comment "When this lease stops being a claim about now, stated inside the signed region. It duplicates the valid_until the publish carries, and that duplication is the point: the temporal filter is the relay's enforcement and this is the AGENT's own signed statement of the same bound, so a reader can check the span against bytes the agent put its key to rather than against metadata the relay computed. A lease with no expiry is not a lease and MUST be refused."@en ;
    rdfs:domain iep:PresenceLease ;
    rdfs:range xsd:dateTime ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:capabilityOf a owl:ObjectProperty ;
    rdfs:label "capability of"@en ;
    rdfs:comment "The agent whose capability document this is, stated inside the signed region for the same reason iep:presenceOf is: a capability document tells a reader where to POST, so one whose subject came only from its filename would be an unattributable instruction to send somebody else's work to an address of the forger's choosing. A reader MUST require exactly one object and MUST require that the signer of the document be that agent."@en ;
    rdfs:range prov:Agent ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:askVia a owl:ObjectProperty ;
    rdfs:label "ask via"@en ;
    rdfs:comment "HOW TO REACH AN AGENT THAT HAS NO ENDPOINT — the explicit alternative to hydra:target, and the reason a capability document is not obliged to carry one. An agent running on somebody's laptop, on their own model credential, behind whatever network they are on, has nothing that will ever answer a POST; publishing a hydra:target for it would advertise a call that cannot connect. This names the route instead: put a signed record where the agent reads, and it answers when its host next runs. A capability document MUST declare exactly one of hydra:target and iep:askVia. Neither means an agent reachable by no route at all, which is worse than advertising nothing; BOTH leaves a reader choosing which of two ways is the real one with no honest basis, and a reader that finds both MUST refuse rather than choose."@en ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:requiresSignedRequest a owl:DatatypeProperty ;
    rdfs:label "requires signed request"@en ;
    rdfs:comment "This agent will only act on a request whose caller signed it. A DECLARATION AND NOT AN ENFORCEMENT POINT: the gate is at the exposing end, where the caller signs a canonical payload, the endpoint recovers the address and compares it to its own policy. It is published so a caller can learn the gate exists before spending a call finding out. Nothing about it is load-bearing for security, and — as everywhere else — its ABSENCE states nothing: a reader that took an unstated value for 'no gate' would be reading absence as evidence."@en ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:EvidenceSource a owl:Class ;
    rdfs:label "Evidence Source"@en ;
    rdfs:comment "A store an affordance READS to compose its answer, declared so a caller can learn of it before spending a call. ── ★★ WHY THIS EXISTS, MEASURED. A contract has two sides and only one was ever written: `hydra:expects` says what the caller must SEND, and nothing anywhere said what the affordance must FIND. Live, over four turns and about $3 of model spend, a delegate signed a valid envelope, dereferenced an affordance whose input was documented exhaustively — required fields, canonical message, clock skew, signing key — invoked it correctly, and received an empty answer. It could not distinguish 'you have done nothing' from 'your evidence is not in the store I read', because nothing it could dereference named the store, what fills it, or whether it was enrolled. The answer was an environment variable. A HUMAN had to read deployment config to find it. ★ WHEN AN ANSWER IS ASSEMBLED FROM DATA THE CALLER NEITHER SENT NOR CAN SEE, AN EMPTY ANSWER AND A CORRECT ANSWER ARE THE SAME BYTES — and a descriptor that cannot distinguish them is unfalsifiable. This is the same argument `iep:requiresSignedRequest` already makes about a gate; the read side simply never got its term. ★ AND ITS ABSENCE STATES NOTHING, as everywhere else: an affordance that declares no source has not declared that it reads none."@en ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:reads a owl:ObjectProperty ;
    rdfs:label "reads"@en ;
    rdfs:comment "A store this affordance reads to answer. MULTI-VALUED ON PURPOSE: one answer is routinely assembled from several stores with different fill mechanisms and different preconditions, and collapsing them to one hides which of them was empty. A declaration and not an enforcement point — the affordance still reads what it reads; this is what lets a caller find out first."@en ;
    rdfs:domain iep:Affordance ;
    rdfs:range iep:EvidenceSource ;
    rdfs:seeAlso iep:requiresSignedRequest ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:enrolled a owl:ObjectProperty ;
    rdfs:label "enrolled"@en ;
    rdfs:comment "A subject whose evidence an iep:EvidenceSource will admit, listed on the register itself so membership is dereferenceable rather than deployment configuration. ★ AND THE LIST IS THE POINT, NOT A COUNT. An agent needs to know whether IT is on it — a register that said only how many were enrolled would leave the same question unanswered as the environment variable it replaces. ★ ABSENCE FROM A REGISTER IS A STATED FACT ABOUT A READABLE LIST, which is different from absence of a register: the first says 'not enrolled', the second says nothing at all."@en ;
    rdfs:domain iep:EvidenceSource ;
    rdfs:range iep:EvidenceSource ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:ControlSet a owl:Class ;
    rdfs:label "Control set"@en ;
    rdfs:comment "A named, PUBLISHED set of controls that a conformance report scores against. ★★ IT EXISTS BECAUSE THE SCOPE WAS A FROZEN ARRAY IN CODE. The compliance engine held a TypeScript copy of each framework's control list, that copy drifted from the published ontology — 16 controls against 25 declared for SOC 2 — and a report reading 100% therefore meant 16/16 of a scope no reader could see. Which controls a deployment claims to be measured on is a DECISION, and a decision that is not published is not auditable. Naming it as a node makes the scope dereferenceable, makes 'scope is narrower than the framework' a visible fact rather than a hidden one, and makes widening it an edit to a graph instead of a release."@en ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:control a owl:ObjectProperty ;
    rdfs:label "control"@en ;
    rdfs:comment "A control that is a member of this iep:ControlSet — i.e. one the report scores. The engine reads these rather than inferring membership from rdf:type, deliberately: the three framework ontologies model controls differently (SOC 2 as owl:NamedIndividual, EU AI Act largely as owl:Class, NIST RMF as individuals mixed with non-control individuals), so any type-based inference would be a fourth guess about somebody else's modelling. Membership is stated, not deduced."@en ;
    rdfs:domain iep:ControlSet ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:auditScope a owl:ObjectProperty ;
    rdfs:label "audit scope"@en ;
    rdfs:comment "Links a framework ontology to the iep:ControlSet a conformance report scores against, so a reader arriving at the namespace document can find the scope without knowing an engine's internals."@en ;
    rdfs:range iep:ControlSet ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:retired a owl:ObjectProperty ;
    rdfs:label "retired"@en ;
    rdfs:comment "A subject that WAS enrolled on this iep:EvidenceSource and is no longer admitted, carrying when that happened and why. ★ THE COUNTERPART TO iep:enrolled EXISTS BECAUSE REMOVING THE ROW PUBLISHED THE DECISION AS AN ABSENCE. Measured: an agent enrolled, was told the enrolment was durable, appeared on a register, and was gone an hour later — and 'retired', 'never enrolled' and 'the write silently failed' were the same bytes to the only party who needed to tell them apart. A register that states its membership must state its unmembership the same way, or its silence carries meaning it cannot be read for. ★ IT IS A BOUNDED TAIL, NOT A LEDGER: the point is that the subject just retired can find out, so a publisher keeps recent retirements and drops old ones rather than accumulating history nobody reads."@en ;
    rdfs:domain iep:EvidenceSource ;
    rdfs:range iep:EvidenceSource ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:store a owl:ObjectProperty ;
    rdfs:label "store"@en ;
    rdfs:comment "The dereferenceable identifier of the store an iep:EvidenceSource stands for. Separate from the source node itself so one description can carry a label, what fills it, what it admits and where its enrolment is published, without any of those being mistaken for the store's identity."@en ;
    rdfs:domain iep:EvidenceSource ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:populatedBy a owl:ObjectProperty ;
    rdfs:label "populated by"@en ;
    rdfs:comment "The mechanism that puts data into an iep:EvidenceSource, as something dereferenceable. ★ THE FIELD THAT WOULD HAVE ANSWERED IT. An agent that knows a store was empty still cannot act; an agent that knows WHAT FILLS THAT STORE can. Live: a delegate had been writing correct, signed, content-bound evidence to its own pod for hours while the projector that fills the reviewed view was reading a list its pod was not on — so writing better evidence could never have changed the answer, and nothing told it that."@en ;
    rdfs:domain iep:EvidenceSource ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:enrolmentRegister a owl:ObjectProperty ;
    rdfs:label "enrolment register"@en ;
    rdfs:comment "Where the set of subjects an iep:EvidenceSource will admit is PUBLISHED, so membership is a fact a caller can dereference rather than deployment configuration nobody outside the process can see. ★ A FACT THAT DECIDES WHOSE EVIDENCE IS READABLE IS ITSELF EVIDENCE, and an environment variable is not a place evidence can live: it is not addressable, not linkable, and invisible to every reader. That is not a style preference here — 'every identifier is a dereferenceable URL' is the rule this substrate is built on, and a register in an env var is the same violation as a `urn:`, with a measured cost attached."@en ;
    rdfs:domain iep:EvidenceSource ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:enrolmentDurability a owl:DatatypeProperty ;
    rdfs:label "enrolment durability"@en ;
    rdfs:comment "Whether an entry on an enrolment register survives a restart of the service that reads it: \"durable\" (recorded in a store, or seeded from the deployment's configuration) or \"session\" (held only in the reading process). ★ BECAUSE AN ENROLMENT THAT LAPSES SILENTLY IS WORSE THAN ONE THAT WAS REFUSED. A register that listed a session-scoped entry indistinguishably from a persisted one would tell an agent it is being read and then stop being true at the next deploy, with no event anywhere marking the change — the same invisible state the register itself exists to remove, rebuilt one layer along. ★ AND IT IS REPORTED, NOT PROMISED: the value is derived from re-reading the store after the write, so \"durable\" means the entry was found, never that persisting it was attempted."@en ;
    rdfs:domain iep:EvidenceSource ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:admits a owl:DatatypeProperty ;
    rdfs:label "admits"@en ;
    rdfs:comment "What an iep:EvidenceSource will accept, in one sentence a caller can act on — the shape, class or modal status required. ★ BECAUSE 'THE STORE IS EMPTY' AND 'THE STORE REFUSED WHAT YOU WROTE' ARE DIFFERENT FAILURES. Live: an agent recorded a step with modal status Hypothetical — an intention — and then reasoned about it as though it were performance. It caught that itself, which is more than the store did: a source that admits only asserted evidence should say so."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .

iep:addressedTo a owl:ObjectProperty ;
    rdfs:label "addressed to"@en ;
    rdfs:comment "The agent or agents a record is a request TO, stated inside the record's own signed region. ★ IT IS HERE AND NOT IN A VERTICAL'S VOCABULARY BECAUSE ADDRESSING AN AGENT IS NOT SOMETHING A ROOM INVENTED: a workspace entry, a Foxxi record and a bare script's record must all spell it identically, or an agent that reads two of them gets two answers to one question — and an agent that belongs to no room could not be addressed at all. ★ AND IT IS IN THE SIGNED REGION RATHER THAN IN THE NOTIFICATION THAT ANNOUNCES IT BECAUSE AN INBOX IS WORLD-WRITABLE. A notification is a POINTER and never the request: it carries no task text, because text that travelled by inbox is text a forger could write. What makes the pointer safe to follow is that the record it names is signed and content-bound, and that its recipient checks the party that delivered the pointer IS the party that signed the record. A reader MUST NOT treat its own absence as anything: a record addressed to nobody is a record, not a request."@en ;
    rdfs:range prov:Agent ;
    rdfs:seeAlso iep:askVia ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep#> .
