    iep:readOnlyHint false ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint true ;
    iep:appliesToCollection "courses" ;
    iep:externallyRouted true ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/skill-affordance> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/skill-affordance> ;
    hydra:method "POST" ;
    hydra:title "Translate a SKILL.md to a typed iep:Affordance descriptor graph (round-trip)" ;
    rdfs:comment "The STRICT SKILL.md ⇄ iep:Affordance translator (core @interego/skills bridge): translate a SKILL.md into a real iep:Affordance ContextDescriptor graph (subject typed iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution) and round-trip it back to a SKILL.md to demonstrate the lossless markdown-carrier ⇄ typed-affordance translation. Pure translation: no pod write, no signing — the authoring DID rides in PROV provenance only. Externally routed." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/agent/skill/affordance> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/agent/skill/affordance> ;
    dcat:mediaType "application/json" ;
    
    hydra:returns [
        a hydra:Class ;
        rdfs:label "foxxi.skill_affordance-output" ;
        rdfs:comment "The typed affordance descriptor graph + the round-tripped SKILL.md + validation. 400 on empty/unparseable skillMd; 413 when too large." ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "ok" ] ;
            hydra:required true ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "skillIri" ] ;
            hydra:required false ;
            rdfs:comment "IRI of the translated iep:Affordance subject." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "graphIri" ] ;
            hydra:required false ;
            rdfs:comment "IRI of the descriptor graph." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "graphContent" ] ;
            hydra:required false ;
            rdfs:comment "The iep:Affordance ContextDescriptor graph."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "roundTripMd" ] ;
            hydra:required false ;
            rdfs:comment "The SKILL.md regenerated from the graph (round-trip proof)." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "atomIris" ] ;
            hydra:required false ;
            rdfs:comment "Map of atom name → IRI."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "validation" ] ;
            hydra:required false ;
            rdfs:comment "Skill validation report."
        ]
    ] ;

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.skill_affordance-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "skillMd" ] ;
            hydra:required true ;
            rdfs:comment "A SKILL.md string to translate (max 2MB)." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "agentDid" ] ;
            hydra:required false ;
            rdfs:comment "Authoring DID recorded in PROV provenance (must start with did:; defaults to the zero address)." ;
            sh:datatype xsd:string
        ]
    ] ;
    rdfs:label "SKILL.md ⇄ iep:Affordance" ;
    iep:readOnlyHint true ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint false ;
    iep:externallyRouted true ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/course-propose-successor> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/course-propose-successor> ;
    hydra:method "POST" ;
    hydra:title "A course proposes its own successor (regime-engine-routed, iep:supersedes)" ;
    rdfs:comment "The Living Curriculum: a course reasons about ITSELF concept by concept. Each concept routes a performance signal through the work-regime engine, which REFUSES the universal content-gap frame (only the Knowable regime runs a gap analysis; a performer who could perform under ideal conditions yields an environment/incentive cause, not a content gap). It composes a real iep:supersedes SUCCESSOR holon into the PGSL lattice — a versioned, dereferenceable revision. Externally routed (rate-limited open access)." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/agent/course/propose-successor> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/agent/course/propose-successor> ;
    dcat:mediaType "application/json" ;
    
    hydra:returns [
        a hydra:Class ;
        rdfs:label "foxxi.course_propose_successor-output" ;
        rdfs:comment "The per-concept regime diagnosis + recommendation roll-up + the composed successor holon. 400 on missing course; 429 on rate limit." ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "ok" ] ;
            hydra:required true ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "courseId" ] ;
            hydra:required false ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "supersedes" ] ;
            hydra:required false ;
            rdfs:comment "The superseded holon URI (or null)." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "summary" ] ;
            hydra:required false ;
            rdfs:comment "Counts: { keep, revise, jobaid, instrument }."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "concepts" ] ;
            hydra:required false ;
            rdfs:comment "Per-concept diagnosis (regime, method, cause, recommendation, rationale, signal)."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "successor" ] ;
            hydra:required false ;
            rdfs:comment "Composed successor holon { holonUri, descriptorUrl, reusedNodes, newNodes } (or null)."
        ]
    ] ;

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.course_propose_successor-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "course" ] ;
            hydra:required true ;
            rdfs:comment "{ courseId, title, concepts:[{id,label}] } (from /agent/course/analyze*)."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "concept_signals" ] ;
            hydra:required false ;
            rdfs:comment "Per-concept signals: array of { id?, label?, completion?, fieldSuccess?, frequency?, criticality? }. No signal for a concept → the engine refuses to claim a regime (instrument-first)."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "holonUri" ] ;
            hydra:required false ;
            rdfs:comment "The original course holon URI — shared as a term so the successor links to it (iep:supersedes)." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "label" ] ;
            hydra:required false ;
            rdfs:comment "Optional label for the successor holon (sanitized; defaults to successor-<courseId>)." ;
            sh:datatype xsd:string
        ]
    ] ;
    rdfs:label "Propose a course successor" ;
    iep:readOnlyHint false ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint true ;
    iep:appliesToCollection "courses" ;
    iep:externallyRouted true ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/calibration-merge> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/calibration-merge> ;
    hydra:method "POST" ;
    hydra:title "Merge signed calibration contributions into a federated memory (k-anon)" ;
    rdfs:comment "Federated calibration: pool SIGNED (regime × cause × intervention → verdict) aggregate tallies from multiple orgs WITHOUT sharing a single raw record. The bridge recovers each contributor from its signature (authenticated, not asserted; same-key resubmissions collapse to one source), applies the k-anonymity suppression floor, then pools them — a cell Hypothetical for each org alone becomes Asserted once pooled across ≥2 distinct keys. The merged memory is composed into the PGSL lattice as a dereferenceable holon no single key could assert alone. Externally routed (rate-limited; each contribution carries its own signature)." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/agent/calibration/merge> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/agent/calibration/merge> ;
    dcat:mediaType "application/json" ;
    
    hydra:returns [
        a hydra:Class ;
        rdfs:label "foxxi.calibration_merge-output" ;
        rdfs:comment "The merged calibration profile + readout + promoted cells + the composed holon. 400 on no/too-many contributions; 401 when a contribution signature fails; 429 on rate limit." ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "ok" ] ;
            hydra:required true ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "contributors" ] ;
            hydra:required false ;
            rdfs:comment "Per-source { source, cells, samples } after k-anon suppression."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "distinctSigners" ] ;
            hydra:required false ;
            rdfs:comment "Count of distinct recovered signing keys." ;
            sh:datatype xsd:integer
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "multiParty" ] ;
            hydra:required false ;
            rdfs:comment "True when ≥2 distinct signers (cross-source promotion is only honest then)." ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "droppedContributions" ] ;
            hydra:required false ;
            rdfs:comment "Envelopes dropped because the recovered signer did not match the claimed agent_id." ;
            sh:datatype xsd:integer
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "merged" ] ;
            hydra:required false ;
            rdfs:comment "The pooled calibration profile."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "readout" ] ;
            hydra:required false ;
            rdfs:comment "The calibration readout."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "promoted" ] ;
            hydra:required false ;
            rdfs:comment "Cells promoted Hypothetical→Asserted by pooling (only when multiParty)."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "holon" ] ;
            hydra:required false ;
            rdfs:comment "Composed PGSL holon { holonUri, descriptorUrl } (or null)."
        ]
    ] ;

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.calibration_merge-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "contributions" ] ;
            hydra:required true ;
            rdfs:comment "Array (1..64) of signed envelopes { _signature, _signed_payload: JSON.stringify({ agent_id, timestamp, specs:[{ regime, causeFactor, intervention, closed, improved, noChange, worsened }] }) }."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "k" ] ;
            hydra:required false ;
            rdfs:comment "Federation k-anonymity threshold floor (server enforces a minimum of 8; callers may raise but not lower it)." ;
            sh:datatype xsd:decimal
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "assertThreshold" ] ;
            hydra:required false ;
            rdfs:comment "Sample count above which a pooled cell becomes Asserted (server minimum 12; raise-only)." ;
            sh:datatype xsd:decimal
        ]
    ] ;
    rdfs:label "Merge calibration contributions" ;
    iep:readOnlyHint false ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint true ;
    iep:externallyRouted true ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/record-performance-signed> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/record-performance-signed> ;
    hydra:method "POST" ;
    hydra:title "Record a production-work performance event as yourself" ;
    rdfs:comment "Record one unit of on-the-job production work as an xAPI performed statement, into your OWN Foxxi lens, authenticated by your delegation (the agent-drivable counterpart of the session-token foxxi.record_performance). Declare an activity_type (a domain type you define, e.g. urn:ttt:Move) to aggregate same-type executions into one competency; else it keys off task_name. success=true on demonstrated work promotes the competency to performance-verified. Composed into your shared PGSL lattice (optionally wrapped to named recipients for cross-seat owner-decrypt). Send trajectory: how the work went, step by step, and it is kept with the record. When a unit fails, the answer offers, unasked, what the work you recorded at that competency implies: its regime read from the trajectories kept with it, the plan for that regime, and the admission that plan implies, yours to keep with foxxi.content_admit or not. Nothing is kept from the offer, and without a trajectory the regime is not read, so nothing is offered. Externally routed: sign_request the args, then POST the envelope." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/agent/record-performance> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/agent/record-performance> ;
    dcat:mediaType "application/json" ;
    
    hydra:returns [
        a hydra:Class ;
        rdfs:label "foxxi.record_performance_signed-output" ;
        rdfs:comment "The recorded statement id + performer + shared-lattice composition, and for a failed unit an offer or why none is made. 400 on missing task_name/success or a malformed trajectory; 401 on auth failure." ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "ok" ] ;
            hydra:required true ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "recorded" ] ;
            hydra:required false ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "offer" ] ;
            hydra:required false ;
            rdfs:comment "For a failed unit: the admission the work at its competency implies, { competency, kinds, because, regime, forPerformer, keep, situation, diagnosis, plan, evidence }, yours to keep with foxxi.content_admit."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "offerWithheld" ] ;
            hydra:required false ;
            rdfs:comment "For a failed unit with no offer: why (no trajectory to read the regime from, a plan with nothing to keep, or an admission you already keep)." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "statementId" ] ;
            hydra:required false ;
            rdfs:comment "The xAPI performed statement id." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "performer" ] ;
            hydra:required false ;
            rdfs:comment "Performer DID (the verified caller)." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "taskId" ] ;
            hydra:required false ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "taskName" ] ;
            hydra:required false ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "activityType" ] ;
            hydra:required false ;
            rdfs:comment "Domain activity-type IRI (or the generic ProductionTask wrapper)." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "success" ] ;
            hydra:required false ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "durable" ] ;
            hydra:required false ;
            rdfs:comment "Pod the canonical holon was composed into." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "sharedLattice" ] ;
            hydra:required false ;
            rdfs:comment "Shared-lattice composition { holonUri, descriptorUrl, ... }."
        ]
    ] ;

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.record_performance_signed-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "_signed_payload" ] ;
            hydra:required true ;
            rdfs:comment "JSON.stringify({ agent_id, timestamp, task_name, success, activity_type?, task_id?, quality?, duration_iso?, actor_kind?, cost_usd?, recipients?, trajectory? }). recipients?: pod URLs/DIDs to ALSO wrap the encrypted holon to (cross-seat owner-decrypt). trajectory?: { steps: [{ modalStatus: Asserted|Hypothetical|Counterfactual, granularity: task|subtask|tool-call, verb, objectId, objectName, id?, parentId?, supersedesId?, result?: { success?, quality?, note? }, recordedAt? }] }, at most 100 steps." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "_signature" ] ;
            hydra:required true ;
            rdfs:comment "secp256k1 over sha256:<hex(sha256(_signed_payload))> by the wallet matching agent_id (relay sign_request)." ;
            sh:datatype xsd:string
        ]
    ] ;
    rdfs:label "Record a performance event" ;
    iep:readOnlyHint false ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint true ;
    iep:appliesToCollection "profiles" ;
    iep:externallyRouted true ;
    iep:encrypted false .

