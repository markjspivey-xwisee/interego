<https://relay.interego.xwisee.com/ns/iep/action/foxxi/prove-competency> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/prove-competency> ;
    hydra:method "POST" ;
    hydra:title "Prove a competency privately (BBS+ selective disclosure, end-to-end)" ;
    rdfs:comment "Holder-facing competency proof. Composes the three BBS+ steps — issue (the bridge as tenant issuer signs a multi-claim credential), derive (disclose only a minimal privacy-preserving subset), verify — into ONE operation a learner can trigger for their own record. Proves \"I hold this competency at this proficiency, issued by this tenant\" to a verifier while keeping score, name, dates, and credential id behind a zero-knowledge proof. This is the IEEE P2997 LER privacy story a flat wallet cannot give. Non-admins may only prove their own competencies." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/foxxi/prove_competency> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/foxxi/prove_competency> ;
    
    

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.prove_competency-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "learner_did" ] ;
            hydra:required true ;
            rdfs:comment "Learner whose competency is being proved. Non-admin callers must pass their own DID." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "competency_name" ] ;
            hydra:required true ;
            rdfs:comment "The competency / course title to prove (becomes Achievement.name on the BBS+ credential)." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "course_id" ] ;
            hydra:required false ;
            rdfs:comment "Optional course identifier; derived from competency_name if omitted." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "learner_name" ] ;
            hydra:required false ;
            rdfs:comment "Optional learner display name (a hidden claim — never disclosed by default)." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "reveal_paths" ] ;
            hydra:required false ;
            rdfs:comment "Optional claim paths to disclose; defaults to the minimal privacy-preserving set (issuer + achievement.name + achievement.proficiencyLevel)."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "presentation_context" ] ;
            hydra:required false ;
            rdfs:comment "Optional verifier/occasion binding (BBS+ presentation header)." ;
            sh:datatype xsd:string
        ]
    ] ;
    rdfs:label "Prove a competency (BBS+)" ;
    iep:readOnlyHint false ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint true ;
    iep:appliesToCollection "profiles" ;
    iep:encrypted false .

