    iep:readOnlyHint false ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint true ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/resolve-did> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
