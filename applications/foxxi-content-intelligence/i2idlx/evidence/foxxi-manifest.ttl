        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "accepted_standards" ] ;
            hydra:required true ;
            rdfs:comment "Array of accepted package standard labels."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "effective_from" ] ;
