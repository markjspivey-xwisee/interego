<https://relay.interego.xwisee.com/ns/iep/action/foxxi/set-autonomy-policy> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/set-autonomy-policy> ;
    hydra:method "POST" ;
    hydra:title "[learning-engineer] Amend the autonomy policy: when a judge may assert on a kind of question without a person" ;
    rdfs:comment "Per kind of question, the registry rating on its axis a judge must reach (accuracy for evidence-level, competence for work-regime), over how many outcomes the latest attestation about it must rest, and how many of those a person must have confirmed. Amended through the constitutional machinery: proposed, voted by the caller, ratified under the tier's rules — tier 4 (a self-sovereign pod, its owner's) ratifies at once; the configured tenant amends at tier 3 and waits for a quorum. Each policy supersedes the last. The judge and record affordances read it to publish Asserted or Hypothetical." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/foxxi/set_autonomy_policy> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/foxxi/set_autonomy_policy> ;
    
    
    hydra:returns [
        a hydra:Class ;
        rdfs:label "foxxi.set_autonomy_policy-output" ;
        rdfs:comment "The policy as published, whether it is in force, the amendment and its status, and where it landed." ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "kind" ] ;
            hydra:required true ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "policy" ] ;
            hydra:required true
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "inForce" ] ;
            hydra:required true ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "amendment" ] ;
            hydra:required true
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "published" ] ;
            hydra:required false
        ]
    ] ;

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.set_autonomy_policy-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "rules" ] ;
            hydra:required true ;
            rdfs:comment "Array of { kind, axis, floor, minSamples, minHumanConfirmers }, one per kind of question the policy speaks to."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "tier" ] ;
            hydra:required false ;
            rdfs:comment "The constitutional tier (1..4); 4 for a self-sovereign pod, 3 for the configured tenant by default." ;
            sh:datatype xsd:decimal
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "description" ] ;
            hydra:required false ;
            rdfs:comment "Why, in a sentence." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "tenant_pod_url" ] ;
            hydra:required false ;
            rdfs:comment "A self-sovereign pod to run the loop on instead of the configured tenant: yours, enrolled with foxxi.register_self_sovereign_learner, whose owner you are. Omitted, the configured tenant is meant and a learning-engineer or admin role is required." ;
            sh:datatype xsd:string
        ]
    ] ;
    rdfs:label "Amend the autonomy policy" ;
    iep:readOnlyHint false ;
    iep:destructiveHint false ;
    iep:idempotentHint false ;
    iep:openWorldHint true ;
    iep:encrypted false .

