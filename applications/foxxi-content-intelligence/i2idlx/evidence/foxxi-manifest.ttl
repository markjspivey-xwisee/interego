        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "tool_name" ] ;
            hydra:required false ;
            rdfs:comment "Optional exact tool name." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "status" ] ;
            hydra:required false ;
