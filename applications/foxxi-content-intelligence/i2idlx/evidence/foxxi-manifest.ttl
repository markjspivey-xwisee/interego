            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "requirement_type" ] ;
            hydra:required true ;
            rdfs:comment "One of: required | recommended." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "trigger" ] ;
            hydra:required true ;
            rdfs:comment "One of: on-hire | on-role-change | on-cycle | manual." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "due_relative_days" ] ;
            hydra:required true ;
            rdfs:comment "Days from trigger event after which the assignment is overdue." ;
            sh:datatype xsd:decimal
        ]
    ] ;
    rdfs:label "Assign a course to an audience" ;
    iep:readOnlyHint false ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint true ;
    iep:appliesToCollection "groups" ;
    iep:appliesToCollection "policies" ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/coverage-query> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/coverage-query> ;
    hydra:method "POST" ;
    hydra:title "[admin] Query concept coverage across the catalog" ;
    rdfs:comment "Privacy-respecting coverage query: across the catalog, which concepts are taught vs only mentioned, by which courses, in which categories. Defaults to v2 merkle-attested-opt-in (count of courses per concept); v3 zk-distribution mode returns a histogram of coverage shape (concepts taught in 1 course / 2-5 / 6-10 / 10+) with per-bucket DP noise. Composes with the existing applications/_shared/aggregate-privacy/ ladder." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/foxxi/coverage_query> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/foxxi/coverage_query> ;
    
    

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.coverage_query-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "tenant_pod_url" ] ;
            hydra:required true ;
            rdfs:comment "Tenant pod URL." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "category_filter" ] ;
            hydra:required false ;
            rdfs:comment "Optional category filter (e.g., \"Power Systems / Technical\")." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "concept_filter" ] ;
            hydra:required false ;
            rdfs:comment "Optional concept label substring filter." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "privacy_mode" ] ;
            hydra:required false ;
            rdfs:comment "One of: abac | merkle-attested-opt-in (v2, default) | zk-distribution (v3 histogram)." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "epsilon" ] ;
            hydra:required false ;
            rdfs:comment "DP ε budget for zk-distribution mode." ;
            sh:datatype xsd:decimal
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "distribution_edges" ] ;
            hydra:required false ;
            rdfs:comment "Bucket-edge boundaries (decimal-string bigints) for zk-distribution."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "distribution_max_value" ] ;
            hydra:required false ;
            rdfs:comment "Upper bound for the last bucket in zk-distribution." ;
            sh:datatype xsd:string
        ]
    ] ;
    rdfs:label "Query concept coverage" ;
    iep:readOnlyHint true ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint true ;
    iep:appliesToCollection "courses" ;
    iep:encrypted false .

