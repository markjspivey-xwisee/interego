<https://relay.interego.xwisee.com/ns/iep/action/foxxi/consume-lesson> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/consume-lesson> ;
    hydra:method "POST" ;
    hydra:title "Consume a lesson + emit consumption descriptor" ;
    rdfs:comment "Stream-load a Foxxi-parsed lesson's structural stratum (slides, audio, transcripts) for consumption, and emit an fxa:ConsumptionEvent descriptor + an xAPI Statement (via the lrs-adapter) for each slide the learner advances past. Composes with the iep:TemporalFacet so consumption is timeboxed; composes with iep:TrustFacet so partial completion is recorded as Hypothetical, full as Asserted." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/foxxi/consume_lesson> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/foxxi/consume_lesson> ;
    
    
    hydra:returns [
        a hydra:Class ;
        rdfs:label "foxxi.consume_lesson-output" ;
        rdfs:comment "Lesson-consumption outcome — { consumed, descriptors emitted for each slide advanced, xAPI statementIds (when lrs_endpoint was supplied), modalStatus = Hypothetical when partial / Asserted on full completion }. Current bridge build returns a stub note flag until the streaming consumption handler is wired."
    ] ;

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.consume_lesson-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "course_iri" ] ;
            hydra:required true ;
            rdfs:comment "IRI of the course (federation_iri_base/course_id)." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "learner_did" ] ;
            hydra:required true ;
            rdfs:comment "Consuming learner DID." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "lrs_endpoint" ] ;
            hydra:required false ;
            rdfs:comment "Optional xAPI LRS endpoint to forward Statements to (composes with the lrs-adapter projector). If omitted, Statements are emitted as descriptors only." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "lrs_auth_header" ] ;
            hydra:required false ;
            rdfs:comment "Authorization header for the LRS when provided." ;
            sh:datatype xsd:string
        ]
    ] ;
    rdfs:label "Consume a lesson" ;
    iep:readOnlyHint false ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint true ;
    iep:appliesToCollection "courses" ;
    iep:appliesToCollection "profiles" ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/ask-course-question> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/ask-course-question> ;
    hydra:method "POST" ;
    hydra:title "Ask a question about a course" ;
    rdfs:comment "Grounded Q&A over a course's narration transcripts + extracted concepts. The learner asks \"what is handicap?\" and the substrate returns verbatim-cited transcript segments + concept snippets that overlap the question. Composes the existing learner-performer-companion grounded-answer machinery (same honesty discipline: tamper-detected atoms, IRI citations, honest null when no atom overlaps the question). Lexical retrieval only — use foxxi.ask_course_question_agentic for graph-aware retrieval + LLM synthesis." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/foxxi/ask_course_question> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/foxxi/ask_course_question> ;
    
    
    hydra:returns [
        a hydra:Class ;
        rdfs:label "foxxi.ask_course_question-output" ;
        rdfs:comment "Grounded course-Q&A result — verbatim transcript citations + concept-card snippets that overlap the question. Honest null when nothing in the course grounds the question. Also persists an lpc:CitedResponse-shape audit descriptor." ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "question" ] ;
            hydra:required false ;
            rdfs:comment "Echo of the asked question." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "citations" ] ;
            hydra:required false ;
            rdfs:comment "Per-citation entries: { slideId, slideTitle?, verbatimQuote, transcriptOffsetMs?, conceptIds }."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "conceptCards" ] ;
            hydra:required false ;
            rdfs:comment "Concept-card snippets that overlap the question (id, label, definition)."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "displayText" ] ;
            hydra:required false ;
            rdfs:comment "Composed display text wrapping the citations — never paraphrases the cited atoms." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "nullReason" ] ;
            hydra:required false ;
            rdfs:comment "When no atom in the course overlaps the question, set to a human-readable reason (\"no-data\")." ;
            sh:datatype xsd:string
        ]
    ] ;

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.ask_course_question-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "course_iri" ] ;
            hydra:required true ;
            rdfs:comment "IRI of the course (matches federation_iri_base#package emitted by ingest_content_package)." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "learner_did" ] ;
            hydra:required true ;
            rdfs:comment "Asking learner DID. Recorded on the response descriptor for audit." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "question" ] ;
            hydra:required true ;
            rdfs:comment "Natural-language question (e.g., \"what is handicap?\")." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "course_content" ] ;
            hydra:required true ;
            rdfs:comment "The course's narration transcripts + extracted concepts. In a real deployment the bridge fetches this from the tenant pod via the published fxs/fxk descriptors; for the in-process invocation supply the shape from the parser's dashboard_data + transcripts payloads."
        ]
    ] ;
    rdfs:label "Ask a question about a course" ;
    iep:readOnlyHint true ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint true ;
    iep:appliesToCollection "courses" ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/ask-course-question-agentic> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/ask-course-question-agentic> ;
    hydra:method "POST" ;
    hydra:title "Agentic RAG Q&A over a course federation (with LLM synthesis)" ;
    rdfs:comment "Multi-step agentic retrieval + LLM synthesis: (1) federated concept-graph search across the primary course + any loaded federation peers, (2) prereq + modifier-of edge expansion within each concept's home course, (3) round-robin slide allocation so peer-course slides survive the citation cap, (4) LLM synthesis with the substrate-assembled structured context as the system prompt. Each step of the agent loop emits an Interego descriptor (fxa:LearnerQuestionEvent Asserted → fxa:RetrievalActivity Hypothetical → fxa:LlmCompletion Hypothetical → fxa:CitedAnswer Asserted with iep:supersedes back through the trace). LLM key precedence: per-request llm_api_key (BYOK from the caller) > server-side FOXXI_LLM_API_KEY / ANTHROPIC_API_KEY env. The trace records which key source was used (bridge-env vs per-request-byok). Without any key, returns retrieval scaffold + descriptor trace alone (use foxxi.retrieve_course_context for the explicit no-LLM path)." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/foxxi/ask_course_question_agentic> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/foxxi/ask_course_question_agentic> ;
    
    
    hydra:returns [
        a hydra:Class ;
        rdfs:label "foxxi.ask_course_question_agentic-output" ;
        rdfs:comment "Agentic-RAG result: federated retrieval scaffold + LLM-synthesised answer + full descriptor trace (fxa:LearnerQuestionEvent Asserted → fxa:RetrievalActivity Hypothetical → fxa:LlmCompletion Hypothetical → fxa:CitedAnswer Asserted, with iep:supersedes chains). When no LLM key is configured, returns the retrieval scaffold + trace only (use foxxi.retrieve_course_context for the explicit no-LLM path). Surfaces a rate-limit error when bridge-env key is used and per-IP rate cap is hit." ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "answer" ] ;
            hydra:required false ;
            rdfs:comment "LLM-synthesised answer composed over the structured retrieval context. Omitted when no LLM key was available." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "citations" ] ;
            hydra:required false ;
            rdfs:comment "Cited slide entries with verbatim transcript snippets, allocated round-robin across primary + federation peers."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "seedConcepts" ] ;
            hydra:required false ;
            rdfs:comment "Concept-graph seeds chosen by the agentic retrieval step (primary + cross-course matches)."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "expandedConcepts" ] ;
            hydra:required false ;
            rdfs:comment "Concepts reached via prereq + modifier-of edge expansion from the seeds."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "trace" ] ;
            hydra:required false ;
            rdfs:comment "Ordered Interego descriptor trace; one entry per agent step (event type + descriptor IRI + modal status + iep:supersedes)."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "llmKeySource" ] ;
            hydra:required false ;
            rdfs:comment "Which LLM-key source was used (BYOK takes precedence over the bridge env key)." ;
            sh:datatype xsd:string ;
            sh:in ( "per-request-byok" "bridge-env" )
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "llmModel" ] ;
            hydra:required false ;
            rdfs:comment "Anthropic model id actually invoked." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "error" ] ;
            hydra:required false ;
            rdfs:comment "Set on rate-limit or auth failure." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "retryAfterSeconds" ] ;
            hydra:required false ;
            rdfs:comment "Set when error is a rate-limit refusal." ;
            sh:datatype xsd:integer
        ]
    ] ;

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.ask_course_question_agentic-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "learner_did" ] ;
            hydra:required true ;
            rdfs:comment "Asking learner DID. Recorded on the fxa:LearnerQuestionEvent descriptor." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "question" ] ;
            hydra:required true ;
            rdfs:comment "Natural-language question." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "primary" ] ;
            hydra:required true ;
            rdfs:comment "Primary course payload — matches the FoxxiAgenticPayload shape (packageMeta + concepts + slides + modifier_pairs + prereq_edges). In a real deployment the bridge fetches this via discover_context against the tenant pod's published fxk:ConceptMap + fxs:Slide descriptors."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "federation" ] ;
            hydra:required false ;
            rdfs:comment "Optional array of federation peer course payloads — same shape as primary. Cross-course concept matching + slide citation works across the full federation."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "history" ] ;
            hydra:required false ;
            rdfs:comment "Prior conversation turns (role/content) for multi-turn Q&A."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "llm_model" ] ;
            hydra:required false ;
            rdfs:comment "Anthropic model id (default claude-sonnet-4-5)." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "llm_api_key" ] ;
            hydra:required false ;
            rdfs:comment "BYOK: per-request Anthropic API key. Used transiently for the one LLM call; bridge does not store/log. Takes precedence over the server-side FOXXI_LLM_API_KEY / ANTHROPIC_API_KEY env. Caller is responsible for transport security (TLS to the bridge)." ;
            sh:datatype xsd:string
        ]
    ] ;
    rdfs:label "Agentic RAG course Q&A" ;
    iep:readOnlyHint true ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint true ;
    iep:appliesToCollection "courses" ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/retrieve-course-context> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/retrieve-course-context> ;
    hydra:method "POST" ;
    hydra:title "Retrieval-only path (MCP-client-as-LLM — your agent does synthesis)" ;
    rdfs:comment "Pure retrieval, no LLM call. Designed for MCP clients where the AGENT itself (Claude.ai connector / Claude Desktop / Claude Code / Cursor / Codex) is the LLM and uses the user's existing subscription. Returns the same federated concept-graph retrieval scaffold (seed concepts + expanded neighborhood + cited slides with verbatim transcripts) as foxxi.ask_course_question_agentic, plus a 2-step Interego trace (fxa:LearnerQuestionEvent Asserted + fxa:RetrievalActivity Hypothetical). The calling agent synthesises the answer in its own context using the cited transcripts as grounding, and optionally closes the trace by publishing its own fxa:CitedAnswer descriptor back to the tenant pod. NO API key required anywhere — user's subscription pays via the MCP client." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/foxxi/retrieve_course_context> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/foxxi/retrieve_course_context> ;
    
    
    hydra:returns [
        a hydra:Class ;
        rdfs:label "foxxi.retrieve_course_context-output" ;
        rdfs:comment "Retrieval-only Q&A scaffold for MCP-client-as-LLM: seed concepts + expanded neighborhood + cited slides with verbatim transcripts + a 2-step Interego trace (fxa:LearnerQuestionEvent Asserted + fxa:RetrievalActivity Hypothetical). The calling agent synthesises the answer in its OWN context using the scaffold as grounding. No API key required — the user's MCP-client subscription pays for synthesis." ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "seedConcepts" ] ;
            hydra:required false ;
            rdfs:comment "Concept-graph seeds matched against the question."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "expandedConcepts" ] ;
            hydra:required false ;
            rdfs:comment "Concepts reached via prereq + modifier-of expansion."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "citations" ] ;
            hydra:required false ;
            rdfs:comment "Cited slide entries with verbatim transcripts the calling agent can ground on."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "trace" ] ;
            hydra:required false ;
            rdfs:comment "Two-step Interego descriptor trace (question event + retrieval activity)."
        ]
    ] ;

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.retrieve_course_context-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "learner_did" ] ;
            hydra:required true ;
            rdfs:comment "Asking learner DID." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "question" ] ;
            hydra:required true ;
            rdfs:comment "Natural-language question." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "primary" ] ;
            hydra:required true ;
            rdfs:comment "Primary course payload (FoxxiAgenticPayload)."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "federation" ] ;
            hydra:required false ;
            rdfs:comment "Optional federation peer payloads."
        ]
    ] ;
    rdfs:label "Retrieve course context (no LLM)" ;
    iep:readOnlyHint true ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint true ;
    iep:appliesToCollection "courses" ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/explore-concept-map> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/explore-concept-map> ;
    hydra:method "POST" ;
    hydra:title "Explore the published concept map for a course" ;
    rdfs:comment "Fetch the concept graph a course PUBLISHED (concepts with tier + confidence, prerequisite edges, modifier-of relations) from its on-pod fxa:CoursePackageBundle, and return it as a navigation graph: pick any concept with focus_concept_id, follow prerequisite edges up AND down to max_depth, and read the slide ids that taught each one. Returns { error } — never an empty graph — when the course is not on the pod or focus_concept_id names no concept in it." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/foxxi/explore_concept_map> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/foxxi/explore_concept_map> ;
    
    
    hydra:returns [
        a hydra:Class ;
        rdfs:label "foxxi.explore_concept_map-output" ;
        rdfs:comment "The course's navigation graph, read from its on-pod fxa:CoursePackageBundle. Returns { error } rather than an empty graph when the course is absent or focus_concept_id names no concept — an empty concepts/edges pair would read as \"this course has no concept map\", which is a different and wrong answer." ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "courseIri" ] ;
            hydra:required false ;
            rdfs:comment "Resolved course IRI (…#package)." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "courseId" ] ;
            hydra:required false ;
            rdfs:comment "Resolved course id." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "title" ] ;
            hydra:required false ;
            rdfs:comment "Course title." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "concepts" ] ;
            hydra:required false ;
            rdfs:comment "Nodes { id, label, tier, confidence, taughtInSlides[], depth? }. depth is hops from focus_concept_id (0 = the focus) and is absent on an unfocused full graph."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "edges" ] ;
            hydra:required false ;
            rdfs:comment "Edges { from, to, kind: prerequisite|modifier-of, confidence? }, restricted to the returned node set."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "slides" ] ;
            hydra:required false ;
            rdfs:comment "Slide index { id, title, sequence_index } the taughtInSlides ids refer into."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "focusConceptId" ] ;
            hydra:required false ;
            rdfs:comment "Echo of the focus, when one was given." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "maxDepth" ] ;
            hydra:required false ;
            rdfs:comment "Traversal depth actually applied (default 3)." ;
            sh:datatype xsd:integer
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "truncated" ] ;
            hydra:required false ;
            rdfs:comment "True when the focus + depth limit excluded concepts the full graph contains." ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "error" ] ;
            hydra:required false ;
            rdfs:comment "Set when the course is not published on the pod, or focus_concept_id names no concept in it." ;
            sh:datatype xsd:string
        ]
    ] ;

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.explore_concept_map-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "course_iri" ] ;
            hydra:required true ;
            rdfs:comment "Course IRI." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "focus_concept_id" ] ;
            hydra:required false ;
            rdfs:comment "Optional concept to center the navigation graph on; default returns the full graph." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "max_depth" ] ;
            hydra:required false ;
            rdfs:comment "Optional depth limit for prerequisite-edge traversal from focus_concept_id (default 3)." ;
            sh:datatype xsd:decimal
        ]
    ] ;
    rdfs:label "Explore the concept map" ;
    iep:readOnlyHint true ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint true ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/extend-standards> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/extend-standards> ;
    hydra:method "POST" ;
    hydra:title "Extend a standard (xAPI / IEEE-LER / ADL-TLA) — afforded by the agentic-performance layer" ;
    rdfs:comment "Emergent, self-descriptive capability: an agent extends a standard IN THE FLOW OF WORK — a new xAPI context extension, an xAPI Profile fragment, or an IEEE-LER / ADL-TLA term — COMPOSING Foxxi's standards (built with Foxxi's own buildProfileDoc + served LER/TLA namespaces), never forking the spec. The agentic-performance (agp:) layer affords this; Foxxi surfaces it (the agp<->Foxxi re-integration). Returns a conformant artifact + a publishable, discoverable iep:StandardsExtension descriptor (distributed) + in-flow performance support (what it builds, how to learn it, how to teach it). Discover the learnable-capability catalog at GET /guidance." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/agent/extend-standards> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/agent/extend-standards> ;
    
    
    hydra:returns [
        a hydra:Class ;
        rdfs:label "foxxi.extend_standards-output" ;
        rdfs:comment "ProposedExtension — the new term IRI, a conformant artifact (xAPI Profile doc or Turtle term), a publishable iep:StandardsExtension descriptor, and _guidance (in-flow performance support)." ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "ok" ] ;
            hydra:required true ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "iri" ] ;
            hydra:required true ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "kind" ] ;
            hydra:required false ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "extendsStandard" ] ;
            hydra:required false ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "artifact" ] ;
            hydra:required true
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "descriptor" ] ;
            hydra:required false
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "_guidance" ] ;
            hydra:required false
        ]
    ] ;

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.extend_standards-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "kind" ] ;
            hydra:required true ;
            rdfs:comment "What to author." ;
            sh:datatype xsd:string ;
            sh:in ( "XapiContextExtension" "XapiProfileFragment" "LerTerm" "TlaTerm" )
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "name" ] ;
            hydra:required true ;
            rdfs:comment "Local slug for the new term/extension (e.g. \"collaborationDepth\")." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "definition" ] ;
            hydra:required true ;
            rdfs:comment "Human-readable definition of the new term/extension." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "label" ] ;
            hydra:required false ;
            rdfs:comment "Display label (defaults to name)." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "extends_standard" ] ;
            hydra:required false ;
            rdfs:comment "IRI of the standard being extended (defaults per kind)." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "subclass_of" ] ;
            hydra:required false ;
            rdfs:comment "For LerTerm/TlaTerm: the superclass IRI to compose onto." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "builds_capability" ] ;
            hydra:required false ;
            rdfs:comment "IRI of the agp:Capability this extension builds/demonstrates." ;
            sh:datatype xsd:string
        ]
    ] ;
    rdfs:label "Extend a standard" ;
    iep:readOnlyHint false ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint true ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/review-record> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/review-record> ;
    hydra:method "POST" ;
    hydra:title "Review your own performance record (ELR + CLR) as yourself" ;
    rdfs:comment "Review your IEEE P2997 Enterprise Learner Record + 1EdTech CLR 2.0 credential wallet, virtualized by Foxxi entirely over your OWN pod. Authenticate with a rev-196 signed-request envelope — Foxxi verifies your own signature and binds identity to the recovered did:ethr (no relay, no separate login). Defaults to your own record. HOW A COMPETENCY IS EARNED, so an empty judgement is readable before you spend a signature: a performance record counts toward a competency only if it carries a DOMAIN activity type, or asserts an outcome (success true/false). A record whose only type is a protocol envelope — AssertedContext, ProductionTask, SignedAuthorship, any *Facet — declares no skill, and auto-projected trajectory steps carry exactly that and no outcome, so any number of them yields zero competencies by design rather than by fault. The other two routes are a mastery-verb learning experience, and an alignment on a verified credential. Competence is a judgement about work; volume of work is not one. WHO IS READABLE, which is a separate question from what counts: a subject is classified from its OWN signed statements, and a subject with none classifies HUMAN, whose record is private to its holder. That is why a brand-new agent cannot be read by anybody, and it is the correct answer rather than a fault — you are what you have done. ONE authenticated performance recorded as actor_kind agent is what flips it, and from that moment the record is a PUBLIC capability record any signed caller can read by naming your DID. Nothing you declare about yourself changes this: a self-declaration would let an agent assert its way into a public class without evidence, which is the opposite of every other rule here. CROSS-POD READS: pass subject_did to read another subject's discoverable agent-capability record — on every route, including through the relay. Two fields that used to be one: subject_pod_url answers WHOSE POD AM I (stamped from your session by sign_request, and never a read target), while the record you are asking for is resolved from subject_did and, when that subject has enrolled, from the pod the enrolment register says it actually writes to. If the subject holds a pod here that its identity does not resolve to, name it with read_pod_url — that carries no authority, only selects among pods this deployment already reads, and is refused with the reason if it names anything else. Every answer reports subject.podChosenBy so you can tell which pod was read and why. A HUMAN learner record stays private to its holder; agent capability records are public." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/agent/review-record> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/agent/review-record> ;
    dcat:mediaType "application/json" ;
    
    hydra:returns [
        a hydra:Class ;
        rdfs:label "foxxi.review_record-output" ;
        rdfs:comment "Your assembled ELR (+ CLR by default) with the subject + statement-source trace. 401 when the signature/delegation does not verify." ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "ok" ] ;
            hydra:required true ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "reviewedAs" ] ;
            hydra:required false ;
            rdfs:comment "Caller DID the record was assembled for." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "authMode" ] ;
            hydra:required false ;
            rdfs:comment "How the caller identity was bound." ;
            sh:datatype xsd:string ;
            sh:in ( "direct" "delegated" )
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "self" ] ;
            hydra:required false ;
            rdfs:comment "True when the subject is the caller." ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "subject" ] ;
            hydra:required false ;
            rdfs:comment "Subject envelope: { did, podUrl, label, kind, lensTenant, statementCount, statementSource, latticeStatements }."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "elr" ] ;
            hydra:required false ;
            rdfs:comment "The assembled IEEE P2997 Enterprise Learner Record."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "clr" ] ;
            hydra:required false ;
            rdfs:comment "Verified 1EdTech CLR wallet (present unless include_clr=false)."
        ]
    ] ;

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.review_record-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "_signed_payload" ] ;
            hydra:required true ;
            rdfs:comment "JSON.stringify({ agent_id: 'did:ethr:<addr>', timestamp: <ISO 8601, within ±60s>, subject_did?, read_pod_url?, subject_pod_url?, subject_name?, actor_kind?, include_clr?, projection?: 'inline'|'links' }). DEFAULT 'links' returns the JUDGEMENT (competencies, credentials, counts — bounded by vocabulary, not by history) with evidence as hydra:Collection references carrying hydra:totalItems and a self-scoped address you can dereference with this same envelope. Pass 'inline' to embed every experience and performance record instead — that grows without bound with the subject's history and has been measured over 1.2 MB." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "read_pod_url" ] ;
            hydra:required false ;
            rdfs:comment "WHOSE RECORD AM I ASKING FOR, when the subject holds a pod that its identity does not resolve to (one wallet has both an eth-<hex> pod and a relay-mediated u-eth-<hex> one). Untrusted: it carries no authority, selects only among pods this deployment already reads, and a pod outside that space is REFUSED with the reason rather than silently swapped for a derived one. Usually unnecessary — an enrolled subject is found from subject_did alone, via the enrolment register. Distinct from subject_pod_url, which answers WHOSE POD AM I, is stamped from your session by sign_request, and is never a read target." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "_signature" ] ;
            hydra:required true ;
            rdfs:comment "secp256k1 signature over the canonical message sha256:<hex(sha256(_signed_payload))>, signed with the wallet matching agent_id." ;
            sh:datatype xsd:string
        ]
    ] ;
    rdfs:label "Review your performance record" ;
    iep:readOnlyHint true ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint true ;
    iep:appliesToCollection "profiles" ;
    iep:externallyRouted true ;
    iep:reads
        [
            a iep:EvidenceSource, dcat:Dataset ;
            rdfs:label "the subject's per-agent mesh lens (lens:<agent>)" ;
            iep:store <https://relay.interego.xwisee.com/ns/iep/store/foxxi/mesh-lens> ;
            dcat:accessURL <https://relay.interego.xwisee.com/ns/iep/store/foxxi/mesh-lens> ;
            iep:populatedBy <https://foxxi-bridge.interego.xwisee.com/agent/mesh-event> ;
            iep:admits "Trajectory steps swept from ENROLLED pods, or pushed directly to /agent/mesh-event. A step whose modal status is Hypothetical is an intention and is not evidence of performance. ADMITTED IS NOT COUNTED: a step enters this store and still earns no competency unless it carries a domain activity type or an asserted outcome — see the judgement rule in this affordance's description. An auto-projected step carries neither, so a long trajectory can produce a full performance record and an empty judgement." ;
            dct:description "Trajectory steps swept from ENROLLED pods, or pushed directly to /agent/mesh-event. A step whose modal status is Hypothetical is an intention and is not evidence of performance. ADMITTED IS NOT COUNTED: a step enters this store and still earns no competency unless it carries a domain activity type or an asserted outcome — see the judgement rule in this affordance's description. An auto-projected step carries neither, so a long trajectory can produce a full performance record and an empty judgement." ;
            iep:enrolmentRegister <https://foxxi-bridge.interego.xwisee.com/agent/mesh/enrolment>
        ] ,
        [
            a iep:EvidenceSource, dcat:Dataset ;
            rdfs:label "the shared PGSL lattice, cold-loaded from the subject's pod" ;
            iep:store <https://relay.interego.xwisee.com/ns/iep/store/foxxi/shared-lattice> ;
            dcat:accessURL <https://relay.interego.xwisee.com/ns/iep/store/foxxi/shared-lattice> ;
            iep:populatedBy <https://foxxi-bridge.interego.xwisee.com/xapi/statements> ;
            iep:admits "xAPI statement content atoms resident for this subject." ;
            dct:description "xAPI statement content atoms resident for this subject."
        ] ,
        [
            a iep:EvidenceSource, dcat:Dataset ;
            rdfs:label "durable xAPI statements recorded on the subject's own pod" ;
            iep:store <https://relay.interego.xwisee.com/ns/iep/store/foxxi/durable-pod-record> ;
            dcat:accessURL <https://relay.interego.xwisee.com/ns/iep/store/foxxi/durable-pod-record> ;
            iep:populatedBy <https://foxxi-bridge.interego.xwisee.com/xapi/statements> ;
            iep:admits "Statements durably written to the subject pod, readable without any enrolment." ;
            dct:description "Statements durably written to the subject pod, readable without any enrolment."
        ] ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/issue-credential> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/issue-credential> ;
    hydra:method "POST" ;
    hydra:title "Issue a competency credential as the authority for your vertical" ;
    rdfs:comment "Issue an Open Badges 3.0 / W3C Verifiable Credential to an agent who demonstrated a competency you defined, as the AUTHORITY for your own vertical. The credential is signed by your stable, platform-custodied issuer identity (derived from your DID), aligned to your competency, and delivered to the recipient agent's OWN pod wallet (their CLR surfaces it). Gated by your verifiable delegation (no tenant admin). Externally routed: sign_request the issuance args, then POST the envelope." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/agent/issue-credential> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/agent/issue-credential> ;
    dcat:mediaType "application/json" ;
    
    hydra:returns [
        a hydra:Class ;
        rdfs:label "foxxi.issue_credential-output" ;
        rdfs:comment "The issued OB3/W3C VC, its issuer + recipient, and the shared-lattice composition. 503 when FOXXI_ISSUER_KEY_SEED is unset; 401 on auth failure." ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "ok" ] ;
            hydra:required true ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "issuedBy" ] ;
            hydra:required false ;
            rdfs:comment "Caller DID acting as the issuing authority." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "issuerDid" ] ;
            hydra:required false ;
            rdfs:comment "Per-creator custodied issuer DID on the VC." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "credentialId" ] ;
            hydra:required false ;
            rdfs:comment "VC id." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "recipient" ] ;
            hydra:required false ;
            rdfs:comment "{ did, podUrl }."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "competency" ] ;
            hydra:required false ;
            rdfs:comment "{ id, name }."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "descriptorUrl" ] ;
            hydra:required false ;
            rdfs:comment "Published credential descriptor URL on the recipient pod." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "vc" ] ;
            hydra:required false ;
            rdfs:comment "The full signed Verifiable Credential."
        ]
    ] ;

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.issue_credential-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "_signed_payload" ] ;
            hydra:required true ;
            rdfs:comment "JSON.stringify({ agent_id, timestamp, recipient_did, recipient_pod_url?, recipient_name?, competency_name, competency_id?, competency_framework?, achievement_description?, criterion?, evidence?, justified_by? })." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "_signature" ] ;
            hydra:required true ;
            rdfs:comment "secp256k1 over sha256:<hex(sha256(_signed_payload))> by the wallet matching agent_id (relay sign_request)." ;
            sh:datatype xsd:string
        ]
    ] ;
    rdfs:label "Issue a competency credential" ;
    iep:readOnlyHint false ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint true ;
    iep:appliesToCollection "profiles" ;
    iep:externallyRouted true ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/verify-extension> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/verify-extension> ;
    hydra:method "POST" ;
    hydra:title "Independently verify a subject extended a standard (issuer due diligence)" ;
    rdfs:comment "Independently verify, from the SUBJECT's own authoritative pod records, that they (a) completed an engine-graded course and (b) recorded a domain-typed StandardsExtension performance, and that the named extension (c) conforms to the agp:StandardsExtension shape. Returns a verdict separating independently-verified evidence from any self-attested outcome — the issuer's due diligence before issue-credential. On success it composes a dereferenceable iep:Verification holon (chain of custody). Externally routed: sign_request the args, then POST the envelope." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/agent/verify-extension> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/agent/verify-extension> ;
    dcat:mediaType "application/json" ;
    
    hydra:returns [
        a hydra:Class ;
        rdfs:label "foxxi.verify_extension-output" ;
        rdfs:comment "The verification verdict + per-check evidence + (on success) the verification holon URI." ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "ok" ] ;
            hydra:required true ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "verifiedBy" ] ;
            hydra:required false ;
            rdfs:comment "Caller DID acting as verifier." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "subject" ] ;
            hydra:required false ;
            rdfs:comment "{ did, podUrl, statementCount }."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "verified" ] ;
            hydra:required false ;
            rdfs:comment "Overall verdict (independently graded ∧ performance recorded ∧ shape conformant)." ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "checks" ] ;
            hydra:required false ;
            rdfs:comment "{ independentlyGraded, gradedScore, performanceRecorded, selfAttestedPerformance, shapeConformant }."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "verificationHolonUri" ] ;
            hydra:required false ;
            rdfs:comment "Dereferenceable iep:Verification holon composed on the verifier's lattice (present only when verified)." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "evidence" ] ;
            hydra:required false ;
            rdfs:comment "Statement ids that grounded the verdict."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "note" ] ;
            hydra:required false ;
            rdfs:comment "Human-readable verdict narrative." ;
            sh:datatype xsd:string
        ]
    ] ;

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.verify_extension-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "_signed_payload" ] ;
            hydra:required true ;
            rdfs:comment "JSON.stringify({ agent_id, timestamp, subject_did, name?, kind?, definition?, subject_pod_url? }). kind defaults to XapiContextExtension; name triggers the shape-conformance check." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "_signature" ] ;
            hydra:required true ;
            rdfs:comment "sign_request signature (secp256k1 over sha256 of _signed_payload)." ;
            sh:datatype xsd:string
        ]
    ] ;
    rdfs:label "Independently verify an extension" ;
    iep:readOnlyHint false ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint true ;
    iep:appliesToCollection "profiles" ;
    iep:externallyRouted true ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/prove-competency-signed> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/prove-competency-signed> ;
    hydra:method "POST" ;
    hydra:title "Prove a competency privately end-to-end (BBS+ selective disclosure)" ;
    rdfs:comment "Holder-facing BBS+ proof, GROUNDED IN THE HOLDER'S ACTUAL RECORD: the bridge assembles the holder's learner record, refuses any competency that record does not assert (\"you can only prove a demonstrated competency, not a claimed one\"), and derives the proficiency from the published Dreyfus rollup rather than from the request. It then signs a multi-claim credential, discloses only a minimal privacy-preserving subset (issuer + achievement name + proficiency by default), and cryptographically HIDES the rest (score, dates, name, id); a verifier learns ONLY the disclosed claims. Real W3C bbs-2023 crypto. Returns a serialized `presentation` an INDEPENDENT verifier can check via foxxi.verify_presentation. Externally routed: sign_request the args as the HOLDER, then POST the envelope." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/foxxi/prove_competency> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/foxxi/prove_competency> ;
    dcat:mediaType "application/json" ;
    
    hydra:returns [
        a hydra:Class ;
        rdfs:label "foxxi.prove_competency_signed-output" ;
        rdfs:comment "The serialized BBS+ selective-disclosure presentation + which claims were revealed vs cryptographically hidden + the record evidence the proficiency was derived from. Returns { error } when the competency is not asserted in the holder's record, or when FOXXI_ISSUER_KEY_SEED is unset." ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "verified" ] ;
            hydra:required true ;
            rdfs:comment "Whether the derived proof verifies (checked at derivation time)." ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "issuerDid" ] ;
            hydra:required false ;
            rdfs:comment "Issuer DID that signed the credential." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "competencyName" ] ;
            hydra:required false ;
            rdfs:comment "The competency proved." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "totalClaims" ] ;
            hydra:required false ;
            rdfs:comment "Number of signed claims the BBS+ signature commits to." ;
            sh:datatype xsd:integer
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "revealedClaims" ] ;
            hydra:required false ;
            rdfs:comment "Disclosed { path, value } pairs — what a verifier learns."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "hiddenClaimCount" ] ;
            hydra:required false ;
            rdfs:comment "How many claims stayed behind the zero-knowledge proof." ;
            sh:datatype xsd:integer
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "hiddenClaimPaths" ] ;
            hydra:required false ;
            rdfs:comment "Claim paths cryptographically withheld."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "unknownRevealPaths" ] ;
            hydra:required false ;
            rdfs:comment "Requested reveal paths the credential does not carry, and which were therefore dropped. Non-empty here means you disclosed less than you intended."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "presentation" ] ;
            hydra:required false ;
            rdfs:comment "Serialized BBS+ presentation (base64 proof + disclosed messages + issuer public key + presentationContext) — feed directly to foxxi.verify_presentation."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "proofB64" ] ;
            hydra:required false ;
            rdfs:comment "Proof bytes alone. NOT sufficient to verify — use `presentation`." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "derivedFromRecord" ] ;
            hydra:required false ;
            rdfs:comment "The rollup this proof was grounded in: Dreyfus proficiency, confidence, the rule that produced it, and the competency IRI."
        ]
    ] ;

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.prove_competency_signed-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "_signed_payload" ] ;
            hydra:required true ;
            rdfs:comment "JSON.stringify({ agent_id, timestamp, tenant_pod_url, competency_name, learner_did?, learner_name?, course_id?, reveal_paths?, presentation_context? }). reveal_paths is an array of claim paths to disclose (default [\"issuer\",\"achievement.name\",\"achievement.proficiencyLevel\"]); any path the credential does not carry is dropped and reported back in unknownRevealPaths. presentation_context binds the proof to one occasion — a verifier MUST echo it back or the proof will not verify. NOTE: score and proficiency are NOT inputs; both are derived from the holder's record." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "_signature" ] ;
            hydra:required true ;
            rdfs:comment "sign_request signature by the holder (subject of the credential)." ;
            sh:datatype xsd:string
        ]
    ] ;
    rdfs:label "Prove a competency (BBS+)" ;
    iep:readOnlyHint false ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint true ;
    iep:appliesToCollection "profiles" ;
    iep:externallyRouted true ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/self-assert-competency> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/self-assert-competency> ;
    hydra:method "POST" ;
    hydra:title "Self-assert a competency with selective disclosure (SelfAsserted — not an authority attestation)" ;
    rdfs:comment "Mint a BBS+ credential about YOURSELF and derive a selective-disclosure presentation from it. The issuer is always the authenticated signer: this route will not issue under another party's identity, and it does not read score or proficiency from the request, so the claim carries the floor of the scale (Novice). What a verifying proof establishes here is INTEGRITY — the holder said this and cannot have altered it since — and not merit. Results carry selfIssued, trustLevel=SelfAsserted and claimsGroundedInRecord=false so a relying party can weigh them without knowing this route. For a proof grounded in a real learning record, and a proficiency derived from the published rollup, use foxxi.prove_competency instead. Externally routed: sign_request the args, then POST the envelope." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/agent/prove-competency> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/agent/prove-competency> ;
    dcat:mediaType "application/json" ;
    
    hydra:returns [
        a hydra:Class ;
        rdfs:label "foxxi.self_assert_competency-output" ;
        rdfs:comment "The serialized BBS+ presentation plus explicit provenance labels. 403 when issuer_did names a party other than the signer; 503 when FOXXI_ISSUER_KEY_SEED is unset." ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "ok" ] ;
            hydra:required true ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "holder" ] ;
            hydra:required false ;
            rdfs:comment "Holder DID — also the issuer." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "issuerDid" ] ;
            hydra:required false ;
            rdfs:comment "Issuer key, derived from the authenticated signer." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "selfIssued" ] ;
            hydra:required false ;
            rdfs:comment "Always true on this route." ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "trustLevel" ] ;
            hydra:required false ;
            rdfs:comment "Always \"SelfAsserted\"." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "claimsGroundedInRecord" ] ;
            hydra:required false ;
            rdfs:comment "Always false — the claims came from the request, not a learner record." ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "groundedAlternative" ] ;
            hydra:required false ;
            rdfs:comment "The affordance to use when the claim must be backed by evidence." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "revealed" ] ;
            hydra:required false ;
            rdfs:comment "Disclosed { path, value } pairs."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "hiddenPaths" ] ;
            hydra:required false ;
            rdfs:comment "Claim paths cryptographically withheld."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "presentation" ] ;
            hydra:required false ;
            rdfs:comment "Serialized BBS+ presentation for foxxi.verify_presentation."
        ]
    ] ;

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.self_assert_competency-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "_signed_payload" ] ;
            hydra:required true ;
            rdfs:comment "JSON.stringify({ agent_id, timestamp, competency_name, reveal? }). reveal is an array of claim paths to disclose (default [\"issuer\",\"achievement.name\",\"achievement.proficiencyLevel\"]). issuer_did, score and proficiency are NOT accepted — naming an issuer other than the signer returns 403." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "_signature" ] ;
            hydra:required true ;
            rdfs:comment "sign_request signature. The recovered signer is both the holder AND the issuer." ;
            sh:datatype xsd:string
        ]
    ] ;
    rdfs:label "Self-assert a competency (BBS+)" ;
    iep:readOnlyHint false ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint true ;
    iep:appliesToCollection "profiles" ;
    iep:externallyRouted true ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/verify-presentation> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/verify-presentation> ;
    hydra:method "POST" ;
    hydra:title "Verify a selective-disclosure BBS+ presentation" ;
    rdfs:comment "Verifier-side. Takes a presentation produced by foxxi.prove_competency; returns whether the issuer signed a credential containing exactly the disclosed claims at the disclosed positions. The verifier learns ONLY the revealed claims. Externally routed: sign_request the args (as any independent verifier), then POST the envelope." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/agent/verify-presentation> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/agent/verify-presentation> ;
    dcat:mediaType "application/json" ;
    
    hydra:returns [
        a hydra:Class ;
        rdfs:label "foxxi.verify_presentation-output" ;
        rdfs:comment "The verification result + which claims the verifier learned. 400 when the presentation envelope is malformed." ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "ok" ] ;
            hydra:required true ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "verifiedBy" ] ;
            hydra:required false ;
            rdfs:comment "Verifier DID." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "issuerDid" ] ;
            hydra:required false ;
            rdfs:comment "Issuer DID the proof attests." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "verified" ] ;
            hydra:required false ;
            rdfs:comment "Whether the BBS+ proof verified." ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "reason" ] ;
            hydra:required false ;
            rdfs:comment "Why the proof did/did not verify." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "disclosed" ] ;
            hydra:required false ;
            rdfs:comment "The claims the verifier learned."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "learned" ] ;
            hydra:required false ;
            rdfs:comment "Count of disclosed claims." ;
            sh:datatype xsd:integer
        ]
    ] ;

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.verify_presentation-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "_signed_payload" ] ;
            hydra:required true ;
            rdfs:comment "JSON.stringify({ agent_id, timestamp, presentation: { proof, disclosedIndexes, disclosedMessages, issuerPublicKey, issuerDid } }) — the presentation from foxxi.prove_competency." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "_signature" ] ;
            hydra:required true ;
            rdfs:comment "sign_request signature by the verifier." ;
            sh:datatype xsd:string
        ]
    ] ;
    rdfs:label "Verify a BBS+ presentation" ;
    iep:readOnlyHint true ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint false ;
    iep:appliesToCollection "profiles" ;
    iep:externallyRouted true ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/void-credential> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/void-credential> ;
    hydra:method "POST" ;
    hydra:title "Void (remove) a credential from your own wallet" ;
    rdfs:comment "Remove a credential you hold from your OWN pod wallet by its descriptor URL (the sourceDescriptor of a CLR entry returned by review-record). Deletes the credential resource + its graph AND rebuilds your pod manifest from actual contents, so no stale entry/ghost remains. You can only void credentials under your own pod. Externally routed: sign_request the args, then POST the envelope." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/agent/void-credential> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/agent/void-credential> ;
    dcat:mediaType "application/json" ;
    
    hydra:returns [
        a hydra:Class ;
        rdfs:label "foxxi.void_credential-output" ;
        rdfs:comment "The deletion result + manifest rebuild summary. 403 when the descriptor_url is not under your own pod." ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "ok" ] ;
            hydra:required true ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "voidedBy" ] ;
            hydra:required false ;
            rdfs:comment "Caller DID." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "descriptor" ] ;
            hydra:required false ;
            rdfs:comment "The voided descriptor URL." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "deletions" ] ;
            hydra:required false ;
            rdfs:comment "Per-resource HTTP delete status (path → status)."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "manifest" ] ;
            hydra:required false ;
            rdfs:comment "Manifest rebuild summary { written, scanned } (or \"rebuild-failed\")."
        ]
    ] ;

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.void_credential-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "_signed_payload" ] ;
            hydra:required true ;
            rdfs:comment "JSON.stringify({ agent_id, timestamp, descriptor_url, subject_pod_url? }) — descriptor_url = a CLR entry sourceDescriptor under your own pod." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "_signature" ] ;
            hydra:required true ;
            rdfs:comment "secp256k1 over sha256:<hex(sha256(_signed_payload))> by the wallet matching agent_id." ;
            sh:datatype xsd:string
        ]
    ] ;
    rdfs:label "Void a credential" ;
    iep:readOnlyHint false ;
    iep:destructiveHint true ;
    iep:idempotentHint true ;
    iep:openWorldHint true ;
    iep:appliesToCollection "profiles" ;
    iep:externallyRouted true ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/publish-encryption-key> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/publish-encryption-key> ;
    hydra:method "POST" ;
    hydra:title "Publish your X25519 encryption public key (self-sovereign)" ;
    rdfs:comment "Publish YOUR X25519 public key to your OWN pod so the bridge encrypts your canonical PGSL holons TO YOU (not just to itself) — making your recorded performances/credentials owner-readable. You generate + hold the private key; only the public key is published (to <yourpod>/keys/encryption.json). Externally routed: sign_request the args, then POST the envelope." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/agent/publish-encryption-key> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/agent/publish-encryption-key> ;
    dcat:mediaType "application/json" ;
    
    hydra:returns [
        a hydra:Class ;
        rdfs:label "foxxi.publish_encryption_key-output" ;
        rdfs:comment "Where the public key was published + the algorithm. 400 when public_key is missing." ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "ok" ] ;
            hydra:required true ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "published" ] ;
            hydra:required false ;
            rdfs:comment "URL of the published <pod>/keys/encryption.json." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "owner" ] ;
            hydra:required false ;
            rdfs:comment "Caller DID (owner of the key)." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "algorithm" ] ;
            hydra:required false ;
            rdfs:comment "X25519-XSalsa20-Poly1305." ;
            sh:datatype xsd:string
        ]
    ] ;

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.publish_encryption_key-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "_signed_payload" ] ;
            hydra:required true ;
            rdfs:comment "JSON.stringify({ agent_id, timestamp, public_key, subject_pod_url? }) — public_key is your base64 X25519 (Curve25519) public key (algorithm X25519-XSalsa20-Poly1305)." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "_signature" ] ;
            hydra:required true ;
            rdfs:comment "secp256k1 over sha256:<hex(sha256(_signed_payload))> by the wallet matching agent_id." ;
            sh:datatype xsd:string
        ]
    ] ;
    rdfs:label "Publish your encryption key" ;
    iep:readOnlyHint false ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint true ;
    iep:appliesToCollection "profiles" ;
    iep:externallyRouted true ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/course-analyze> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/course-analyze> ;
    hydra:method "POST" ;
    hydra:title "Analyze a SCORM package: fingerprint the authoring tool + build a course KG" ;
    rdfs:comment "Fingerprint WHICH authoring tool produced a SCORM package (from its imsmanifest.xml + file list/contents), build the concept/slide knowledge-graph, and compose it into a per-course PGSL lattice holon (dereferenceable + interrogable). Open + rate-limited per IP (it composes a holon on success). Externally routed (rate-limited open access, no signature)." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/agent/course/analyze> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/agent/course/analyze> ;
    dcat:mediaType "application/json" ;
    
    hydra:returns [
        a hydra:Class ;
        rdfs:label "foxxi.course_analyze-output" ;
        rdfs:comment "The authoring-tool fingerprint, the parsed course structure + concept/slide course graph, and the composed course-KG holon. 400 on missing/invalid manifest; 413 when too large; 429 on rate limit." ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "ok" ] ;
            hydra:required true ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "fingerprint" ] ;
            hydra:required false ;
            rdfs:comment "Authoring-tool fingerprint (tool, vendor, confidence, signals, standard, candidates)."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "structure" ] ;
            hydra:required false ;
            rdfs:comment "Parsed course structure (courseId, etc.)."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "course" ] ;
            hydra:required false ;
            rdfs:comment "The FoxxiAgenticCourse (concepts + slides) usable by /agent/course/ask."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "courseKg" ] ;
            hydra:required false ;
            rdfs:comment "Composed course-KG holon { label, holonUri, descriptorUrl, agentDid, reusedNodes, newNodes, stats }."
        ]
    ] ;

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.course_analyze-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "manifestXml" ] ;
            hydra:required true ;
            rdfs:comment "imsmanifest.xml text (must contain <manifest...; max 2MB)." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "fileList" ] ;
            hydra:required false ;
            rdfs:comment "Optional list of file paths in the package (capped at 5000) — strengthens fingerprinting."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "fileText" ] ;
            hydra:required false ;
            rdfs:comment "Optional map of filename → extracted text (capped) for concept extraction."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "fileContents" ] ;
            hydra:required false ;
            rdfs:comment "Optional map of filename → raw content (capped) for fingerprint signals."
        ]
    ] ;
    rdfs:label "Analyze a SCORM course" ;
    iep:readOnlyHint false ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint true ;
    iep:appliesToCollection "courses" ;
    iep:externallyRouted true ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/course-analyze-authored> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/course-analyze-authored> ;
    hydra:method "POST" ;
    hydra:title "Analyze an agent-authored course (cryptographic provenance fingerprint)" ;
    rdfs:comment "Analyze a course an agent authored via /agent/scorm/author. Because the structured course + signed authoredBy provenance is known, the \"fingerprint\" reports that ground truth (a Foxxi agent authored it) rather than sniffing a third-party tool. Resolves the course from the in-memory cache → the author's PGSL lattice → legacy pod RDF. Same response shape as foxxi.course_analyze. Externally routed (rate-limited open access)." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/agent/course/analyze-authored> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/agent/course/analyze-authored> ;
    dcat:mediaType "application/json" ;
    
    hydra:returns [
        a hydra:Class ;
        rdfs:label "foxxi.course_analyze_authored-output" ;
        rdfs:comment "The provenance fingerprint + parsed course + composed course-KG holon (authored:true). 404 when the agent-authored course is not found; 429 on rate limit." ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "ok" ] ;
            hydra:required true ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "fingerprint" ] ;
            hydra:required false ;
            rdfs:comment "Provenance fingerprint (tool: \"Foxxi (agent-authored)\", confidence 1, signed authoredBy signal)."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "structure" ] ;
            hydra:required false
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "course" ] ;
            hydra:required false ;
            rdfs:comment "The FoxxiAgenticCourse."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "courseKg" ] ;
            hydra:required false ;
            rdfs:comment "Composed course-KG holon."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "authored" ] ;
            hydra:required false ;
            rdfs:comment "Always true for this route." ;
            sh:datatype xsd:boolean
        ]
    ] ;

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.course_analyze_authored-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "courseId" ] ;
            hydra:required true ;
            rdfs:comment "The agent-authored course id (from /agent/scorm/author)." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "author_did" ] ;
            hydra:required false ;
            rdfs:comment "Author DID — used to resolve the course from the author's pod/lattice when not cached." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "course_pod" ] ;
            hydra:required false ;
            rdfs:comment "Explicit author pod URL (defaults to the author_did's resolved pod)." ;
            sh:datatype xsd:string
        ]
    ] ;
    rdfs:label "Analyze an agent-authored course" ;
    iep:readOnlyHint false ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint true ;
    iep:appliesToCollection "courses" ;
    iep:externallyRouted true ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/course-ask> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/course-ask> ;
    hydra:method "POST" ;
    hydra:title "Ask a role-framed, grounded question about an analyzed course" ;
    rdfs:comment "Grounded Q&A over a FoxxiAgenticCourse (from /agent/course/analyze*). A role (author / performance-manager / assessor / meta / learner) sets the lens; the answer stays grounded in the course knowledge-graph. Without llm_api_key it returns the retrieval scaffold (rate-limited; the caller's own LLM synthesises); with a BYOK key it runs agentic RAG synthesis. honest `grounded` flag (true only on a real graph hit). Externally routed (rate-limited; BYOK exempt)." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/agent/course/ask> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/agent/course/ask> ;
    dcat:mediaType "application/json" ;
    
    hydra:returns [
        a hydra:Class ;
        rdfs:label "foxxi.course_ask-output" ;
        rdfs:comment "The retrieval scaffold (and, with BYOK, the synthesised answer) + the honest grounding signal. 400 on missing course/question; 429 on rate limit (non-BYOK)." ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "ok" ] ;
            hydra:required true ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "role" ] ;
            hydra:required false ;
            rdfs:comment "Echo of the role lens." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "grounded" ] ;
            hydra:required false ;
            rdfs:comment "True only on a real graph hit (retrievalKind=graph with seed concepts)." ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "retrievalKind" ] ;
            hydra:required false ;
            rdfs:comment "graph | fallback — how citations were sourced." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "answer" ] ;
            hydra:required false ;
            rdfs:comment "LLM-synthesised answer (only when llm_api_key supplied)." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "retrieval" ] ;
            hydra:required false ;
            rdfs:comment "Retrieval scaffold (seed concepts, cited slides, etc.)."
        ]
    ] ;

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.course_ask-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "course" ] ;
            hydra:required true ;
            rdfs:comment "The FoxxiAgenticCourse (must have concepts[] + slides[]) from /agent/course/analyze*."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "question" ] ;
            hydra:required true ;
            rdfs:comment "Natural-language question." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "role" ] ;
            hydra:required false ;
            rdfs:comment "Lens for the answer: author | performance-manager | assessor | meta | learner." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "learnerActivity" ] ;
            hydra:required false ;
            rdfs:comment "Optional fenced learner-activity text the role can reference (treated as untrusted data)." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "llm_api_key" ] ;
            hydra:required false ;
            rdfs:comment "BYOK Anthropic key — when present, runs LLM synthesis (rate-limit exempt); when absent, returns the retrieval scaffold for the caller's own LLM." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "history" ] ;
            hydra:required false ;
            rdfs:comment "Prior conversation turns for multi-turn Q&A."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "learnerDid" ] ;
            hydra:required false ;
            rdfs:comment "Asking learner DID (recorded; defaults to urn:foxxi:demo:asker)." ;
            sh:datatype xsd:string
        ]
    ] ;
    rdfs:label "Ask about a course" ;
    iep:readOnlyHint true ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint true ;
    iep:appliesToCollection "courses" ;
    iep:externallyRouted true ;
    iep:encrypted false .

