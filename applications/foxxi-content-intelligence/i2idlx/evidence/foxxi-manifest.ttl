            hydra:property [ a rdf:Property ; rdfs:label "measured_episodes" ] ;
            hydra:required false ;
            sh:datatype xsd:integer
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "eligible_episodes" ] ;
            hydra:required false ;
            sh:datatype xsd:integer
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "ineligible_episodes" ] ;
            hydra:required false ;
            sh:datatype xsd:integer
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "distinct_reported_learners" ] ;
