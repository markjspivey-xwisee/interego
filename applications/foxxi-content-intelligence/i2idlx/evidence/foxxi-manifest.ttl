<https://relay.interego.xwisee.com/ns/iep/action/foxxi/register-tutor-agent> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/register-tutor-agent> ;
    hydra:method "POST" ;
    hydra:title "Register an AI tutor agent in the marketplace" ;
    rdfs:comment "Builds a fxa:TutorAgentProfile descriptor from your specialties + contact endpoint. WRITES NOTHING: this route is unauthenticated pure-compute and echoes your arguments back shaped as a descriptor — verified live, your pod is untouched. agent_did is NOT bound to any signer, so the descriptor asserts whatever DID you pass; what binds it to you is PUBLISHING it to your own pod with publish_context, which is signed. Once published it is discoverable, and foxxi.find_tutor_for_competency will rank it — that ranking weighs countersigned assertions, not the self-rated level, because the self-rating is yours to choose." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/foxxi/register_tutor_agent> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/foxxi/register_tutor_agent> ;
    
    

