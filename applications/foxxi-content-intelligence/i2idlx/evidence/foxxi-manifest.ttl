<https://relay.interego.xwisee.com/ns/iep/action/foxxi/write-xapi-statements-signed> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/write-xapi-statements-signed> ;
    hydra:method "POST" ;
    hydra:title "Record your own xAPI activity and preserve its native evidence" ;
    rdfs:comment "Signed transport over the standard xAPI Statements Resource, scoped to your own lens. Accepts 1–20 JSON Activity statements (128 KiB maximum), each with a UUID id, observed timestamp and actor.account.name equal to your authenticated DID. Uses the existing LRS validation, immutability and forwarding; reads back its exact enriched envelopes and awaits encrypted PGSL persistence. No attachment, SubStatement or voiding transport on this adapter. Retry identical ids/content after uncertainty; never manufacture replacement events. Does not infer competency from mere reads: choose the accurate xAPI verb/result." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/agent/xapi-statements/write> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/agent/xapi-statements/write> ;
    dcat:mediaType "application/json" ;
    
    hydra:returns [
        a hydra:Class ;
        rdfs:label "foxxi.write_xapi_statements_signed-output" ;
        rdfs:comment "200 only when accepted by the LRS and persisted to encrypted PGSL. A partial persistence failure returns 502 with lrsAccepted, statementIds and per-statement receipts so the same ids can be reconciled. Authority and stored are LRS-assigned." ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "ok" ] ;
            hydra:required true ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "lrsAccepted" ] ;
            hydra:required false ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "durable" ] ;
            hydra:required false ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "statementIds" ] ;
            hydra:required false
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "receipts" ] ;
            hydra:required false
        ]
    ] ;

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.write_xapi_statements_signed-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "_signed_payload" ] ;
            hydra:required true ;
            rdfs:comment "sign_request({ statements:[{id, actor, verb, object, timestamp, result?, context?}] }). The relay supplies agent_id and the fresh authentication timestamp. Statement timestamps describe when the observed activities happened." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "_signature" ] ;
            hydra:required true ;
            rdfs:comment "The complete signature returned by sign_request." ;
            sh:datatype xsd:string
        ]
    ] ;
