<https://relay.interego.xwisee.com/ns/iep/action/foxxi/declare-framework-alignment> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/declare-framework-alignment> ;
    hydra:method "POST" ;
    hydra:title "[admin] Declare an alignment between this tenant's competency and another tenant's" ;
    rdfs:comment "Publishes a fxa:CASEAlignment descriptor binding one of this tenant's fxk:Skill / rcd:CompetencyDefinition items to an item in a foreign tenant's framework. The alignment becomes a substrate-discoverable artifact + lifts into the next CASE 1.0 export as a CFAssociation." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/foxxi/declare_framework_alignment> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/foxxi/declare_framework_alignment> ;
    
    

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.declare_framework_alignment-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "own_item_iri" ] ;
            hydra:required true ;
            rdfs:comment "This tenant's competency IRI." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "own_item_label" ] ;
            hydra:required true ;
            rdfs:comment "Display label." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "other_item_iri" ] ;
            hydra:required true ;
            rdfs:comment "Foreign competency IRI." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "other_framework_iri" ] ;
            hydra:required true ;
            rdfs:comment "Foreign framework IRI." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "other_tenant_did" ] ;
            hydra:required false ;
            rdfs:comment "Foreign tenant DID (optional but useful for trust scoping)." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "relation" ] ;
            hydra:required true ;
            rdfs:comment "isAlignedTo | isEquivalentTo | precedes | isPrerequisiteOf | broadens | narrows." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "rationale" ] ;
            hydra:required false ;
            rdfs:comment "Free-text rationale." ;
            sh:datatype xsd:string
        ]
    ] ;
    rdfs:label "Declare framework alignment" ;
    iep:readOnlyHint false ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint true ;
    iep:encrypted false .

