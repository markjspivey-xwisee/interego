    iep:openWorldHint true ;
    iep:appliesToCollection "policies" ;
    iep:appliesToCollection "courses" ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/connect-lms> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/connect-lms> ;
