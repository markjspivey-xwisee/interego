            hydra:property [ a rdf:Property ; rdfs:label "instruction" ] ;
            hydra:required false ;
            rdfs:comment "How to proceed." ;
            sh:datatype xsd:string
        ]
    ] ;

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.scorm_launch-input" ;
