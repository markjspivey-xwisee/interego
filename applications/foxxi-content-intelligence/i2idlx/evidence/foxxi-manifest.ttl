<https://relay.interego.xwisee.com/ns/iep/action/foxxi/issue-completion-credential> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/issue-completion-credential> ;
    hydra:method "POST" ;
    hydra:title "[admin] Issue a W3C VC / Open Badges 3.0 completion credential" ;
    rdfs:comment "Mint a W3C Verifiable Credential (Open Badges 3.0-shaped) for a learner who completed a course, sign it with the tenant's deterministic Ed25519 issuer key (eddsa-jcs-2022 DataIntegrityProof), and publish it to the learner's pod in the foxxi-wallet/ container as a fxa:CourseCompletionCredential descriptor. The signed VC verifies independently with any W3C VC verifier; the descriptor is discoverable via iep:discover() filtered on dct:conformsTo." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/foxxi/issue_completion_credential> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/foxxi/issue_completion_credential> ;
    
    

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.issue_completion_credential-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "learner_did" ] ;
            hydra:required true ;
            rdfs:comment "Learner's WebID / DID — becomes credentialSubject.id on the VC." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "learner_pod_url" ] ;
            hydra:required true ;
            rdfs:comment "Learner's pod where the credential is published (typically same as tenant_pod_url for tenant-hosted wallets)." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "course_id" ] ;
            hydra:required true ;
            rdfs:comment "Course identifier (e.g. golf-explained)." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "course_title" ] ;
            hydra:required true ;
            rdfs:comment "Human-readable course title (becomes Achievement.name)." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "course_description" ] ;
            hydra:required false ;
            rdfs:comment "Optional achievement description." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "criterion_narrative" ] ;
            hydra:required false ;
            rdfs:comment "Optional natural-language statement of the completion criterion (becomes Achievement.criteria.narrative)." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "aligned_skills" ] ;
            hydra:required false ;
            rdfs:comment "Optional array of competency alignments (each: { targetCode, targetName, targetFramework?, targetFrameworkUrl?, proficiencyLevel? }). Becomes Achievement.alignment[]."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "evidence" ] ;
            hydra:required false ;
            rdfs:comment "Optional supporting evidence array (each: { type, id, narrative? }) — e.g. cited slides from a Q&A turn."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "derived_from_experiences" ] ;
            hydra:required false ;
            rdfs:comment "Optional IRIs of the raw xAPI experience records this completion was derived from. Recorded as prov:wasDerivedFrom on the credential descriptor + fxa:LearningExperience evidence on the VC, so an auditor can walk credential → raw events."
        ]
    ] ;
    rdfs:label "Issue a completion credential" ;
    iep:readOnlyHint false ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint true ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/export-clr> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
