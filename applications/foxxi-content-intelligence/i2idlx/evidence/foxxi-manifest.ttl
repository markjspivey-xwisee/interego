        a hydra:Class ;
        rdfs:label "foxxi.register_tutor_agent-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "agent_did" ] ;
            hydra:required true ;
            rdfs:comment "The tutor's DID." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "display_name" ] ;
            hydra:required true ;
            rdfs:comment "Human-readable name for the tutor agent, shown wherever it is offered as a tutor." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "specialties" ] ;
            hydra:required true ;
            rdfs:comment "Array of { frameworkIri, competencyIri, selfRatedLevel }."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "description" ] ;
            hydra:required false ;
            rdfs:comment "What this tutor agent teaches and how, shown alongside its display name." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "powered_by" ] ;
            hydra:required false ;
            rdfs:comment "e.g. claude-opus-4-7" ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "contact_endpoint" ] ;
            hydra:required false ;
            rdfs:comment "MCP server URL where the tutor agent runs." ;
            sh:datatype xsd:string
        ]
    ] ;
    rdfs:label "Register a tutor agent" ;
    iep:readOnlyHint false ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint true ;
    iep:encrypted false .

