        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "context" ] ;
            hydra:required false ;
            rdfs:comment "The passage as revised, if it changed." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "slide_id" ] ;
            hydra:required false ;
            rdfs:comment "The slide the claim is on." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "course_iri" ] ;
            hydra:required false ;
            rdfs:comment "The course the content belongs to." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "revised_by_kind" ] ;
            hydra:required false ;
            rdfs:comment "human (the default) or agent: who wrote the revision." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "note" ] ;
            hydra:required false ;
            rdfs:comment "Why, in a sentence." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "tenant_pod_url" ] ;
            hydra:required false ;
            rdfs:comment "A self-sovereign pod to run the loop on instead of the configured tenant: yours, enrolled with foxxi.register_self_sovereign_learner, whose owner you are. Omitted, the configured tenant is meant and a learning-engineer or admin role is required." ;
            sh:datatype xsd:string
        ]
    ] ;
    rdfs:label "Revise a claim" ;
    iep:readOnlyHint false ;
    iep:destructiveHint false ;
    iep:idempotentHint false ;
    iep:openWorldHint true ;
    iep:encrypted false .

