            hydra:property [ a rdf:Property ; rdfs:label "human_seed" ] ;
            hydra:required true ;
            rdfs:comment "Human admin's seed for deterministic countersign key." ;
            sh:datatype xsd:string
        ]
    ] ;
    rdfs:label "Countersign an AI assessment" ;
    iep:readOnlyHint false ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint true ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/audit-compliance-trail> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
