            hydra:required false ;
            rdfs:comment "Optional event kind, for example tool-failed." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "capture_mode" ] ;
            hydra:required false ;
            rdfs:comment "Optional live, backfill or validation observation filter." ;
            sh:datatype xsd:string ;
            sh:in ( "live" "backfill" "validation" )
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "capture_channel" ] ;
            hydra:required false ;
            rdfs:comment "Select server, client or explicit manual observations. Multiple channels may observe the same work." ;
            sh:datatype xsd:string ;
            sh:in ( "server" "client" "manual" )
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "since" ] ;
            hydra:required false ;
            rdfs:comment "Optional inclusive UTC event time, for example 2026-09-16T00:00:00Z." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "until" ] ;
            hydra:required false ;
            rdfs:comment "Optional inclusive UTC event time." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "limit" ] ;
            hydra:required false ;
            rdfs:comment "Event page size (default 50). Aggregates cover the full matching snapshot." ;
            sh:datatype xsd:integer ;
            sh:minInclusive 1 ;
            sh:maxInclusive 200
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "offset" ] ;
            hydra:required false ;
            rdfs:comment "Event page offset (default 0)." ;
            sh:datatype xsd:integer ;
            sh:minInclusive 0 ;
            sh:maxInclusive 1000000
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "view" ] ;
            hydra:required false ;
            rdfs:comment "Choose the report presentation." ;
            sh:datatype xsd:string ;
            sh:in ( "sessions" "timeline" "report" "export" )
        ]
    ] ;
    rdfs:label "Query LLM observations" ;
    iep:readOnlyHint true ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint false ;
    iep:appliesToCollection "entry" ;
    iep:appliesToCollection "profiles" ;
    iep:appliesToCollection "telemetry" ;
    iep:externallyRouted true ;
    iep:encrypted false .

