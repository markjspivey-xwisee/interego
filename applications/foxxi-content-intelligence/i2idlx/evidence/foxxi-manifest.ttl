    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/content-launch-signed> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/content-launch-signed> ;
    hydra:method "POST" ;
    hydra:title "Launch a composition for yourself and get the first step" ;
    rdfs:comment "Resolve a composition for yourself (as foxxi.content_resolve does, from your own record) and start playing it: the first step comes back as you receive it, the fragment's Markdown and rendering and its questions without their verifiers. Continue with foxxi.content_next. The same for a person and for an agent. When everything is already demonstrated or nothing admissible fills it, there is nothing to play and the reasons come back instead." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/agent/content/launch> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/agent/content/launch> ;
    dcat:mediaType "application/json" ;
    
    hydra:returns [
        a hydra:Class ;
        rdfs:label "foxxi.content_launch-output" ;
        rdfs:comment "The play session and its first step, or nothingToPlay with the reasons. 404 when the composition is not here; 400 for an invalid admission or a composition too large to resolve; 503 when the admissions you kept could not be read just now (nothing is launched without them); 401 on auth failure." ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "ok" ] ;
            hydra:required true ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "sessionId" ] ;
            hydra:required false ;
            rdfs:comment "Pass to foxxi.content_next." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "registration" ] ;
            hydra:required false ;
            rdfs:comment "The xAPI registration every statement of this play carries." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "composition" ] ;
            hydra:required false ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "learnerKind" ] ;
            hydra:required false ;
            sh:datatype xsd:string ;
            sh:in ( "human" "agent" )
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "step" ] ;
            hydra:required false ;
            rdfs:comment "{ step, of, competency, chosenBecause, fragment: its public form, bodyHtml and numbered questions }."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "nothingToPlay" ] ;
            hydra:required false ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "skipped" ] ;
            hydra:required false
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "unmet" ] ;
            hydra:required false
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "admittedBy" ] ;
            hydra:required false ;
            rdfs:comment "The admissions you kept that limited a position, as foxxi.content_resolve reports them."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "trace" ] ;
            hydra:required false
        ]
    ] ;

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.content_launch-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "_signed_payload" ] ;
            hydra:required true ;
            rdfs:comment "JSON.stringify({ agent_id, timestamp, composition: IRI, admission?: { kinds:[fragment kinds], because }, learner_kind?: human|agent })." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "_signature" ] ;
            hydra:required true ;
            rdfs:comment "sign_request signature (secp256k1 over sha256 of _signed_payload)." ;
            sh:datatype xsd:string
        ]
    ] ;
    rdfs:label "Launch a composition" ;
    iep:readOnlyHint false ;
    iep:destructiveHint false ;
    iep:idempotentHint false ;
    iep:openWorldHint true ;
    iep:appliesToCollection "courses" ;
    iep:appliesToCollection "profiles" ;
    iep:externallyRouted true ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/content-next-signed> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/content-next-signed> ;
    hydra:method "POST" ;
    hydra:title "Answer the step you are on and go on" ;
    rdfs:comment "Answer the questions of the step you are on, if it has any, and move to the next. The bridge grades graded questions against their verifiers (never your word) and records the step in your own record as xAPI: an answered statement per question, the question as an interaction activity without its correct responses, and an experienced statement for the fragment carrying the competency, position, alternatives offered and why it was chosen. A missed check brings another way in: each position that taught its competency since the last check there, and offers more than you met, gives you another of its alternatives (chosen as resolution chose, never one you were shown), then another check when the missed one's position has one, before the play goes on. Each position does this once per play. On the last step the composition is completed. Every statement follows the Foxxi xAPI profile's composition-attempt pattern. A step counts only once its record is kept: if it cannot be kept, the answers you gave stand and the next call keeps them before anything else." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/agent/content/next> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/agent/content/next> ;
    dcat:mediaType "application/json" ;
    
    hydra:returns [
        a hydra:Class ;
        rdfs:label "foxxi.content_next-output" ;
        rdfs:comment "The graded step and the next one, or the summary when done. 404 for an unknown or expired session; 403 when the session is another learner's; 422 with validationErrors when the answers cannot be taken (the step does not advance); 503 when your answers were taken but could not be kept in your record yet (call again: the answers already given are kept, and any sent with the retry are not taken); 409 while another call is recording or expected_step is stale; 400 for an invalid expected_step; 401 on auth failure. A guarded latest receipt may be replayed without recording or efficacy credit a second time." ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "ok" ] ;
            hydra:required true ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "sessionId" ] ;
            hydra:required false ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "recorded" ] ;
            hydra:required false ;
            rdfs:comment "The ids of the statements recorded for this step."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "keptEarlierAnswers" ] ;
            hydra:required false ;
            rdfs:comment "True when this call kept a step answered on an earlier call whose record could not be kept then: graded and recorded are that step's." ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "replayedReceipt" ] ;
            hydra:required false ;
            rdfs:comment "True when expected_step replayed the latest successful receipt without grading, recording or efficacy credit again." ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "graded" ] ;
            hydra:required false ;
            rdfs:comment "{ correct, total, detail:[{ question, correct: true|false|null, explanation? }] } when the step had questions."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "done" ] ;
            hydra:required false ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "step" ] ;
            hydra:required false ;
            rdfs:comment "The next step, as launch returns it."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "summary" ] ;
            hydra:required false ;
            rdfs:comment "{ steps, graded: { correct, total } } when done."
        ]
    ] ;

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.content_next-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "_signed_payload" ] ;
            hydra:required true ;
            rdfs:comment "JSON.stringify({ agent_id, timestamp, session_id, expected_step?, answers? }). expected_step is the positive one-based step.step you received; keep it unchanged on retries. Include it to replay the latest successful receipt after a lost HTTP acknowledgement without applying old answers to the next step. Receipts last only for this in-process session (up to three hours and the session capacity bound), including a guarded final step. Without it, retry only a reported pending-write failure; a successful write with a lost acknowledgement is not safely replayable. answers is one string per question of the step, in the formats foxxi.scorm_submit takes: text, a number, option letters (\"B\" or \"A, C\"), true or false, the letters of shown items in their right order, a letter per prompt for matching, a scale letter for likert, free text for long-fill-in." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "_signature" ] ;
            hydra:required true ;
            rdfs:comment "sign_request signature (secp256k1 over sha256 of _signed_payload)." ;
            sh:datatype xsd:string
        ]
    ] ;
    rdfs:label "Answer and continue" ;
    iep:readOnlyHint false ;
    iep:destructiveHint false ;
    iep:idempotentHint false ;
    iep:openWorldHint true ;
    iep:appliesToCollection "courses" ;
    iep:appliesToCollection "profiles" ;
    iep:externallyRouted true ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/xapi-author-signed> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/xapi-author-signed> ;
    hydra:method "POST" ;
    hydra:title "Author a native xAPI course as yourself" ;
    rdfs:comment "Author teaching and checks natively as content-addressed fragments and compositions, kept on your own pod. The native composition engine grades stored question verifiers and records xAPI 2.0 directly; it does not require SCORM sequencing or a SCORM manifest. The answer-safe native descriptor and HyperMarkdown launch control are readable without starting an attempt. cmi5 and SCORM remain optional projections of the same content. Externally routed: sign_request the args, then POST the envelope." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/agent/xapi/author> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/agent/xapi/author> ;
    dcat:mediaType "application/json" ;
    
    hydra:returns [
        a hydra:Class ;
        rdfs:label "foxxi.xapi_author-output" ;
        rdfs:comment "The native course content identity, author, composition, artifact links and confirmed pod persistence. Follow foxxi.content_launch with composition set to the returned @id. 400 for invalid content; 401 for failed authentication; 503 when the course could not be kept." ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "ok" ] ;
            hydra:required true ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "@id" ] ;
            hydra:required true ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "authoredBy" ] ;
            hydra:required true ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "composition" ] ;
            hydra:required false
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "modules" ] ;
            hydra:required false ;
            sh:datatype xsd:integer
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "lessons" ] ;
            hydra:required false ;
            sh:datatype xsd:integer
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "items" ] ;
            hydra:required false ;
            sh:datatype xsd:integer
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "artifacts" ] ;
            hydra:required true
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "durable" ] ;
            hydra:required false ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "sharedLattice" ] ;
            hydra:required false
        ]
    ] ;

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.xapi_author-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "_signed_payload" ] ;
            hydra:required true ;
            rdfs:comment "JSON.stringify({ agent_id, timestamp, course: { title, competency, modules:[{ title, competency?, lessons:[{ title, competency?, fragments:[{ kind, body, title?, level?, competencies?, questions?, audience?, suits?, language? }] }] }], supersedes? }, subject_pod_url? }). Each fragment uses the same form and question types as foxxi.content_fragment; omitted competencies inherit the lesson, and explicit fragment competencies must include that lesson competency (use a lesson override for another competency). Assessment-item needs a graded question; reflection and probe use only ungraded questions. At most 100 modules, 100 lessons total, and 500 fragments total; each fragment keeps the existing 20000-character and 40-question limits. No plaintext answer key is returned." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "_signature" ] ;
            hydra:required true ;
            rdfs:comment "sign_request signature (secp256k1 over sha256 of _signed_payload)." ;
            sh:datatype xsd:string
        ]
    ] ;
    rdfs:label "Author a native xAPI course" ;
    iep:readOnlyHint false ;
    iep:destructiveHint false ;
    iep:idempotentHint false ;
    iep:openWorldHint true ;
    iep:appliesToCollection "courses" ;
    iep:appliesToCollection "profiles" ;
    iep:externallyRouted true ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/scorm-author-signed> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/scorm-author-signed> ;
    hydra:method "POST" ;
    hydra:title "Author a real conformant SCORM 2004 course as yourself" ;
    rdfs:comment "Author a SCORM 2004 course as yourself. Foxxi generates a CONFORMANT imsmanifest.xml and validates it parses on the real SCORM SN runtime, then composes the full course losslessly into your shared PGSL lattice (launchable cross-restart + cross-agent). Assessment answers are hashed at author time (plaintext never touches the pod). Externally routed: sign_request the args, then POST the envelope." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/agent/scorm/author> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/agent/scorm/author> ;
    dcat:mediaType "application/json" ;
    
    hydra:returns [
        a hydra:Class ;
        rdfs:label "foxxi.scorm_author-output" ;
        rdfs:comment "The authored course summary + manifest-valid flag + shared-lattice composition. 400 on a missing/invalid course or non-parsing manifest; 401 on auth failure." ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "ok" ] ;
            hydra:required true ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "authoredBy" ] ;
            hydra:required false ;
            rdfs:comment "Caller DID." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "courseId" ] ;
            hydra:required false ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "title" ] ;
            hydra:required false ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "scoCount" ] ;
            hydra:required false ;
            sh:datatype xsd:integer
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "assessmentScos" ] ;
            hydra:required false ;
            rdfs:comment "How many SCOs carry an assessment." ;
            sh:datatype xsd:integer
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "masteryScore" ] ;
            hydra:required false ;
            sh:datatype xsd:decimal
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "manifestValid" ] ;
            hydra:required false ;
            rdfs:comment "True — the generated manifest parsed on the SN runtime." ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "durable" ] ;
            hydra:required false ;
            rdfs:comment "Pod the course was composed into." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "courseIri" ] ;
            hydra:required false ;
            sh:datatype xsd:string
        ]
    ] ;

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.scorm_author-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "_signed_payload" ] ;
            hydra:required true ;
            rdfs:comment "JSON.stringify({ agent_id, timestamp, course: { courseId, title, masteryScore?, scos:[{ id, title, body, assessment?:[question, …] }] }, subject_pod_url? }). body is Markdown (headings, lists, tables, fenced code, quotes, images and links), up to 20000 characters; at most 100 sections and 40 questions a section. Each question is { question, explanation?, … } in one of the xAPI interaction types: fill-in { answer, accept?:[other answers], caseSensitive?: true } (an answer that reads as a number is graded as one unless type is \"fill-in\"; letter case counts only with caseSensitive); numeric { answer: number, min?, max? }; choice { options:[…], answer: \"B\" or the option text, or a list when several are right }; true-false { answer: true|false }; sequencing { items:[in their right order] } (shown shuffled); matching { pairs:[[prompt, answer], …], distractors?:[…] }; likert { scale?:[…] } and long-fill-in {} are recorded, not graded. Give type when it is not plain from the fields." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "_signature" ] ;
            hydra:required true ;
            rdfs:comment "sign_request signature (secp256k1 over sha256 of _signed_payload)." ;
            sh:datatype xsd:string
        ]
    ] ;
    rdfs:label "Author a SCORM course" ;
    iep:readOnlyHint false ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint true ;
    iep:appliesToCollection "courses" ;
    iep:appliesToCollection "profiles" ;
    iep:externallyRouted true ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/scorm-launch-signed> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/scorm-launch-signed> ;
    hydra:method "POST" ;
    hydra:title "Launch a SCORM course (start an attempt on the SN engine)" ;
    rdfs:comment "Launch an authored SCORM course as yourself. The SCORM 2004 SN runtime parses the manifest, starts an attempt, and delivers the first SCO (its content +, for an assessment SCO, the questions). The course is resolved from the in-memory catalog, else loaded from the author pod (author_did/course_pod; defaults to your own pod for a self-authored course), so it survives restarts and is launchable cross-agent. Then POST /agent/scorm/submit per SCO. Externally routed: sign_request the args, then POST the envelope." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/agent/scorm/launch> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/agent/scorm/launch> ;
    dcat:mediaType "application/json" ;
    
    hydra:returns [
        a hydra:Class ;
        rdfs:label "foxxi.scorm_launch-output" ;
        rdfs:comment "The launched session id + the first delivered SCO view. 404 when the course is not found; 409 when the SN start fails; 401 on auth failure." ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "ok" ] ;
            hydra:required true ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "sessionId" ] ;
            hydra:required false ;
            rdfs:comment "SCORM play session id — pass to /agent/scorm/submit." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "launchedBy" ] ;
            hydra:required false ;
            rdfs:comment "Caller DID." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "course" ] ;
            hydra:required false ;
            rdfs:comment "{ id, title }."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "sco" ] ;
            hydra:required false ;
            rdfs:comment "The delivered SCO view: body (Markdown), bodyHtml (its safe rendering), and assessment questions { index, question, type, input: { options | items | targets | min/max }, graded } with answers withheld."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "sequencingEnded" ] ;
            hydra:required false ;
            sh:datatype xsd:boolean
        ] ,
        [
