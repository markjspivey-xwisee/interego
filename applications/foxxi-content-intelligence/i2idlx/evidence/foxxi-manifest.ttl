    hydra:target <https://foxxi-bridge.interego.xwisee.com/foxxi/confirm_content_judgment> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/foxxi/confirm_content_judgment> ;
    
    
    hydra:returns [
        a hydra:Class ;
        rdfs:label "foxxi.confirm_content_judgment-output" ;
        rdfs:comment "The outcome (answer, confirmed answer, hit, Brier) and where it was published, superseding the judgment." ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "kind" ] ;
            hydra:required true ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "outcome" ] ;
            hydra:required true
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "published" ] ;
            hydra:required true
        ]
    ] ;

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.confirm_content_judgment-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "judgment_iri" ] ;
            hydra:required true ;
            rdfs:comment "The judgment entity on the pod, as foxxi.judge_content_claim returned it in published.graphIri (urn:foxxi:judgment:<id>)." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "confirmed_answer" ] ;
            hydra:required true ;
            rdfs:comment "The answer held to be true, one of the judgment's alternatives." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
