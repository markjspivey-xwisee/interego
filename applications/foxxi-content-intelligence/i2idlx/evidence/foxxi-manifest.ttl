    hydra:title "List the compositions you made and the ones you played" ;
    rdfs:comment "List the compositions you authored and the ones you have played, to launch one (foxxi.content_launch) or read what it has learned (GET <composition IRI>/efficacy). Nothing new is kept to answer this. Played compositions are read from your own record: the last played first, whether you finished, and the latest finished score. Authored ones are read from the index of where content lives, which names each item's author; one authored as a whole (a composition, or a folded course's root) is marked root when its authoring record is still at hand. Each composition is named by this bridge's IRI for its hash. The same for a person and for an agent." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/agent/content/mine> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/agent/content/mine> ;
    dcat:mediaType "application/json" ;
    
    hydra:returns [
        a hydra:Class ;
        rdfs:label "foxxi.content_mine-output" ;
        rdfs:comment "Your compositions. 401 on auth failure." ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "ok" ] ;
            hydra:required true ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "authored" ] ;
            hydra:required false ;
            rdfs:comment "{ iri, title?, at?, root? }, authoring acts with a known time first, newest first."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "played" ] ;
            hydra:required false ;
            rdfs:comment "{ iri, title?, at, finished, score?: { raw, max } }, the last played first."
        ]
    ] ;

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.content_mine-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "_signed_payload" ] ;
            hydra:required true ;
            rdfs:comment "JSON.stringify({ agent_id, timestamp, limit? }). limit: at most how many of each, 1 to 200 (50 when left out)." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "_signature" ] ;
            hydra:required true ;
            rdfs:comment "sign_request signature (secp256k1 over sha256 of _signed_payload)." ;
            sh:datatype xsd:string
        ]
    ] ;
    rdfs:label "Your compositions" ;
    iep:readOnlyHint true ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint true ;
