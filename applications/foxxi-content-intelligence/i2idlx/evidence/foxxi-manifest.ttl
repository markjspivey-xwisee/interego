        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "_signed_payload" ] ;
            hydra:required true ;
            rdfs:comment "JSON.stringify({ agent_id, timestamp, composition: { title, competency, positions:[{ competency, demonstratedAt?: 1-5, paradigm:[fragment or composition IRIs, 1-12] }, …], supersedes? }, subject_pod_url? }). At most 100 positions. demonstratedAt is the proficiency rank (1 Novice … 5 Expert) at which a learner skips the position; the default is 3, Competent." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "_signature" ] ;
            hydra:required true ;
            rdfs:comment "sign_request signature (secp256k1 over sha256 of _signed_payload)." ;
            sh:datatype xsd:string
        ]
    ] ;
    rdfs:label "Compose content" ;
    iep:readOnlyHint false ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint true ;
    iep:appliesToCollection "courses" ;
    iep:appliesToCollection "profiles" ;
    iep:externallyRouted true ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/content-fold-course-signed> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/content-fold-course-signed> ;
    hydra:method "POST" ;
    hydra:title "Fold a course you authored, or a SCORM package hosted here, into fragments and compositions" ;
    rdfs:comment "Fold a course you authored (foxxi.scorm_author), an emergent course as POST /content/compose-course returns it, or a package hosted here (GET /scorm/packages lists them: SCORM packages, and authoring tools' own exports kept to be folded), into composable content, kept on your pod. An emergent course keeps its syntagms and paradigms, its competencies named by the very text they were written in, and its \"question ::: answer — why\" checks graded on this bridge. Each section's teaching becomes a concept fragment and its questions a check (an assessment item, or a reflection when none is graded); a section with both becomes a composition of its own, teaching then check, and the course becomes a composition of its sections in order. The questions keep their stored form, so they grade as they did in the course, and the same course folds to the same IRIs on this bridge. A package is read in the order its manifest gives: each HTML page becomes a concept fragment in Markdown (its images served from the package here), the pages in one folder a topic, and the questions the package keeps a check for their topic: calls to a Question constructor it declares, QTI items (2.x, 3.0 or 1.2) read by their declared correct response, or a question bank written as data, in a JSON file or in a script, read by its field names, graded on this bridge; a topic of more than one part becomes a composition, pages then check, and the package a composition of its topics. A package Adapt, H5P, Rise 360, Storyline, iSpring or Captivate made, or its own export (an .h5p file, an Adapt course exported as source, a Rise 360, Storyline, iSpring or Captivate course published for xAPI or the web), is read in that tool's own model instead, since its runtime draws each page from data it carries: Adapt's pages, articles and components, H5P's chapters, slides and pieces, Rise 360's lessons and blocks, Storyline's scenes and slides, iSpring's slides and quizzes, or Captivate's slides, and their questions as the tool grades them, options the tool shuffles turned so the right one is not always first. A package that holds several courses (a zip of modules, or a SCORM package whose activities include one a tool published) has each read in its tool's model, and its other activities read as any package's. Anything not read (shared templates, a page with no text of its own, a question whose answer does not fit it) is listed with why. What it makes resolves per learner (foxxi.content_resolve), plays step by step (foxxi.content_launch), and learns which explanation works once others are offered at a position. The same for a person and for an agent." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/agent/content/fold-course> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/agent/content/fold-course> ;
    dcat:mediaType "application/json" ;
    
    hydra:returns [
        a hydra:Class ;
        rdfs:label "foxxi.content_fold_course-output" ;
        rdfs:comment "The course's or package's composition, and where each section or topic went. 404 when the course or package is not here; 403 when you did not author the course; 400 naming what to fix; 422 when the package cannot be folded (no manifest, nothing with text, too large for one fold); 503 when your pod could not keep it, or when this bridge holds no key to keep anything with; 401 on auth failure." ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "ok" ] ;
            hydra:required true ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "@id" ] ;
            hydra:required false ;
            rdfs:comment "The course's composition IRI: <bridge>/ns/foxxi/composition/<sha256>. Pass it to foxxi.content_resolve or foxxi.content_launch; GET <IRI>/cmi5.xml projects it as a cmi5 course any LMS can import, and <IRI>/scorm.zip as a SCORM 2004 package." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "course" ] ;
            hydra:required false ;
            rdfs:comment "The course IRI it was folded from." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "package" ] ;
            hydra:required false ;
            rdfs:comment "The hosted package it was folded from: <bridge>/scorm/packages/<sha-256>. Kept with the bundle as derivedFrom." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "packageSha256" ] ;
            hydra:required false ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "derivedFrom" ] ;
            hydra:required false ;
            rdfs:comment "What the bundle was derived from, kept with it on your pod." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "topics" ] ;
            hydra:required false ;
            rdfs:comment "A package's topics, in order: { id, title, competency, at? (the IRI at its position), pages: [{ path, title, concept }], check?, questions }. A topic with nothing that folded has no at."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "unread" ] ;
            hydra:required false ;
            rdfs:comment "What of a package was not read or not folded, and why: [{ path, why }]."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "checks" ] ;
            hydra:required false ;
            rdfs:comment "Said when a package's questions became checks: they grade here, and are only as closed-book as the package was, which serves its answers to every browser." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "authoredBy" ] ;
            hydra:required false ;
            rdfs:comment "Caller DID." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "competency" ] ;
            hydra:required false ;
            rdfs:comment "The competency the course develops, as named or as the course itself." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "composition" ] ;
            hydra:required false
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "sections" ] ;
            hydra:required false ;
            rdfs:comment "In order: { id, title, competency, at? (the IRI at its position), concept?, check?, lesson? }. A section with neither teaching nor questions has no at."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "items" ] ;
            hydra:required false ;
            rdfs:comment "How many fragments and compositions the fold made, kept together as one bundle on your pod." ;
            sh:datatype xsd:decimal
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "durable" ] ;
            hydra:required false ;
            rdfs:comment "Pod the bundle was composed into." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "authoredStatementId" ] ;
            hydra:required false ;
            sh:datatype xsd:string
        ]
    ] ;

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.content_fold_course-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "_signed_payload" ] ;
            hydra:required true ;
            rdfs:comment "JSON.stringify({ agent_id, timestamp, course_id, competency?, section_competencies?: { <section id>: competency }, level?, language?, subject_pod_url? }), or JSON.stringify({ agent_id, timestamp, course: <an emergent course>, subject_pod_url? }), or JSON.stringify({ agent_id, timestamp, package_sha256, competency?, topic_competencies?: { <topic id>: competency }, level?, language?, subject_pod_url? }). An emergent course answers mapped: which IRIs each of its ids became, one each unless the older model gave several things one id (two lessons titled alike share one). competency is what the course or package develops: a competency IRI, another authority's term IRI, or a slug; without one, the course's or package's own IRI names it. section_competencies names a section's own where it differs, and topic_competencies a package topic's (a topic's id is its folder). level is foundational, working (default), applied or advanced; language is a BCP 47 tag." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "_signature" ] ;
            hydra:required true ;
            rdfs:comment "sign_request signature (secp256k1 over sha256 of _signed_payload)." ;
            sh:datatype xsd:string
        ]
    ] ;
    rdfs:label "Fold a course" ;
    iep:readOnlyHint false ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint true ;
    iep:appliesToCollection "courses" ;
    iep:appliesToCollection "profiles" ;
    iep:externallyRouted true ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/content-resolve-signed> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/content-resolve-signed> ;
    hydra:method "POST" ;
    hydra:title "Resolve a composition for yourself, from your own record" ;
    rdfs:comment "Resolve a composition for yourself: which fragment you are shown at each position and why. A position whose competency your record shows you have demonstrated (an Asserted competency, from performance or a credential, at the position's rank) is skipped; a training-only inference skips nothing. An admission, if given, limits each position to the forms that suit the work (the performance practice makes one from a plan); with none given, the admission you have kept for each competency (foxxi.content_admit) does, and admittedBy says which records decided anything. Among what is left, the alternative pitched nearest your level is chosen, and among those pitched equally near, the one that has worked best here for learners at your level, while one not yet tried enough still gets its turn (each fragment IRI's /efficacy shows what it has done where). Content that does not hash to its IRI is never used, and the trace says so. The same for a person and for an agent." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/agent/content/resolve> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/agent/content/resolve> ;
    dcat:mediaType "application/json" ;
    
    hydra:returns [
        a hydra:Class ;
        rdfs:label "foxxi.content_resolve-output" ;
        rdfs:comment "Your resolution. 404 when the composition is not here; 400 for an invalid admission or a composition too large to resolve; 503 when the admissions you kept could not be read just now (nothing is resolved without them); 401 on auth failure." ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "ok" ] ;
            hydra:required true ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "composition" ] ;
            hydra:required false ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "learner" ] ;
            hydra:required false ;
            rdfs:comment "Caller DID." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "learnerKind" ] ;
            hydra:required false ;
            sh:datatype xsd:string ;
            sh:in ( "human" "agent" )
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "steps" ] ;
            hydra:required false ;
            rdfs:comment "In order: { fragment (its public form, bodyHtml, numbered questions), competency, path, position, alternatives, chosenBecause, pitchedAt }. chosenBecause names the level and, when alternatives were equally near, what each has done for learners at that level."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "skipped" ] ;
            hydra:required false ;
            rdfs:comment "Positions you have demonstrated, with why."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "unmet" ] ;
            hydra:required false ;
            rdfs:comment "Positions nothing admissible could fill, with why."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "missing" ] ;
            hydra:required false ;
            rdfs:comment "Alternatives this bridge could not reach."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "admittedBy" ] ;
            hydra:required false ;
            rdfs:comment "The admissions you kept (foxxi.content_admit) that limited a position, when the request named none: { competency, admission, source?, regime?, at }."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "refused" ] ;
            hydra:required false ;
            rdfs:comment "Content refused anywhere in the resolution because it did not hash to its IRI."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "trace" ] ;
            hydra:required false ;
            rdfs:comment "Every decision, in words."
        ]
    ] ;

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.content_resolve-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "_signed_payload" ] ;
            hydra:required true ;
            rdfs:comment "JSON.stringify({ agent_id, timestamp, composition: IRI, admission?: { kinds:[fragment kinds], because }, learner_kind?: human|agent }). learner_kind defaults to human for a wallet signing for itself and agent for a delegated agent." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "_signature" ] ;
            hydra:required true ;
            rdfs:comment "sign_request signature (secp256k1 over sha256 of _signed_payload)." ;
            sh:datatype xsd:string
        ]
    ] ;
    rdfs:label "Resolve a composition" ;
    iep:readOnlyHint true ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint true ;
    iep:appliesToCollection "courses" ;
    iep:appliesToCollection "profiles" ;
    iep:externallyRouted true ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/content-admit-signed> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/content-admit-signed> ;
    hydra:method "POST" ;
    hydra:title "Keep which forms of content suit you at a competency" ;
    rdfs:comment "Keep, on your own pod, which forms of content suit you at a competency, or withdraw that. A plan made for your work (contextualize_and_plan) offers the admission it implies: a plan for Emergent work admits probes and reflection, never a lesson, and one for Turbulent work admits no content at all. The bridge never keeps a plan's consequence for you; you keep it here, and from then on foxxi.content_resolve and foxxi.content_launch admit only those forms at that competency whenever a request names no admission of its own. The latest record for a competency stands; admission: null withdraws it (and a withdrawal at a competency stands over what a composition's wider competency admits), and earlier records stay in your history. It is kept in a list of its own on your pod, sealed to the bridge and to you, and nothing counts until your pod holds it. The same for a person and for an agent." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/agent/content/admit> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/agent/content/admit> ;
    dcat:mediaType "application/json" ;
    
    hydra:returns [
        a hydra:Class ;
        rdfs:label "foxxi.content_admit-output" ;
        rdfs:comment "The record kept. 400 naming what to fix; 409 when your pod is not on this bridge's store, so resolution here could not read it back; 503 when your pod could not keep it; 401 on auth failure." ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "ok" ] ;
            hydra:required true ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "kept" ] ;
            hydra:required false ;
            rdfs:comment "{ competency, admission (null for a withdrawal), source?, regime?, at }."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "durable" ] ;
            hydra:required false ;
            rdfs:comment "Your pod, where it was kept." ;
            sh:datatype xsd:string
        ]
    ] ;

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.content_admit-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "_signed_payload" ] ;
            hydra:required true ;
            rdfs:comment "JSON.stringify({ agent_id, timestamp, competency, admission: { kinds:[fragment kinds], because } | null, source?, regime? }). competency is a competency IRI, another authority's term IRI, or a slug. source is the IRI of the plan or situation it came from; regime is Evident, Knowable, Emergent or Turbulent." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "_signature" ] ;
            hydra:required true ;
            rdfs:comment "sign_request signature (secp256k1 over sha256 of _signed_payload)." ;
            sh:datatype xsd:string
        ]
    ] ;
    rdfs:label "Keep an admission" ;
    iep:readOnlyHint false ;
    iep:destructiveHint false ;
    iep:idempotentHint false ;
    iep:openWorldHint true ;
    iep:appliesToCollection "courses" ;
    iep:appliesToCollection "profiles" ;
    iep:externallyRouted true ;
    iep:encrypted false .

