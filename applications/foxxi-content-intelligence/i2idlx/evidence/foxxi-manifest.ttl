    hydra:method "POST" ;
    hydra:title "Upload a SCORM zip package for ingestion" ;
    rdfs:comment "Upload a SCORM / cmi5 .zip. Parsed IN-PROCESS on arrival — no queue, no external runner: the manifest, course title, standard, SCO list, activity structure and authoring-tool fingerprint are read out of the zip synchronously and returned. Publishes a Hypothetical fxs:PackageUpload receipt, then — only if the parse succeeds — an Asserted fxs:ParsedPackage over the same graph that supersedes it (iep:supersedes). A zip that cannot be read returns status:failed and leaves the receipt Hypothetical: nothing is asserted about a package that could not be parsed. A parsed package is also hosted and playable: kept on the tenant pod by its sha-256 (packageSha256), served from this bridge with each document in a sandbox of its own, and registered as a cmi5 course of its SCOs (course.id); a learner plays it with the signed cmi5 launch (launch), and what it reports lands in their record as experience. An authoring tool's own export that is no SCORM package (an .h5p file, an Adapt course exported as source, or a Rise 360, Storyline, iSpring or Captivate course published for xAPI or the web) is read in its tool's model instead (exported: its tool, and the topics, pages and questions folding it reads), promoted the same way, and kept the same way by its sha-256, to be folded: it launches nothing as it is (playable:false), and the answer names the fold that takes it (fold: foxxi.content_fold_course with its package_sha256). hosted:false says why when it could not be kept." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/foxxi/upload_scorm_package> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/foxxi/upload_scorm_package> ;
    
    

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.upload_scorm_package-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "zip_base64" ] ;
            hydra:required true ;
            rdfs:comment "base64-encoded SCORM zip, or an authoring tool's own export of a course (an .h5p file, an Adapt course exported as source, or a Rise 360, Storyline, iSpring or Captivate course published for xAPI or the web)." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "hinted_title" ] ;
            hydra:required false ;
            rdfs:comment "Display name for the upload while parsing is pending." ;
            sh:datatype xsd:string
        ]
    ] ;
    rdfs:label "Upload a SCORM zip package" ;
    iep:readOnlyHint false ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint true ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/derive-adaptive-policy> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
