            hydra:property [ a rdf:Property ; rdfs:label "evaluation_id" ] ;
            hydra:required true ;
            rdfs:comment "The evaluation cohort." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "candidate_id" ] ;
            hydra:required true ;
            rdfs:comment "The candidate to decide on (from request_evaluation_enrollment)." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "decision" ] ;
            hydra:required true ;
            rdfs:comment "accept | decline." ;
            sh:datatype xsd:string
        ]
    ] ;
    rdfs:label "Decide a candidate agent" ;
    iep:readOnlyHint false ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint true ;
    iep:appliesToCollection "profiles" ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/record-external-agent-run> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/record-external-agent-run> ;
    hydra:method "POST" ;
    hydra:title "Record one completed run of an external agent (Codex, OpenClaw, Hermes, enterprise)" ;
    rdfs:comment "The one-call adapter for an EXTERNAL agent — one that does its work outside Foxxi (a Codex doing real coding, an OpenClaw or Hermes agent, a custom enterprise agent) and is therefore invisible to the trajectory layer and the ELR. Emit a single completed RUN and the bridge normalises it into a genuine agentic-native trajectory AND xAPI `performed` statements, so the run becomes visible to disposition assessment, the IEEE P2997 ELR, and — if bound to an evaluation — the portfolio read. Two input shapes: `tool_calls` (a flat list — an un-instrumented agent wires this in ~10 lines) or `steps` (the full modal / poly-granular trajectory, for an agent that already tracks intentions + counterfactual branches). Bind the run to a cohort with evaluation_id (+ optionally candidate_id)." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/foxxi/record_external_agent_run> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/foxxi/record_external_agent_run> ;
    
    

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.record_external_agent_run-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "agent_did" ] ;
            hydra:required true ;
            rdfs:comment "The external agent's DID." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "agent_name" ] ;
            hydra:required false ;
            rdfs:comment "Display name for the agent." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "task_name" ] ;
            hydra:required true ;
            rdfs:comment "What the run accomplished (becomes the xAPI Activity name)." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "task_id" ] ;
            hydra:required false ;
            rdfs:comment "Stable task identifier; derived from task_name if omitted." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "task_description" ] ;
            hydra:required false ;
            rdfs:comment "Optional longer task description." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "success" ] ;
            hydra:required true ;
            rdfs:comment "Did the run succeed overall?" ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "quality" ] ;
            hydra:required false ;
            rdfs:comment "Outcome quality 0..1." ;
            sh:datatype xsd:decimal ;
            sh:minInclusive 0 ;
            sh:maxInclusive 1
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "duration_iso" ] ;
            hydra:required false ;
            rdfs:comment "ISO 8601 duration the run took (e.g. PT12M)." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "cost_usd" ] ;
            hydra:required false ;
            rdfs:comment "Cost of the run in USD — agent-economics signal for the portfolio read." ;
            sh:datatype xsd:decimal
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "tool_calls" ] ;
            hydra:required false ;
            rdfs:comment "Simple form — a flat list of tool invocations. Each: { tool, object_name?, object_id?, success?, quality?, note? }."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "steps" ] ;
            hydra:required false ;
            rdfs:comment "Rich form — the full modal / poly-granular trajectory. Each: { modal_status, granularity, verb, object_id, object_name, id?, parent_id?, supersedes_id?, was_derived_from?[], result? }. Provide tool_calls OR steps."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "evaluation_id" ] ;
            hydra:required false ;
            rdfs:comment "Bind this run to an evaluation cohort." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "candidate_id" ] ;
            hydra:required false ;
            rdfs:comment "The candidate this run belongs to; resolved from agent_did within the evaluation if omitted." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "harness" ] ;
            hydra:required false ;
            rdfs:comment "The harness / runtime: { name?, version?, runtime? }."
        ]
    ] ;
    rdfs:label "Record an external agent run" ;
    iep:readOnlyHint false ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint true ;
    iep:appliesToCollection "profiles" ;
    iep:encrypted false .

