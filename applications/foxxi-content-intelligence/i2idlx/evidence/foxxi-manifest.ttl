    rdfs:comment "Register an external LMS (Cornerstone OnDemand, Workday Learning, SAP SuccessFactors, etc.) as a content source. Composes with src/connectors/ — uses the existing OAuth 2.0 / Basic-auth / SCORM-Cloud-API flows where supported. The connector's sync schedule is recorded as a foxxi:LmsConnection descriptor on the tenant pod with the connector's auth_warning surfaced if the credentials need rotation." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/foxxi/connect_lms> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/foxxi/connect_lms> ;
    
    

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.connect_lms-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "tenant_pod_url" ] ;
            hydra:required true ;
            rdfs:comment "Tenant pod URL." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "connector_id" ] ;
            hydra:required true ;
            rdfs:comment "Stable connector ID (e.g., \"cornerstone-prod\")." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "product" ] ;
            hydra:required true ;
            rdfs:comment "LMS product name (e.g., \"Cornerstone OnDemand\")." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "instance" ] ;
            hydra:required true ;
            rdfs:comment "LMS instance URL or domain (e.g., \"acme-training.csod.com\")." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "auth_method" ] ;
            hydra:required true ;
            rdfs:comment "Auth method (e.g., \"OAuth 2.0 (corporate)\", \"Basic+API key\")." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "sync_frequency" ] ;
            hydra:required false ;
            rdfs:comment "Human-readable sync frequency (default: \"every 6 hours\")." ;
            sh:datatype xsd:string
        ]
    ] ;
    rdfs:label "Register an external LMS connector" ;
    iep:readOnlyHint false ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint true ;
    iep:appliesToCollection "integrations" ;
