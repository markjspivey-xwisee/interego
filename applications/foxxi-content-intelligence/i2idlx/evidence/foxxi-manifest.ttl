<https://relay.interego.xwisee.com/ns/iep/action/foxxi/content-fragment-signed> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/content-fragment-signed> ;
    hydra:method "POST" ;
    hydra:title "Author a fragment of teaching or support" ;
    rdfs:comment "Author a fragment as yourself: one piece of teaching or support that compositions use by reference. Its IRI is the hash of its content, so the same content is the same fragment anywhere and nobody can change what a learner is shown under it. The body is Markdown (read as is by an agent, rendered for a person); questions take the xAPI interaction types and are stored with verifiers, never answers. It is kept on your pod's shared lattice and recorded as your authored statement; its IRI dereferences to its public form (no salt, verifier or explanation, and still checkable against the IRI)." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/agent/content/fragment> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/agent/content/fragment> ;
    dcat:mediaType "application/json" ;
    
    hydra:returns [
        a hydra:Class ;
        rdfs:label "foxxi.content_fragment-output" ;
        rdfs:comment "The fragment's IRI and public form. 400 naming what to fix when the fragment cannot be stored; 401 on auth failure." ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "ok" ] ;
            hydra:required true ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "@id" ] ;
            hydra:required false ;
            rdfs:comment "The fragment IRI: <bridge>/ns/foxxi/fragment/<sha256>. GET <IRI>/efficacy shows, for each competency and learner level it has been played at, how the learners who met it went on to do (counts appear once a cell holds 5 outcomes)." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "authoredBy" ] ;
            hydra:required false ;
            rdfs:comment "Caller DID." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "fragment" ] ;
            hydra:required false ;
            rdfs:comment "The public form: kind, level, competencies, title?, body, and each question as { question, type, input?, graded, commitment }."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "durable" ] ;
            hydra:required false ;
            rdfs:comment "Pod the fragment was composed into." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "authoredStatementId" ] ;
            hydra:required false ;
            sh:datatype xsd:string
        ]
    ] ;

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.content_fragment-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "_signed_payload" ] ;
            hydra:required true ;
            rdfs:comment "JSON.stringify({ agent_id, timestamp, fragment: { kind, level?, competencies:[competency IRI, term IRI or slug], title?, body, questions?:[question, …], audience?: human|agent, suits?:[tag], language? }, subject_pod_url? }). kind is one of concept, worked-example, video, simulation, practice-task, assessment-item (needs a graded question), job-aid, reference, context-descriptor, probe and reflection (these two take only likert or long-fill-in questions). level is foundational, working (default), applied or advanced. body is Markdown, up to 20000 characters. Questions are written as foxxi.scorm_author takes them, at most 40." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "_signature" ] ;
            hydra:required true ;
            rdfs:comment "sign_request signature (secp256k1 over sha256 of _signed_payload)." ;
            sh:datatype xsd:string
        ]
    ] ;
    rdfs:label "Author a fragment" ;
    iep:readOnlyHint false ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint true ;
    iep:appliesToCollection "courses" ;
    iep:appliesToCollection "profiles" ;
    iep:externallyRouted true ;
    iep:encrypted false .

