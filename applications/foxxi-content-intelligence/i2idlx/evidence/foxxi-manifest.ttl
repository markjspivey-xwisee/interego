<https://relay.interego.xwisee.com/ns/iep/action/foxxi/cross-confirm> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/cross-confirm> ;
    hydra:method "POST" ;
    hydra:title "[learning-engineer] Judges confirm each other: every two judges' newest judgments of one claim score each other, once" ;
    rdfs:comment "For every claim two or more judges have judged, each judge's newest judgment gets an outcome from each other judge's answer — an agent confirmation naming the peer judgment it came from — so every judge's calibration counts agreement with its peers, apart from a person's word. Idempotent: a pair already scored is skipped. A person's confirmation is still what retires a judgment from foxxi.confirm_next." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/foxxi/cross_confirm> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/foxxi/cross_confirm> ;
    
    
    hydra:returns [
        a hydra:Class ;
        rdfs:label "foxxi.cross_confirm-output" ;
        rdfs:comment "The outcomes recorded (judgment, judge, peer judge, hit, Brier), how many judgments were read and how many pairs were due." ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "kind" ] ;
            hydra:required true ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "recorded" ] ;
            hydra:required true
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "judgments" ] ;
            hydra:required false ;
            sh:datatype xsd:decimal
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "pairs" ] ;
            hydra:required false ;
            sh:datatype xsd:decimal
        ]
    ] ;

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.cross_confirm-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "tenant_pod_url" ] ;
            hydra:required false ;
            rdfs:comment "A self-sovereign pod to run the loop on instead of the configured tenant: yours, enrolled with foxxi.register_self_sovereign_learner, whose owner you are. Omitted, the configured tenant is meant and a learning-engineer or admin role is required." ;
            sh:datatype xsd:string
        ]
    ] ;
    rdfs:label "Cross-confirm judgments" ;
    iep:readOnlyHint false ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint true ;
    iep:encrypted false .

