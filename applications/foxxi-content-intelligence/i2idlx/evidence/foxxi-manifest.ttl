            sh:datatype xsd:decimal
        ]
    ] ;
    rdfs:label "Design an A/B experiment" ;
    iep:readOnlyHint true ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint false ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/judge-content-claim> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/judge-content-claim> ;
    hydra:method "POST" ;
    hydra:title "[learning-engineer] Judge a content claim with a System One model: a typed answer with probabilities, Hypothetical until confirmed" ;
    rdfs:comment "One narrow question to TypeSafe System One about a unit of course content, answered as typed probabilities rather than prose. judgment_kind evidence-level scores how well claim_text is supported by context and evidence on a five-level scale (unsupported, asserted-only, supported-by-context, supported-by-cited-evidence, corroborated); work-regime chooses among the Foxxi work regimes (Evident, Knowable, Emergent, Turbulent) for the work the content describes. Policy is code: which question is asked, what the answer means, and which controls a person is offered (cite-evidence, choose-method-for-regime, confirm-or-refute). Published to the tenant pod as a Hypothetical foxxi:ContentJudgment when the bridge has one. Needs TYPESAFE_API_KEY on the bridge (503 otherwise). Built on the shared judgment kit jev-harness proved." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/foxxi/judge_content_claim> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/foxxi/judge_content_claim> ;
    
    
    hydra:returns [
        a hydra:Class ;
        rdfs:label "foxxi.judge_content_claim-output" ;
        rdfs:comment "The judgment (answer, probabilities, confidence, model), the controls it affords, a HyperMarkdown projection, and where it was published." ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "kind" ] ;
            hydra:required true ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "judgment" ] ;
            hydra:required true
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "controls" ] ;
            hydra:required true
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "markdown" ] ;
            hydra:required false ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "published" ] ;
            hydra:required false ;
            rdfs:comment "status published | skipped | failed, with the descriptor IRI and URL when published."
        ]
    ] ;

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.judge_content_claim-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "judgment_kind" ] ;
            hydra:required true ;
            rdfs:comment "evidence-level or work-regime." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "claim_text" ] ;
            hydra:required true ;
            rdfs:comment "The claim to judge, as it appears in or about the content (at least 8 characters)." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "context" ] ;
            hydra:required false ;
            rdfs:comment "The passage the claim sits in (slide text, transcript, section); the first 6000 characters are used." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "evidence" ] ;
            hydra:required false ;
            rdfs:comment "Array of { type, id, narrative? } evidence references, as foxxi.ai_assess_competency takes them; at most 20 are used."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "course_iri" ] ;
            hydra:required false ;
            rdfs:comment "The course the content belongs to." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "slide_id" ] ;
            hydra:required false ;
            rdfs:comment "The slide the claim is on." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "concept_ids" ] ;
            hydra:required false ;
            rdfs:comment "Concept ids the claim concerns."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "tenant_pod_url" ] ;
            hydra:required false ;
            rdfs:comment "A self-sovereign pod to run the loop on instead of the configured tenant: yours, enrolled with foxxi.register_self_sovereign_learner, whose owner you are. Omitted, the configured tenant is meant and a learning-engineer or admin role is required." ;
            sh:datatype xsd:string
        ]
    ] ;
    rdfs:label "Judge a content claim" ;
    iep:readOnlyHint false ;
    iep:destructiveHint false ;
    iep:idempotentHint false ;
    iep:openWorldHint true ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/confirm-content-judgment> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/confirm-content-judgment> ;
    hydra:method "POST" ;
