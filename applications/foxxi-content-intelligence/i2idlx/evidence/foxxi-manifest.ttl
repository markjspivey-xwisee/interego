    hydra:title "[learning-engineer] Detect plateaus in a per-concept learning curve" ;
    rdfs:comment "Plots mastery-rate-per-attempt + detects plateaus (3 consecutive attempts with <1pp improvement). Returns diagnosis (rising / plateau-low / plateau-high / insufficient-data) + an actionable recommendation." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/foxxi/le_analyze_learning_curve> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/foxxi/le_analyze_learning_curve> ;
    
    

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.le_analyze_learning_curve-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "concept_id" ] ;
            hydra:required true ;
            rdfs:comment "Stable identifier of the concept whose learning curve is analysed." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "concept_label" ] ;
            hydra:required false ;
            rdfs:comment "Human-readable label for that concept, echoed in the returned analysis." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "attempts" ] ;
            hydra:required true ;
            rdfs:comment "Per-learner outcomes: array of { learnerId, attemptNumber, mastered }."
        ]
    ] ;
    rdfs:label "Analyze a learning curve" ;
    iep:readOnlyHint true ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint false ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/le-calibrate-mastery-threshold> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/le-calibrate-mastery-threshold> ;
    hydra:method "POST" ;
    hydra:title "[learning-engineer] Calibrate the cmi5 mastery threshold against downstream success" ;
    rdfs:comment "Find the score threshold that maximizes Youden's J (sensitivity + specificity − 1) against downstream prereq-dependent performance. Returns ROC curve + recommended threshold." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/foxxi/le_calibrate_mastery_threshold> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/foxxi/le_calibrate_mastery_threshold> ;
    
    

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.le_calibrate_mastery_threshold-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "records" ] ;
            hydra:required true ;
            rdfs:comment "Per-learner outcomes: array of { scoreScaled, downstreamSuccess }."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "threshold_grid" ] ;
            hydra:required false ;
            rdfs:comment "Optional thresholds to evaluate (default 0..1 step 0.05)."
        ]
    ] ;
    rdfs:label "Calibrate mastery threshold" ;
    iep:readOnlyHint true ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint false ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/le-framework-gap-analysis> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/le-framework-gap-analysis> ;
    hydra:method "POST" ;
    hydra:title "[learning-engineer] Cross-reference framework competencies against taught concepts" ;
    rdfs:comment "Finds (a) competencies in the framework with no taught concept (assessments can't be grounded) and (b) taught concepts not aligned to any competency (credentials can't reference the framework). Returns coverage % + per-direction gap lists." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/foxxi/le_framework_gap_analysis> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/foxxi/le_framework_gap_analysis> ;
    
    

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.le_framework_gap_analysis-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "framework_skills" ] ;
            hydra:required true ;
            rdfs:comment "Array of { id, label? } competency definitions."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "course_concepts" ] ;
            hydra:required true ;
            rdfs:comment "Array of CourseConcept from a published course."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "alignments" ] ;
            hydra:required true ;
            rdfs:comment "Array of { skillId, conceptId } edges."
        ]
    ] ;
    rdfs:label "Framework gap analysis" ;
    iep:readOnlyHint true ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint false ;
    iep:encrypted false .
