<https://relay.interego.xwisee.com/ns/iep/action/foxxi/scorm-submit-signed> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/scorm-submit-signed> ;
    hydra:method "POST" ;
    hydra:title "Submit the current SCO + advance (graded, committed to the SN engine)" ;
    rdfs:comment "Submit the current SCO. For an assessment SCO pass { answers:[...] } — the player GRADES them against the package answer hashes (not self-reported), commitTracking()s cmi.completion/success/score into the SN engine, and advances (Continue). When the engine sequences to the end, its ROLLUP decides pass/complete and the outcome is recorded to your ELR. If your record does not hold the outcome, the answer is a 503 carrying it, and the session stays: submit to it again, and the same statements are kept. Externally routed: sign_request the args, then POST the envelope." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/agent/scorm/submit> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/agent/scorm/submit> ;
    dcat:mediaType "application/json" ;
    
    hydra:returns [
        a hydra:Class ;
        rdfs:label "foxxi.scorm_submit-output" ;
        rdfs:comment "The next SCO (done:false) or the final rolled-up outcome (done:true) + grading detail. 404 when no play session; 403 when not your session; 409 when no current SCO; 401 on auth failure; 503 with the outcome when the attempt ended but your record does not hold it (the session stays for another submit)." ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "ok" ] ;
            hydra:required true ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "done" ] ;
            hydra:required false ;
            rdfs:comment "True when sequencing ended (final outcome present)." ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "graded" ] ;
            hydra:required false ;
            rdfs:comment "Assessment grading { score, correct, total, passed, detail:[{ question, your, correct (null when not graded), explanation? }] } (for an assessment SCO)."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "sco" ] ;
            hydra:required false ;
            rdfs:comment "The next delivered SCO view (when done:false)."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "course" ] ;
            hydra:required false ;
            rdfs:comment "{ id, title } (when done:true)."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "completed" ] ;
            hydra:required false ;
            rdfs:comment "Engine rollup completion (when done:true)." ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "passed" ] ;
            hydra:required false ;
            rdfs:comment "Engine rollup pass (when done:true)." ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "score" ] ;
            hydra:required false ;
            rdfs:comment "Rolled-up normalized score (when done:true)." ;
            sh:datatype xsd:decimal
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "recordedStatements" ] ;
            hydra:required false ;
            rdfs:comment "Count of the outcome's xAPI statements your ELR holds (when done:true)." ;
            sh:datatype xsd:integer
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "recorded" ] ;
            hydra:required false ;
            rdfs:comment "Whether your ELR holds the outcome: every statement that records it (when done:true)." ;
            sh:datatype xsd:boolean
        ]
    ] ;

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.scorm_submit-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "_signed_payload" ] ;
            hydra:required true ;
            rdfs:comment "JSON.stringify({ agent_id, timestamp, session_id, answers? }). answers is the ordered array for an assessment SCO, one string per question: fill-in its text; numeric a number; choice the option letter (\"B\") or its text, several letters joined by commas (\"A, C\"); true-false true or false; sequencing the letters of the shown items in their right order (\"C, A, B\"); matching one target letter per prompt, in prompt order (\"B, A, C\"); likert one letter; long-fill-in its text." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "_signature" ] ;
            hydra:required true ;
            rdfs:comment "sign_request signature (secp256k1 over sha256 of _signed_payload)." ;
            sh:datatype xsd:string
        ]
    ] ;
    rdfs:label "Submit a SCORM SCO" ;
    iep:readOnlyHint false ;
    iep:destructiveHint false ;
    iep:idempotentHint false ;
    iep:openWorldHint true ;
    iep:appliesToCollection "courses" ;
    iep:appliesToCollection "profiles" ;
    iep:externallyRouted true ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/read-intervention-methods> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/read-intervention-methods> ;
    hydra:method "GET" ;
    hydra:title "Read performance consulting and intervention methods" ;
    rdfs:comment "Discover the versioned consulting and management cycle and the implementation method for each intervention. Profiles carry steps, revision links, required work products and evidence criteria. Contextualize and diagnose before choosing a method; gap analysis is Knowable-only." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/performance/methods> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/performance/methods> ;
    dcat:mediaType "application/ld+json" ;
    
    hydra:returns [
        a hydra:Class ;
        rdfs:label "foxxi.read_intervention_methods-output" ;
        rdfs:comment "The JSON-LD method catalogue or selected profile. Markdown and Turtle are negotiated representations of this resource." ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "@context" ] ;
            hydra:required true ;
            rdfs:comment "Canonical methodology vocabulary bindings."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "@id" ] ;
            hydra:required true ;
            rdfs:comment "Catalogue or selected method resource." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "@graph" ] ;
            hydra:required true ;
            rdfs:comment "Profiles with steps, criteria, source guidance and revision links."
        ]
    ] ;

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.read_intervention_methods-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "method" ] ;
            hydra:required false ;
            rdfs:comment "Optional profile token or canonical IRI; omit for the catalogue. consulting is the full performance consulting and management cycle." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "format" ] ;
            hydra:required false ;
            rdfs:comment "Representation to read." ;
            sh:datatype xsd:string ;
            sh:in ( "jsonld" "markdown" "turtle" )
        ]
    ] ;
    iep:readOnlyHint true ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint false ;
    iep:externallyRouted true ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/review-method-evidence> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/review-method-evidence> ;
    hydra:method "POST" ;
    hydra:title "Check intervention method evidence coverage" ;
    rdfs:comment "Check supplied artifact pointers and notes against the selected method criteria. Returns missing-evidence or documented-unverified, coverage percent and missing work products. Does not inspect linked contents, approve quality, verify authorship, select an intervention or claim performance effects. No records are written." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/performance/methods/review> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/performance/methods/review> ;
    dcat:mediaType "application/json" ;
    
    hydra:returns [
        a hydra:Class ;
        rdfs:label "foxxi.review_method_evidence-output" ;
        rdfs:comment "Evidence-pointer coverage only; never certification or substantive quality approval." ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "method" ] ;
            hydra:required true ;
            rdfs:comment "Canonical method IRI." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "version" ] ;
            hydra:required true ;
            rdfs:comment "Reviewed method version." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "status" ] ;
            hydra:required true ;
            rdfs:comment "Coverage status, not an efficacy verdict." ;
            sh:datatype xsd:string ;
            sh:in ( "missing-evidence" "documented-unverified" )
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "coverage" ] ;
            hydra:required true ;
            rdfs:comment "Percentage of criteria with documented pointers." ;
            sh:datatype xsd:decimal
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "verified" ] ;
            hydra:required true ;
            rdfs:comment "Always false; artifact contents are not inspected." ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "criteria" ] ;
            hydra:required true ;
            rdfs:comment "Required work products and quality criteria."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "criterionResults" ] ;
            hydra:required true ;
            rdfs:comment "Per-criterion coverage and submitted pointers."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "note" ] ;
            hydra:required true ;
            rdfs:comment "Explicit review limitations." ;
            sh:datatype xsd:string
        ]
    ] ;

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.review_method_evidence-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "method" ] ;
            hydra:required true ;
            rdfs:comment "Method token or canonical IRI from the catalogue." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "evidence" ] ;
            hydra:required false ;
            rdfs:comment "Up to 200 objects, each {criterion: exact criterion IRI from the profile, artifact: absolute http/https/urn IRI, note: non-empty explanation (max 2000 characters)}. Omit or send [] to see all missing evidence. Caller approval or verification flags are rejected."
        ]
    ] ;
    iep:readOnlyHint true ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint false ;
    iep:externallyRouted true ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/ingest-content-package> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/ingest-content-package> ;
    hydra:method "POST" ;
    hydra:title "[admin] Ingest a SCORM/cmi5/xAPI content package" ;
    rdfs:comment "Unwrap a SCORM 1.2 / SCORM 2004 / cmi5 zip package, run the Foxxi storyline parser (deterministic structural rendering + Whisper-transcribed audio + concept extraction with morphology + prerequisite-edge inference), and emit three-stratum descriptors (fxs structural, fxk knowledge, fxa activity-schema) to the tenant pod. SHACL-validates against the Foxxi vocab; non-clean packages are flagged in the catalog with parse_status=\"violations\"." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/foxxi/ingest_content_package> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/foxxi/ingest_content_package> ;
    
    
    hydra:returns [
        a hydra:Class ;
        rdfs:label "foxxi.ingest_content_package-output" ;
        rdfs:comment "Result of parsing + publishing a SCORM/cmi5/xAPI content package. Emits three-stratum descriptors (fxs structural, fxk knowledge, fxa activity-schema) on the tenant pod and reports SHACL violations under parseStatus." ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "courseIri" ] ;
            hydra:required false ;
            rdfs:comment "IRI of the new fxa:CoursePackageBundle." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "catalogIri" ] ;
            hydra:required false ;
            rdfs:comment "IRI of the catalog entry updated for this course." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "parseStatus" ] ;
            hydra:required false ;
            rdfs:comment "clean = SHACL-valid; violations = catalog flagged with shape violations." ;
            sh:datatype xsd:string ;
            sh:in ( "clean" "violations" )
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "descriptorUrls" ] ;
            hydra:required false ;
            rdfs:comment "Per-stratum descriptor URLs: { structural[], knowledge[], activity[] }."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "concepts" ] ;
            hydra:required false ;
            rdfs:comment "Number of concepts extracted." ;
            sh:datatype xsd:integer
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "slides" ] ;
            hydra:required false ;
            rdfs:comment "Number of slides parsed." ;
            sh:datatype xsd:integer
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "prereqEdges" ] ;
            hydra:required false ;
            rdfs:comment "Number of prerequisite edges inferred." ;
            sh:datatype xsd:integer
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "violations" ] ;
            hydra:required false ;
            rdfs:comment "SHACL violation entries (only when parseStatus=violations)."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "note" ] ;
            hydra:required false ;
            rdfs:comment "Stub note when the Python parser has not yet been run and parsed payload is absent." ;
            sh:datatype xsd:string
        ]
    ] ;

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.ingest_content_package-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "zip_base64" ] ;
            hydra:required true ;
            rdfs:comment "Content package as base64-encoded zip." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "tenant_pod_url" ] ;
            hydra:required true ;
            rdfs:comment "Tenant pod URL where the parsed descriptors land." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "authoritative_source" ] ;
            hydra:required true ;
            rdfs:comment "DID of the content publisher (e.g., did:web:acme-training.example)." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "course_id" ] ;
            hydra:required false ;
            rdfs:comment "Stable catalog course_id (default: derived from manifest identifier)." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "lms_source" ] ;
            hydra:required false ;
            rdfs:comment "Originating LMS connector ID (default: \"Direct upload\")." ;
            sh:datatype xsd:string
        ]
    ] ;
    rdfs:label "Ingest a content package" ;
    iep:readOnlyHint false ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint true ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/publish-authoring-policy> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/publish-authoring-policy> ;
