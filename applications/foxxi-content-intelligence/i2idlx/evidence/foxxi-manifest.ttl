<https://relay.interego.xwisee.com/ns/iep/action/foxxi/record-course-completion-signed> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/record-course-completion-signed> ;
