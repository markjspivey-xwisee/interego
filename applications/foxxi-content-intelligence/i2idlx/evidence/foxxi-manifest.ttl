<https://relay.interego.xwisee.com/ns/iep/action/foxxi/discover-lrs> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/discover-lrs> ;
    hydra:method "GET" ;
    hydra:title "Find the xAPI Learning Record Store this bridge serves" ;
    rdfs:comment "Dereference the LRS's own discovery document (xAPI 2.0 §4.1.6 `about`). Returns the xAPI versions supported plus extensions naming the backend, the tenancy model, the published xAPI Profile, and the IEEE-LER / ADL-TLA spec ontologies. FROM HERE the whole standard LRS surface follows without being restated in this manifest: /xapi/statements (write, query, PUT-by-id, void), /xapi/activities, /xapi/agents, and the Activity State / Activity Profile / Agent Profile document resources — all fixed by the specification rather than by this vertical. Unauthenticated and requires no version header, by design: it is how a client discovers which versions it may then ask for. TO ACTUALLY READ OR WRITE you need Basic credentials scoped to your own lens — mint them yourself with foxxi.credentials (POST /agent/credentials), which is also what an upstream system would use to forward statements in; no admin or operator role is involved. Statements you record through foxxi.record_performance land in that same lens, so course completion and production work are queryable together." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/xapi/about> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/xapi/about> ;
    dcat:mediaType "application/json" ;
    
    hydra:returns [
        a hydra:Class ;
        rdfs:label "foxxi.discover_lrs-output" ;
        rdfs:comment "The xAPI `about` document: supported versions plus this deployment's extensions. Always 200; no authentication." ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "version" ] ;
            hydra:required true ;
            rdfs:comment "xAPI versions this LRS accepts, newest first."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "extensions" ] ;
            hydra:required false ;
            rdfs:comment "Deployment facts under the foxxi namespace — identity, bridge, pod, statementForwarding, substrateBackend, lrsBackend, multiTenant, and the dereferenceable xapiProfile / ieeeLerOntology / adlTlaOntology IRIs."
        ]
    ] ;

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.discover_lrs-input"
    ] ;
    rdfs:label "Discover the LRS" ;
    iep:readOnlyHint true ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint false ;
    iep:appliesToCollection "profiles" ;
    iep:externallyRouted true ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/discover-assigned-courses> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/discover-assigned-courses> ;
    hydra:method "POST" ;
    hydra:title "Discover assigned courses" ;
    rdfs:comment "Walk the L&D admin's policy descriptors + the learner's audience-tag membership, returning the courses currently assigned to this learner (required + suggested) with due-by dates derived from policy triggers." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/foxxi/discover_assigned_courses> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/foxxi/discover_assigned_courses> ;
    
    
    hydra:returns [
        a hydra:Class ;
        rdfs:label "foxxi.discover_assigned_courses-output" ;
        rdfs:comment "Discovered assignment list for the learner — required + suggested courses with due-by dates derived from policy triggers — plus an ABAC accessDecision trace. Returns { error, accessDecision } when the caller is not authorised to query this learner." ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "learnerWebId" ] ;
            hydra:required false ;
            rdfs:comment "Echo of the queried learner DID/WebID." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "assignments" ] ;
            hydra:required false ;
            rdfs:comment "Per-course assignment entries (courseIri, courseTitle, requirementType (required|recommended), trigger, dueAt, sourcePolicyIri)."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "audienceTagsUsed" ] ;
            hydra:required false ;
            rdfs:comment "Audience tags actually used to compute the membership (caller override OR resolved from the learner record)."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "accessDecision" ] ;
            hydra:required false ;
            rdfs:comment "ABAC trace: caller role + applied policies + allow/deny."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "error" ] ;
            hydra:required false ;
            rdfs:comment "Set when the caller cannot query this learner (forbidden); accessDecision carries the deny trace." ;
            sh:datatype xsd:string
        ]
    ] ;

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.discover_assigned_courses-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "learner_did" ] ;
            hydra:required true ;
            rdfs:comment "Learner DID (web_id pattern from the tenant identity service)." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "tenant_pod_url" ] ;
            hydra:required true ;
            rdfs:comment "Pod URL of the L&D tenant where policy descriptors live." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "audience_tags" ] ;
            hydra:required false ;
            rdfs:comment "Optional caller-supplied audience tags to override the learner's default audience membership (e.g., temporary access)."
        ]
    ] ;
    rdfs:label "Discover assigned courses" ;
    iep:readOnlyHint true ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint true ;
    iep:appliesToCollection "profiles" ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/discover-course-catalogs> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/discover-course-catalogs> ;
    hydra:method "POST" ;
    hydra:title "Discover course catalogs across pods" ;
    rdfs:comment "Every federated course catalog the given pods publish, found by its descriptor type (hyprcat:FederatedCatalog) in each pod's manifest and read back: the catalog's issuer and world, and each course as a data product with its title, category, keywords, standard, landing page and the port that fetches it. The issuer is checked against the identity the manifest attributes the descriptor to. No registry: the pods are the ones the caller names, or the tenant pod and the pods this deployment federates with. A pod that cannot be reached is reported, not fatal." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/foxxi/discover_course_catalogs> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/foxxi/discover_course_catalogs> ;
    
    
    hydra:returns [
        a hydra:Class ;
        rdfs:label "foxxi.discover_course_catalogs-output" ;
        rdfs:comment "The catalogs found, each with its pod, descriptor, issuer, whether the issuer matches the attribution, its federation peers and its products with ports; and a line per pod walked." ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "catalogs" ] ;
            hydra:required false ;
            rdfs:comment "Per catalog: iri, pod, descriptorUrl, title, issuedBy, attributedTo, issuerMatches, world, modified, federatedWith, products (iri, courseId, title, description, category, standard, keywords, landingPage, ports)."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "pods" ] ;
            hydra:required false ;
            rdfs:comment "Per pod walked: entries seen, catalogs found, unreachable when it could not be read."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "accessDecision" ] ;
            hydra:required false ;
            rdfs:comment "ABAC trace: caller role + applied policies + the decision."
        ]
    ] ;

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.discover_course_catalogs-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "pod_urls" ] ;
            hydra:required false ;
            rdfs:comment "The pods to walk; omitted, the tenant pod and this deployment's federation peers." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "tenant_pod_url" ] ;
            hydra:required false ;
            rdfs:comment "The tenant the caller belongs to; omitted, the configured tenant." ;
            sh:datatype xsd:string
        ]
    ] ;
    rdfs:label "Discover course catalogs" ;
    iep:readOnlyHint true ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint true ;
    iep:appliesToCollection "catalog" ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/earned-credentials> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/earned-credentials> ;
    hydra:method "POST" ;
    hydra:title "Where every assigned course stands" ;
    rdfs:comment "For each course assigned to the learner: credentialed (a verified, unexpired completion credential in their pod wallet), claimable (their own xAPI record demonstrates mastery — a passed, mastered, satisfied or waived statement about the course with success not false and any score at or above the course's threshold, graded by this bridge itself — and no credential is in force), in progress (statements about the course, none demonstrating mastery), or not started. The claimable ones carry the foxxi.claim_credential call; a lapsed credential is named. Reads the learner's own record (shared lattice, lens and durable records) and wallet. A learner asks about themselves; an admin about anyone." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/foxxi/earned_credentials> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/foxxi/earned_credentials> ;
    
    
    hydra:returns [
        a hydra:Class ;
        rdfs:label "foxxi.earned_credentials-output" ;
        rdfs:comment "The learner's standing per assigned course, the claimable ones first, with the credential held or lapsed and the evidence counts, plus an ABAC accessDecision trace." ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "learner" ] ;
            hydra:required false ;
            rdfs:comment "The learner the standings are about." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "learnerPodUrl" ] ;
            hydra:required false ;
            rdfs:comment "The pod the record and the wallet were read from." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "standings" ] ;
            hydra:required false ;
            rdfs:comment "Per course: courseId, courseTitle, state (credentialed | claimable | in-progress | not-started), dueAt, credential, lapsed, statements, mastery, and for a claimable course the claim call."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "held" ] ;
            hydra:required false ;
            rdfs:comment "How many credentials the wallet holds." ;
            sh:datatype xsd:integer
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "accessDecision" ] ;
            hydra:required false ;
            rdfs:comment "ABAC trace: caller role + applied policies + the decision."
        ]
    ] ;

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.earned_credentials-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "learner_did" ] ;
            hydra:required false ;
            rdfs:comment "The learner's WebID; omitted, the caller. An admin may name any learner." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "learner_pod_url" ] ;
            hydra:required false ;
            rdfs:comment "The learner's pod when it is not derived from their identity; bounded to the pod space this deployment reads." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "tenant_pod_url" ] ;
            hydra:required false ;
            rdfs:comment "The tenant whose catalog and assignments apply; omitted, the configured tenant." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "audience_tags" ] ;
            hydra:required false ;
            rdfs:comment "Audience tags to resolve the assignments with, for a learner the tenant directory does not list." ;
            sh:datatype xsd:string
        ]
    ] ;
    rdfs:label "Where every assigned course stands" ;
    iep:readOnlyHint true ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint true ;
    iep:appliesToCollection "profiles" ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/claim-credential> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/claim-credential> ;
    hydra:method "POST" ;
    hydra:title "Claim a credential the record has earned" ;
    rdfs:comment "The tenant issues an Open Badges 3.0 completion credential for a catalog course only from the learner's own record: a passed, mastered, satisfied or waived xAPI statement about the course, with success not false and any score at or above the course's threshold, and graded by this bridge itself: the SCORM engine's completions carry the bridge's grading tag, so a statement the learner recorded is in the record but does not earn a credential. The credential names that evidence, is signed by the tenant's issuer key, is valid for a year, and is written to the learner's pod wallet; a credentialed statement joins their record. Already held and in force: the held credential comes back and nothing is issued. Not earned: a 409 refusal saying what statement would earn it. A learner claims for themselves; an admin may claim for a learner." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/foxxi/claim_credential> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/foxxi/claim_credential> ;
    
    
    hydra:returns [
        a hydra:Class ;
        rdfs:label "foxxi.claim_credential-output" ;
        rdfs:comment "The decision: issued (credentialId, descriptorUrl, graphUrl, issuer, validUntil, the evidence statements, the signed vc, the credentialed statement id) or already-held (the credential in force); a refusal with status 409 when the record has not earned it, saying what would." ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "decision" ] ;
            hydra:required false ;
            rdfs:comment "issued | already-held" ;
            sh:datatype xsd:string ;
            sh:in ( "issued" "already-held" )
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "courseId" ] ;
            hydra:required false ;
            rdfs:comment "The catalog course the credential is for." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "credentialId" ] ;
            hydra:required false ;
            rdfs:comment "The credential's id: its own dereferenceable descriptor location on the learner's pod." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "descriptorUrl" ] ;
            hydra:required false ;
            rdfs:comment "Where the credential descriptor was published in the wallet." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "validUntil" ] ;
            hydra:required false ;
            rdfs:comment "When the issued credential expires (ISO 8601)." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "evidence" ] ;
            hydra:required false ;
            rdfs:comment "The mastery statements the credential names: id, verb, object, timestamp, scoreScaled, success."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "credential" ] ;
            hydra:required false ;
            rdfs:comment "For already-held: the credential in force (id, descriptorUrl, achievementId, issuer, validFrom, validUntil, verified)."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "vc" ] ;
            hydra:required false ;
            rdfs:comment "The signed Open Badges 3.0 credential as issued."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "accessDecision" ] ;
            hydra:required false ;
            rdfs:comment "ABAC trace: caller role + applied policies + the decision."
        ]
    ] ;

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.claim_credential-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "course_id" ] ;
            hydra:required true ;
            rdfs:comment "The tenant catalog course id the credential is for." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "learner_did" ] ;
            hydra:required false ;
            rdfs:comment "The learner's WebID; omitted, the caller. An admin may name any learner." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "learner_pod_url" ] ;
            hydra:required false ;
            rdfs:comment "The learner's pod when it is not derived from their identity; bounded to the pod space this deployment reads." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "tenant_pod_url" ] ;
            hydra:required false ;
            rdfs:comment "The tenant whose catalog applies and whose issuer signs; omitted, the configured tenant." ;
            sh:datatype xsd:string
        ]
    ] ;
    rdfs:label "Claim a credential the record has earned" ;
    iep:readOnlyHint false ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint true ;
    iep:appliesToCollection "profiles" ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/verify-credential> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/verify-credential> ;
    hydra:method "POST" ;
    hydra:title "Verify a credential" ;
    rdfs:comment "What a relying party should check before believing an Open Badges 3.0 credential: the Data Integrity proof verifies against the issuer's key and the proof's key is the stated issuer; validUntil has not passed and validFrom has; the issuer is one this tenant stands behind (its own issuer key); the credential names its subject. Answers every check and, in words, what each failed one found. Give the credential's link in its holder's wallet and the bridge reads the exact bytes that were signed; a pasted copy is only as good as whoever copied it, and an agent that retypes a credential can change it. No caller identity is needed: anyone may verify." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/foxxi/verify_credential> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/foxxi/verify_credential> ;
    
    
    hydra:returns [
        a hydra:Class ;
        rdfs:label "foxxi.verify_credential-output" ;
        rdfs:comment "Whether the credential is valid here, each check (signature, notExpired, inForce, issuerTrusted, subjectBound), what the credential says (issuer, subject, achievement, validFrom, validUntil), and the notes for the checks that failed." ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "valid" ] ;
            hydra:required false ;
            rdfs:comment "Every check passed." ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "checks" ] ;
            hydra:required false ;
            rdfs:comment "signature, notExpired, inForce, issuerTrusted, subjectBound: each true or false."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "issuer" ] ;
            hydra:required false ;
            rdfs:comment "The stated issuer DID." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "subject" ] ;
            hydra:required false ;
            rdfs:comment "The credential subject." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "achievement" ] ;
            hydra:required false ;
            rdfs:comment "The achievement's id and name, when present."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "notes" ] ;
            hydra:required false ;
            rdfs:comment "What each failed check found, in words."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "trustedIssuers" ] ;
            hydra:required false ;
            rdfs:comment "How many issuers this verifier stands behind." ;
            sh:datatype xsd:integer
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "readFrom" ] ;
            hydra:required false ;
            rdfs:comment "The link the credential was read from, when one was given." ;
            sh:datatype xsd:string
        ]
    ] ;

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.verify_credential-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "credential_url" ] ;
            hydra:required false ;
            rdfs:comment "A link to the credential in its holder's wallet on this deployment's pod store: its wallet descriptor (the credential's id, as a claim returns it) or the graph beside it. Preferred: nothing is retyped. Give this or credential." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "credential" ] ;
            hydra:required false ;
            rdfs:comment "The credential JSON, with its Data Integrity proof, when there is no link to it. Give this or credential_url."
        ]
    ] ;
    rdfs:label "Verify a credential" ;
    iep:readOnlyHint true ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint false ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/earned-credentials-signed> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/earned-credentials-signed> ;
    hydra:method "POST" ;
    hydra:title "Where my courses stand, signed as myself" ;
    rdfs:comment "foxxi.earned_credentials for the courses this bridge's SCORM engine grades, signed the way the engine's own routes are: by your wallet, or by an agent holding your delegation (a relay connection, such as a Claude connector). Reads your own record and wallet — the pod the signature derives, never one you name — and reports each course your record is about, and any you list in course_ids: credentialed, claimable (with the claim to make), in progress, or not started. Externally routed: sign_request the args, then POST the envelope." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/agent/credentials/earned> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/agent/credentials/earned> ;
    dcat:mediaType "application/json" ;
    
    hydra:returns [
        a hydra:Class ;
        rdfs:label "foxxi.earned_credentials_signed-output" ;
        rdfs:comment "Your standing per course, the claimable ones first, each claimable one with the claim to make. 401 on auth failure." ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "learner" ] ;
            hydra:required false ;
            rdfs:comment "Who the standings are about: your wallet DID, or the person your delegation names." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "via" ] ;
            hydra:required false ;
            rdfs:comment "The agent that signed for you, when it was a delegation." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "learnerPodUrl" ] ;
            hydra:required false ;
            rdfs:comment "The pod the record and the wallet were read from." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "standings" ] ;
            hydra:required false ;
            rdfs:comment "Per course: courseId, courseTitle, state (credentialed | claimable | in-progress | not-started), credential, lapsed, statements, mastery, and for a claimable course the claim (affordance, target, payload)."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "held" ] ;
            hydra:required false ;
            rdfs:comment "How many credentials the wallet holds." ;
            sh:datatype xsd:integer
        ]
    ] ;

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.earned_credentials_signed-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "_signed_payload" ] ;
            hydra:required true ;
            rdfs:comment "JSON.stringify({ agent_id, timestamp, course_ids? })." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "_signature" ] ;
            hydra:required true ;
            rdfs:comment "sign_request signature (secp256k1 over sha256 of _signed_payload)." ;
            sh:datatype xsd:string
        ]
    ] ;
    rdfs:label "Where my courses stand" ;
    iep:readOnlyHint true ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint true ;
    iep:appliesToCollection "profiles" ;
    iep:externallyRouted true ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/claim-credential-signed> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/claim-credential-signed> ;
    hydra:method "POST" ;
    hydra:title "Claim a credential the record earned, signed as myself" ;
    rdfs:comment "foxxi.claim_credential for a course this bridge's SCORM engine grades, signed by your wallet or by an agent holding your delegation (a relay connection, such as a Claude connector). The tenant issues an Open Badges 3.0 completion credential only from your own record — a passed, mastered, satisfied or waived statement about the course with success not false and any score at or above its threshold, graded by this bridge (the engine's results carry its grading tag; a statement you wrote yourself is in the record but is not evidence). The credential names that evidence and the course's author, is signed by the tenant's issuer key, is valid for a year, and is written to your pod's wallet; a delegated claim is issued to the person the delegation names. Already held and in force: the held credential comes back. Not earned: 409 saying what would earn it. Externally routed: sign_request the args, then POST the envelope." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/agent/credentials/claim> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/agent/credentials/claim> ;
    dcat:mediaType "application/json" ;
    
    hydra:returns [
        a hydra:Class ;
        rdfs:label "foxxi.claim_credential_signed-output" ;
        rdfs:comment "issued (credentialId, descriptorUrl, graphUrl, issuer, validUntil, evidence, courseAuthor, vc) or already-held (credential). 409 when your record has not earned it, saying what would; 404 for a course the engine does not play; 401 on auth failure." ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "decision" ] ;
            hydra:required false ;
            rdfs:comment "issued | already-held" ;
            sh:datatype xsd:string ;
            sh:in ( "issued" "already-held" )
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "courseId" ] ;
            hydra:required false ;
            rdfs:comment "The course the credential is for." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "credentialId" ] ;
            hydra:required false ;
            rdfs:comment "The credential's id: its own descriptor location on your pod." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "descriptorUrl" ] ;
            hydra:required false ;
            rdfs:comment "Where the credential descriptor was published in your wallet." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "learner" ] ;
            hydra:required false ;
            rdfs:comment "Who the credential names: your wallet DID, or the person your delegation names." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "courseAuthor" ] ;
            hydra:required false ;
            rdfs:comment "Who authored the course, as the credential's criteria also say." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "vc" ] ;
            hydra:required false ;
            rdfs:comment "The signed Open Badges 3.0 credential as issued."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "credential" ] ;
            hydra:required false ;
            rdfs:comment "For already-held: the credential in force."
        ]
    ] ;

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.claim_credential_signed-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "_signed_payload" ] ;
            hydra:required true ;
            rdfs:comment "JSON.stringify({ agent_id, timestamp, course_id })." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "_signature" ] ;
            hydra:required true ;
            rdfs:comment "sign_request signature (secp256k1 over sha256 of _signed_payload)." ;
            sh:datatype xsd:string
        ]
    ] ;
    rdfs:label "Claim an earned credential" ;
    iep:readOnlyHint false ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint true ;
    iep:appliesToCollection "profiles" ;
    iep:externallyRouted true ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/cmi5-launch-signed> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/cmi5-launch-signed> ;
    hydra:method "POST" ;
    hydra:title "Launch a cmi5 activity for myself" ;
    rdfs:comment "Launch an Assignable Unit of a cmi5 course published on this bridge, for yourself, signed by your wallet or by an agent holding your delegation (a relay connection, such as a Claude connector). The launch is for the signer and nobody else. The LMS stages LMS.LaunchData in the State resource and returns the conformant launch URL; the AU fetches its auth-token once. Its statements, and the `satisfied` the LMS records when they meet moveOn, land in your own record and are kept on your pod, where your IEEE P2997 learner record reads them. They count as experience, not as graded evidence for a credential: a cmi5 AU reports its own result. Without au_id, the first AU you have not satisfied; sequential progression is enforced (409 names the AU that comes first). Externally routed: sign_request the args, then POST the envelope." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/agent/cmi5/launch> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/agent/cmi5/launch> ;
    dcat:mediaType "application/json" ;
    
    hydra:returns [
        a hydra:Class ;
        rdfs:label "foxxi.cmi5_launch_signed-output" ;
        rdfs:comment "The launch: registration, launchUrl, actor, and the AU with its moveOn. 404 for a course or AU this bridge does not publish; 409 when an earlier AU is not yet satisfied; 401 on auth failure." ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "registration" ] ;
            hydra:required false ;
            rdfs:comment "The cmi5 registration this launch opened." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "launchUrl" ] ;
            hydra:required false ;
            rdfs:comment "The conformant cmi5 launch URL: open it to run the AU." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "actor" ] ;
            hydra:required false ;
            rdfs:comment "The xAPI Agent the AU records as: you."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "auId" ] ;
            hydra:required false ;
            rdfs:comment "The AU launched." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "moveOn" ] ;
            hydra:required false ;
            rdfs:comment "The criterion the LMS applies before recording satisfied." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "launchDataStaged" ] ;
            hydra:required false ;
            rdfs:comment "LMS.LaunchData is in the State resource for the AU to read." ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "progress" ] ;
            hydra:required false ;
            rdfs:comment "Where the registration's moveOn state can be read." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "learner" ] ;
            hydra:required false ;
            rdfs:comment "Who the launch is for: your wallet DID, or the person your delegation names." ;
            sh:datatype xsd:string
        ]
    ] ;

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.cmi5_launch_signed-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "_signed_payload" ] ;
            hydra:required true ;
            rdfs:comment "JSON.stringify({ agent_id, timestamp, course_id, au_id?, return_url? }): the published course, optionally the AU, optionally where the AU returns you." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "_signature" ] ;
            hydra:required true ;
            rdfs:comment "sign_request signature (secp256k1 over sha256 of _signed_payload)." ;
            sh:datatype xsd:string
        ]
    ] ;
    rdfs:label "Launch a cmi5 activity" ;
    iep:readOnlyHint false ;
    iep:destructiveHint false ;
    iep:idempotentHint false ;
    iep:openWorldHint true ;
    iep:appliesToCollection "profiles" ;
    iep:externallyRouted true ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/lti-launch-signed> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/lti-launch-signed> ;
    hydra:method "POST" ;
    hydra:title "Launch a course from Foxxi's own LMS over LTI 1.3" ;
    rdfs:comment "Launch a course this bridge's SCORM engine grades from Foxxi's own LMS, the LTI 1.3 Platform this bridge runs beside its Tool, for yourself, signed by your wallet or by an agent holding your delegation (a relay connection, such as a Claude connector). The LMS knows who you are from the signature and returns an initiation URL, used once within five minutes. From there it is a standard launch over HTTP: the Tool's OIDC login, the LMS's authorization, a signed id_token posted to the Tool, then the course. A browser does all of it; a client without one follows the redirects, asks the authorization step for JSON, posts the form it returns, and plays the course as JSON. When the attempt ends the SCORM engine's outcome is in your record, where your IEEE P2997 learner record reads it, and the Tool posts your grade to the LMS gradebook over Assignment and Grade Services (foxxi.lti_gradebook_signed reads it). Externally routed: sign_request the args, then POST the envelope." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/agent/lti/launch> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/agent/lti/launch> ;
    dcat:mediaType "application/json" ;
    
    hydra:returns [
        a hydra:Class ;
        rdfs:label "foxxi.lti_launch_signed-output" ;
        rdfs:comment "The launch: the initiation URL, the LMS course context, the resource link and its gradebook line item. 404 for a course this bridge does not grade; 429 when rate limited; 401 on auth failure." ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "initiationUrl" ] ;
            hydra:required false ;
            rdfs:comment "The OIDC third-party-initiated login at the Tool: open it once, within five minutes." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "expiresAt" ] ;
            hydra:required false ;
            rdfs:comment "When the launch can no longer be started." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "platform" ] ;
            hydra:required false ;
            rdfs:comment "The LMS: its issuer and its OpenID configuration."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "lineItem" ] ;
            hydra:required false ;
            rdfs:comment "The gradebook column the grade is posted to."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "learner" ] ;
            hydra:required false ;
            rdfs:comment "Who the launch is for: your wallet DID, or the person your delegation names. It is the LTI sub." ;
            sh:datatype xsd:string
        ]
    ] ;

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.lti_launch_signed-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "_signed_payload" ] ;
            hydra:required true ;
            rdfs:comment "JSON.stringify({ agent_id, timestamp, course_id }): a course this bridge's SCORM engine grades." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "_signature" ] ;
            hydra:required true ;
            rdfs:comment "sign_request signature (secp256k1 over sha256 of _signed_payload)." ;
            sh:datatype xsd:string
        ]
    ] ;
    rdfs:label "Launch a course over LTI" ;
    iep:readOnlyHint false ;
    iep:destructiveHint false ;
    iep:idempotentHint false ;
    iep:openWorldHint true ;
    iep:appliesToCollection "profiles" ;
    iep:externallyRouted true ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/lti-gradebook-signed> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
