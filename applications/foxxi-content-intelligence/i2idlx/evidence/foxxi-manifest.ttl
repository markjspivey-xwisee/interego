<https://relay.interego.xwisee.com/ns/iep/action/foxxi/course-analyze-skill> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/course-analyze-skill> ;
