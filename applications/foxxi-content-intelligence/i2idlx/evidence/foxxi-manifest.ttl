        a hydra:Class ;
        rdfs:label "foxxi.open_agent_evaluation-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "name" ] ;
            hydra:required true ;
            rdfs:comment "Human-readable name for the evaluation cohort." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "decision_question" ] ;
            hydra:required true ;
            rdfs:comment "The decision this cohort exists to inform — e.g. \"Which coding-agent harness should the platform team adopt — or should we keep more than one?\"." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "task_set" ] ;
            hydra:required false ;
            rdfs:comment "Optional shared task set for apples-to-apples comparison. Each: { name, id?, description? } (a plain string is accepted as a task name)."
        ]
    ] ;
    rdfs:label "Open an agent evaluation cohort" ;
    iep:readOnlyHint false ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint true ;
    iep:appliesToCollection "profiles" ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/request-evaluation-enrollment> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/request-evaluation-enrollment> ;
    hydra:method "POST" ;
    hydra:title "Request enrollment of an agent into an evaluation cohort (cross-pod delegation)" ;
    rdfs:comment "A team requests that its agent / harness join an evaluation cohort as a candidate. The candidate agent is identified by its own DID — which may live on a different team's pod — so enrolling it is a cross-pod delegation: the request starts as `requested` and does not enter the comparison until the evaluation owner accepts it (foxxi.decide_evaluation_candidate). This request → accept handshake is the delegation grant. Records the team, and the harness/runtime the agent is built on, so the portfolio read can attribute behaviour to the harness." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/foxxi/request_evaluation_enrollment> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/foxxi/request_evaluation_enrollment> ;
    
    

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.request_evaluation_enrollment-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "evaluation_id" ] ;
            hydra:required true ;
            rdfs:comment "The evaluation cohort to enrol into." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "agent_did" ] ;
            hydra:required true ;
            rdfs:comment "The candidate agent's DID — may resolve to another team's pod." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "agent_name" ] ;
            hydra:required false ;
            rdfs:comment "Display name for the candidate agent." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "team" ] ;
            hydra:required true ;
            rdfs:comment "The team that owns / submitted this candidate." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "harness" ] ;
            hydra:required false ;
            rdfs:comment "The harness / runtime the agent is built on: { name?, version?, runtime? }."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "pod_url" ] ;
            hydra:required false ;
            rdfs:comment "Pod where the candidate agent's records live, when cross-pod." ;
            sh:datatype xsd:string
        ]
    ] ;
    rdfs:label "Request evaluation enrollment" ;
    iep:readOnlyHint false ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint true ;
    iep:appliesToCollection "profiles" ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/decide-evaluation-candidate> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/decide-evaluation-candidate> ;
    hydra:method "POST" ;
    hydra:title "Accept or decline a candidate agent (the cross-pod delegation grant)" ;
    rdfs:comment "The evaluation owner accepts or declines a requested candidate. Accepting it IS the cross-pod delegation grant — the candidate agent (whose DID may belong to another team / pod) becomes a managed member of the cohort and may record runs into it. This closes the gap where Interego could register an agent on your own pod but had no turnkey flow to authorise an external agent into a shared, managed evaluation." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/foxxi/decide_evaluation_candidate> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/foxxi/decide_evaluation_candidate> ;
    
    

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.decide_evaluation_candidate-input" ;
