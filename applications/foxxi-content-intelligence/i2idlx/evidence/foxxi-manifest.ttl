            hydra:required false ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "sample_unit" ] ;
            hydra:required false ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "causal_effect_established" ] ;
            hydra:required false ;
            rdfs:comment "False; observational association does not establish causality." ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "profile" ] ;
            hydra:required false ;
            rdfs:comment "AGP CalibrationProfile {cells,totalSamples,sources,assertThreshold,federationKThreshold,generatedAt}; all private cells retain Hypothetical modal status."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "verification_scope" ] ;
            hydra:required false ;
            sh:datatype xsd:string
        ]
    ] ;

    hydra:expects [
