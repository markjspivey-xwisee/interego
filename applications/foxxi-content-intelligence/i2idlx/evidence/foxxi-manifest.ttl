<https://relay.interego.xwisee.com/ns/iep/action/foxxi/assemble-learner-record> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/assemble-learner-record> ;
    hydra:method "POST" ;
    hydra:title "Assemble an Enterprise Learner Record (IEEE P2997 — human or AI agent)" ;
    rdfs:comment "Compose an IEEE P2997 Enterprise Learner Record — the unified, provenance-pointed aggregate of a subject's path. Pulls learning EXPERIENCES + on-the-job PERFORMANCE records from Foxxi-as-LRS xAPI statements, CREDENTIALS from the subject's pod wallet (reusing the verified CLR composer), and COMPETENCIES ranked across three bases: performance-verified (Asserted — proven by successful production work, supersedes weaker evidence), credentialed (Asserted), and inferred (Hypothetical — predicted from a passed/completed experience alone; iep:modalStatus keeps the prediction honest). Actor-agnostic: the subject may be a human learner/performer OR an AI agent learning + exercising tools — set actor_kind accordingly. Every entry carries a raw-data-location pointer per the P2997 data-ownership requirement. Pure read; non-admins may assemble their own human record, and any caller may assemble an agent capability record (agent capabilities are discoverable, like the agent registry)." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/foxxi/assemble_learner_record> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/foxxi/assemble_learner_record> ;
    
    

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.assemble_learner_record-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "learner_did" ] ;
            hydra:required true ;
            rdfs:comment "Subject's WebID/DID — the ELR subject; cross-checked against credential subjects." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "learner_pod_url" ] ;
            hydra:required false ;
            rdfs:comment "Subject's pod root to walk for wallet credentials (defaults to the tenant pod)." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "learner_name" ] ;
            hydra:required false ;
            rdfs:comment "Optional subject display name for the ELR header." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "actor_kind" ] ;
            hydra:required false ;
            rdfs:comment "human (default) or agent. Agent capability records are assemblable by any caller; human records are self/admin-only." ;
            sh:datatype xsd:string
        ]
    ] ;
    rdfs:label "Assemble an Enterprise Learner Record" ;
    iep:readOnlyHint true ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint true ;
    iep:appliesToCollection "profiles" ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/record-performance> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/record-performance> ;
    hydra:method "POST" ;
    hydra:title "Record a performance event (on-the-job work — human or AI agent)" ;
    rdfs:comment "Record one unit of on-the-job production work as an xAPI `performed` statement — the IEEE P2997 employment-history leg, kept distinct from training experiences. The performer (actor_did) may be a human exercising a workplace task OR an AI agent exercising a tool; the authenticated caller is the attesting observer, recorded in provenance. Performance records feed the ELR competency engine: successful production work yields a performance-verified (Asserted) competency that SUPERSEDES a training-only inference for the same competency — closing the data-informed loop." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/foxxi/record_performance> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/foxxi/record_performance> ;
    
    

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.record_performance-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "actor_did" ] ;
            hydra:required true ;
            rdfs:comment "Performer's DID — a human learner/performer or an AI agent. Defaults to the caller." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "task_name" ] ;
            hydra:required true ;
            rdfs:comment "Human-readable task or tool name (e.g. \"Resolve a tier-2 support ticket\", \"Use the web-search tool\"). Becomes the xAPI Activity name + (absent activity_type) the competency label." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "task_id" ] ;
            hydra:required false ;
            rdfs:comment "Stable task/tool identifier; derived from task_name if omitted." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "activity_type" ] ;
            hydra:required false ;
            rdfs:comment "Optional DOMAIN activity-type IRI you define for your vertical (e.g. urn:ttt:Move). Becomes object.definition.type; the ELR competency engine AGGREGATES same-type executions across instances under one competency. This is how a vertical-creator declares the publishing-layer vocabulary that makes competencies meaningful. Omit to use the generic ProductionTask wrapper (competency then keys off task_name)." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "success" ] ;
            hydra:required true ;
            rdfs:comment "Did the performer complete the task successfully?" ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "quality" ] ;
            hydra:required false ;
            rdfs:comment "Outcome quality, 0..1 (becomes xAPI result.score.scaled)." ;
            sh:datatype xsd:decimal ;
            sh:minInclusive 0 ;
            sh:maxInclusive 1
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "duration_iso" ] ;
            hydra:required false ;
            rdfs:comment "ISO 8601 duration the task took (e.g. PT4M30S)." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "cost_usd" ] ;
            hydra:required false ;
            rdfs:comment "Optional cost of the execution in USD (useful for AI-agent performance economics)." ;
            sh:datatype xsd:decimal
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "actor_kind" ] ;
            hydra:required false ;
            rdfs:comment "human (default) or agent." ;
            sh:datatype xsd:string
        ]
    ] ;
    rdfs:label "Record a performance event" ;
    iep:readOnlyHint false ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint true ;
    iep:appliesToCollection "profiles" ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/record-agent-trajectory> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/record-agent-trajectory> ;
    hydra:method "POST" ;
    hydra:title "Record an agentic-native trajectory (modal · poly-granular · composable)" ;
    rdfs:comment "Record an agent run in the AGENTIC-NATIVE form — not as flat xAPI statements but as a trajectory of Context Descriptors emergent from Interego L1: each step is MODAL (Hypothetical = an intention/plan, Asserted = executed, Counterfactual = a rejected branch — with iep:supersedes chains), POLY-GRANULAR (task ▸ subtask ▸ tool-call, the PGSL principle), and COMPOSABLE (trajectories merge via the L1 union/restriction algebra). The native trajectory is the source of truth; the bridge projects only the Asserted tool-call steps down to xAPI `performed` statements (which the IEEE P2997 ELR then reads). Intentions, counterfactuals, and the task hierarchy are retained ONLY in the native trajectory — xAPI structurally cannot hold them, and the projection reports exactly what it dropped." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/foxxi/record_agent_trajectory> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/foxxi/record_agent_trajectory> ;
    
    

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.record_agent_trajectory-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "agent_did" ] ;
            hydra:required true ;
            rdfs:comment "The agent whose run this trajectory records." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "agent_name" ] ;
            hydra:required false ;
            rdfs:comment "Optional agent display name." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "steps" ] ;
            hydra:required true ;
            rdfs:comment "Ordered trajectory steps. Each: { modal_status (Hypothetical|Asserted|Counterfactual), granularity (task|subtask|tool-call), verb, object_id, object_name, object_type?, id?, parent_id?, supersedes_id?, was_derived_from?[], result?{success,quality,note} }. A task step names the competency its work counts toward as the learner record counts work: by object_type when that is a domain activity type, or else by object_name when the step has a result. When work you record at that competency fails (foxxi.record_performance_signed), its regime is read from this trajectory too, cut to that task and the steps below it."
        ]
    ] ;
    rdfs:label "Record an agentic-native trajectory" ;
    iep:readOnlyHint false ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint true ;
    iep:appliesToCollection "profiles" ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/get-agent-trajectory> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/get-agent-trajectory> ;
    hydra:method "POST" ;
    hydra:title "Get an agent's native trajectory (what the xAPI projection drops)" ;
    rdfs:comment "Return an agent's full agentic-native trajectory — every step at every modal status (including the Hypothetical intentions + Counterfactual branches xAPI cannot represent) and every granularity. Includes a projection summary: how many steps reach xAPI vs. how many are retained only in the native form. Agent trajectories are discoverable, like the agent capability registry." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/foxxi/get_agent_trajectory> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/foxxi/get_agent_trajectory> ;
    
    

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.get_agent_trajectory-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "agent_did" ] ;
            hydra:required true ;
            rdfs:comment "The agent whose trajectory to retrieve." ;
            sh:datatype xsd:string
        ]
    ] ;
    rdfs:label "Get an agent's native trajectory" ;
    iep:readOnlyHint true ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint true ;
    iep:appliesToCollection "profiles" ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/assess-agent-disposition> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/assess-agent-disposition> ;
    hydra:method "POST" ;
    hydra:title "Assess a team of agents' disposition (Agent Performance Technology)" ;
    rdfs:comment "Read a team of agents' DISPOSITION from their trajectories — deliberately NOT a gap analysis. There is no ideal future state and no score-vs-exemplary; the gap model only fits knowable work, and a team of agents is a complex, adaptive system. Returns the modal balance (deliberation / exploration / plan-revision propensities), named dispositions, a WORK-REGIME placement of the team's behaviour with the decision stance it calls for, and a VECTOR of drift from the present — not a destination. If a safe-to-fail probe has been run on this team, also returns the causal read (the interventional + counterfactual effect)." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/foxxi/assess_agent_disposition> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/foxxi/assess_agent_disposition> ;
    
    

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.assess_agent_disposition-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "agent_dids" ] ;
            hydra:required true ;
            rdfs:comment "The DIDs of the agents forming the team to assess." ;
            sh:datatype xsd:string
        ]
    ] ;
    rdfs:label "Assess an agent team disposition" ;
    iep:readOnlyHint true ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint true ;
    iep:appliesToCollection "profiles" ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/run-performance-probe> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/run-performance-probe> ;
    hydra:method "POST" ;
    hydra:title "Run a safe-to-fail performance probe on an agent team" ;
    rdfs:comment "Record a safe-to-fail probe on an agent team — the disposition-based intervention. A probe nudges a CONSTRAINT (an affordance scope, a delegation bound, a connecting constraint), never an outcome: manage constraints, not targets. It is a deliberate, reversible change: the handler snapshots the team's disposition before the change as the causal baseline. The probe declares its safe-to-fail portfolio role (coherent / oblique / contradictory) and its weak signals — what would tell the consultant to amplify vs. dampen it. Re-assess the team afterward (assess_agent_disposition) to get the interventional + counterfactual causal read." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/foxxi/run_performance_probe> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/foxxi/run_performance_probe> ;
    
    

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.run_performance_probe-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "agent_dids" ] ;
            hydra:required true ;
            rdfs:comment "The agent team the probe is run on." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "constraint_target" ] ;
            hydra:required true ;
            rdfs:comment "The constraint being nudged — e.g. \"delegation-scope\", \"web-search-affordance\", \"connecting-constraint:researcher-summariser\". Never an outcome." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "change" ] ;
            hydra:required true ;
            rdfs:comment "Human description of the constraint nudge (e.g. \"broaden the delegation scope so the researcher may sub-delegate retrieval\")." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "coherence" ] ;
            hydra:required true ;
            rdfs:comment "Safe-to-fail portfolio role: coherent | oblique | contradictory." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "hypothesized_effect" ] ;
            hydra:required true ;
            rdfs:comment "What the consultant expects the nudge to do to the disposition (a hypothesis, not a target)." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "amplify_signal" ] ;
            hydra:required true ;
            rdfs:comment "The weak signal that would say: amplify this probe." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "dampen_signal" ] ;
            hydra:required true ;
            rdfs:comment "The weak signal that would say: dampen / withdraw this probe." ;
            sh:datatype xsd:string
        ]
    ] ;
    rdfs:label "Run a safe-to-fail probe" ;
    iep:readOnlyHint false ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint true ;
    iep:appliesToCollection "profiles" ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/foxxi/open-agent-evaluation> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/open-agent-evaluation> ;
    hydra:method "POST" ;
    hydra:title "Open an agent / harness evaluation cohort" ;
    rdfs:comment "Open a named, shared evaluation — the place where several teams' competing agents or harnesses are compared head-to-head. Carries the decision the cohort exists to inform (e.g. \"should we standardise on one agentic harness, or fund several?\") and an optional shared task set so the comparison is apples-to-apples. The motivating case: an enterprise where multiple teams independently build agents/harnesses and cannot agree how to evaluate one against another. Candidates enrol via foxxi.request_evaluation_enrollment; runs are recorded via foxxi.record_external_agent_run; the portfolio read is foxxi.compare_agent_evaluation." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/foxxi/open_agent_evaluation> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/foxxi/open_agent_evaluation> ;
    
    

