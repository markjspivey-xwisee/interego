<https://relay.interego.xwisee.com/ns/iep/action/foxxi/publish-course-catalog-product> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/publish-course-catalog-product> ;
    hydra:method "POST" ;
    hydra:title "Publish the course catalog as a federated data product" ;
    rdfs:comment "The tenant's course catalog as a HyprCat FederatedCatalog on the tenant pod: a public, Asserted descriptor that conforms to hyprcat:FederatedCatalog, so any pod walk finds it by type, describing a graph in which each course is a FederatedDataProduct issued by the tenant in the service world, with its title, category, audience keywords, standard, landing page, and an output port that is a followable distribution (a GET of the course's own IRI). Republishing supersedes the previous catalog under the same IRI. federated_with names peer catalogs on other pods. The configured tenant's catalog is its admin's to publish; with tenant_pod_url naming a self-sovereign pod, that pod's owner publishes that pod's catalog, to that pod and issued by it, including the SCORM courses the owner authored on this bridge." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/foxxi/publish_course_catalog_product> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/foxxi/publish_course_catalog_product> ;
    
    
    hydra:returns [
        a hydra:Class ;
        rdfs:label "foxxi.publish_course_catalog_product-output" ;
        rdfs:comment "Where the catalog was published and what it lists." ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "catalogIri" ] ;
            hydra:required false ;
            rdfs:comment "The catalog's IRI, fixed per tenant pod." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "descriptorUrl" ] ;
            hydra:required false ;
            rdfs:comment "The published descriptor." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "graphUrl" ] ;
            hydra:required false ;
            rdfs:comment "The published catalog graph (Turtle)." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "conformsTo" ] ;
            hydra:required false ;
            rdfs:comment "hyprcat:FederatedCatalog." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "products" ] ;
            hydra:required false ;
            rdfs:comment "How many courses the catalog lists." ;
            sh:datatype xsd:integer
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "federatedWith" ] ;
            hydra:required false ;
            rdfs:comment "The peer catalogs named."
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "publishedAt" ] ;
            hydra:required false ;
            rdfs:comment "When it was published (ISO 8601)." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "accessDecision" ] ;
            hydra:required false ;
            rdfs:comment "ABAC trace: caller role + applied policies + the decision."
        ]
    ] ;

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.publish_course_catalog_product-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "federated_with" ] ;
            hydra:required false ;
            rdfs:comment "IRIs of catalogs on other pods this one federates with." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "tenant_pod_url" ] ;
            hydra:required false ;
            rdfs:comment "The tenant whose catalog is published; omitted, the configured tenant." ;
            sh:datatype xsd:string
        ]
    ] ;
    rdfs:label "Publish the catalog as a data product" ;
    iep:readOnlyHint false ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint true ;
    iep:appliesToCollection "catalog" ;
    iep:encrypted false .

