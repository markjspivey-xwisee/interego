<https://relay.interego.xwisee.com/ns/iep/action/foxxi/emit-cmi5-session> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/foxxi/emit-cmi5-session> ;
    hydra:method "POST" ;
    hydra:title "Emit a cmi5-conformant xAPI session trace (launched → terminated)" ;
    rdfs:comment "Build the full cmi5 statement trace (launched + initialized + completed + passed/failed + terminated, plus optional satisfied if moveOn rule fires) for a learner's AU session. Each statement carries the cmi5 context category, session ID, and registration UUID per IEEE 9274.2.1. Caller can either fan-out to a connected LRS via the lrs-adapter or persist directly to the pod as fxa:LearningExperience descriptors." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/foxxi/emit_cmi5_session> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/foxxi/emit_cmi5_session> ;
    
    

    hydra:expects [
        a hydra:Class ;
        rdfs:label "foxxi.emit_cmi5_session-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "learner_did" ] ;
            hydra:required true ;
            rdfs:comment "Learner WebID — becomes the xAPI actor (mbox or account)." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "course_id" ] ;
            hydra:required true ;
            rdfs:comment "Course ID (becomes parent contextActivities)." ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "au_activity_id" ] ;
            hydra:required true ;
