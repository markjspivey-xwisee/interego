<https://relay.interego.xwisee.com/ns/iep/action/llm-telemetry/profile> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/llm-telemetry/profile> ;
    hydra:method "GET" ;
    hydra:title "Read the LLM xAPI profile" ;
    rdfs:comment "Read the versioned, general LLM telemetry vocabulary, statement templates and observation-stream pattern." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/llm-telemetry/profile> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/llm-telemetry/profile> ;
    dcat:mediaType "application/ld+json" ;
    
    hydra:returns [
        a hydra:Class ;
        rdfs:label "llm_telemetry.profile-output" ;
        rdfs:comment "Versioned ADL xAPI Profile document." ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "id" ] ;
            hydra:required false ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "type" ] ;
            hydra:required false ;
            sh:datatype xsd:string
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "versions" ] ;
            hydra:required false
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "concepts" ] ;
            hydra:required false
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "templates" ] ;
            hydra:required false
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "patterns" ] ;
            hydra:required false
        ]
    ] ;

    hydra:expects [
        a hydra:Class ;
        rdfs:label "llm_telemetry.profile-input"
    ] ;
    rdfs:label "Read LLM telemetry profile" ;
    iep:readOnlyHint true ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint false ;
    iep:appliesToCollection "entry" ;
    iep:appliesToCollection "profiles" ;
    iep:appliesToCollection "telemetry" ;
    iep:externallyRouted true ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/llm-telemetry/ingest> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
    iep:action <https://relay.interego.xwisee.com/ns/iep/action/llm-telemetry/ingest> ;
    hydra:method "POST" ;
    hydra:title "Record LLM observations" ;
    rdfs:comment "Sign {events:[...]} with the authenticated observer using sign_request then act, or act(sign_payload:true). Server and client deliveries require their independent capture opt-in; explicit manual-observation events are a signed one-off action. Accepts 1–20 allowlisted metadata events, validates xAPI in the actual own-lens LRS, then awaits encrypted PGSL persistence. Retry identical source_event_id and metadata; conflicting reuse returns 409. Content, credentials and transcripts are excluded." ;
    hydra:target <https://foxxi-bridge.interego.xwisee.com/agent/llm-telemetry/ingest> ;
    dcat:accessURL <https://foxxi-bridge.interego.xwisee.com/agent/llm-telemetry/ingest> ;
    dcat:mediaType "application/json" ;
    
    hydra:returns [
        a hydra:Class ;
        rdfs:label "llm_telemetry.ingest-output" ;
        rdfs:comment "LRS acceptance and awaited encrypted persistence receipts. A 502 can represent a partial commit; retry identical event IDs." ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "ok" ] ;
            hydra:required false ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "lrsAccepted" ] ;
            hydra:required false ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "durable" ] ;
            hydra:required false ;
            sh:datatype xsd:boolean
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "statementIds" ] ;
            hydra:required false
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "receipts" ] ;
            hydra:required false
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "error" ] ;
            hydra:required false ;
            sh:datatype xsd:string
        ]
    ] ;

    hydra:expects [
        a hydra:Class ;
        rdfs:label "llm_telemetry.ingest-input" ;
        hydra:supportedProperty
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "events" ] ;
            hydra:required true ;
            rdfs:comment "Metadata observations conforming to /llm-telemetry/event-schema. Actor is bound by verified signature." ;
            sh:minCount 1
        ] ,
        [
            a hydra:SupportedProperty ;
            hydra:property [ a rdf:Property ; rdfs:label "capture_revision" ] ;
            hydra:required false ;
            rdfs:comment "Required for server observations: the durable consent revision read before the operation." ;
            sh:datatype xsd:integer ;
            sh:minInclusive 0
        ]
    ] ;
    rdfs:label "Record LLM observations" ;
    iep:readOnlyHint false ;
    iep:destructiveHint false ;
    iep:idempotentHint true ;
    iep:openWorldHint false ;
    iep:appliesToCollection "telemetry" ;
    iep:externallyRouted true ;
    iep:encrypted false .

<https://relay.interego.xwisee.com/ns/iep/action/llm-telemetry/query> a iep:Affordance, ieh:Affordance, hydra:Operation, dcat:Distribution ;
