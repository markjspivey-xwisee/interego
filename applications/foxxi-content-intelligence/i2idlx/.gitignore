# Build outputs (dist/ is also ignored repo-wide). The published graphs are canonical at their
# Interego IRIs; the workbench and the reference page are regenerated by tools/build_app.py and
# tools/build_site.py.
site/
app/build/
app/node_modules/
# Fetched by tools/refresh_upper.py and tools/refresh-evidence.sh before a rebuild: other publishers'
# vocabulary files, referenced rather than redistributed,
evidence/upper/*.ttl
evidence/xapi-ontology.ttl
evidence/xapi-profile-ontology.ttl
# and snapshots of this repository's own namespace files (the same files as docs/ns/).
evidence/interego-*.ttl
