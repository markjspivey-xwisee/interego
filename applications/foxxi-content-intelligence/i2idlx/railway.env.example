# Set these on the existing Railway Foxxi bridge service. Do not commit actual secrets.
PORT=6080
BRIDGE_DEPLOYMENT_URL=https://YOUR_PUBLIC_SERVICE_DOMAIN
FOXXI_TENANT_POD_URL=https://YOUR_EXISTING_GATE/YOUR_EXISTING_TENANT/
FOXXI_POD_WRITE_SECRET=
FOXXI_BRIDGE_PRIVATE_KEY=
# Existing shared pod, admitted canonical account IDs and exact actor/editor DIDs:
FOXXI_I2IDLX_SHARED_POD_URL=
FOXXI_I2IDLX_PARTICIPANTS=
FOXXI_I2IDLX_EDITORS=
# Independently authenticated owner addresses; never copy unsigned pod claims as a trust root.
FOXXI_I2IDLX_OWNER_ANCHORS={}
FOXXI_I2IDLX_SITE_DIR=/app/applications/foxxi-content-intelligence/i2idlx/site-ts
FOXXI_I2IDLX_DIST_DIR=/app/applications/foxxi-content-intelligence/i2idlx/dist-ts
# Optional generated public task-context data file (not user-selected):
FOXXI_I2IDLX_APP_DATA_FILE=/app/applications/foxxi-content-intelligence/i2idlx/app/build-ts/data.json
