foxxi-scorm-cam:organizations a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "organizations"@en ;
    rdfs:comment "The organizations of a manifest."@en ;
    skos:definition "The organizations of a manifest."@en ;
    rdfs:domain foxxi-scorm-cam:Manifest ;
    rdfs:range foxxi-scorm-cam:Organizations ;
    dct:source "IMS Content Packaging 1.1.4 (imscp_v1p1.xsd): manifestType" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

foxxi-scorm-cam:resources a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "resources"@en ;
    rdfs:comment "The resources of a manifest."@en ;
    skos:definition "The resources of a manifest."@en ;
    rdfs:domain foxxi-scorm-cam:Manifest ;
    rdfs:range foxxi-scorm-cam:Resources ;
    dct:source "IMS Content Packaging 1.1.4 (imscp_v1p1.xsd): manifestType" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

foxxi-scorm-cam:subManifest a owl:ObjectProperty ;
    rdfs:label "sub-manifest"@en ;
    skos:notation "manifest" ;
    rdfs:comment "A manifest nested in a manifest."@en ;
    skos:definition "A manifest nested in a manifest."@en ;
    rdfs:domain foxxi-scorm-cam:Manifest ;
    rdfs:range foxxi-scorm-cam:Manifest ;
