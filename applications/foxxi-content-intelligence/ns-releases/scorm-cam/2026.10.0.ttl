foxxi-scorm-cam:UnitInterval a rdfs:Datatype ;
    rdfs:label "Unit interval"@en ;
    rdfs:comment "A number from 0 to 1 inclusive: a decimal as the schema writes it, or a double, which is what JSON-LD 1.1 (§8.6) makes of a JSON number with a fraction."@en ;
    skos:definition "A number from 0 to 1 inclusive: a decimal as the schema writes it, or a double, which is what JSON-LD 1.1 (§8.6) makes of a JSON number with a fraction."@en ;
    dct:source "ADL content packaging extensions, SCORM 2004 4th Edition (adlcp_v1p3.xsd): minProgressMeasureType, progressWeightType" ;
    owl:equivalentClass [
        a rdfs:Datatype ;
        owl:unionOf (
            [
                a rdfs:Datatype ;
                owl:onDatatype xsd:decimal ;
                owl:withRestrictions ( [ xsd:minInclusive 0 ] [ xsd:maxInclusive 1 ] )
            ]
            [
                a rdfs:Datatype ;
                owl:onDatatype xsd:double ;
                owl:withRestrictions ( [ xsd:minInclusive "0.0E0"^^xsd:double ] [ xsd:maxInclusive "1.0E0"^^xsd:double ] )
            ]
        )
    ] ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

foxxi-scorm-cam:Manifest a owl:Class ;
    rdfs:label "Manifest"@en ;
    rdfs:comment "The <manifest> of a content package: its identifier, its metadata, the organizations of its content and the resources that content is made of, and any manifests nested in it."@en ;
    skos:definition "The <manifest> of a content package: its identifier, its metadata, the organizations of its content and the resources that content is made of, and any manifests nested in it."@en ;
    dct:source "IMS Content Packaging 1.1.4 (imscp_v1p1.xsd): manifestType" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

foxxi-scorm-cam:Metadata a owl:Class ;
    rdfs:label "Metadata"@en ;
    rdfs:comment "A <metadata> element: metadata about the package or one of its parts — the schema it follows, its version, and the location of any metadata record kept outside the manifest."@en ;
    skos:definition "A <metadata> element: metadata about the package or one of its parts — the schema it follows, its version, and the location of any metadata record kept outside the manifest."@en ;
    dct:source "IMS Content Packaging 1.1.4 (imscp_v1p1.xsd): metadataType" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

foxxi-scorm-cam:Organizations a owl:Class ;
    rdfs:label "Organizations"@en ;
    rdfs:comment "The <organizations> element: the organizations of a package's content, and which of them is the default."@en ;
    skos:definition "The <organizations> element: the organizations of a package's content, and which of them is the default."@en ;
    dct:source "IMS Content Packaging 1.1.4 (imscp_v1p1.xsd): organizationsType" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

foxxi-scorm-cam:Organization a owl:Class ;
    rdfs:label "Organization"@en ;
    rdfs:comment "An <organization>: one structure of a package's content — a titled tree of items — that can be presented to a learner. In SCORM it is the root of an activity tree."@en ;
    skos:definition "An <organization>: one structure of a package's content — a titled tree of items — that can be presented to a learner. In SCORM it is the root of an activity tree."@en ;
    dct:source "IMS Content Packaging 1.1.4 (imscp_v1p1.xsd): organizationType" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

foxxi-scorm-cam:Item a owl:Class ;
    rdfs:label "Item"@en ;
    rdfs:comment "An <item>: a node of an organization's tree, standing for a learning activity. An item that references a resource launches it; an item with child items aggregates them."@en ;
    skos:definition "An <item>: a node of an organization's tree, standing for a learning activity. An item that references a resource launches it; an item with child items aggregates them."@en ;
    dct:source "IMS Content Packaging 1.1.4 (imscp_v1p1.xsd): itemType" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

foxxi-scorm-cam:Resources a owl:Class ;
    rdfs:label "Resources"@en ;
    rdfs:comment "The <resources> element: the resources of a package."@en ;
    skos:definition "The <resources> element: the resources of a package."@en ;
    dct:source "IMS Content Packaging 1.1.4 (imscp_v1p1.xsd): resourcesType" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

foxxi-scorm-cam:Resource a owl:Class ;
    rdfs:label "Resource"@en ;
    rdfs:comment "A <resource>: a set of files delivered together, with the file that launches it — a sharable content object (SCO), which communicates with the LMS at run time, or an asset, which does not."@en ;
    skos:definition "A <resource>: a set of files delivered together, with the file that launches it — a sharable content object (SCO), which communicates with the LMS at run time, or an asset, which does not."@en ;
    dct:source "IMS Content Packaging 1.1.4 (imscp_v1p1.xsd): resourceType; ADL content packaging extensions, SCORM 2004 4th Edition (adlcp_v1p3.xsd): scormType" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

foxxi-scorm-cam:File a owl:Class ;
    rdfs:label "File"@en ;
    rdfs:comment "A <file>: one file a resource is made of."@en ;
    skos:definition "A <file>: one file a resource is made of."@en ;
    dct:source "IMS Content Packaging 1.1.4 (imscp_v1p1.xsd): fileType" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

foxxi-scorm-cam:Dependency a owl:Class ;
    rdfs:label "Dependency"@en ;
    rdfs:comment "A <dependency>: a resource's reference to another resource whose files it also needs."@en ;
    skos:definition "A <dependency>: a resource's reference to another resource whose files it also needs."@en ;
    dct:source "IMS Content Packaging 1.1.4 (imscp_v1p1.xsd): dependencyType" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

foxxi-scorm-cam:SharedDataMap a owl:Class ;
    rdfs:label "Shared data map"@en ;
    skos:notation "adlcp:map" ;
    rdfs:comment "An <adlcp:map> in an item's <adlcp:data>: access, for the content the item launches, to a shared data store named by its target ID — to read it, to write it, or both. The content reaches the store through the adl.data run-time data model. Added in the 4th Edition."@en ;
    skos:definition "An <adlcp:map> in an item's <adlcp:data>: access, for the content the item launches, to a shared data store named by its target ID — to read it, to write it, or both. The content reaches the store through the adl.data run-time data model. Added in the 4th Edition."@en ;
    dct:source "ADL content packaging extensions, SCORM 2004 4th Edition (adlcp_v1p3.xsd): mapType" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

foxxi-scorm-cam:Schema a owl:Class ;
    rdfs:label "obsolete Schema"@en ;
    rdfs:comment "Formerly the class of the <schema> element, which holds text; the text is now the value of the datatype property metadataSchema."@en ;
    skos:definition "Formerly the class of the <schema> element, which holds text; the text is now the value of the datatype property metadataSchema."@en ;
    skos:changeNote "2026.10.0: deprecated; the element's text is the value of metadataSchema."@en ;
    owl:deprecated true ;
    dct:isReplacedBy foxxi-scorm-cam:metadataSchema ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

foxxi-scorm-cam:SchemaVersion a owl:Class ;
    rdfs:label "obsolete Schema version"@en ;
    rdfs:comment "Formerly the class of the <schemaversion> element, which holds text; the text is now the value of the datatype property metadataSchemaVersion."@en ;
    skos:definition "Formerly the class of the <schemaversion> element, which holds text; the text is now the value of the datatype property metadataSchemaVersion."@en ;
    skos:changeNote "2026.10.0: deprecated; the element's text is the value of metadataSchemaVersion."@en ;
    owl:deprecated true ;
    dct:isReplacedBy foxxi-scorm-cam:metadataSchemaVersion ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

foxxi-scorm-cam:Title a owl:Class ;
    rdfs:label "obsolete Title"@en ;
    rdfs:comment "Formerly the class of the <title> element, which holds text; the text is now the value of the datatype property titleText."@en ;
    skos:definition "Formerly the class of the <title> element, which holds text; the text is now the value of the datatype property titleText."@en ;
    skos:changeNote "2026.10.0: deprecated; the element's text is the value of titleText."@en ;
    owl:deprecated true ;
    dct:isReplacedBy foxxi-scorm-cam:titleText ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

foxxi-scorm-cam:identifier a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "identifier"@en ;
    rdfs:comment "The identifier of a manifest, organization, item or resource: an XML ID, unique within the manifest. xsd:ID is outside the OWL 2 datatype map, so the range is xsd:string."@en ;
    skos:definition "The identifier of a manifest, organization, item or resource: an XML ID, unique within the manifest. xsd:ID is outside the OWL 2 datatype map, so the range is xsd:string."@en ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            foxxi-scorm-cam:Manifest
            foxxi-scorm-cam:Organization
            foxxi-scorm-cam:Item
            foxxi-scorm-cam:Resource
        )
    ] ;
    rdfs:range xsd:string ;
    dct:source "IMS Content Packaging 1.1.4 (imscp_v1p1.xsd): attr.identifier.req" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

foxxi-scorm-cam:identifierref a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "identifier reference"@en ;
    skos:notation "identifierref" ;
    rdfs:comment "A resource's identifier: on an item, the resource the item launches; on a dependency, the resource depended on."@en ;
    skos:definition "A resource's identifier: on an item, the resource the item launches; on a dependency, the resource depended on."@en ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( foxxi-scorm-cam:Item foxxi-scorm-cam:Dependency ) ] ;
    rdfs:range xsd:string ;
    dct:source "IMS Content Packaging 1.1.4 (imscp_v1p1.xsd): attr.identifierref, attr.identifierref.req" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

foxxi-scorm-cam:version a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "version"@en ;
    rdfs:comment "The version of a manifest, as its author writes it."@en ;
    skos:definition "The version of a manifest, as its author writes it."@en ;
    rdfs:domain foxxi-scorm-cam:Manifest ;
    rdfs:range xsd:string ;
    dct:source "IMS Content Packaging 1.1.4 (imscp_v1p1.xsd): attr.version" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

foxxi-scorm-cam:isvisible a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "is visible"@en ;
    skos:notation "isvisible" ;
    rdfs:comment "Whether an item is shown to the learner when its organization is presented. Default true."@en ;
    skos:definition "Whether an item is shown to the learner when its organization is presented. Default true."@en ;
    rdfs:domain foxxi-scorm-cam:Item ;
    rdfs:range xsd:boolean ;
    dct:source "IMS Content Packaging 1.1.4 (imscp_v1p1.xsd): attr.isvisible" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

foxxi-scorm-cam:parameters a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "parameters"@en ;
    rdfs:comment "A query string an item adds to the URL of the resource it launches."@en ;
    skos:definition "A query string an item adds to the URL of the resource it launches."@en ;
    rdfs:domain foxxi-scorm-cam:Item ;
    rdfs:range xsd:string ;
    dct:source "IMS Content Packaging 1.1.4 (imscp_v1p1.xsd): attr.parameters" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

foxxi-scorm-cam:structure a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "structure"@en ;
    rdfs:comment "The shape of an organization. Default \"hierarchical\"."@en ;
    skos:definition "The shape of an organization. Default \"hierarchical\"."@en ;
    rdfs:domain foxxi-scorm-cam:Organization ;
    rdfs:range xsd:string ;
    dct:source "IMS Content Packaging 1.1.4 (imscp_v1p1.xsd): attr.structure.req" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

foxxi-scorm-cam:href a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "href"@en ;
    rdfs:comment "A URL: on a resource, the file that launches it; on a file, the file. Relative URLs resolve against the XML base in effect."@en ;
    skos:definition "A URL: on a resource, the file that launches it; on a file, the file. Relative URLs resolve against the XML base in effect."@en ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( foxxi-scorm-cam:Resource foxxi-scorm-cam:File ) ] ;
    rdfs:range xsd:anyURI ;
    dct:source "IMS Content Packaging 1.1.4 (imscp_v1p1.xsd): attr.href, attr.href.req" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

foxxi-scorm-cam:type a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "type"@en ;
    rdfs:comment "The type of a resource, such as \"webcontent\"."@en ;
    skos:definition "The type of a resource, such as \"webcontent\"."@en ;
    rdfs:domain foxxi-scorm-cam:Resource ;
    rdfs:range xsd:string ;
    dct:source "IMS Content Packaging 1.1.4 (imscp_v1p1.xsd): attr.resourcetype.req" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

foxxi-scorm-cam:base a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "XML base"@en ;
    skos:notation "xml:base" ;
    rdfs:comment "The base URL that relative URLs inside the element resolve against."@en ;
    skos:definition "The base URL that relative URLs inside the element resolve against."@en ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf ( foxxi-scorm-cam:Manifest foxxi-scorm-cam:Resources foxxi-scorm-cam:Resource )
    ] ;
    rdfs:range xsd:anyURI ;
    dct:source "IMS Content Packaging 1.1.4 (imscp_v1p1.xsd): attr.base" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

foxxi-scorm-cam:defaultOrganization a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "default organization"@en ;
    skos:notation "default" ;
    rdfs:comment "The identifier of the organization presented by default (an XML IDREF)."@en ;
    skos:definition "The identifier of the organization presented by default (an XML IDREF)."@en ;
    rdfs:domain foxxi-scorm-cam:Organizations ;
    rdfs:range xsd:string ;
    dct:source "IMS Content Packaging 1.1.4 (imscp_v1p1.xsd): attr.default" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

foxxi-scorm-cam:metadata a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "metadata"@en ;
    rdfs:comment "The metadata of a manifest, organization, item, resource or file."@en ;
    skos:definition "The metadata of a manifest, organization, item, resource or file."@en ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            foxxi-scorm-cam:Manifest
