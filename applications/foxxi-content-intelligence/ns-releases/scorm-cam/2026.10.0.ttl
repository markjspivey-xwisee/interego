    dct:issued "2026-10-12"^^xsd:date ;
    dct:language <http://id.loc.gov/vocabulary/iso639-1/en> ;
    bibo:status <http://purl.org/ontology/bibo/status/published> ;
    dct:bibliographicCitation "Spivey, M. (2026). SCORM 2004 4th Edition — Content Aggregation Model (content packaging) (Version 2026.10.0) [Ontology]. Foxxi Mediums Inc. https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam/2026.10.0" ;
    vann:preferredNamespacePrefix "foxxi-scorm-cam" ;
    vann:preferredNamespaceUri "https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam#" ;
    dct:source <https://adlnet.gov/past-projects/scorm> , <https://www.imsglobal.org/content/packaging/index.html> ;
    prov:wasDerivedFrom <https://github.com/markjspivey-xwisee/interego/blob/foxxi-ns-2026.10.0/applications/foxxi-content-intelligence/src/spec/scorm-cam.model.ts> ,
        <https://github.com/markjspivey-xwisee/interego/blob/foxxi-ns-2026.10.0/applications/foxxi-content-intelligence/src/spec-ontology.ts> ;
    rdfs:seeAlso <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam/shapes/2026.10.0> ,
