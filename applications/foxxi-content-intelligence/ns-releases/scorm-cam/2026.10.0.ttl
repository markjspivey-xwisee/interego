foxxi-scorm-cam:organization a owl:ObjectProperty ;
    rdfs:label "organization"@en ;
    rdfs:comment "An organization of the package."@en ;
    skos:definition "An organization of the package."@en ;
    rdfs:domain foxxi-scorm-cam:Organizations ;
    rdfs:range foxxi-scorm-cam:Organization ;
    dct:source "IMS Content Packaging 1.1.4 (imscp_v1p1.xsd): organizationsType" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

foxxi-scorm-cam:item a owl:ObjectProperty ;
    rdfs:label "item"@en ;
    rdfs:comment "A child item: of an organization, one of its top-level items; of an item, one of the items it aggregates."@en ;
    skos:definition "A child item: of an organization, one of its top-level items; of an item, one of the items it aggregates."@en ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( foxxi-scorm-cam:Organization foxxi-scorm-cam:Item ) ] ;
    rdfs:range foxxi-scorm-cam:Item ;
    dct:source "IMS Content Packaging 1.1.4 (imscp_v1p1.xsd): organizationType, itemType" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

foxxi-scorm-cam:position a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "position"@en ;
    rdfs:comment "The position of an item among the children of its organization or parent item, counting from 1 in document order: the order SCORM sequencing takes them in. An RDF reading of a manifest states it, since RDF keeps no order of its own."@en ;
    skos:definition "The position of an item among the children of its organization or parent item, counting from 1 in document order: the order SCORM sequencing takes them in. An RDF reading of a manifest states it, since RDF keeps no order of its own."@en ;
    rdfs:domain foxxi-scorm-cam:Item ;
    rdfs:range xsd:positiveInteger ;
    dct:source "IMS Content Packaging 1.1.4 (imscp_v1p1.xsd): organizationType, itemType (the order of the item elements)" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

foxxi-scorm-cam:resource a owl:ObjectProperty ;
    rdfs:label "resource"@en ;
    rdfs:comment "A resource of the package."@en ;
    skos:definition "A resource of the package."@en ;
    rdfs:domain foxxi-scorm-cam:Resources ;
    rdfs:range foxxi-scorm-cam:Resource ;
    dct:source "IMS Content Packaging 1.1.4 (imscp_v1p1.xsd): resourcesType" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

foxxi-scorm-cam:file a owl:ObjectProperty ;
    rdfs:label "file"@en ;
    rdfs:comment "A file a resource is made of."@en ;
    skos:definition "A file a resource is made of."@en ;
    rdfs:domain foxxi-scorm-cam:Resource ;
    rdfs:range foxxi-scorm-cam:File ;
    dct:source "IMS Content Packaging 1.1.4 (imscp_v1p1.xsd): resourceType" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

foxxi-scorm-cam:dependency a owl:ObjectProperty ;
    rdfs:label "dependency"@en ;
    rdfs:comment "A dependency of a resource on another resource."@en ;
    skos:definition "A dependency of a resource on another resource."@en ;
    rdfs:domain foxxi-scorm-cam:Resource ;
    rdfs:range foxxi-scorm-cam:Dependency ;
    dct:source "IMS Content Packaging 1.1.4 (imscp_v1p1.xsd): resourceType" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

foxxi-scorm-cam:titleText a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "title"@en ;
    skos:notation "title" ;
    rdfs:comment "The title of an organization or item, shown to the learner: the text of its <title>."@en ;
    skos:definition "The title of an organization or item, shown to the learner: the text of its <title>."@en ;
    skos:changeNote "2026.10.0: new, in place of the object property title."@en ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( foxxi-scorm-cam:Organization foxxi-scorm-cam:Item ) ] ;
    rdfs:range xsd:string ;
    dct:source "IMS Content Packaging 1.1.4 (imscp_v1p1.xsd): titleType" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

foxxi-scorm-cam:metadataSchema a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "metadata schema"@en ;
    skos:notation "schema" ;
    rdfs:comment "The schema the metadata follows: \"ADL SCORM\" for a SCORM package. The text of <schema>."@en ;
    skos:definition "The schema the metadata follows: \"ADL SCORM\" for a SCORM package. The text of <schema>."@en ;
    skos:changeNote "2026.10.0: new, in place of the object property schema."@en ;
    rdfs:domain foxxi-scorm-cam:Metadata ;
    rdfs:range xsd:string ;
    dct:source "IMS Content Packaging 1.1.4 (imscp_v1p1.xsd): schemaType" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

foxxi-scorm-cam:metadataSchemaVersion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "metadata schema version"@en ;
    skos:notation "schemaversion" ;
    rdfs:comment "The version of that schema: for SCORM 2004, \"2004 4th Edition\", \"2004 3rd Edition\", or \"CAM 1.3\" for the 2nd Edition. The text of <schemaversion>."@en ;
    skos:definition "The version of that schema: for SCORM 2004, \"2004 4th Edition\", \"2004 3rd Edition\", or \"CAM 1.3\" for the 2nd Edition. The text of <schemaversion>."@en ;
    skos:changeNote "2026.10.0: new, in place of the object property schemaversion."@en ;
    rdfs:domain foxxi-scorm-cam:Metadata ;
    rdfs:range xsd:string ;
    dct:source "IMS Content Packaging 1.1.4 (imscp_v1p1.xsd): schemaversionType" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

foxxi-scorm-cam:title a owl:ObjectProperty ;
    rdfs:label "obsolete title"@en ;
    rdfs:comment "The <title> element of an organization or item, as a node of the deprecated class Title. Use titleText, whose value is the title itself."@en ;
    skos:definition "The <title> element of an organization or item, as a node of the deprecated class Title. Use titleText, whose value is the title itself."@en ;
    skos:changeNote "2026.10.0: deprecated in favour of titleText; kept as the object property it was published as."@en ;
    owl:deprecated true ;
    dct:isReplacedBy foxxi-scorm-cam:titleText ;
    rdfs:range foxxi-scorm-cam:Title ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

foxxi-scorm-cam:schema a owl:ObjectProperty ;
    rdfs:label "obsolete schema"@en ;
    rdfs:comment "The <schema> element of the metadata, as a node of the deprecated class Schema. Use metadataSchema, whose value is the schema's name itself."@en ;
    skos:definition "The <schema> element of the metadata, as a node of the deprecated class Schema. Use metadataSchema, whose value is the schema's name itself."@en ;
    skos:changeNote "2026.10.0: deprecated in favour of metadataSchema; kept as the object property it was published as."@en ;
    owl:deprecated true ;
    dct:isReplacedBy foxxi-scorm-cam:metadataSchema ;
    rdfs:domain foxxi-scorm-cam:Metadata ;
    rdfs:range foxxi-scorm-cam:Schema ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

foxxi-scorm-cam:schemaversion a owl:ObjectProperty ;
    rdfs:label "obsolete schemaversion"@en ;
    rdfs:comment "The <schemaversion> element of the metadata, as a node of the deprecated class SchemaVersion. Use metadataSchemaVersion, whose value is the version itself."@en ;
    skos:definition "The <schemaversion> element of the metadata, as a node of the deprecated class SchemaVersion. Use metadataSchemaVersion, whose value is the version itself."@en ;
    skos:changeNote "2026.10.0: deprecated in favour of metadataSchemaVersion; kept as the object property it was published as."@en ;
    owl:deprecated true ;
    dct:isReplacedBy foxxi-scorm-cam:metadataSchemaVersion ;
    rdfs:domain foxxi-scorm-cam:Metadata ;
    rdfs:range foxxi-scorm-cam:SchemaVersion ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

foxxi-scorm-cam:scormType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "SCORM type"@en ;
    skos:notation "adlcp:scormType" ;
    rdfs:comment "Whether a resource is a SCO, which communicates with the LMS at run time, or an asset, which does not. Every SCORM resource has one."@en ;
    skos:definition "Whether a resource is a SCO, which communicates with the LMS at run time, or an asset, which does not. Every SCORM resource has one."@en ;
    rdfs:domain foxxi-scorm-cam:Resource ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "sco" "asset" ) ] ;
    dct:source "ADL content packaging extensions, SCORM 2004 4th Edition (adlcp_v1p3.xsd): scormType" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

foxxi-scorm-cam:location a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "location"@en ;
    skos:notation "adlcp:location" ;
    rdfs:comment "The URL of a metadata record kept outside the manifest."@en ;
    skos:definition "The URL of a metadata record kept outside the manifest."@en ;
    rdfs:domain foxxi-scorm-cam:Metadata ;
    rdfs:range xsd:anyURI ;
    dct:source "ADL content packaging extensions, SCORM 2004 4th Edition (adlcp_v1p3.xsd): locationType" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

foxxi-scorm-cam:dataFromLMS a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data from LMS"@en ;
    skos:notation "adlcp:dataFromLMS" ;
    rdfs:comment "Data an item gives the content it launches, which the content reads as cmi.launch_data."@en ;
    skos:definition "Data an item gives the content it launches, which the content reads as cmi.launch_data."@en ;
    rdfs:domain foxxi-scorm-cam:Item ;
    rdfs:range xsd:string ;
    dct:source "ADL content packaging extensions, SCORM 2004 4th Edition (adlcp_v1p3.xsd): dataFromLMSType" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

foxxi-scorm-cam:timeLimitAction a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "time limit action"@en ;
    skos:notation "adlcp:timeLimitAction" ;
    rdfs:comment "What the content an item launches should do when the learner exceeds the time allowed; the content reads it as cmi.time_limit_action."@en ;
    skos:definition "What the content an item launches should do when the learner exceeds the time allowed; the content reads it as cmi.time_limit_action."@en ;
    rdfs:domain foxxi-scorm-cam:Item ;
    rdfs:range [
        a rdfs:Datatype ;
        owl:oneOf ( "exit,message" "exit,no message" "continue,message" "continue,no message" )
    ] ;
    dct:source "ADL content packaging extensions, SCORM 2004 4th Edition (adlcp_v1p3.xsd): timeLimitActionType" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

foxxi-scorm-cam:completionThreshold a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "completion threshold"@en ;
    skos:notation "adlcp:completionThreshold" ;
    rdfs:comment "An item's completion threshold as SCORM 2004 3rd Edition writes it: the content of the element, a number from 0 to 1. The 4th Edition expresses the threshold as minProgressMeasure; its schema still admits the content, so 3rd Edition packages remain valid."@en ;
    skos:definition "An item's completion threshold as SCORM 2004 3rd Edition writes it: the content of the element, a number from 0 to 1. The 4th Edition expresses the threshold as minProgressMeasure; its schema still admits the content, so 3rd Edition packages remain valid."@en ;
    rdfs:domain foxxi-scorm-cam:Item ;
    rdfs:range foxxi-scorm-cam:UnitInterval ;
    dct:source "ADL content packaging extensions, SCORM 2004 4th Edition (adlcp_v1p3.xsd): completionThresholdType (3rd Edition content)" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

foxxi-scorm-cam:completedByMeasure a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "completed by measure"@en ;
    skos:notation "adlcp:completionThreshold/@completedByMeasure" ;
    rdfs:comment "Whether an item's completion is decided by comparing its progress measure with its minimum progress measure. Default false. Added in the 4th Edition."@en ;
    skos:definition "Whether an item's completion is decided by comparing its progress measure with its minimum progress measure. Default false. Added in the 4th Edition."@en ;
    rdfs:domain foxxi-scorm-cam:Item ;
    rdfs:range xsd:boolean ;
    dct:source "ADL content packaging extensions, SCORM 2004 4th Edition (adlcp_v1p3.xsd): completionThresholdType" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

foxxi-scorm-cam:minProgressMeasure a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "minimum progress measure"@en ;
    skos:notation "adlcp:completionThreshold/@minProgressMeasure" ;
    rdfs:comment "The progress measure, from 0 to 1, at or above which an item whose completion is decided by measure is complete. Default 1.0. The content reads it as cmi.completion_threshold. Added in the 4th Edition."@en ;
    skos:definition "The progress measure, from 0 to 1, at or above which an item whose completion is decided by measure is complete. Default 1.0. The content reads it as cmi.completion_threshold. Added in the 4th Edition."@en ;
    rdfs:domain foxxi-scorm-cam:Item ;
    rdfs:range foxxi-scorm-cam:UnitInterval ;
    dct:source "ADL content packaging extensions, SCORM 2004 4th Edition (adlcp_v1p3.xsd): completionThresholdType" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

foxxi-scorm-cam:progressWeight a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "progress weight"@en ;
    skos:notation "adlcp:completionThreshold/@progressWeight" ;
    rdfs:comment "The weight, from 0 to 1, that an item's progress measure carries when its parent's progress measure is rolled up. Default 1.0. Added in the 4th Edition."@en ;
    skos:definition "The weight, from 0 to 1, that an item's progress measure carries when its parent's progress measure is rolled up. Default 1.0. Added in the 4th Edition."@en ;
    rdfs:domain foxxi-scorm-cam:Item ;
    rdfs:range foxxi-scorm-cam:UnitInterval ;
    dct:source "ADL content packaging extensions, SCORM 2004 4th Edition (adlcp_v1p3.xsd): completionThresholdType" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

foxxi-scorm-cam:dataMap a owl:ObjectProperty ;
    rdfs:label "shared data"@en ;
    skos:notation "adlcp:data" ;
    rdfs:comment "A shared data store the content an item launches has access to: one for each <adlcp:map> in the item's <adlcp:data>. Added in the 4th Edition."@en ;
    skos:definition "A shared data store the content an item launches has access to: one for each <adlcp:map> in the item's <adlcp:data>. Added in the 4th Edition."@en ;
    rdfs:domain foxxi-scorm-cam:Item ;
    rdfs:range foxxi-scorm-cam:SharedDataMap ;
    dct:source "ADL content packaging extensions, SCORM 2004 4th Edition (adlcp_v1p3.xsd): dataType" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

foxxi-scorm-cam:targetID a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "target ID"@en ;
    skos:notation "targetID" ;
    rdfs:comment "The identifier of a shared data store. Required."@en ;
    skos:definition "The identifier of a shared data store. Required."@en ;
    rdfs:domain foxxi-scorm-cam:SharedDataMap ;
    rdfs:range xsd:anyURI ;
    dct:source "ADL content packaging extensions, SCORM 2004 4th Edition (adlcp_v1p3.xsd): mapType" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

foxxi-scorm-cam:readSharedData a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "read shared data"@en ;
    skos:notation "readSharedData" ;
    rdfs:comment "Whether the content can read the store. Default true."@en ;
    skos:definition "Whether the content can read the store. Default true."@en ;
    rdfs:domain foxxi-scorm-cam:SharedDataMap ;
    rdfs:range xsd:boolean ;
    dct:source "ADL content packaging extensions, SCORM 2004 4th Edition (adlcp_v1p3.xsd): mapType" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

foxxi-scorm-cam:writeSharedData a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "write shared data"@en ;
    skos:notation "writeSharedData" ;
    rdfs:comment "Whether the content can write the store. Default false."@en ;
    skos:definition "Whether the content can write the store. Default false."@en ;
    rdfs:domain foxxi-scorm-cam:SharedDataMap ;
    rdfs:range xsd:boolean ;
    dct:source "ADL content packaging extensions, SCORM 2004 4th Edition (adlcp_v1p3.xsd): mapType" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

foxxi-scorm-cam:sharedDataGlobalToSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "shared data global to system"@en ;
    skos:notation "adlcp:sharedDataGlobalToSystem" ;
    rdfs:comment "Whether the shared data stores an organization's items map are global to the LMS, so other packages can reach them for the same learner (true, the default), or belong to this package (false). Added in the 4th Edition."@en ;
    skos:definition "Whether the shared data stores an organization's items map are global to the LMS, so other packages can reach them for the same learner (true, the default), or belong to this package (false). Added in the 4th Edition."@en ;
    rdfs:domain foxxi-scorm-cam:Organization ;
    rdfs:range xsd:boolean ;
    dct:source "ADL content packaging extensions, SCORM 2004 4th Edition (adlcp_v1p3.xsd): sharedDataGlobalToSystem" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

foxxi-scorm-cam:ScormType a skos:ConceptScheme ;
    rdfs:label "SCORM types"@en ;
    skos:prefLabel "SCORM types"@en ;
    skos:definition "The values of adlcp:scormType on a resource."@en ;
    rdfs:comment "The values of adlcp:scormType on a resource."@en ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> ;
    skos:hasTopConcept foxxi-scorm-cam:ScormType-sco , foxxi-scorm-cam:ScormType-asset .

foxxi-scorm-cam:ScormType-sco a skos:Concept ;
    skos:inScheme foxxi-scorm-cam:ScormType ;
    skos:topConceptOf foxxi-scorm-cam:ScormType ;
    skos:prefLabel "SCO"@en ;
    rdfs:label "SCO (SCORM types)"@en ;
    skos:notation "sco" ;
    skos:definition "A sharable content object: launched by the LMS, it communicates with the LMS through the run-time API."@en ;
    rdfs:comment "A sharable content object: launched by the LMS, it communicates with the LMS through the run-time API."@en ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

foxxi-scorm-cam:ScormType-asset a skos:Concept ;
    skos:inScheme foxxi-scorm-cam:ScormType ;
    skos:topConceptOf foxxi-scorm-cam:ScormType ;
    skos:prefLabel "asset"@en ;
    rdfs:label "asset (SCORM types)"@en ;
    skos:notation "asset" ;
    skos:definition "Content the LMS can launch that does not communicate with the LMS."@en ;
    rdfs:comment "Content the LMS can launch that does not communicate with the LMS."@en ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

foxxi-scorm-cam:TimeLimitAction a skos:ConceptScheme ;
    rdfs:label "Time limit actions"@en ;
    skos:prefLabel "Time limit actions"@en ;
    skos:definition "The values of adlcp:timeLimitAction, and so of cmi.time_limit_action."@en ;
    rdfs:comment "The values of adlcp:timeLimitAction, and so of cmi.time_limit_action."@en ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> ;
    skos:hasTopConcept foxxi-scorm-cam:TimeLimitAction-exit-message ,
        foxxi-scorm-cam:TimeLimitAction-exit-no-message ,
        foxxi-scorm-cam:TimeLimitAction-continue-message ,
        foxxi-scorm-cam:TimeLimitAction-continue-no-message .

foxxi-scorm-cam:TimeLimitAction-exit-message a skos:Concept ;
    skos:inScheme foxxi-scorm-cam:TimeLimitAction ;
    skos:topConceptOf foxxi-scorm-cam:TimeLimitAction ;
    skos:prefLabel "exit with a message"@en ;
    rdfs:label "exit with a message (Time limit actions)"@en ;
    skos:notation "exit,message" ;
    skos:definition "Leave the SCO, and tell the learner why."@en ;
    rdfs:comment "Leave the SCO, and tell the learner why."@en ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

foxxi-scorm-cam:TimeLimitAction-exit-no-message a skos:Concept ;
    skos:inScheme foxxi-scorm-cam:TimeLimitAction ;
    skos:topConceptOf foxxi-scorm-cam:TimeLimitAction ;
    skos:prefLabel "exit without a message"@en ;
    rdfs:label "exit without a message (Time limit actions)"@en ;
    skos:notation "exit,no message" ;
    skos:definition "Leave the SCO without telling the learner."@en ;
    rdfs:comment "Leave the SCO without telling the learner."@en ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

foxxi-scorm-cam:TimeLimitAction-continue-message a skos:Concept ;
    skos:inScheme foxxi-scorm-cam:TimeLimitAction ;
    skos:topConceptOf foxxi-scorm-cam:TimeLimitAction ;
    skos:prefLabel "continue with a message"@en ;
    rdfs:label "continue with a message (Time limit actions)"@en ;
    skos:notation "continue,message" ;
    skos:definition "Stay in the SCO, and tell the learner the time is up."@en ;
    rdfs:comment "Stay in the SCO, and tell the learner the time is up."@en ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

foxxi-scorm-cam:TimeLimitAction-continue-no-message a skos:Concept ;
    skos:inScheme foxxi-scorm-cam:TimeLimitAction ;
    skos:topConceptOf foxxi-scorm-cam:TimeLimitAction ;
    skos:prefLabel "continue without a message"@en ;
    rdfs:label "continue without a message (Time limit actions)"@en ;
    skos:notation "continue,no message" ;
    skos:definition "Stay in the SCO without telling the learner."@en ;
    rdfs:comment "Stay in the SCO without telling the learner."@en ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

foxxi-scorm-cam:Structure a skos:ConceptScheme ;
    rdfs:label "Organization structures"@en ;
    skos:prefLabel "Organization structures"@en ;
    skos:definition "The values of an organization's structure attribute that SCORM uses."@en ;
    rdfs:comment "The values of an organization's structure attribute that SCORM uses."@en ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> ;
    skos:hasTopConcept foxxi-scorm-cam:Structure-hierarchical .

foxxi-scorm-cam:Structure-hierarchical a skos:Concept ;
    skos:inScheme foxxi-scorm-cam:Structure ;
    skos:topConceptOf foxxi-scorm-cam:Structure ;
    skos:prefLabel "hierarchical"@en ;
    rdfs:label "hierarchical (Organization structures)"@en ;
    skos:notation "hierarchical" ;
    skos:definition "A tree of items: the default structure, and the one SCORM content uses."@en ;
    rdfs:comment "A tree of items: the default structure, and the one SCORM content uses."@en ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-cam> .

[
    a owl:AllDisjointClasses ;
    owl:members (
        foxxi-scorm-cam:Manifest
        foxxi-scorm-cam:Metadata
        foxxi-scorm-cam:Organizations
        foxxi-scorm-cam:Organization
        foxxi-scorm-cam:Item
        foxxi-scorm-cam:Resources
        foxxi-scorm-cam:Resource
        foxxi-scorm-cam:File
        foxxi-scorm-cam:Dependency
        foxxi-scorm-cam:SharedDataMap
    )
] .

prov:wasDerivedFrom a owl:ObjectProperty ;
    rdfs:label "was derived from"@en ;
    rdfs:comment "A transformation of an entity into another, an update of an entity resulting in a new one, or the construction of a new entity based on a pre-existing one. (PROV-O)"@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o> ;
    rdfs:domain prov:Entity ;
    rdfs:range prov:Entity .

skos:ConceptScheme a owl:Class ;
    rdfs:label "Concept Scheme"@en ;
    rdfs:comment "A set of concepts, optionally including statements about semantic relationships between those concepts. (SKOS)"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    owl:disjointWith skos:Concept .

skos:hasTopConcept a owl:ObjectProperty ;
    rdfs:label "has top concept"@en ;
    rdfs:comment "Relates, by convention, a concept scheme to a concept which is topmost in the broader/narrower concept hierarchies for that scheme. (SKOS)"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:domain skos:ConceptScheme ;
    rdfs:range skos:Concept .

skos:Concept a owl:Class ;
    rdfs:label "Concept"@en ;
    rdfs:comment "An idea or notion; a unit of thought. (SKOS)"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> .

skos:inScheme a owl:ObjectProperty ;
    rdfs:label "is in scheme"@en ;
    rdfs:comment "Relates a resource (for example a concept) to a concept scheme in which it is included. (SKOS)"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:range skos:ConceptScheme .

skos:topConceptOf a owl:ObjectProperty ;
    rdfs:label "is top concept in scheme"@en ;
    rdfs:comment "Relates a concept to the concept scheme that it is a top level concept of. (SKOS)"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:inScheme ;
    owl:inverseOf skos:hasTopConcept .

prov:Entity a owl:Class ;
    rdfs:label "Entity"@en ;
    rdfs:comment "A physical, digital, conceptual, or other kind of thing with some fixed aspects. (PROV-O)"@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o> .

dct:title a owl:AnnotationProperty .

dct:description a owl:AnnotationProperty .

skos:historyNote a owl:AnnotationProperty .

dct:creator a owl:AnnotationProperty .

dct:contributor a owl:AnnotationProperty .

dct:publisher a owl:AnnotationProperty .

dct:license a owl:AnnotationProperty .

dct:rights a owl:AnnotationProperty .

dct:created a owl:AnnotationProperty .

dct:modified a owl:AnnotationProperty .

dct:issued a owl:AnnotationProperty .

dct:language a owl:AnnotationProperty .

bibo:status a owl:AnnotationProperty .

dct:bibliographicCitation a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

dct:source a owl:AnnotationProperty .

skos:definition a owl:AnnotationProperty .

skos:notation a owl:AnnotationProperty .

skos:changeNote a owl:AnnotationProperty .

dct:isReplacedBy a owl:AnnotationProperty .

skos:prefLabel a owl:AnnotationProperty .
