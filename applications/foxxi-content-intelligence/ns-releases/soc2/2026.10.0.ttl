foxxi-soc2:TrustServicesCriterion a owl:Class ;
    rdfs:label "Trust Services Criterion"@en ;
    rdfs:comment "A SOC 2 control objective from the AICPA Trust Services Criteria (2017, rev. 2022). The Common Criteria (CC) apply to the Security category that every SOC 2 report covers. Its instances here are the concepts of this document's CommonCriterion list."@en ;
    skos:definition "A SOC 2 control objective from the AICPA Trust Services Criteria (2017, rev. 2022). The Common Criteria (CC) apply to the Security category that every SOC 2 report covers. Its instances here are the concepts of this document's CommonCriterion list."@en ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/soc2> .

foxxi-soc2:OperationalEvidenceEvent a owl:Class ;
    rdfs:label "Operational Evidence Event"@en ;
    rdfs:comment "A signed, anchored substrate event that serves as operating-effectiveness evidence for one or more Trust Services Criteria over the audit period. Interego's operations package (@interego/ops) records each as a context descriptor (iep:ContextDescriptor)."@en ;
    skos:definition "A signed, anchored substrate event that serves as operating-effectiveness evidence for one or more Trust Services Criteria over the audit period. Interego's operations package (@interego/ops) records each as a context descriptor (iep:ContextDescriptor)."@en ;
    skos:closeMatch soc2:ControlEvidence ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/soc2> .

foxxi-soc2:AccessChangeEvent a owl:Class ;
    rdfs:label "Access Change Event"@en ;
    rdfs:comment "An OperationalEvidenceEvent recording that logical access was granted, revoked or modified (an agent registered or revoked, say): evidence for CC6.2 (registration and authorization) and CC6.3 (changes and removal by role)."@en ;
    skos:definition "An OperationalEvidenceEvent recording that logical access was granted, revoked or modified (an agent registered or revoked, say): evidence for CC6.2 (registration and authorization) and CC6.3 (changes and removal by role)."@en ;
    rdfs:subClassOf foxxi-soc2:OperationalEvidenceEvent ;
    skos:exactMatch soc2:AccessChangeEvent ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/soc2> .

foxxi-soc2:DeployEvent a owl:Class ;
    rdfs:label "Deploy Event"@en ;
    rdfs:comment "An OperationalEvidenceEvent recording a change deployed to production: evidence for CC8.1 (change management)."@en ;
    skos:definition "An OperationalEvidenceEvent recording a change deployed to production: evidence for CC8.1 (change management)."@en ;
    rdfs:subClassOf foxxi-soc2:OperationalEvidenceEvent ;
    skos:exactMatch soc2:DeployEvent ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/soc2> .

foxxi-soc2:KeyRotationEvent a owl:Class ;
    rdfs:label "Key Rotation Event"@en ;
    rdfs:comment "An OperationalEvidenceEvent recording the rotation of a signing or encryption key: evidence for CC6.1 (protecting encryption keys is among its points of focus) and, for a key that protects information in transit, CC6.7."@en ;
    skos:definition "An OperationalEvidenceEvent recording the rotation of a signing or encryption key: evidence for CC6.1 (protecting encryption keys is among its points of focus) and, for a key that protects information in transit, CC6.7."@en ;
    rdfs:subClassOf foxxi-soc2:OperationalEvidenceEvent ;
    skos:exactMatch soc2:KeyRotationEvent ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/soc2> .

foxxi-soc2:IncidentEvent a owl:Class ;
    rdfs:label "Incident Event"@en ;
    rdfs:comment "An OperationalEvidenceEvent recording a security incident, from its detection to its resolution: evidence for CC7.3 (evaluating security events), CC7.4 (responding to incidents) and, once resolved, CC7.5 (recovery)."@en ;
    skos:definition "An OperationalEvidenceEvent recording a security incident, from its detection to its resolution: evidence for CC7.3 (evaluating security events), CC7.4 (responding to incidents) and, once resolved, CC7.5 (recovery)."@en ;
    rdfs:subClassOf foxxi-soc2:OperationalEvidenceEvent ;
    skos:exactMatch soc2:IncidentEvent ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/soc2> .

foxxi-soc2:QuarterlyReviewEvent a owl:Class ;
    rdfs:label "Quarterly Review Event"@en ;
    rdfs:comment "An OperationalEvidenceEvent recording that a recurring quarterly review was completed (of access, changes, risk, vendors or monitoring): evidence for the criteria the review covers, such as CC6.2 and CC6.3 for an access review or CC8.1 for a change review."@en ;
    skos:definition "An OperationalEvidenceEvent recording that a recurring quarterly review was completed (of access, changes, risk, vendors or monitoring): evidence for the criteria the review covers, such as CC6.2 and CC6.3 for an access review or CC8.1 for a change review."@en ;
    rdfs:subClassOf foxxi-soc2:OperationalEvidenceEvent ;
    skos:exactMatch soc2:QuarterlyReviewEvent ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/soc2> .

foxxi-soc2:evidences a owl:ObjectProperty ;
    rdfs:label "evidences"@en ;
    rdfs:comment "Links an OperationalEvidenceEvent to the TrustServicesCriterion whose operating effectiveness it evidences."@en ;
    skos:definition "Links an OperationalEvidenceEvent to the TrustServicesCriterion whose operating effectiveness it evidences."@en ;
    rdfs:domain foxxi-soc2:OperationalEvidenceEvent ;
    rdfs:range foxxi-soc2:TrustServicesCriterion ;
    skos:closeMatch soc2:satisfiesControl ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/soc2> .

foxxi-soc2:occurredAt a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "occurred at"@en ;
    skos:notation "occurredAt" ;
    rdfs:comment "The instant the evidenced operation occurred (xsd:dateTime), inside the audit period."@en ;
    skos:definition "The instant the evidenced operation occurred (xsd:dateTime), inside the audit period."@en ;
    rdfs:domain foxxi-soc2:OperationalEvidenceEvent ;
    rdfs:range xsd:dateTime ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/soc2> .

foxxi-soc2:actingAgent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "acting agent"@en ;
    skos:notation "actingAgent" ;
    rdfs:comment "The agent or principal, identified by its DID, whose action the event records — recovered from the request signature, not asserted by the application."@en ;
    skos:definition "The agent or principal, identified by its DID, whose action the event records — recovered from the request signature, not asserted by the application."@en ;
    skos:changeNote "2026.10.0: new, in place of actor, which held the DID as a string."@en ;
    rdfs:domain foxxi-soc2:OperationalEvidenceEvent ;
    rdfs:range prov:Agent ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/soc2> .

foxxi-soc2:actor a owl:DatatypeProperty ;
    rdfs:label "obsolete actor"@en ;
    rdfs:comment "The DID of the agent or principal whose action the event records, as a string. An agent with an identity is a node, not a string: use actingAgent, whose value is the DID itself."@en ;
    skos:definition "The DID of the agent or principal whose action the event records, as a string. An agent with an identity is a node, not a string: use actingAgent, whose value is the DID itself."@en ;
    skos:changeNote "2026.10.0: deprecated in favour of actingAgent; kept as the datatype property it was published as, so data that used it keeps its meaning."@en ;
    owl:deprecated true ;
    dct:isReplacedBy foxxi-soc2:actingAgent ;
    rdfs:domain foxxi-soc2:OperationalEvidenceEvent ;
    rdfs:range xsd:anyURI ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/soc2> .

foxxi-soc2:signer a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "signer"@en ;
    rdfs:comment "The recovered signing address proving who produced the evidence (ECDSA signature recovery)."@en ;
    skos:definition "The recovered signing address proving who produced the evidence (ECDSA signature recovery)."@en ;
    rdfs:domain foxxi-soc2:OperationalEvidenceEvent ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/soc2> .

foxxi-soc2:CommonCriterion a skos:ConceptScheme ;
    rdfs:label "SOC 2 Common Criteria"@en ;
    skos:prefLabel "SOC 2 Common Criteria"@en ;
    skos:definition "The Common Criteria this document cites: the eight on logical and physical access (CC6.1–CC6.8), the three on responding to security incidents (CC7.3–CC7.5), and the one on change management (CC8.1). Each is a TrustServicesCriterion, paraphrased here and cited by its code: the criteria's own text is the AICPA's (2017 Trust Services Criteria, with revised points of focus, 2022), and it governs."@en ;
    rdfs:comment "The Common Criteria this document cites: the eight on logical and physical access (CC6.1–CC6.8), the three on responding to security incidents (CC7.3–CC7.5), and the one on change management (CC8.1). Each is a TrustServicesCriterion, paraphrased here and cited by its code: the criteria's own text is the AICPA's (2017 Trust Services Criteria, with revised points of focus, 2022), and it governs."@en ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/soc2> ;
    skos:hasTopConcept foxxi-soc2:CommonCriterion-CC6.1 ,
        foxxi-soc2:CommonCriterion-CC6.2 ,
        foxxi-soc2:CommonCriterion-CC6.3 ,
        foxxi-soc2:CommonCriterion-CC6.4 ,
        foxxi-soc2:CommonCriterion-CC6.5 ,
        foxxi-soc2:CommonCriterion-CC6.6 ,
        foxxi-soc2:CommonCriterion-CC6.7 ,
        foxxi-soc2:CommonCriterion-CC6.8 ,
        foxxi-soc2:CommonCriterion-CC7.3 ,
        foxxi-soc2:CommonCriterion-CC7.4 ,
        foxxi-soc2:CommonCriterion-CC7.5 ,
        foxxi-soc2:CommonCriterion-CC8.1 .

foxxi-soc2:CommonCriterion-CC6.1 a skos:Concept , foxxi-soc2:TrustServicesCriterion ;
    skos:inScheme foxxi-soc2:CommonCriterion ;
    skos:topConceptOf foxxi-soc2:CommonCriterion ;
    skos:prefLabel "CC6.1 logical access security"@en ;
    rdfs:label "CC6.1 logical access security (SOC 2 Common Criteria)"@en ;
    skos:notation "CC6.1" ;
    skos:definition "Software, infrastructure and system architecture restrict logical access to the information assets the entity protects, guarding them against security events."@en ;
    rdfs:comment "Software, infrastructure and system architecture restrict logical access to the information assets the entity protects, guarding them against security events."@en ;
    skos:exactMatch soc2:CC6.1 ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/soc2> .

foxxi-soc2:CommonCriterion-CC6.2 a skos:Concept , foxxi-soc2:TrustServicesCriterion ;
    skos:inScheme foxxi-soc2:CommonCriterion ;
    skos:topConceptOf foxxi-soc2:CommonCriterion ;
    skos:prefLabel "CC6.2 user registration and authorization"@en ;
    rdfs:label "CC6.2 user registration and authorization (SOC 2 Common Criteria)"@en ;
    skos:notation "CC6.2" ;
    skos:definition "New internal and external users are registered and authorized before they are given credentials or access to the system."@en ;
    rdfs:comment "New internal and external users are registered and authorized before they are given credentials or access to the system."@en ;
    skos:exactMatch soc2:CC6.2 ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/soc2> .

foxxi-soc2:CommonCriterion-CC6.3 a skos:Concept , foxxi-soc2:TrustServicesCriterion ;
    skos:inScheme foxxi-soc2:CommonCriterion ;
    skos:topConceptOf foxxi-soc2:CommonCriterion ;
    skos:prefLabel "CC6.3 role-based access changes"@en ;
    rdfs:label "CC6.3 role-based access changes (SOC 2 Common Criteria)"@en ;
    skos:notation "CC6.3" ;
    skos:definition "Access to data, software and functions is granted, changed or removed according to roles and responsibilities, or to the system's design and its changes."@en ;
    rdfs:comment "Access to data, software and functions is granted, changed or removed according to roles and responsibilities, or to the system's design and its changes."@en ;
    skos:exactMatch soc2:CC6.3 ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/soc2> .

foxxi-soc2:CommonCriterion-CC6.4 a skos:Concept , foxxi-soc2:TrustServicesCriterion ;
    skos:inScheme foxxi-soc2:CommonCriterion ;
    skos:topConceptOf foxxi-soc2:CommonCriterion ;
    skos:prefLabel "CC6.4 physical access restriction"@en ;
    rdfs:label "CC6.4 physical access restriction (SOC 2 Common Criteria)"@en ;
    skos:notation "CC6.4" ;
    skos:definition "Physical access to facilities and protected assets — data centres, backup media and other sensitive locations — is limited to authorized people."@en ;
    rdfs:comment "Physical access to facilities and protected assets — data centres, backup media and other sensitive locations — is limited to authorized people."@en ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/soc2> .

foxxi-soc2:CommonCriterion-CC6.5 a skos:Concept , foxxi-soc2:TrustServicesCriterion ;
    skos:inScheme foxxi-soc2:CommonCriterion ;
    skos:topConceptOf foxxi-soc2:CommonCriterion ;
    skos:prefLabel "CC6.5 disposal of physical assets"@en ;
    rdfs:label "CC6.5 disposal of physical assets (SOC 2 Common Criteria)"@en ;
    skos:notation "CC6.5" ;
    skos:definition "Protections over a physical asset are withdrawn only once the data and software on it can no longer be read or recovered, and are no longer needed."@en ;
    rdfs:comment "Protections over a physical asset are withdrawn only once the data and software on it can no longer be read or recovered, and are no longer needed."@en ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/soc2> .

foxxi-soc2:CommonCriterion-CC6.6 a skos:Concept , foxxi-soc2:TrustServicesCriterion ;
    skos:inScheme foxxi-soc2:CommonCriterion ;
    skos:topConceptOf foxxi-soc2:CommonCriterion ;
    skos:prefLabel "CC6.6 protection against external threats"@en ;
    rdfs:label "CC6.6 protection against external threats (SOC 2 Common Criteria)"@en ;
    skos:notation "CC6.6" ;
    skos:definition "Logical access measures protect the system against threats from sources outside its boundaries."@en ;
    rdfs:comment "Logical access measures protect the system against threats from sources outside its boundaries."@en ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/soc2> .

foxxi-soc2:CommonCriterion-CC6.7 a skos:Concept , foxxi-soc2:TrustServicesCriterion ;
    skos:inScheme foxxi-soc2:CommonCriterion ;
    skos:topConceptOf foxxi-soc2:CommonCriterion ;
    skos:prefLabel "CC6.7 protection of information in transit"@en ;
    rdfs:label "CC6.7 protection of information in transit (SOC 2 Common Criteria)"@en ;
    skos:notation "CC6.7" ;
    skos:definition "Transmitting, moving and removing information is limited to authorized users and processes, and the information is protected while it moves."@en ;
    rdfs:comment "Transmitting, moving and removing information is limited to authorized users and processes, and the information is protected while it moves."@en ;
    skos:exactMatch soc2:CC6.7 ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/soc2> .

foxxi-soc2:CommonCriterion-CC6.8 a skos:Concept , foxxi-soc2:TrustServicesCriterion ;
    skos:inScheme foxxi-soc2:CommonCriterion ;
    skos:topConceptOf foxxi-soc2:CommonCriterion ;
    skos:prefLabel "CC6.8 malicious software prevention"@en ;
    rdfs:label "CC6.8 malicious software prevention (SOC 2 Common Criteria)"@en ;
    skos:notation "CC6.8" ;
    skos:definition "Controls prevent, or detect and act on, the introduction of unauthorized or malicious software."@en ;
    rdfs:comment "Controls prevent, or detect and act on, the introduction of unauthorized or malicious software."@en ;
    skos:exactMatch soc2:CC6.8 ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/soc2> .

foxxi-soc2:CommonCriterion-CC7.3 a skos:Concept , foxxi-soc2:TrustServicesCriterion ;
    skos:inScheme foxxi-soc2:CommonCriterion ;
    skos:topConceptOf foxxi-soc2:CommonCriterion ;
    skos:prefLabel "CC7.3 security event evaluation"@en ;
    rdfs:label "CC7.3 security event evaluation (SOC 2 Common Criteria)"@en ;
    skos:notation "CC7.3" ;
    skos:definition "Security events are evaluated to decide whether they could cause, or have caused, a failure to meet the entity's objectives (a security incident) and, where they could or did, action is taken to prevent or address the failure."@en ;
    rdfs:comment "Security events are evaluated to decide whether they could cause, or have caused, a failure to meet the entity's objectives (a security incident) and, where they could or did, action is taken to prevent or address the failure."@en ;
    skos:exactMatch soc2:CC7.3 ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/soc2> .

foxxi-soc2:CommonCriterion-CC7.4 a skos:Concept , foxxi-soc2:TrustServicesCriterion ;
    skos:inScheme foxxi-soc2:CommonCriterion ;
    skos:topConceptOf foxxi-soc2:CommonCriterion ;
    skos:prefLabel "CC7.4 security incident response"@en ;
    rdfs:label "CC7.4 security incident response (SOC 2 Common Criteria)"@en ;
    skos:notation "CC7.4" ;
    skos:definition "Identified security incidents are handled through a defined response programme that works to understand, contain, remediate and communicate them, as appropriate."@en ;
    rdfs:comment "Identified security incidents are handled through a defined response programme that works to understand, contain, remediate and communicate them, as appropriate."@en ;
    skos:exactMatch soc2:CC7.4 ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/soc2> .

foxxi-soc2:CommonCriterion-CC7.5 a skos:Concept , foxxi-soc2:TrustServicesCriterion ;
    skos:inScheme foxxi-soc2:CommonCriterion ;
    skos:topConceptOf foxxi-soc2:CommonCriterion ;
    skos:prefLabel "CC7.5 security incident recovery"@en ;
    rdfs:label "CC7.5 security incident recovery (SOC 2 Common Criteria)"@en ;
    skos:notation "CC7.5" ;
    skos:definition "Activities to recover from identified security incidents are identified, developed and carried out."@en ;
    rdfs:comment "Activities to recover from identified security incidents are identified, developed and carried out."@en ;
    skos:exactMatch soc2:CC7.5 ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/soc2> .

foxxi-soc2:CommonCriterion-CC8.1 a skos:Concept , foxxi-soc2:TrustServicesCriterion ;
    skos:inScheme foxxi-soc2:CommonCriterion ;
    skos:topConceptOf foxxi-soc2:CommonCriterion ;
    skos:prefLabel "CC8.1 change management"@en ;
    rdfs:label "CC8.1 change management (SOC 2 Common Criteria)"@en ;
    skos:notation "CC8.1" ;
    skos:definition "Changes to infrastructure, data, software and procedures are authorized, designed or acquired, configured, documented, tested, approved and implemented, so that they serve the entity's objectives."@en ;
    rdfs:comment "Changes to infrastructure, data, software and procedures are authorized, designed or acquired, configured, documented, tested, approved and implemented, so that they serve the entity's objectives."@en ;
    skos:exactMatch soc2:CC8.1 ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/soc2> .

[
    a owl:AllDisjointClasses ;
    owl:members ( foxxi-soc2:TrustServicesCriterion foxxi-soc2:OperationalEvidenceEvent )
] .

prov:wasDerivedFrom a owl:ObjectProperty ;
    rdfs:label "was derived from"@en ;
    rdfs:comment "A transformation of an entity into another, an update of an entity resulting in a new one, or the construction of a new entity based on a pre-existing one. (PROV-O)"@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o> ;
    rdfs:domain prov:Entity ;
    rdfs:range prov:Entity .

prov:Agent a owl:Class ;
    rdfs:label "Agent"@en ;
    rdfs:comment "Something that bears some form of responsibility for an activity taking place, for the existence of an entity, or for another agent's activity. (PROV-O)"@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o> .

skos:ConceptScheme a owl:Class ;
    rdfs:label "Concept Scheme"@en ;
    rdfs:comment "A set of concepts, optionally including statements about semantic relationships between those concepts. (SKOS)"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    owl:disjointWith skos:Concept .

skos:hasTopConcept a owl:ObjectProperty ;
    rdfs:label "has top concept"@en ;
    rdfs:comment "Relates, by convention, a concept scheme to a concept which is topmost in the broader/narrower concept hierarchies for that scheme. (SKOS)"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:domain skos:ConceptScheme ;
    rdfs:range skos:Concept .

skos:Concept a owl:Class ;
    rdfs:label "Concept"@en ;
    rdfs:comment "An idea or notion; a unit of thought. (SKOS)"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> .

skos:inScheme a owl:ObjectProperty ;
    rdfs:label "is in scheme"@en ;
    rdfs:comment "Relates a resource (for example a concept) to a concept scheme in which it is included. (SKOS)"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:range skos:ConceptScheme .

skos:topConceptOf a owl:ObjectProperty ;
    rdfs:label "is top concept in scheme"@en ;
    rdfs:comment "Relates a concept to the concept scheme that it is a top level concept of. (SKOS)"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:inScheme ;
    owl:inverseOf skos:hasTopConcept .

prov:Entity a owl:Class ;
    rdfs:label "Entity"@en ;
    rdfs:comment "A physical, digital, conceptual, or other kind of thing with some fixed aspects. (PROV-O)"@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o> .

dct:title a owl:AnnotationProperty .

