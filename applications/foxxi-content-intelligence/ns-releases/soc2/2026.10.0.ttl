<https://foxxi-bridge.interego.xwisee.com/ns/soc2> a owl:Ontology ;
    dct:title "AICPA SOC 2 — Trust Services Criteria (Security / Common Criteria)"@en ;
    dct:description "OWL + SHACL projection of the substrate L3 SOC 2 mapping (docs/ns/soc2.ttl): the Common Criteria for logical and physical access (CC6.1–CC6.8), and the operational evidence events Interego records (@interego/ops), each an operation an auditor can sample as evidence for a criterion — an access change for CC6.2 and CC6.3, a deploy for CC8.1. Composed into PGSL and projected here so a cited control IRI dereferences."@en ;
    rdfs:comment "Independent formalization by Mark Spivey (Foxxi Mediums Inc.). Not affiliated with or endorsed by the AICPA. Where this document and the published standard differ, the standard governs."@en ,
        "Mapped to the Interego substrate's SOC 2 vocabulary (prefix soc2:, docs/ns/soc2.ttl) by SKOS mappings. Since 2026.10.0, actor is an object property."@en ,
        "Each criterion is paraphrased and cited by its code; the AICPA's text governs. How Interego produces evidence for one is documented with the substrate (spec/SOC2-PREPARATION.md), not here: whether the evidence suffices is the auditor's judgment."@en ;
    owl:versionIRI <https://foxxi-bridge.interego.xwisee.com/ns/soc2/2026.10.0> ;
    owl:versionInfo "2026.10.0" ;
    skos:historyNote "Versioned by calendar (YYYY.MM.PATCH) from 2026.10.0: the version numbers this document, not the standard it formalizes. Every released version stays resolvable at its version IRI, and the content there never changes. Earlier publications carried no version IRI, and their owl:versionInfo restated the version of the standard."@en ;
    dct:creator "Mark Spivey" ;
    dct:contributor "Claude (Anthropic)" ;
    dct:publisher "Foxxi Mediums Inc." ;
    dct:license <https://opensource.org/licenses/MIT> ;
    dct:rights "© 2026 Mark Spivey (Foxxi Mediums Inc.). Released under the MIT License."@en ;
    dct:created "2026-06-19"^^xsd:date ;
    dct:modified "2026-10-12"^^xsd:date ;
    dct:issued "2026-10-12"^^xsd:date ;
    dct:language <http://id.loc.gov/vocabulary/iso639-1/en> ;
    bibo:status <http://purl.org/ontology/bibo/status/published> ;
    dct:bibliographicCitation "Spivey, M. (2026). AICPA SOC 2 — Trust Services Criteria (Security / Common Criteria) (Version 2026.10.0) [Ontology]. Foxxi Mediums Inc. https://foxxi-bridge.interego.xwisee.com/ns/soc2/2026.10.0" ;
    vann:preferredNamespacePrefix "foxxi-soc2" ;
    vann:preferredNamespaceUri "https://foxxi-bridge.interego.xwisee.com/ns/soc2#" ;
    dct:source <https://www.aicpa-cima.com/resources/download/2017-trust-services-criteria-with-revised-points-of-focus-2022> ;
