shapes:OperationalEvidenceEventShape a sh:NodeShape ;
    sh:targetClass foxxi-soc2:OperationalEvidenceEvent ,
        foxxi-soc2:AccessChangeEvent ,
        foxxi-soc2:DeployEvent ,
        foxxi-soc2:KeyRotationEvent ,
        foxxi-soc2:IncidentEvent ,
        foxxi-soc2:QuarterlyReviewEvent ;
    sh:targetSubjectsOf foxxi-soc2:evidences , foxxi-soc2:occurredAt , foxxi-soc2:actingAgent , foxxi-soc2:signer ;
    rdfs:label "SOC 2 evidence-event conformance"@en ;
    rdfs:comment "An operational evidence event cites a criterion it evidences, carries the instant it occurred, and names the acting agent and the recovered signer, so an audit pack shows who acted and which criterion the event is evidence for."@en ;
    sh:property shapes:OperationalEvidenceEventShape-evidences ,
        shapes:OperationalEvidenceEventShape-occurredAt ,
        shapes:OperationalEvidenceEventShape-actingAgent ,
        shapes:OperationalEvidenceEventShape-signer ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/soc2/shapes> .

shapes:OperationalEvidenceEventShape-evidences a sh:PropertyShape ;
    sh:path foxxi-soc2:evidences ;
    sh:name "evidences" ;
    sh:description "cite at least one Trust Services Criterion"@en ;
    sh:message "SOC 2 evidence-event conformance — evidences: at least 1 value — cite at least one Trust Services Criterion"@en ;
    sh:minCount 1 .

shapes:OperationalEvidenceEventShape-occurredAt a sh:PropertyShape ;
    sh:path foxxi-soc2:occurredAt ;
    sh:name "occurredAt" ;
    sh:description "one occurrence instant in the audit period"@en ;
    sh:message "SOC 2 evidence-event conformance — occurredAt: exactly 1 value, of type xsd:dateTime — one occurrence instant in the audit period"@en ;
    sh:datatype xsd:dateTime ;
    sh:minCount 1 ;
    sh:maxCount 1 .

shapes:OperationalEvidenceEventShape-actingAgent a sh:PropertyShape ;
    sh:path foxxi-soc2:actingAgent ;
    sh:name "actingAgent" ;
    sh:description "the acting agent, by its DID"@en ;
    sh:message "SOC 2 evidence-event conformance — actingAgent: exactly 1 value, an IRI — the acting agent, by its DID"@en ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 .

shapes:OperationalEvidenceEventShape-signer a sh:PropertyShape ;
    sh:path foxxi-soc2:signer ;
    sh:name "signer" ;
    sh:description "the recovered signer address"@en ;
    sh:message "SOC 2 evidence-event conformance — signer: exactly 1 value, of type xsd:string — the recovered signer address"@en ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 .
