{
  "@context": {
    "@version": 1.1,
    "@protected": true,
    "ler": "https://foxxi-bridge.interego.xwisee.com/ns/ieee-ler#",
    "tla": "https://foxxi-bridge.interego.xwisee.com/ns/adl-tla#",
    "iep": "https://markjspivey-xwisee.github.io/interego/ns/iep#",
    "prov": "http://www.w3.org/ns/prov#",
    "dct": "http://purl.org/dc/terms/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "hydra": "http://www.w3.org/ns/hydra/core#",
    "EnterpriseLearnerRecord": "ler:EnterpriseLearnerRecord",
    "CompetencyAssertion": "ler:CompetencyAssertion",
    "Asserted": "iep:Asserted",
    "Hypothetical": "iep:Hypothetical",
    "conformsTo": {
      "@id": "dct:conformsTo",
      "@type": "@id"
    },
    "assembledAt": {
      "@id": "prov:generatedAtTime",
      "@type": "xsd:dateTime"
    },
    "subjectKind": "ler:subjectKind",
    "learner": {
      "@id": "ler:aboutLearner",
      "@context": {
        "did": "@id"
      }
    },
    "organizationPath": {
      "@id": "ler:organizationPath",
      "@container": "@set",
      "@context": {
        "id": {
          "@id": "ler:pathOrganization",
          "@type": "@id"
        },
        "role": "ler:pathRole",
        "position": {
          "@id": "ler:pathPosition",
          "@type": "xsd:positiveInteger"
        }
      }
    },
    "provenance": "@nest",
    "rawDataLocations": {
      "@id": "ler:rawDataLocation",
      "@nest": "provenance",
      "@container": "@set",
      "@context": {
        "kind": "ler:rawDataKind",
        "location": {
          "@id": "ler:dataLocation",
          "@type": "xsd:anyURI"
        }
      }
    },
    "experiences": {
      "@id": "ler:recordEntry",
      "@container": "@set",
      "@context": {
        "id": "dct:identifier",
        "verb": {
          "@id": "ler:entryVerb",
          "@type": "@id"
        },
        "timestamp": {
          "@id": "ler:occurredAt",
          "@type": "xsd:dateTime"
        },
        "activityId": {
          "@id": "ler:aboutActivity",
          "@type": "@id"
        },
        "taskId": {
          "@id": "ler:aboutActivity",
          "@type": "@id"
        },
        "taskType": {
          "@id": "ler:activityType",
          "@type": "@id"
        },
        "success": "ler:succeeded"
      }
    },
    "performanceRecords": {
      "@id": "ler:recordEntry",
      "@container": "@set",
      "@context": {
        "id": "dct:identifier",
        "verb": {
          "@id": "ler:entryVerb",
          "@type": "@id"
        },
        "timestamp": {
          "@id": "ler:occurredAt",
          "@type": "xsd:dateTime"
        },
        "activityId": {
          "@id": "ler:aboutActivity",
          "@type": "@id"
        },
        "taskId": {
          "@id": "ler:aboutActivity",
          "@type": "@id"
        },
        "taskType": {
          "@id": "ler:activityType",
          "@type": "@id"
        },
        "success": "ler:succeeded"
      }
    },
    "rawDataLocation": {
      "@id": "ler:dataLocation",
      "@type": "xsd:anyURI"
    },
    "modalStatus": {
      "@id": "iep:modalStatus",
      "@type": "@vocab"
    },
    "competencies": {
      "@id": "ler:hasAssertion",
      "@container": "@set",
      "@context": {
        "assertionId": "@id",
        "assertionType": {
          "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#type",
          "@type": "@id"
        },
        "id": {
          "@id": "ler:aboutCompetency",
          "@type": "@id"
        },
        "aboutCompetency": {
          "@id": "ler:aboutCompetency",
          "@type": "@id"
        },
        "subject": {
          "@id": "ler:assertionSubject",
          "@type": "@id"
        },
        "proficiencyLevel": {
          "@id": "ler:atProficiency",
          "@type": "@id"
        },
        "confidence": "ler:successConfidence",
        "rolledUpBy": {
          "@id": "ler:rolledUpBy",
          "@type": "@id"
        },
        "assertingAgent": {
          "@id": "prov:wasAttributedTo",
          "@type": "@id"
        },
        "evidence": {
          "@id": "ler:supportedByEvidence",
          "@type": "@id",
          "@container": "@set"
        },
        "basis": "ler:evidenceBasis"
      }
    }
  }
}
