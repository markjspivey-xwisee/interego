        shapes:LaunchDataShape-moveOn ,
        shapes:LaunchDataShape-masteryScore ,
        shapes:LaunchDataShape-launchParameters ,
        shapes:LaunchDataShape-returnURL ,
        shapes:LaunchDataShape-entitlementKey ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/cmi5/shapes> .

shapes:LaunchDataShape-contextTemplate a sh:PropertyShape ;
    sh:path foxxi-cmi5:contextTemplate ;
    sh:name "contextTemplate" ;
    sh:description "context template (§10.2.1)"@en ;
    sh:message "cmi5 LMS.LaunchData conformance — contextTemplate: exactly 1 value — context template (§10.2.1)"@en ;
    sh:minCount 1 ;
    sh:maxCount 1 .

shapes:LaunchDataShape-launchMode a sh:PropertyShape ;
    sh:path foxxi-cmi5:launchMode ;
    sh:name "launchMode" ;
    sh:description "launch mode (§10.2.2)"@en ;
    sh:message "cmi5 LMS.LaunchData conformance — launchMode: exactly 1 value, one of \"Normal\", \"Browse\", \"Review\" — launch mode (§10.2.2)"@en ;
    sh:minCount 1 ;
