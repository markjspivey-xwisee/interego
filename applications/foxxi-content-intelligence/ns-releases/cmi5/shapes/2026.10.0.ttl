shapes:CourseStructureShape a sh:NodeShape ;
    sh:targetClass foxxi-cmi5:CourseStructure ;
    sh:targetSubjectsOf foxxi-cmi5:course , foxxi-cmi5:structure ;
    rdfs:label "cmi5 course structure conformance"@en ;
    rdfs:comment "cmi5 Quartz §13.1: a course structure contains exactly one Course and at least one top-level Block or Assignable Unit."@en ;
    sh:not [
        sh:or (
            [ sh:class foxxi-cmi5:Course ]
            [ sh:class foxxi-cmi5:Block ]
            [ sh:class foxxi-cmi5:Objective ]
            [ sh:class foxxi-cmi5:AssignableUnit ]
            [ sh:class foxxi-cmi5:Session ]
            [ sh:class foxxi-cmi5:LaunchData ]
            [ sh:class foxxi-cmi5:EntitlementKey ]
            [ sh:class foxxi-cmi5:LearnerPreferences ]
        )
    ] ;
    sh:message "cmi5 course structure conformance: a CourseStructure is not also of a kind this document declares disjoint with it"@en ;
    sh:property shapes:CourseStructureShape-course , shapes:CourseStructureShape-structure ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/cmi5/shapes> .

shapes:CourseStructureShape-course a sh:PropertyShape ;
    sh:path foxxi-cmi5:course ;
    sh:name "course" ;
    sh:description "exactly one Course (§13.1)"@en ;
    sh:message "cmi5 course structure conformance — course: exactly 1 value, an instance of Course — exactly one Course (§13.1)"@en ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:minCount 1 ;
    sh:maxCount 1 .

shapes:CourseStructureShape-structure a sh:PropertyShape ;
    sh:path foxxi-cmi5:structure ;
    sh:name "structure" ;
    sh:description "at least one top-level Block or AU (§13.1)"@en ;
    sh:message "cmi5 course structure conformance — structure: at least 1 value — at least one top-level Block or AU (§13.1)"@en ;
    sh:minCount 1 .

shapes:CourseShape a sh:NodeShape ;
    sh:targetClass foxxi-cmi5:Course ;
    sh:targetObjectsOf foxxi-cmi5:course ;
    rdfs:label "cmi5 Course conformance"@en ;
    rdfs:comment "cmi5 Quartz §13.1.1: a Course is identified by an IRI and has a title and a description."@en ;
    sh:not [
        sh:or (
            [ sh:class foxxi-cmi5:CourseStructure ]
            [ sh:class foxxi-cmi5:Block ]
            [ sh:class foxxi-cmi5:Objective ]
            [ sh:class foxxi-cmi5:AssignableUnit ]
            [ sh:class foxxi-cmi5:Session ]
            [ sh:class foxxi-cmi5:LaunchData ]
            [ sh:class foxxi-cmi5:EntitlementKey ]
            [ sh:class foxxi-cmi5:LearnerPreferences ]
        )
    ] ;
    sh:message "cmi5 Course conformance: a Course is not also of a kind this document declares disjoint with it"@en ,
        "cmi5 Course conformance: the node must be identified by an IRI — a globally unique IRI (§13.1.1)"@en ;
    sh:nodeKind sh:IRI ;
    sh:property shapes:CourseShape-title , shapes:CourseShape-description ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/cmi5/shapes> .

shapes:CourseShape-title a sh:PropertyShape ;
    sh:path foxxi-cmi5:title ;
    sh:name "title" ;
    sh:description "title (§13.1.1)"@en ;
    sh:message "cmi5 Course conformance — title: at least 1 value — title (§13.1.1)"@en ;
    sh:minCount 1 .

shapes:CourseShape-description a sh:PropertyShape ;
    sh:path foxxi-cmi5:description ;
    sh:name "description" ;
    sh:description "description (§13.1.1)"@en ;
    sh:message "cmi5 Course conformance — description: at least 1 value — description (§13.1.1)"@en ;
    sh:minCount 1 .

shapes:BlockShape a sh:NodeShape ;
    sh:targetClass foxxi-cmi5:Block ;
    sh:targetObjectsOf foxxi-cmi5:block ;
    rdfs:label "cmi5 Block conformance"@en ;
    rdfs:comment "cmi5 Quartz §13.1.2: a Block is identified by an IRI and has a title and a description."@en ;
    sh:not [
        sh:or (
            [ sh:class foxxi-cmi5:CourseStructure ]
            [ sh:class foxxi-cmi5:Course ]
            [ sh:class foxxi-cmi5:Objective ]
            [ sh:class foxxi-cmi5:AssignableUnit ]
            [ sh:class foxxi-cmi5:Session ]
            [ sh:class foxxi-cmi5:LaunchData ]
            [ sh:class foxxi-cmi5:EntitlementKey ]
            [ sh:class foxxi-cmi5:LearnerPreferences ]
        )
    ] ;
    sh:message "cmi5 Block conformance: a Block is not also of a kind this document declares disjoint with it"@en ,
        "cmi5 Block conformance: the node must be identified by an IRI — an IRI unique within the course structure (§13.1.2)"@en ;
    sh:nodeKind sh:IRI ;
    sh:property shapes:BlockShape-title ,
        shapes:BlockShape-description ,
        shapes:BlockShape-position ,
        shapes:BlockShape-objectives ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/cmi5/shapes> .

shapes:BlockShape-title a sh:PropertyShape ;
    sh:path foxxi-cmi5:title ;
    sh:name "title" ;
    sh:description "title (§13.1.2)"@en ;
    sh:message "cmi5 Block conformance — title: at least 1 value — title (§13.1.2)"@en ;
    sh:minCount 1 .

shapes:BlockShape-description a sh:PropertyShape ;
    sh:path foxxi-cmi5:description ;
    sh:name "description" ;
    sh:description "description (§13.1.2)"@en ;
    sh:message "cmi5 Block conformance — description: at least 1 value — description (§13.1.2)"@en ;
    sh:minCount 1 .

shapes:BlockShape-position a sh:PropertyShape ;
    sh:path foxxi-cmi5:position ;
    sh:name "position" ;
    sh:description "its place in the sequence (§13.1)"@en ;
    sh:message "cmi5 Block conformance — position: at most 1 value, of type xsd:positiveInteger, at least 1 — its place in the sequence (§13.1)"@en ;
    sh:datatype xsd:positiveInteger ;
    sh:maxCount 1 ;
    sh:minInclusive 1 .

shapes:BlockShape-objectives a sh:PropertyShape ;
    sh:path foxxi-cmi5:objectiveReference ;
    sh:name "objectives" ;
    sh:description "each objective it references (§13.1.2)"@en ;
    sh:message "cmi5 Block conformance — objectives: an instance of Objective — each objective it references (§13.1.2)"@en ;
    sh:nodeKind sh:BlankNodeOrIRI .

shapes:AssignableUnitShape a sh:NodeShape ;
    sh:targetClass foxxi-cmi5:AssignableUnit ;
    sh:targetObjectsOf foxxi-cmi5:au , foxxi-cmi5:launchedAU ;
    sh:targetSubjectsOf foxxi-cmi5:url , foxxi-cmi5:launchMethod , foxxi-cmi5:auActivityType , foxxi-cmi5:activityType ;
    rdfs:label "cmi5 Assignable Unit conformance"@en ;
    rdfs:comment "cmi5 Quartz §13.1.4: an AU is identified by an IRI and has a title, a description and a launch URL. moveOn (default NotApplicable) and launchMethod (default AnyWindow) take their vocabularies; masteryScore is a decimal in [0, 1]."@en ;
    sh:not [
        sh:or (
            [ sh:class foxxi-cmi5:CourseStructure ]
            [ sh:class foxxi-cmi5:Course ]
            [ sh:class foxxi-cmi5:Block ]
            [ sh:class foxxi-cmi5:Objective ]
            [ sh:class foxxi-cmi5:Session ]
            [ sh:class foxxi-cmi5:LaunchData ]
            [ sh:class foxxi-cmi5:EntitlementKey ]
            [ sh:class foxxi-cmi5:LearnerPreferences ]
        )
    ] ;
    sh:message "cmi5 Assignable Unit conformance: an AssignableUnit is not also of a kind this document declares disjoint with it"@en ,
        "cmi5 Assignable Unit conformance: the node must be identified by an IRI — an IRI unique within the course structure (§13.1.4)"@en ;
    sh:nodeKind sh:IRI ;
    sh:property shapes:AssignableUnitShape-title ,
        shapes:AssignableUnitShape-description ,
        shapes:AssignableUnitShape-position ,
        shapes:AssignableUnitShape-url ,
        shapes:AssignableUnitShape-moveOn ,
        shapes:AssignableUnitShape-launchMethod ,
        shapes:AssignableUnitShape-masteryScore ,
        shapes:AssignableUnitShape-activityType ,
        shapes:AssignableUnitShape-objectives ,
        shapes:AssignableUnitShape-launchParameters ,
        shapes:AssignableUnitShape-entitlementKey ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/cmi5/shapes> .

shapes:AssignableUnitShape-title a sh:PropertyShape ;
    sh:path foxxi-cmi5:title ;
    sh:name "title" ;
    sh:description "title (§13.1.4)"@en ;
    sh:message "cmi5 Assignable Unit conformance — title: at least 1 value — title (§13.1.4)"@en ;
    sh:minCount 1 .

shapes:AssignableUnitShape-description a sh:PropertyShape ;
    sh:path foxxi-cmi5:description ;
    sh:name "description" ;
    sh:description "description (§13.1.4)"@en ;
    sh:message "cmi5 Assignable Unit conformance — description: at least 1 value — description (§13.1.4)"@en ;
    sh:minCount 1 .

shapes:AssignableUnitShape-position a sh:PropertyShape ;
    sh:path foxxi-cmi5:position ;
    sh:name "position" ;
    sh:description "its place in the sequence (§13.1)"@en ;
    sh:message "cmi5 Assignable Unit conformance — position: at most 1 value, of type xsd:positiveInteger, at least 1 — its place in the sequence (§13.1)"@en ;
    sh:datatype xsd:positiveInteger ;
    sh:maxCount 1 ;
    sh:minInclusive 1 .

shapes:AssignableUnitShape-url a sh:PropertyShape ;
    sh:path foxxi-cmi5:url ;
    sh:name "url" ;
    sh:description "launch URL (§13.1.4)"@en ;
    sh:message "cmi5 Assignable Unit conformance — url: exactly 1 value, of type xsd:anyURI — launch URL (§13.1.4)"@en ;
    sh:datatype xsd:anyURI ;
    sh:minCount 1 ;
    sh:maxCount 1 .

shapes:AssignableUnitShape-moveOn a sh:PropertyShape ;
    sh:path foxxi-cmi5:moveOn ;
    sh:name "moveOn" ;
    sh:description "moveOn vocabulary; NotApplicable when absent (§13.1.4)"@en ;
    sh:message "cmi5 Assignable Unit conformance — moveOn: at most 1 value, one of \"Passed\", \"Completed\", \"CompletedAndPassed\", \"CompletedOrPassed\", \"NotApplicable\" — moveOn vocabulary; NotApplicable when absent (§13.1.4)"@en ;
    sh:maxCount 1 ;
    sh:in ( "Passed" "Completed" "CompletedAndPassed" "CompletedOrPassed" "NotApplicable" ) .

shapes:AssignableUnitShape-launchMethod a sh:PropertyShape ;
    sh:path foxxi-cmi5:launchMethod ;
    sh:name "launchMethod" ;
    sh:description "launchMethod vocabulary; AnyWindow when absent (§13.1.4)"@en ;
    sh:message "cmi5 Assignable Unit conformance — launchMethod: at most 1 value, one of \"OwnWindow\", \"AnyWindow\" — launchMethod vocabulary; AnyWindow when absent (§13.1.4)"@en ;
    sh:maxCount 1 ;
    sh:in ( "OwnWindow" "AnyWindow" ) .

shapes:AssignableUnitShape-masteryScore a sh:PropertyShape ;
    sh:path foxxi-cmi5:masteryScore ;
    sh:name "masteryScore" ;
    sh:description "masteryScore ∈ [0, 1] (§13.1.4)"@en ;
    sh:message "cmi5 Assignable Unit conformance — masteryScore: at most 1 value, of type xsd:integer or xsd:decimal or xsd:double, between 0 and 1 — masteryScore ∈ [0, 1] (§13.1.4)"@en ;
    sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:decimal ] [ sh:datatype xsd:double ] ) ;
    sh:maxCount 1 ;
    sh:minInclusive 0 ;
    sh:maxInclusive 1 .

shapes:AssignableUnitShape-activityType a sh:PropertyShape ;
    sh:path foxxi-cmi5:auActivityType ;
    sh:name "activityType" ;
    sh:description "activity type IRI (§13.1.4)"@en ;
    sh:message "cmi5 Assignable Unit conformance — activityType: at most 1 value, an IRI — activity type IRI (§13.1.4)"@en ;
    sh:nodeKind sh:IRI ;
    sh:maxCount 1 .

shapes:AssignableUnitShape-objectives a sh:PropertyShape ;
    sh:path foxxi-cmi5:objectiveReference ;
    sh:name "objectives" ;
    sh:description "each objective it references (§13.1.4)"@en ;
    sh:message "cmi5 Assignable Unit conformance — objectives: an instance of Objective — each objective it references (§13.1.4)"@en ;
    sh:nodeKind sh:BlankNodeOrIRI .

shapes:AssignableUnitShape-launchParameters a sh:PropertyShape ;
    sh:path foxxi-cmi5:launchParameters ;
    sh:name "launchParameters" ;
    sh:description "static launch parameters (§13.1.4)"@en ;
    sh:message "cmi5 Assignable Unit conformance — launchParameters: at most 1 value, of type xsd:string — static launch parameters (§13.1.4)"@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 .

shapes:AssignableUnitShape-entitlementKey a sh:PropertyShape ;
    sh:path foxxi-cmi5:entitlementKey ;
    sh:name "entitlementKey" ;
    sh:description "entitlement key (§13.1.4)"@en ;
    sh:message "cmi5 Assignable Unit conformance — entitlementKey: at most 1 value, of type xsd:string — entitlement key (§13.1.4)"@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 .

shapes:ObjectiveShape a sh:NodeShape ;
    sh:targetClass foxxi-cmi5:Objective ;
    sh:targetObjectsOf foxxi-cmi5:objective , foxxi-cmi5:objectiveReference ;
    rdfs:label "cmi5 Objective conformance"@en ;
    rdfs:comment "cmi5 Quartz §13.1.3: an Objective is identified by an IRI and has a title and a description."@en ;
    sh:not [
        sh:or (
            [ sh:class foxxi-cmi5:CourseStructure ]
            [ sh:class foxxi-cmi5:Course ]
            [ sh:class foxxi-cmi5:Block ]
            [ sh:class foxxi-cmi5:AssignableUnit ]
            [ sh:class foxxi-cmi5:Session ]
            [ sh:class foxxi-cmi5:LaunchData ]
            [ sh:class foxxi-cmi5:EntitlementKey ]
            [ sh:class foxxi-cmi5:LearnerPreferences ]
        )
    ] ;
    sh:message "cmi5 Objective conformance: an Objective is not also of a kind this document declares disjoint with it"@en ,
        "cmi5 Objective conformance: the node must be identified by an IRI — an IRI unique within the course structure (§13.1.3)"@en ;
    sh:nodeKind sh:IRI ;
    sh:property shapes:ObjectiveShape-title , shapes:ObjectiveShape-description ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/cmi5/shapes> .

shapes:ObjectiveShape-title a sh:PropertyShape ;
    sh:path foxxi-cmi5:title ;
    sh:name "title" ;
    sh:description "title (§13.1.3)"@en ;
    sh:message "cmi5 Objective conformance — title: at least 1 value — title (§13.1.3)"@en ;
    sh:minCount 1 .

shapes:ObjectiveShape-description a sh:PropertyShape ;
    sh:path foxxi-cmi5:description ;
    sh:name "description" ;
    sh:description "description (§13.1.3)"@en ;
    sh:message "cmi5 Objective conformance — description: at least 1 value — description (§13.1.3)"@en ;
    sh:minCount 1 .

shapes:SessionShape a sh:NodeShape ;
    sh:targetClass foxxi-cmi5:Session ;
    sh:targetSubjectsOf foxxi-cmi5:sessionId , foxxi-cmi5:registration , foxxi-cmi5:launchedAU , foxxi-cmi5:learner ;
    rdfs:label "cmi5 session conformance"@en ;
    rdfs:comment "cmi5 Quartz §9.6.1, §9.6.3.1, §10.2.2: a session carries a registration UUID and a session ID; launchMode takes its vocabulary."@en ;
    sh:not [
        sh:or (
            [ sh:class foxxi-cmi5:CourseStructure ]
            [ sh:class foxxi-cmi5:Course ]
            [ sh:class foxxi-cmi5:Block ]
            [ sh:class foxxi-cmi5:Objective ]
            [ sh:class foxxi-cmi5:AssignableUnit ]
            [ sh:class foxxi-cmi5:LaunchData ]
            [ sh:class foxxi-cmi5:EntitlementKey ]
            [ sh:class foxxi-cmi5:LearnerPreferences ]
        )
    ] ;
    sh:message "cmi5 session conformance: a Session is not also of a kind this document declares disjoint with it"@en ;
    sh:property shapes:SessionShape-registration ,
        shapes:SessionShape-sessionId ,
        shapes:SessionShape-launchMode ,
        shapes:SessionShape-launchedAU ,
        shapes:SessionShape-learner ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/cmi5/shapes> .

shapes:SessionShape-registration a sh:PropertyShape ;
    sh:path foxxi-cmi5:registration ;
    sh:name "registration" ;
    sh:description "registration UUID (§9.6.1)"@en ;
    sh:message "cmi5 session conformance — registration: exactly 1 value, matching ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ — registration UUID (§9.6.1)"@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:pattern "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" .

shapes:SessionShape-sessionId a sh:PropertyShape ;
    sh:path foxxi-cmi5:sessionId ;
    sh:name "sessionId" ;
    sh:description "session ID (§9.6.3.1)"@en ;
    sh:message "cmi5 session conformance — sessionId: exactly 1 value, of type xsd:string — session ID (§9.6.3.1)"@en ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 .

shapes:SessionShape-launchMode a sh:PropertyShape ;
    sh:path foxxi-cmi5:launchMode ;
    sh:name "launchMode" ;
    sh:description "launchMode vocabulary (§10.2.2)"@en ;
    sh:message "cmi5 session conformance — launchMode: at most 1 value, one of \"Normal\", \"Browse\", \"Review\" — launchMode vocabulary (§10.2.2)"@en ;
    sh:maxCount 1 ;
    sh:in ( "Normal" "Browse" "Review" ) .

shapes:SessionShape-launchedAU a sh:PropertyShape ;
    sh:path foxxi-cmi5:launchedAU ;
    sh:name "launchedAU" ;
    sh:description "the one AU it is a launch of"@en ;
    sh:message "cmi5 session conformance — launchedAU: at most 1 value — the one AU it is a launch of"@en ;
    sh:maxCount 1 .

shapes:SessionShape-learner a sh:PropertyShape ;
    sh:path foxxi-cmi5:learner ;
    sh:name "learner" ;
    sh:description "the one learner it is for: an Agent with an account (§9.2)"@en ;
    sh:message "cmi5 session conformance — learner: at most 1 value, conforming to LearnerShape — the one learner it is for: an Agent with an account (§9.2)"@en ;
    sh:node shapes:LearnerShape ;
    sh:maxCount 1 .

shapes:LaunchDataShape a sh:NodeShape ;
    sh:targetClass foxxi-cmi5:LaunchData ;
    sh:targetSubjectsOf foxxi-cmi5:contextTemplate , foxxi-cmi5:returnURL ;
    rdfs:label "cmi5 LMS.LaunchData conformance"@en ;
    rdfs:comment "cmi5 Quartz §10.2: the launch data has a context template, a launch mode and a moveOn; a mastery score is a decimal in [0, 1]."@en ;
    sh:not [
        sh:or (
            [ sh:class foxxi-cmi5:CourseStructure ]
            [ sh:class foxxi-cmi5:Course ]
            [ sh:class foxxi-cmi5:Block ]
            [ sh:class foxxi-cmi5:Objective ]
            [ sh:class foxxi-cmi5:AssignableUnit ]
            [ sh:class foxxi-cmi5:Session ]
            [ sh:class foxxi-cmi5:EntitlementKey ]
            [ sh:class foxxi-cmi5:LearnerPreferences ]
        )
    ] ;
    sh:message "cmi5 LMS.LaunchData conformance: a LaunchData is not also of a kind this document declares disjoint with it"@en ;
    sh:property shapes:LaunchDataShape-contextTemplate ,
        shapes:LaunchDataShape-launchMode ,
        shapes:LaunchDataShape-moveOn ,
        shapes:LaunchDataShape-masteryScore ,
        shapes:LaunchDataShape-launchParameters ,
        shapes:LaunchDataShape-returnURL ,
        shapes:LaunchDataShape-entitlementKey ,
        shapes:LaunchDataShape-contextTemplate-sessionid ,
        shapes:LaunchDataShape-contextTemplate-publisher ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/cmi5/shapes> .

shapes:LaunchDataShape-contextTemplate a sh:PropertyShape ;
    sh:path foxxi-cmi5:contextTemplate ;
    sh:name "contextTemplate" ;
    sh:description "context template (§10.2.1)"@en ;
    sh:message "cmi5 LMS.LaunchData conformance — contextTemplate: exactly 1 value — context template (§10.2.1)"@en ;
    sh:minCount 1 ;
    sh:maxCount 1 .

shapes:LaunchDataShape-launchMode a sh:PropertyShape ;
    sh:path foxxi-cmi5:launchMode ;
    sh:name "launchMode" ;
    sh:description "launch mode (§10.2.2)"@en ;
    sh:message "cmi5 LMS.LaunchData conformance — launchMode: exactly 1 value, one of \"Normal\", \"Browse\", \"Review\" — launch mode (§10.2.2)"@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in ( "Normal" "Browse" "Review" ) .

shapes:LaunchDataShape-moveOn a sh:PropertyShape ;
    sh:path foxxi-cmi5:moveOn ;
    sh:name "moveOn" ;
    sh:description "moveOn (§10.2.5)"@en ;
    sh:message "cmi5 LMS.LaunchData conformance — moveOn: exactly 1 value, one of \"Passed\", \"Completed\", \"CompletedAndPassed\", \"CompletedOrPassed\", \"NotApplicable\" — moveOn (§10.2.5)"@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in ( "Passed" "Completed" "CompletedAndPassed" "CompletedOrPassed" "NotApplicable" ) .

shapes:LaunchDataShape-masteryScore a sh:PropertyShape ;
    sh:path foxxi-cmi5:masteryScore ;
    sh:name "masteryScore" ;
    sh:description "masteryScore ∈ [0, 1] (§10.2.4)"@en ;
    sh:message "cmi5 LMS.LaunchData conformance — masteryScore: at most 1 value, of type xsd:integer or xsd:decimal or xsd:double, between 0 and 1 — masteryScore ∈ [0, 1] (§10.2.4)"@en ;
    sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:decimal ] [ sh:datatype xsd:double ] ) ;
    sh:maxCount 1 ;
    sh:minInclusive 0 ;
    sh:maxInclusive 1 .

shapes:LaunchDataShape-launchParameters a sh:PropertyShape ;
    sh:path foxxi-cmi5:launchParameters ;
    sh:name "launchParameters" ;
    sh:description "launch parameters (§10.2.3)"@en ;
    sh:message "cmi5 LMS.LaunchData conformance — launchParameters: at most 1 value, of type xsd:string — launch parameters (§10.2.3)"@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 .

shapes:LaunchDataShape-returnURL a sh:PropertyShape ;
    sh:path foxxi-cmi5:returnURL ;
    sh:name "returnURL" ;
    sh:description "return URL (§10.2.6)"@en ;
    sh:message "cmi5 LMS.LaunchData conformance — returnURL: at most 1 value, of type xsd:anyURI — return URL (§10.2.6)"@en ;
    sh:datatype xsd:anyURI ;
    sh:maxCount 1 .

shapes:LaunchDataShape-entitlementKey a sh:PropertyShape ;
    sh:path foxxi-cmi5:launchEntitlementKey ;
    sh:name "entitlementKey" ;
    sh:description "entitlement key object (§10.2.7)"@en ;
    sh:message "cmi5 LMS.LaunchData conformance — entitlementKey: at most 1 value — entitlement key object (§10.2.7)"@en ;
    sh:maxCount 1 .

shapes:LaunchDataShape-contextTemplate-sessionid a sh:PropertyShape ;
    sh:path (
        foxxi-cmi5:contextTemplate
        foxxi-xapi:extensions
        <https://w3id.org/xapi/cmi5/context/extensions/sessionid>
    ) ;
    sh:name "contextTemplate.extensions.sessionid" ;
    sh:description "the session ID, in the context template's extensions (§10.2.1, §9.6.3.1)"@en ;
    sh:message "cmi5 LMS.LaunchData conformance — contextTemplate.extensions.sessionid: exactly 1 value — the session ID, in the context template's extensions (§10.2.1, §9.6.3.1)"@en ;
    sh:minCount 1 ;
    sh:maxCount 1 .

shapes:LaunchDataShape-contextTemplate-publisher a sh:PropertyShape ;
    sh:path ( foxxi-cmi5:contextTemplate foxxi-xapi:contextActivities foxxi-xapi:grouping ) ;
    sh:name "contextTemplate.contextActivities.grouping" ;
    sh:description "the publisher ID activity, in the context template's grouping list (§10.2.1, §9.6.2.3)"@en ;
    sh:message "cmi5 LMS.LaunchData conformance — contextTemplate.contextActivities.grouping: at least 1 value — the publisher ID activity, in the context template's grouping list (§10.2.1, §9.6.2.3)"@en ;
    sh:minCount 1 .

shapes:EntitlementKeyShape a sh:NodeShape ;
    sh:targetClass foxxi-cmi5:EntitlementKey ;
    sh:targetObjectsOf foxxi-cmi5:launchEntitlementKey ;
    sh:targetSubjectsOf foxxi-cmi5:courseStructureKey , foxxi-cmi5:alternateKey ;
    rdfs:label "cmi5 entitlement key conformance"@en ;
    rdfs:comment "cmi5 Quartz §10.2.7: the entitlement key in the launch data carries the key from the course structure, which the LMS must provide, and may carry an alternate key; each is a string. The document names them \"courseStructure\" and \"alternate\"."@en ;
    sh:not [
        sh:or (
            [ sh:class foxxi-cmi5:CourseStructure ]
            [ sh:class foxxi-cmi5:Course ]
            [ sh:class foxxi-cmi5:Block ]
            [ sh:class foxxi-cmi5:Objective ]
            [ sh:class foxxi-cmi5:AssignableUnit ]
            [ sh:class foxxi-cmi5:Session ]
            [ sh:class foxxi-cmi5:LaunchData ]
            [ sh:class foxxi-cmi5:LearnerPreferences ]
        )
    ] ;
    sh:message "cmi5 entitlement key conformance: an EntitlementKey is not also of a kind this document declares disjoint with it"@en ;
    sh:property shapes:EntitlementKeyShape-courseStructure , shapes:EntitlementKeyShape-alternate ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/cmi5/shapes> .

shapes:EntitlementKeyShape-courseStructure a sh:PropertyShape ;
    sh:path foxxi-cmi5:courseStructureKey ;
    sh:name "courseStructure" ;
    sh:description "the key from the course structure (§10.2.7.1)"@en ;
    sh:message "cmi5 entitlement key conformance — courseStructure: exactly 1 value, of type xsd:string — the key from the course structure (§10.2.7.1)"@en ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 .

shapes:EntitlementKeyShape-alternate a sh:PropertyShape ;
    sh:path foxxi-cmi5:alternateKey ;
    sh:name "alternate" ;
    sh:description "an alternate key (§10.2.7.2)"@en ;
    sh:message "cmi5 entitlement key conformance — alternate: at most 1 value, of type xsd:string — an alternate key (§10.2.7.2)"@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 .

shapes:LearnerShape a sh:NodeShape ;
    rdfs:label "cmi5 learner"@en ;
    rdfs:comment "cmi5 Quartz §9.2: the actor of a cmi5 session is an Agent, not a Group, identified by an account; an xAPI Agent written as xAPI writes one, read through /ns/xapi/context."@en ;
    sh:property shapes:LearnerShape-account , shapes:LearnerShape-objectType ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/cmi5/shapes> .

shapes:LearnerShape-account a sh:PropertyShape ;
    sh:path foxxi-xapi:account ;
    sh:name "account" ;
    sh:description "identified by an account (§9.2)"@en ;
    sh:message "cmi5 learner — account: at least 1 value — identified by an account (§9.2)"@en ;
    sh:minCount 1 .

shapes:LearnerShape-objectType a sh:PropertyShape ;
    sh:path rdf:type ;
    sh:name "objectType" ;
    sh:description "an Agent, not a Group (§9.2)"@en ;
    sh:message "cmi5 learner — objectType: never foxxi-xapi:Group — an Agent, not a Group (§9.2)"@en ;
    sh:not [ sh:hasValue foxxi-xapi:Group ] .

shapes:LearnerPreferencesShape a sh:NodeShape ;
    sh:targetClass foxxi-cmi5:LearnerPreferences ;
    sh:targetSubjectsOf foxxi-cmi5:languagePreference , foxxi-cmi5:audioPreference ;
    rdfs:label "cmi5 learner preferences conformance"@en ;
    rdfs:comment "cmi5 Quartz §11: languagePreference is a comma-separated list of RFC 5646 tags; audioPreference is \"on\" or \"off\"."@en ;
    sh:not [
        sh:or (
            [ sh:class foxxi-cmi5:CourseStructure ]
            [ sh:class foxxi-cmi5:Course ]
            [ sh:class foxxi-cmi5:Block ]
            [ sh:class foxxi-cmi5:Objective ]
            [ sh:class foxxi-cmi5:AssignableUnit ]
            [ sh:class foxxi-cmi5:Session ]
            [ sh:class foxxi-cmi5:LaunchData ]
            [ sh:class foxxi-cmi5:EntitlementKey ]
        )
    ] ;
    sh:message "cmi5 learner preferences conformance: a LearnerPreferences is not also of a kind this document declares disjoint with it"@en ;
    sh:property shapes:LearnerPreferencesShape-languagePreference , shapes:LearnerPreferencesShape-audioPreference ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/cmi5/shapes> .

shapes:LearnerPreferencesShape-languagePreference a sh:PropertyShape ;
    sh:path foxxi-cmi5:languagePreference ;
    sh:name "languagePreference" ;
    sh:description "RFC 5646 tags, most preferred first (§11.1)"@en ;
    sh:message "cmi5 learner preferences conformance — languagePreference: at most 1 value, of type xsd:string, matching ^[A-Za-z]{1,8}(-[A-Za-z0-9]{1,8})*(,[A-Za-z]{1,8}(-[A-Za-z0-9]{1,8})*)*$ — RFC 5646 tags, most preferred first (§11.1)"@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:pattern "^[A-Za-z]{1,8}(-[A-Za-z0-9]{1,8})*(,[A-Za-z]{1,8}(-[A-Za-z0-9]{1,8})*)*$" .

shapes:LearnerPreferencesShape-audioPreference a sh:PropertyShape ;
    sh:path foxxi-cmi5:audioPreference ;
    sh:name "audioPreference" ;
    sh:description "\"on\" or \"off\" (§11.2)"@en ;
    sh:message "cmi5 learner preferences conformance — audioPreference: at most 1 value, one of \"on\", \"off\" — \"on\" or \"off\" (§11.2)"@en ;
    sh:maxCount 1 ;
    sh:in ( "on" "off" ) .
