foxxi-nist-rmf:Function a owl:Class ;
    rdfs:label "AI RMF Core Function"@en ;
    rdfs:comment "One of the four functions of the NIST AI RMF 1.0 core. Its instances are the four concepts of this document's CoreFunction list. A record of an action that addresses a function (addressesFunction) is evidence toward it."@en ;
    skos:definition "One of the four functions of the NIST AI RMF 1.0 core. Its instances are the four concepts of this document's CoreFunction list. A record of an action that addresses a function (addressesFunction) is evidence toward it."@en ;
    skos:changeNote "2026.10.1: typed onto the CoreFunction concepts that name the functions."@en ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/nist-rmf> .

foxxi-nist-rmf:Govern a owl:Class ;
    rdfs:label "Govern"@en ;
    rdfs:comment "Cultivate a culture of risk management; policies, accountability, and oversight structures are in place and applied. Its one instance is the concept GOVERN; the class is kept to match the substrate's nist-rmf:Govern."@en ;
    skos:definition "Cultivate a culture of risk management; policies, accountability, and oversight structures are in place and applied. Its one instance is the concept GOVERN; the class is kept to match the substrate's nist-rmf:Govern."@en ;
    rdfs:subClassOf foxxi-nist-rmf:Function ;
    skos:closeMatch nist-rmf:Govern ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/nist-rmf> .

foxxi-nist-rmf:Map a owl:Class ;
    rdfs:label "Map"@en ;
    rdfs:comment "Establish the context to frame risks; categorize the AI system and its capabilities, intended uses, and impacts. Its one instance is the concept MAP; the class is kept to match the substrate's nist-rmf:Map."@en ;
    skos:definition "Establish the context to frame risks; categorize the AI system and its capabilities, intended uses, and impacts. Its one instance is the concept MAP; the class is kept to match the substrate's nist-rmf:Map."@en ;
    rdfs:subClassOf foxxi-nist-rmf:Function ;
    skos:closeMatch nist-rmf:Map ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/nist-rmf> .

foxxi-nist-rmf:Measure a owl:Class ;
    rdfs:label "Measure"@en ;
    rdfs:comment "Employ quantitative, qualitative, or mixed methods to analyze, assess, benchmark, and monitor AI risk. Its one instance is the concept MEASURE; the class is kept to match the substrate's nist-rmf:Measure."@en ;
    skos:definition "Employ quantitative, qualitative, or mixed methods to analyze, assess, benchmark, and monitor AI risk. Its one instance is the concept MEASURE; the class is kept to match the substrate's nist-rmf:Measure."@en ;
    rdfs:subClassOf foxxi-nist-rmf:Function ;
    skos:closeMatch nist-rmf:Measure ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/nist-rmf> .

foxxi-nist-rmf:Manage a owl:Class ;
    rdfs:label "Manage"@en ;
    rdfs:comment "Allocate resources to mapped and measured risks; respond to, recover from, and communicate about incidents. Its one instance is the concept MANAGE; the class is kept to match the substrate's nist-rmf:Manage."@en ;
    skos:definition "Allocate resources to mapped and measured risks; respond to, recover from, and communicate about incidents. Its one instance is the concept MANAGE; the class is kept to match the substrate's nist-rmf:Manage."@en ;
    rdfs:subClassOf foxxi-nist-rmf:Function ;
    skos:closeMatch nist-rmf:Manage ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/nist-rmf> .

foxxi-nist-rmf:addressesFunction a owl:ObjectProperty ;
    rdfs:label "addresses function"@en ;
    skos:notation "addressesFunction" ;
    rdfs:comment "Names the AI RMF core function (one of this document's CoreFunction concepts) that the subject, a record of an action or a control, contributes to."@en ;
    skos:definition "Names the AI RMF core function (one of this document's CoreFunction concepts) that the subject, a record of an action or a control, contributes to."@en ;
    rdfs:range foxxi-nist-rmf:Function ;
    skos:relatedMatch nist-rmf:contributesTo ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/nist-rmf> .

foxxi-nist-rmf:functionId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "function ID"@en ;
    skos:notation "functionId" ;
    rdfs:comment "The id of a core function, as the AI RMF names it in capitals: GOVERN, MAP, MEASURE or MANAGE."@en ;
    skos:definition "The id of a core function, as the AI RMF names it in capitals: GOVERN, MAP, MEASURE or MANAGE."@en ;
    rdfs:domain foxxi-nist-rmf:Function ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "GOVERN" "MAP" "MEASURE" "MANAGE" ) ] ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/nist-rmf> .

foxxi-nist-rmf:CoreFunction a skos:ConceptScheme ;
    rdfs:label "NIST AI RMF Core Functions"@en ;
    skos:prefLabel "NIST AI RMF Core Functions"@en ;
    skos:definition "The four functions of the AI RMF 1.0 core."@en ;
    rdfs:comment "The four functions of the AI RMF 1.0 core."@en ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/nist-rmf> ;
    skos:hasTopConcept foxxi-nist-rmf:CoreFunction-GOVERN ,
        foxxi-nist-rmf:CoreFunction-MAP ,
        foxxi-nist-rmf:CoreFunction-MEASURE ,
        foxxi-nist-rmf:CoreFunction-MANAGE .

foxxi-nist-rmf:CoreFunction-GOVERN a skos:Concept , foxxi-nist-rmf:Function , foxxi-nist-rmf:Govern ;
    skos:inScheme foxxi-nist-rmf:CoreFunction ;
    skos:topConceptOf foxxi-nist-rmf:CoreFunction ;
    skos:prefLabel "GOVERN"@en ;
    rdfs:label "GOVERN (NIST AI RMF Core Functions)"@en ;
    skos:notation "GOVERN" ;
    skos:definition "Risk-management culture, policies, accountability, oversight."@en ;
    rdfs:comment "Risk-management culture, policies, accountability, oversight."@en ;
    foxxi-nist-rmf:functionId "GOVERN" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/nist-rmf> .

foxxi-nist-rmf:CoreFunction-MAP a skos:Concept , foxxi-nist-rmf:Function , foxxi-nist-rmf:Map ;
    skos:inScheme foxxi-nist-rmf:CoreFunction ;
    skos:topConceptOf foxxi-nist-rmf:CoreFunction ;
    skos:prefLabel "MAP"@en ;
    rdfs:label "MAP (NIST AI RMF Core Functions)"@en ;
    skos:notation "MAP" ;
    skos:definition "Context, categorization, capabilities, intended use, impacts."@en ;
    rdfs:comment "Context, categorization, capabilities, intended use, impacts."@en ;
    foxxi-nist-rmf:functionId "MAP" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/nist-rmf> .

foxxi-nist-rmf:CoreFunction-MEASURE a skos:Concept , foxxi-nist-rmf:Function , foxxi-nist-rmf:Measure ;
    skos:inScheme foxxi-nist-rmf:CoreFunction ;
    skos:topConceptOf foxxi-nist-rmf:CoreFunction ;
    skos:prefLabel "MEASURE"@en ;
    rdfs:label "MEASURE (NIST AI RMF Core Functions)"@en ;
    skos:notation "MEASURE" ;
    skos:definition "Analyze, assess, benchmark, monitor AI risk."@en ;
    rdfs:comment "Analyze, assess, benchmark, monitor AI risk."@en ;
    foxxi-nist-rmf:functionId "MEASURE" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/nist-rmf> .

foxxi-nist-rmf:CoreFunction-MANAGE a skos:Concept , foxxi-nist-rmf:Function , foxxi-nist-rmf:Manage ;
    skos:inScheme foxxi-nist-rmf:CoreFunction ;
    skos:topConceptOf foxxi-nist-rmf:CoreFunction ;
    skos:prefLabel "MANAGE"@en ;
    rdfs:label "MANAGE (NIST AI RMF Core Functions)"@en ;
    skos:notation "MANAGE" ;
    skos:definition "Prioritize, respond, recover, communicate about risk."@en ;
    rdfs:comment "Prioritize, respond, recover, communicate about risk."@en ;
    foxxi-nist-rmf:functionId "MANAGE" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/nist-rmf> .

[
    a owl:AllDisjointClasses ;
    owl:members ( foxxi-nist-rmf:Govern foxxi-nist-rmf:Map foxxi-nist-rmf:Measure foxxi-nist-rmf:Manage )
] .

prov:wasDerivedFrom a owl:ObjectProperty ;
    rdfs:label "was derived from"@en ;
    rdfs:comment "A transformation of an entity into another, an update of an entity resulting in a new one, or the construction of a new entity based on a pre-existing one. (PROV-O)"@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o> ;
    rdfs:domain prov:Entity ;
    rdfs:range prov:Entity .

skos:ConceptScheme a owl:Class ;
    rdfs:label "Concept Scheme"@en ;
    rdfs:comment "A set of concepts, optionally including statements about semantic relationships between those concepts. (SKOS)"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    owl:disjointWith skos:Concept .

skos:hasTopConcept a owl:ObjectProperty ;
    rdfs:label "has top concept"@en ;
    rdfs:comment "Relates, by convention, a concept scheme to a concept which is topmost in the broader/narrower concept hierarchies for that scheme. (SKOS)"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:domain skos:ConceptScheme ;
    rdfs:range skos:Concept .

skos:Concept a owl:Class ;
    rdfs:label "Concept"@en ;
    rdfs:comment "An idea or notion; a unit of thought. (SKOS)"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> .

skos:inScheme a owl:ObjectProperty ;
    rdfs:label "is in scheme"@en ;
    rdfs:comment "Relates a resource (for example a concept) to a concept scheme in which it is included. (SKOS)"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:range skos:ConceptScheme .

skos:topConceptOf a owl:ObjectProperty ;
    rdfs:label "is top concept in scheme"@en ;
    rdfs:comment "Relates a concept to the concept scheme that it is a top level concept of. (SKOS)"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:inScheme ;
    owl:inverseOf skos:hasTopConcept .

prov:Entity a owl:Class ;
    rdfs:label "Entity"@en ;
    rdfs:comment "A physical, digital, conceptual, or other kind of thing with some fixed aspects. (PROV-O)"@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o> .

