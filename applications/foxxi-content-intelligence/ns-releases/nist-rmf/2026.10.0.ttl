<https://foxxi-bridge.interego.xwisee.com/ns/nist-rmf> a owl:Ontology ;
    dct:title "NIST AI Risk Management Framework 1.0 — function mapping"@en ;
    dct:description "OWL + SHACL projection of the substrate L3 NIST AI RMF mapping (docs/ns/nist-rmf.ttl): the four core functions (Govern / Map / Measure / Manage), so that a record of an action can name the function it contributes to. Composed into PGSL and projected here so a cited function IRI dereferences."@en ;
    rdfs:comment "Independent formalization by Mark Spivey (Foxxi Mediums Inc.). Not affiliated with or endorsed by NIST. Where this document and the published standard differ, the standard governs."@en ,
        "AI RMF 1.0 is the current version of the framework; NIST's later publications, such as the Generative AI Profile (NIST AI 600-1, 2024), are profiles of it and keep its four functions."@en ,
        "Mapped to the Interego substrate's NIST AI RMF vocabulary (prefix nist-rmf:, docs/ns/nist-rmf.ttl) by SKOS mappings."@en ;
    owl:versionIRI <https://foxxi-bridge.interego.xwisee.com/ns/nist-rmf/2026.10.0> ;
    owl:versionInfo "2026.10.0" ;
    skos:historyNote "Versioned by calendar (YYYY.MM.PATCH) from 2026.10.0: the version numbers this document, not the standard it formalizes. Every released version stays resolvable at its version IRI, and the content there never changes. Earlier publications carried no version IRI, and their owl:versionInfo restated the version of the standard."@en ;
    dct:creator "Mark Spivey" ;
    dct:contributor "Claude (Anthropic)" ;
    dct:publisher "Foxxi Mediums Inc." ;
    dct:license <https://opensource.org/licenses/MIT> ;
    dct:rights "© 2026 Mark Spivey (Foxxi Mediums Inc.). Released under the MIT License."@en ;
    dct:created "2026-06-19"^^xsd:date ;
    dct:modified "2026-10-12"^^xsd:date ;
    dct:issued "2026-10-12"^^xsd:date ;
    dct:language <http://id.loc.gov/vocabulary/iso639-1/en> ;
    bibo:status <http://purl.org/ontology/bibo/status/published> ;
    dct:bibliographicCitation "Spivey, M. (2026). NIST AI Risk Management Framework 1.0 — function mapping (Version 2026.10.0) [Ontology]. Foxxi Mediums Inc. https://foxxi-bridge.interego.xwisee.com/ns/nist-rmf/2026.10.0" ;
    vann:preferredNamespacePrefix "foxxi-nist-rmf" ;
    vann:preferredNamespaceUri "https://foxxi-bridge.interego.xwisee.com/ns/nist-rmf#" ;
    dct:source <https://doi.org/10.6028/NIST.AI.100-1> ;
    prov:wasDerivedFrom <https://github.com/markjspivey-xwisee/interego/blob/master/applications/foxxi-content-intelligence/src/spec/compliance.model.ts> ,
        <https://github.com/markjspivey-xwisee/interego/blob/master/applications/foxxi-content-intelligence/src/spec-ontology.ts> ;
    rdfs:seeAlso <https://foxxi-bridge.interego.xwisee.com/ns/nist-rmf/shapes> ,
        <https://foxxi-bridge.interego.xwisee.com/ns/nist-rmf/mappings> ,
        <https://markjspivey-xwisee.github.io/interego/ns/nist-rmf> ,
        <https://www.nist.gov/itl/ai-risk-management-framework> .

foxxi-nist-rmf:Function a owl:Class ;
    rdfs:label "AI RMF Core Function"@en ;
    rdfs:comment "One of the four NIST AI RMF core functions. A substrate action addressing a function provides evidence toward it."@en ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/nist-rmf> .

foxxi-nist-rmf:Govern a owl:Class ;
    rdfs:label "Govern"@en ;
    rdfs:comment "Cultivate a culture of risk management; policies, accountability, and oversight structures are in place and applied."@en ;
    rdfs:subClassOf foxxi-nist-rmf:Function ;
    skos:closeMatch nist-rmf:Govern ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/nist-rmf> .

foxxi-nist-rmf:Map a owl:Class ;
    rdfs:label "Map"@en ;
    rdfs:comment "Establish the context to frame risks; categorize the AI system and its capabilities, intended uses, and impacts."@en ;
    rdfs:subClassOf foxxi-nist-rmf:Function ;
    skos:closeMatch nist-rmf:Map ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/nist-rmf> .

foxxi-nist-rmf:Measure a owl:Class ;
    rdfs:label "Measure"@en ;
    rdfs:comment "Employ quantitative, qualitative, or mixed methods to analyze, assess, benchmark, and monitor AI risk."@en ;
    rdfs:subClassOf foxxi-nist-rmf:Function ;
    skos:closeMatch nist-rmf:Measure ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/nist-rmf> .

foxxi-nist-rmf:Manage a owl:Class ;
    rdfs:label "Manage"@en ;
    rdfs:comment "Allocate resources to mapped and measured risks; respond to, recover from, and communicate about incidents."@en ;
    rdfs:subClassOf foxxi-nist-rmf:Function ;
    skos:closeMatch nist-rmf:Manage ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/nist-rmf> .

foxxi-nist-rmf:addressesFunction a owl:ObjectProperty ;
    rdfs:label "addresses function"@en ;
    skos:notation "addressesFunction" ;
    rdfs:comment "Asserts the subject action / control addresses the named NIST AI RMF function."@en ;
    rdfs:range foxxi-nist-rmf:Function ;
    skos:relatedMatch nist-rmf:contributesTo ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/nist-rmf> .

foxxi-nist-rmf:functionId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "function ID"@en ;
    skos:notation "functionId" ;
    rdfs:comment "The short id of the function (GOVERN / MAP / MEASURE / MANAGE)."@en ;
    rdfs:domain foxxi-nist-rmf:Function ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "GOVERN" "MAP" "MEASURE" "MANAGE" ) ] ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/nist-rmf> .

foxxi-nist-rmf:CoreFunction a skos:ConceptScheme ;
    rdfs:label "NIST AI RMF Core Functions"@en ;
    skos:prefLabel "NIST AI RMF Core Functions"@en ;
    rdfs:comment "The four functions of the AI RMF 1.0 core."@en ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/nist-rmf> ;
    skos:hasTopConcept foxxi-nist-rmf:CoreFunction-GOVERN ,
        foxxi-nist-rmf:CoreFunction-MAP ,
        foxxi-nist-rmf:CoreFunction-MEASURE ,
        foxxi-nist-rmf:CoreFunction-MANAGE .

foxxi-nist-rmf:CoreFunction-GOVERN a skos:Concept ;
    skos:inScheme foxxi-nist-rmf:CoreFunction ;
    skos:topConceptOf foxxi-nist-rmf:CoreFunction ;
    skos:prefLabel "GOVERN"@en ;
    rdfs:label "GOVERN (NIST AI RMF Core Functions)"@en ;
    skos:notation "GOVERN" ;
    skos:definition "Risk-management culture, policies, accountability, oversight."@en ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/nist-rmf> .

foxxi-nist-rmf:CoreFunction-MAP a skos:Concept ;
    skos:inScheme foxxi-nist-rmf:CoreFunction ;
    skos:topConceptOf foxxi-nist-rmf:CoreFunction ;
    skos:prefLabel "MAP"@en ;
    rdfs:label "MAP (NIST AI RMF Core Functions)"@en ;
    skos:notation "MAP" ;
    skos:definition "Context, categorization, capabilities, intended use, impacts."@en ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/nist-rmf> .

foxxi-nist-rmf:CoreFunction-MEASURE a skos:Concept ;
    skos:inScheme foxxi-nist-rmf:CoreFunction ;
    skos:topConceptOf foxxi-nist-rmf:CoreFunction ;
    skos:prefLabel "MEASURE"@en ;
    rdfs:label "MEASURE (NIST AI RMF Core Functions)"@en ;
    skos:notation "MEASURE" ;
    skos:definition "Analyze, assess, benchmark, monitor AI risk."@en ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/nist-rmf> .

foxxi-nist-rmf:CoreFunction-MANAGE a skos:Concept ;
    skos:inScheme foxxi-nist-rmf:CoreFunction ;
    skos:topConceptOf foxxi-nist-rmf:CoreFunction ;
    skos:prefLabel "MANAGE"@en ;
    rdfs:label "MANAGE (NIST AI RMF Core Functions)"@en ;
    skos:notation "MANAGE" ;
    skos:definition "Prioritize, respond, recover, communicate about risk."@en ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/nist-rmf> .

[
    a owl:AllDisjointClasses ;
    owl:members ( foxxi-nist-rmf:Govern foxxi-nist-rmf:Map foxxi-nist-rmf:Measure foxxi-nist-rmf:Manage )
] .

prov:wasDerivedFrom a owl:ObjectProperty ;
    rdfs:label "was derived from"@en ;
    rdfs:comment "A transformation of an entity into another, an update of an entity resulting in a new one, or the construction of a new entity based on a pre-existing one. (PROV-O)"@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o> ;
    rdfs:domain prov:Entity ;
    rdfs:range prov:Entity .

skos:ConceptScheme a owl:Class ;
    rdfs:label "Concept Scheme"@en ;
    rdfs:comment "A set of concepts, optionally including statements about semantic relationships between those concepts. (SKOS)"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    owl:disjointWith skos:Concept .

skos:hasTopConcept a owl:ObjectProperty ;
    rdfs:label "has top concept"@en ;
    rdfs:comment "Relates, by convention, a concept scheme to a concept which is topmost in the broader/narrower concept hierarchies for that scheme. (SKOS)"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:domain skos:ConceptScheme ;
    rdfs:range skos:Concept .

skos:Concept a owl:Class ;
    rdfs:label "Concept"@en ;
    rdfs:comment "An idea or notion; a unit of thought. (SKOS)"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> .

skos:inScheme a owl:ObjectProperty ;
    rdfs:label "is in scheme"@en ;
    rdfs:comment "Relates a resource (for example a concept) to a concept scheme in which it is included. (SKOS)"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:range skos:ConceptScheme .

skos:topConceptOf a owl:ObjectProperty ;
    rdfs:label "is top concept in scheme"@en ;
    rdfs:comment "Relates a concept to the concept scheme that it is a top level concept of. (SKOS)"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:inScheme ;
    owl:inverseOf skos:hasTopConcept .

prov:Entity a owl:Class ;
    rdfs:label "Entity"@en ;
    rdfs:comment "A physical, digital, conceptual, or other kind of thing with some fixed aspects. (PROV-O)"@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o> .

