shapes:SignedInteractionRecordShape a sh:NodeShape ;
    sh:targetClass foxxi-ai-elearning:SignedInteractionRecord ;
    sh:targetSubjectsOf foxxi-ai-elearning:signedEnvelope ,
        foxxi-ai-elearning:signedBy ,
        foxxi-ai-elearning:recordedAt ,
        foxxi-ai-elearning:attestedModel ,
        foxxi-ai-elearning:citedSource ,
        foxxi-ai-elearning:confidenceProof ,
        foxxi-ai-elearning:interventionEfficacy ;
    rdfs:label "Verifiable AI-interaction record conformance"@en ;
    rdfs:comment "A recorded AI interaction MUST carry a signature and a recovered signer and a record time — so the \"audit trail\" is tamper-evident evidence, not self-asserted text. This is the constraint the self-asserted vendor pattern lacks."@en ;
    sh:property shapes:SignedInteractionRecordShape-signedEnvelope ,
        shapes:SignedInteractionRecordShape-signer ,
        shapes:SignedInteractionRecordShape-recordedAt ,
        shapes:SignedInteractionRecordShape-interventionEfficacy ,
        shapes:SignedInteractionRecordShape-confidenceProof ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/ai-elearning/shapes> .

shapes:SignedInteractionRecordShape-signedEnvelope a sh:PropertyShape ;
    sh:path foxxi-ai-elearning:signedEnvelope ;
    sh:name "signedEnvelope" ;
    sh:description "the rev-196 signed envelope carrying the statement"@en ;
    sh:message "Verifiable AI-interaction record conformance — signedEnvelope: exactly 1 value, of type xsd:string — the rev-196 signed envelope carrying the statement"@en ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 .

shapes:SignedInteractionRecordShape-signer a sh:PropertyShape ;
    sh:path foxxi-ai-elearning:signedBy ;
    sh:name "signer" ;
    sh:description "the recovered signer DID — proves who recorded it"@en ;
    sh:message "Verifiable AI-interaction record conformance — signer: exactly 1 value, an IRI, matching ^did:(ethr|key|web|pkh):.+ — the recovered signer DID — proves who recorded it"@en ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:pattern "^did:(ethr|key|web|pkh):.+" .

shapes:SignedInteractionRecordShape-recordedAt a sh:PropertyShape ;
    sh:path foxxi-ai-elearning:recordedAt ;
    sh:name "recordedAt" ;
    sh:description "the signing instant (backdating detectable)"@en ;
    sh:message "Verifiable AI-interaction record conformance — recordedAt: exactly 1 value, of type xsd:dateTime — the signing instant (backdating detectable)"@en ;
    sh:datatype xsd:dateTime ;
    sh:minCount 1 ;
    sh:maxCount 1 .

shapes:SignedInteractionRecordShape-interventionEfficacy a sh:PropertyShape ;
    sh:path foxxi-ai-elearning:interventionEfficacy ;
    sh:name "interventionEfficacy" ;
    sh:description "optional separate efficacy rate (not a calibration)"@en ;
    sh:message "Verifiable AI-interaction record conformance — interventionEfficacy: at most 1 value, of type xsd:integer or xsd:decimal or xsd:double, between 0 and 1 — optional separate efficacy rate (not a calibration)"@en ;
    sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:decimal ] [ sh:datatype xsd:double ] ) ;
    sh:maxCount 1 ;
    sh:minInclusive 0 ;
    sh:maxInclusive 1 .

shapes:SignedInteractionRecordShape-confidenceProof a sh:PropertyShape ;
    sh:path foxxi-ai-elearning:confidenceProof ;
    sh:name "confidenceProof" ;
    sh:description "at most one confidence range proof"@en ;
    sh:message "Verifiable AI-interaction record conformance — confidenceProof: at most 1 value — at most one confidence range proof"@en ;
    sh:maxCount 1 .

shapes:AttestedModelClaimShape a sh:NodeShape ;
    sh:targetClass foxxi-ai-elearning:AttestedModelClaim ;
    sh:targetObjectsOf foxxi-ai-elearning:attestedModel ;
    sh:targetSubjectsOf foxxi-ai-elearning:modelClaimSignedBy , foxxi-ai-elearning:model , foxxi-ai-elearning:provider ;
    rdfs:label "Attested model/provider conformance"@en ;
    rdfs:comment "A model/provider claim MUST be signed — attributable to the gateway that made the call — rather than free text the spec trusts."@en ;
    sh:property shapes:AttestedModelClaimShape-modelClaimSigner ,
        shapes:AttestedModelClaimShape-model ,
        shapes:AttestedModelClaimShape-provider ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/ai-elearning/shapes> .

shapes:AttestedModelClaimShape-modelClaimSigner a sh:PropertyShape ;
    sh:path foxxi-ai-elearning:modelClaimSignedBy ;
    sh:name "modelClaimSigner" ;
    sh:description "the gateway DID that signed the claim"@en ;
    sh:message "Attested model/provider conformance — modelClaimSigner: exactly 1 value, an IRI, matching ^did:(ethr|key|web|pkh):.+ — the gateway DID that signed the claim"@en ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:pattern "^did:(ethr|key|web|pkh):.+" .

shapes:AttestedModelClaimShape-model a sh:PropertyShape ;
    sh:path foxxi-ai-elearning:model ;
    sh:name "model" ;
    sh:description "the attested model"@en ;
    sh:message "Attested model/provider conformance — model: exactly 1 value, of type xsd:string — the attested model"@en ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 .

shapes:AttestedModelClaimShape-provider a sh:PropertyShape ;
    sh:path foxxi-ai-elearning:provider ;
    sh:name "provider" ;
    sh:description "the attested provider"@en ;
    sh:message "Attested model/provider conformance — provider: at most 1 value, of type xsd:string — the attested provider"@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 .

shapes:ContentAddressedSourceShape a sh:NodeShape ;
    sh:targetClass foxxi-ai-elearning:ContentAddressedSource ;
    sh:targetObjectsOf foxxi-ai-elearning:citedSource ;
    sh:targetSubjectsOf foxxi-ai-elearning:citesAtom ;
    rdfs:label "Content-addressed source conformance"@en ;
    rdfs:comment "A cited source MUST be content-addressed to a urn:pgsl:atom so it resolves to exactly the bytes used — replacing a bare source string."@en ;
    sh:property shapes:ContentAddressedSourceShape-sourceAtom ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/ai-elearning/shapes> .

shapes:ContentAddressedSourceShape-sourceAtom a sh:PropertyShape ;
    sh:path foxxi-ai-elearning:citesAtom ;
    sh:name "sourceAtom" ;
    sh:description "a urn:pgsl:atom content-address"@en ;
    sh:message "Content-addressed source conformance — sourceAtom: exactly 1 value, an IRI, matching ^(urn:pgsl:atom:|https?://[^/]+/ns/pgsl/atom/).+ — a urn:pgsl:atom content-address"@en ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:pattern "^(urn:pgsl:atom:|https?://[^/]+/ns/pgsl/atom/).+" .

shapes:ConfidenceRangeProofShape a sh:NodeShape ;
    sh:targetClass foxxi-ai-elearning:ConfidenceRangeProof ;
    sh:targetObjectsOf foxxi-ai-elearning:confidenceProof ;
    sh:targetSubjectsOf foxxi-ai-elearning:assertedConfidence ,
        foxxi-ai-elearning:confidenceThreshold ,
        foxxi-ai-elearning:proofVerified ;
    rdfs:label "Confidence range-proof conformance"@en ;
    rdfs:comment "Confidence is recorded as a committed range proof (≥ threshold) beside the verbatim self-reported number. The threshold is required; the asserted value is optional and explicitly unverified."@en ;
    sh:property shapes:ConfidenceRangeProofShape-confidenceThreshold ,
        shapes:ConfidenceRangeProofShape-assertedConfidence ,
        shapes:ConfidenceRangeProofShape-proofVerified ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/ai-elearning/shapes> .

shapes:ConfidenceRangeProofShape-confidenceThreshold a sh:PropertyShape ;
    sh:path foxxi-ai-elearning:confidenceThreshold ;
    sh:name "confidenceThreshold" ;
    sh:description "the proven lower bound (0..1)"@en ;
    sh:message "Confidence range-proof conformance — confidenceThreshold: exactly 1 value, of type xsd:integer or xsd:decimal or xsd:double, between 0 and 1 — the proven lower bound (0..1)"@en ;
    sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:decimal ] [ sh:datatype xsd:double ] ) ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:minInclusive 0 ;
    sh:maxInclusive 1 .

shapes:ConfidenceRangeProofShape-assertedConfidence a sh:PropertyShape ;
    sh:path foxxi-ai-elearning:assertedConfidence ;
    sh:name "assertedConfidence" ;
    sh:description "verbatim self-report (0..1), unverified"@en ;
    sh:message "Confidence range-proof conformance — assertedConfidence: at most 1 value, of type xsd:integer or xsd:decimal or xsd:double, between 0 and 1 — verbatim self-report (0..1), unverified"@en ;
    sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:decimal ] [ sh:datatype xsd:double ] ) ;
    sh:maxCount 1 ;
    sh:minInclusive 0 ;
    sh:maxInclusive 1 .

shapes:ConfidenceRangeProofShape-proofVerified a sh:PropertyShape ;
    sh:path foxxi-ai-elearning:proofVerified ;
    sh:name "proofVerified" ;
    sh:description "whether the proof checked out"@en ;
    sh:message "Confidence range-proof conformance — proofVerified: at most 1 value, of type xsd:boolean — whether the proof checked out"@en ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 .
