shapes:RandomizationControlsShape a sh:NodeShape ;
    sh:targetClass foxxi-scorm-sn:RandomizationControls ;
    sh:targetObjectsOf foxxi-scorm-sn:randomizationControls ;
    sh:targetSubjectsOf foxxi-scorm-sn:randomizationTiming ,
        foxxi-scorm-sn:selectCount ,
        foxxi-scorm-sn:reorderChildren ,
        foxxi-scorm-sn:selectionTiming ;
    rdfs:label "Randomization controls conformance"@en ;
    rdfs:comment "The timings are never, once or onEachNewAttempt (default never); selectCount is a non-negative integer; reorderChildren is a boolean (default false) (IMS Simple Sequencing 1.0 (imsss_v1p0.xsd): randomizationType)."@en ;
    sh:property shapes:RandomizationControlsShape-randomizationTiming ,
        shapes:RandomizationControlsShape-selectCount ,
        shapes:RandomizationControlsShape-reorderChildren ,
        shapes:RandomizationControlsShape-selectionTiming ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-sn/shapes> .

shapes:RandomizationControlsShape-randomizationTiming a sh:PropertyShape ;
    sh:path foxxi-scorm-sn:randomizationTiming ;
    sh:name "randomizationTiming" ;
    sh:description "randomTimingType (default never)"@en ;
    sh:message "Randomization controls conformance — randomizationTiming: at most 1 value, of type xsd:string, one of \"never\", \"once\", \"onEachNewAttempt\" — randomTimingType (default never)"@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:in ( "never" "once" "onEachNewAttempt" ) .

shapes:RandomizationControlsShape-selectCount a sh:PropertyShape ;
    sh:path foxxi-scorm-sn:selectCount ;
    sh:name "selectCount" ;
    sh:description "xs:nonNegativeInteger"@en ;
    sh:message "Randomization controls conformance — selectCount: at most 1 value, of type xsd:nonNegativeInteger or xsd:integer, at least 0 — xs:nonNegativeInteger"@en ;
    sh:or ( [ sh:datatype xsd:nonNegativeInteger ] [ sh:datatype xsd:integer ] ) ;
    sh:maxCount 1 ;
    sh:minInclusive 0 .

shapes:RandomizationControlsShape-reorderChildren a sh:PropertyShape ;
    sh:path foxxi-scorm-sn:reorderChildren ;
    sh:name "reorderChildren" ;
    sh:description "default false"@en ;
    sh:message "Randomization controls conformance — reorderChildren: at most 1 value, of type xsd:boolean — default false"@en ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 .

shapes:RandomizationControlsShape-selectionTiming a sh:PropertyShape ;
    sh:path foxxi-scorm-sn:selectionTiming ;
    sh:name "selectionTiming" ;
    sh:description "randomTimingType (default never)"@en ;
    sh:message "Randomization controls conformance — selectionTiming: at most 1 value, of type xsd:string, one of \"never\", \"once\", \"onEachNewAttempt\" — randomTimingType (default never)"@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:in ( "never" "once" "onEachNewAttempt" ) .

shapes:DeliveryControlsShape a sh:NodeShape ;
    sh:targetClass foxxi-scorm-sn:DeliveryControls ;
    sh:targetObjectsOf foxxi-scorm-sn:deliveryControls ;
    sh:targetSubjectsOf foxxi-scorm-sn:tracked ,
        foxxi-scorm-sn:completionSetByContent ,
        foxxi-scorm-sn:objectiveSetByContent ;
    rdfs:label "Delivery controls conformance"@en ;
    rdfs:comment "tracked (default true), completionSetByContent and objectiveSetByContent (default false) are booleans (IMS Simple Sequencing 1.0 (imsss_v1p0.xsd): deliveryControlsType)."@en ;
    sh:property shapes:DeliveryControlsShape-tracked ,
        shapes:DeliveryControlsShape-completionSetByContent ,
        shapes:DeliveryControlsShape-objectiveSetByContent ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-sn/shapes> .

shapes:DeliveryControlsShape-tracked a sh:PropertyShape ;
    sh:path foxxi-scorm-sn:tracked ;
    sh:name "tracked" ;
    sh:description "default true"@en ;
    sh:message "Delivery controls conformance — tracked: at most 1 value, of type xsd:boolean — default true"@en ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 .

shapes:DeliveryControlsShape-completionSetByContent a sh:PropertyShape ;
    sh:path foxxi-scorm-sn:completionSetByContent ;
    sh:name "completionSetByContent" ;
    sh:description "default false"@en ;
    sh:message "Delivery controls conformance — completionSetByContent: at most 1 value, of type xsd:boolean — default false"@en ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 .

shapes:DeliveryControlsShape-objectiveSetByContent a sh:PropertyShape ;
    sh:path foxxi-scorm-sn:objectiveSetByContent ;
    sh:name "objectiveSetByContent" ;
    sh:description "default false"@en ;
    sh:message "Delivery controls conformance — objectiveSetByContent: at most 1 value, of type xsd:boolean — default false"@en ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 .

shapes:AuxiliaryResourceShape a sh:NodeShape ;
    sh:targetClass foxxi-scorm-sn:AuxiliaryResource ;
    sh:targetObjectsOf foxxi-scorm-sn:auxiliaryResource ;
    sh:targetSubjectsOf foxxi-scorm-sn:auxiliaryResourceID , foxxi-scorm-sn:purpose ;
    rdfs:label "Auxiliary resource conformance"@en ;
    rdfs:comment "An auxiliary resource has exactly one ID and one purpose (IMS Simple Sequencing 1.0 (imsss_v1p0.xsd): auxiliaryResourceType)."@en ;
    sh:property shapes:AuxiliaryResourceShape-auxiliaryResourceID , shapes:AuxiliaryResourceShape-purpose ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-sn/shapes> .

shapes:AuxiliaryResourceShape-auxiliaryResourceID a sh:PropertyShape ;
    sh:path foxxi-scorm-sn:auxiliaryResourceID ;
    sh:name "auxiliaryResourceID" ;
    sh:description "xs:anyURI (required)"@en ;
    sh:message "Auxiliary resource conformance — auxiliaryResourceID: exactly 1 value, of type xsd:anyURI — xs:anyURI (required)"@en ;
    sh:datatype xsd:anyURI ;
    sh:minCount 1 ;
    sh:maxCount 1 .

shapes:AuxiliaryResourceShape-purpose a sh:PropertyShape ;
    sh:path foxxi-scorm-sn:purpose ;
    sh:name "purpose" ;
    sh:description "required"@en ;
    sh:message "Auxiliary resource conformance — purpose: exactly 1 value, of type xsd:string — required"@en ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 .

shapes:RollupConsiderationsShape a sh:NodeShape ;
    sh:targetClass foxxi-scorm-sn:RollupConsiderations ;
    sh:targetObjectsOf foxxi-scorm-sn:rollupConsiderations ;
    sh:targetSubjectsOf foxxi-scorm-sn:requiredForSatisfied ,
        foxxi-scorm-sn:requiredForNotSatisfied ,
        foxxi-scorm-sn:requiredForCompleted ,
        foxxi-scorm-sn:requiredForIncomplete ,
        foxxi-scorm-sn:measureSatisfactionIfActive ;
    rdfs:label "Rollup considerations conformance"@en ;
    rdfs:comment "The four requiredFor attributes are always, ifAttempted, ifNotSkipped or ifNotSuspended (default always); measureSatisfactionIfActive is a boolean (default true) (ADL sequencing extensions, SCORM 2004 4th Edition (adlseq_v1p3.xsd): rollupConsiderationsType)."@en ;
    sh:property shapes:RollupConsiderationsShape-requiredForSatisfied ,
        shapes:RollupConsiderationsShape-requiredForNotSatisfied ,
        shapes:RollupConsiderationsShape-requiredForCompleted ,
        shapes:RollupConsiderationsShape-requiredForIncomplete ,
        shapes:RollupConsiderationsShape-measureSatisfactionIfActive ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-sn/shapes> .

shapes:RollupConsiderationsShape-requiredForSatisfied a sh:PropertyShape ;
    sh:path foxxi-scorm-sn:requiredForSatisfied ;
    sh:name "requiredForSatisfied" ;
    sh:description "rollupConsiderationType (default always)"@en ;
    sh:message "Rollup considerations conformance — requiredForSatisfied: at most 1 value, of type xsd:string, one of \"always\", \"ifAttempted\", \"ifNotSkipped\", \"ifNotSuspended\" — rollupConsiderationType (default always)"@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:in ( "always" "ifAttempted" "ifNotSkipped" "ifNotSuspended" ) .

shapes:RollupConsiderationsShape-requiredForNotSatisfied a sh:PropertyShape ;
    sh:path foxxi-scorm-sn:requiredForNotSatisfied ;
    sh:name "requiredForNotSatisfied" ;
    sh:description "rollupConsiderationType (default always)"@en ;
    sh:message "Rollup considerations conformance — requiredForNotSatisfied: at most 1 value, of type xsd:string, one of \"always\", \"ifAttempted\", \"ifNotSkipped\", \"ifNotSuspended\" — rollupConsiderationType (default always)"@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:in ( "always" "ifAttempted" "ifNotSkipped" "ifNotSuspended" ) .

shapes:RollupConsiderationsShape-requiredForCompleted a sh:PropertyShape ;
    sh:path foxxi-scorm-sn:requiredForCompleted ;
    sh:name "requiredForCompleted" ;
    sh:description "rollupConsiderationType (default always)"@en ;
    sh:message "Rollup considerations conformance — requiredForCompleted: at most 1 value, of type xsd:string, one of \"always\", \"ifAttempted\", \"ifNotSkipped\", \"ifNotSuspended\" — rollupConsiderationType (default always)"@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:in ( "always" "ifAttempted" "ifNotSkipped" "ifNotSuspended" ) .

shapes:RollupConsiderationsShape-requiredForIncomplete a sh:PropertyShape ;
    sh:path foxxi-scorm-sn:requiredForIncomplete ;
    sh:name "requiredForIncomplete" ;
    sh:description "rollupConsiderationType (default always)"@en ;
    sh:message "Rollup considerations conformance — requiredForIncomplete: at most 1 value, of type xsd:string, one of \"always\", \"ifAttempted\", \"ifNotSkipped\", \"ifNotSuspended\" — rollupConsiderationType (default always)"@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:in ( "always" "ifAttempted" "ifNotSkipped" "ifNotSuspended" ) .

shapes:RollupConsiderationsShape-measureSatisfactionIfActive a sh:PropertyShape ;
    sh:path foxxi-scorm-sn:measureSatisfactionIfActive ;
    sh:name "measureSatisfactionIfActive" ;
    sh:description "default true"@en ;
    sh:message "Rollup considerations conformance — measureSatisfactionIfActive: at most 1 value, of type xsd:boolean — default true"@en ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 .

shapes:ConstrainedChoiceConsiderationsShape a sh:NodeShape ;
    sh:targetClass foxxi-scorm-sn:ConstrainedChoiceConsiderations ;
    sh:targetObjectsOf foxxi-scorm-sn:constrainedChoiceConsiderations ;
    sh:targetSubjectsOf foxxi-scorm-sn:preventActivation , foxxi-scorm-sn:constrainChoice ;
    rdfs:label "Constrained choice considerations conformance"@en ;
    rdfs:comment "preventActivation and constrainChoice are booleans (default false) (ADL sequencing extensions, SCORM 2004 4th Edition (adlseq_v1p3.xsd): constrainChoiceConsiderationsType)."@en ;
    sh:property shapes:ConstrainedChoiceConsiderationsShape-preventActivation ,
        shapes:ConstrainedChoiceConsiderationsShape-constrainChoice ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-sn/shapes> .

shapes:ConstrainedChoiceConsiderationsShape-preventActivation a sh:PropertyShape ;
    sh:path foxxi-scorm-sn:preventActivation ;
    sh:name "preventActivation" ;
    sh:description "default false"@en ;
    sh:message "Constrained choice considerations conformance — preventActivation: at most 1 value, of type xsd:boolean — default false"@en ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 .

shapes:ConstrainedChoiceConsiderationsShape-constrainChoice a sh:PropertyShape ;
    sh:path foxxi-scorm-sn:constrainChoice ;
    sh:name "constrainChoice" ;
    sh:description "default false"@en ;
    sh:message "Constrained choice considerations conformance — constrainChoice: at most 1 value, of type xsd:boolean — default false"@en ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 .

shapes:NavigationInterfaceShape a sh:NodeShape ;
    sh:targetClass foxxi-scorm-sn:NavigationInterface ;
    sh:targetObjectsOf foxxi-scorm-sn:navigationInterface ;
    sh:targetSubjectsOf foxxi-scorm-sn:hideLMSUI ;
    rdfs:label "Navigation interface conformance"@en ;
    rdfs:comment "Each hideLMSUI value is one of the seven hideable controls (ADL navigation extensions (adlnav_v1p3.xsd): hideLMSUIType)."@en ;
    sh:property shapes:NavigationInterfaceShape-hideLMSUI ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-sn/shapes> .

shapes:NavigationInterfaceShape-hideLMSUI a sh:PropertyShape ;
    sh:path foxxi-scorm-sn:hideLMSUI ;
    sh:name "hideLMSUI" ;
    sh:description "hideLMSUIType"@en ;
    sh:message "Navigation interface conformance — hideLMSUI: of type xsd:string, one of \"previous\", \"continue\", \"exit\", \"exitAll\", \"abandon\", \"abandonAll\", \"suspendAll\" — hideLMSUIType"@en ;
    sh:datatype xsd:string ;
    sh:in ( "previous" "continue" "exit" "exitAll" "abandon" "abandonAll" "suspendAll" ) .
