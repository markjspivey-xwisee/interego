shapes:AdlObjectiveMappingShape-writeProgressMeasure a sh:PropertyShape ;
    sh:path foxxi-scorm-sn:writeProgressMeasure ;
    sh:name "writeProgressMeasure" ;
    sh:description "default false"@en ;
    sh:message "ADL objective mapping conformance — writeProgressMeasure: at most 1 value, of type xsd:boolean — default false"@en ;
