    sh:message "ADL objective mapping conformance — readMinScore: at most 1 value, of type xsd:boolean — default true"@en ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 .

shapes:AdlObjectiveMappingShape-readMaxScore a sh:PropertyShape ;
    sh:path foxxi-scorm-sn:readMaxScore ;
    sh:name "readMaxScore" ;
    sh:description "default true"@en ;
    sh:message "ADL objective mapping conformance — readMaxScore: at most 1 value, of type xsd:boolean — default true"@en ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 .

shapes:AdlObjectiveMappingShape-readCompletionStatus a sh:PropertyShape ;
    sh:path foxxi-scorm-sn:readCompletionStatus ;
    sh:name "readCompletionStatus" ;
    sh:description "default true"@en ;
    sh:message "ADL objective mapping conformance — readCompletionStatus: at most 1 value, of type xsd:boolean — default true"@en ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 .

shapes:AdlObjectiveMappingShape-readProgressMeasure a sh:PropertyShape ;
    sh:path foxxi-scorm-sn:readProgressMeasure ;
    sh:name "readProgressMeasure" ;
    sh:description "default true"@en ;
    sh:message "ADL objective mapping conformance — readProgressMeasure: at most 1 value, of type xsd:boolean — default true"@en ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 .

shapes:AdlObjectiveMappingShape-writeRawScore a sh:PropertyShape ;
    sh:path foxxi-scorm-sn:writeRawScore ;
    sh:name "writeRawScore" ;
    sh:description "default false"@en ;
    sh:message "ADL objective mapping conformance — writeRawScore: at most 1 value, of type xsd:boolean — default false"@en ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 .

shapes:AdlObjectiveMappingShape-writeMinScore a sh:PropertyShape ;
    sh:path foxxi-scorm-sn:writeMinScore ;
    sh:name "writeMinScore" ;
    sh:description "default false"@en ;
    sh:message "ADL objective mapping conformance — writeMinScore: at most 1 value, of type xsd:boolean — default false"@en ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 .

shapes:AdlObjectiveMappingShape-writeMaxScore a sh:PropertyShape ;
    sh:path foxxi-scorm-sn:writeMaxScore ;
    sh:name "writeMaxScore" ;
    sh:description "default false"@en ;
    sh:message "ADL objective mapping conformance — writeMaxScore: at most 1 value, of type xsd:boolean — default false"@en ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 .

shapes:AdlObjectiveMappingShape-writeCompletionStatus a sh:PropertyShape ;
    sh:path foxxi-scorm-sn:writeCompletionStatus ;
    sh:name "writeCompletionStatus" ;
    sh:description "default false"@en ;
    sh:message "ADL objective mapping conformance — writeCompletionStatus: at most 1 value, of type xsd:boolean — default false"@en ;
