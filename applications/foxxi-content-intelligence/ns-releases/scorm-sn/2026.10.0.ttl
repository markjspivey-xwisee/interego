    bibo:status <http://purl.org/ontology/bibo/status/published> ;
    dct:bibliographicCitation "Spivey, M. (2026). SCORM 2004 4th Edition — Sequencing and Navigation (IMS Simple Sequencing and ADL extensions) (Version 2026.10.0) [Ontology]. Foxxi Mediums Inc. https://foxxi-bridge.interego.xwisee.com/ns/scorm-sn/2026.10.0" ;
