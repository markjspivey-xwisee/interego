    dct:source "ADL sequencing extensions, SCORM 2004 4th Edition (adlseq_v1p3.xsd): objectiveType" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-sn> .

foxxi-scorm-sn:AdlObjectiveMapping a owl:Class ;
    rdfs:label "ADL objective mapping"@en ;
    skos:notation "adlseq:mapInfo" ;
    rdfs:comment "A map from an objective to a global objective for the data imsss:mapInfo does not carry: whether the objective reads and writes the global objective's raw, minimum and maximum score, completion status and progress measure. Added in the 4th Edition."@en ;
    skos:definition "A map from an objective to a global objective for the data imsss:mapInfo does not carry: whether the objective reads and writes the global objective's raw, minimum and maximum score, completion status and progress measure. Added in the 4th Edition."@en ;
    dct:source "ADL sequencing extensions, SCORM 2004 4th Edition (adlseq_v1p3.xsd): mapInfoType" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-sn> .

foxxi-scorm-sn:Presentation a owl:Class ;
    rdfs:label "Presentation"@en ;
    skos:notation "adlnav:presentation" ;
    rdfs:comment "How an item is presented: the navigation controls the LMS hides while it is delivered."@en ;
