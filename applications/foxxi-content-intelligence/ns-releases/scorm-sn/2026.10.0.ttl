foxxi-scorm-sn:conditionOperator a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rule condition operator"@en ;
    skos:notation "operator" ;
    rdfs:comment "Whether a rule condition is negated (not) or taken as it is (noOp, the default)."@en ;
