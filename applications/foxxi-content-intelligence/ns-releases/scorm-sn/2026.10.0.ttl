    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-sn> .

foxxi-scorm-sn:SequencingRuleConditionName-objectiveMeasureGreaterThan a skos:Concept ;
    skos:inScheme foxxi-scorm-sn:SequencingRuleConditionName ;
    skos:topConceptOf foxxi-scorm-sn:SequencingRuleConditionName ;
    skos:prefLabel "objective measure greater than"@en ;
    rdfs:label "objective measure greater than (Sequencing rule conditions)"@en ;
