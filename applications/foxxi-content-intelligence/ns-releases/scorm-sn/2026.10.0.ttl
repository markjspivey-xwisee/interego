foxxi-scorm-sn:adlObjectives a owl:ObjectProperty ;
    rdfs:label "obsolete ADL objectives"@en ;
    skos:notation "adlObjectives" ;
    rdfs:comment "Formerly the adlseq:objectives of a sequencing definition, read as an imsss Objectives container, which it is not. Use adlObjective, which relates a sequencing definition to each adlseq:objective."@en ;
    skos:definition "Formerly the adlseq:objectives of a sequencing definition, read as an imsss Objectives container, which it is not. Use adlObjective, which relates a sequencing definition to each adlseq:objective."@en ;
    skos:changeNote "2026.10.0: deprecated in favour of adlObjective; kept as it was published, with the range Objectives."@en ;
    owl:deprecated true ;
    dct:isReplacedBy foxxi-scorm-sn:adlObjective ;
    rdfs:domain foxxi-scorm-sn:Sequencing ;
    rdfs:range foxxi-scorm-sn:Objectives ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-sn> .

