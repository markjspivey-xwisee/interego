    dct:source "ADL navigation extensions (adlnav_v1p3.xsd): presentationType" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-sn> .

foxxi-scorm-sn:NavigationInterface a owl:Class ;
    rdfs:label "Navigation interface"@en ;
    skos:notation "adlnav:navigationInterface" ;
    rdfs:comment "The LMS navigation controls to hide while an item is delivered."@en ;
