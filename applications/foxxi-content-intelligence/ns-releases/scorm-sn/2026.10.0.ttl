foxxi-scorm-sn:Duration a rdfs:Datatype ;
    rdfs:label "Duration"@en ;
    rdfs:comment "A duration in the lexical form of XML Schema's xs:duration (an optional minus sign, then P, years, months, days, T, hours, minutes, seconds; at least one component), the type of the duration limits. Defined on xsd:string because xsd:duration is outside the OWL 2 datatype map."@en ;
    skos:definition "A duration in the lexical form of XML Schema's xs:duration (an optional minus sign, then P, years, months, days, T, hours, minutes, seconds; at least one component), the type of the duration limits. Defined on xsd:string because xsd:duration is outside the OWL 2 datatype map."@en ;
    dct:source "IMS Simple Sequencing 1.0 (imsss_v1p0.xsd): limitConditionsType" ;
    owl:equivalentClass [
        a rdfs:Datatype ;
        owl:onDatatype xsd:string ;
        owl:withRestrictions (
            [
                xsd:pattern "-?P(([0-9]+Y([0-9]+M)?([0-9]+D)?|[0-9]+M([0-9]+D)?|[0-9]+D)(T([0-9]+H([0-9]+M)?([0-9]+(\\.[0-9]+)?S)?|[0-9]+M([0-9]+(\\.[0-9]+)?S)?|[0-9]+(\\.[0-9]+)?S))?|T([0-9]+H([0-9]+M)?([0-9]+(\\.[0-9]+)?S)?|[0-9]+M([0-9]+(\\.[0-9]+)?S)?|[0-9]+(\\.[0-9]+)?S))"
            ]
        )
    ] ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-sn> .

foxxi-scorm-sn:Measure a rdfs:Datatype ;
    rdfs:label "Measure"@en ;
    rdfs:comment "A normalized measure, a number from -1 to 1: a decimal as the schema writes it, or a double, which is what JSON-LD 1.1 (§8.6) makes of a JSON number with a fraction."@en ;
    skos:definition "A normalized measure, a number from -1 to 1: a decimal as the schema writes it, or a double, which is what JSON-LD 1.1 (§8.6) makes of a JSON number with a fraction."@en ;
    dct:source "IMS Simple Sequencing 1.0 (imsss_v1p0.xsd): measureType" ;
    owl:equivalentClass [
        a rdfs:Datatype ;
        owl:unionOf (
            [
                a rdfs:Datatype ;
                owl:onDatatype xsd:decimal ;
                owl:withRestrictions ( [ xsd:minInclusive -1 ] [ xsd:maxInclusive 1 ] )
            ]
            [
                a rdfs:Datatype ;
                owl:onDatatype xsd:double ;
                owl:withRestrictions ( [ xsd:minInclusive "-1.0E0"^^xsd:double ] [ xsd:maxInclusive "1.0E0"^^xsd:double ] )
            ]
        )
    ] ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-sn> .

foxxi-scorm-sn:Sequencing a owl:Class ;
    rdfs:label "Sequencing"@en ;
    skos:notation "imsss:sequencing" ;
    rdfs:comment "A sequencing definition: how the activity of an item or organization, and its children, are sequenced — control mode, sequencing rules, limit conditions, rollup rules, objectives, randomization and delivery controls, auxiliary resources, and ADL's extensions. A definition in the manifest's sequencing collection has an ID that others reuse by IDRef."@en ;
    skos:definition "A sequencing definition: how the activity of an item or organization, and its children, are sequenced — control mode, sequencing rules, limit conditions, rollup rules, objectives, randomization and delivery controls, auxiliary resources, and ADL's extensions. A definition in the manifest's sequencing collection has an ID that others reuse by IDRef."@en ;
    dct:source "IMS Simple Sequencing 1.0 (imsss_v1p0.xsd): sequencingType" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-sn> .

foxxi-scorm-sn:SequencingCollection a owl:Class ;
    rdfs:label "Sequencing collection"@en ;
    skos:notation "imsss:sequencingCollection" ;
    rdfs:comment "The sequencing definitions a manifest shares among its items and organizations, each with an ID."@en ;
    skos:definition "The sequencing definitions a manifest shares among its items and organizations, each with an ID."@en ;
    dct:source "IMS Simple Sequencing 1.0 (imsss_v1p0.xsd): sequencingCollection" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-sn> .

foxxi-scorm-sn:ControlMode a owl:Class ;
    rdfs:label "Control mode"@en ;
    skos:notation "imsss:controlMode" ;
    rdfs:comment "The navigation an activity allows among its children: free choice, flow (continue and previous), whether flow is forward only, and whether only current-attempt information is used."@en ;
    skos:definition "The navigation an activity allows among its children: free choice, flow (continue and previous), whether flow is forward only, and whether only current-attempt information is used."@en ;
    dct:source "IMS Simple Sequencing 1.0 (imsss_v1p0.xsd): controlModeType" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-sn> .

foxxi-scorm-sn:SequencingRules a owl:Class ;
    rdfs:label "Sequencing rules"@en ;
    skos:notation "imsss:sequencingRules" ;
    rdfs:comment "The pre-condition, exit-condition and post-condition rules of an activity."@en ;
    skos:definition "The pre-condition, exit-condition and post-condition rules of an activity."@en ;
    dct:source "IMS Simple Sequencing 1.0 (imsss_v1p0.xsd): sequencingRulesType" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-sn> .

foxxi-scorm-sn:SequencingRule a owl:Class ;
    rdfs:label "Sequencing rule"@en ;
    rdfs:comment "A rule that applies an action when its conditions hold: a pre-condition, exit-condition or post-condition rule, and only one of them."@en ;
    skos:definition "A rule that applies an action when its conditions hold: a pre-condition, exit-condition or post-condition rule, and only one of them."@en ;
    owl:disjointUnionOf (
        foxxi-scorm-sn:PreConditionRule
        foxxi-scorm-sn:ExitConditionRule
        foxxi-scorm-sn:PostConditionRule
    ) ;
    dct:source "IMS Simple Sequencing 1.0 (imsss_v1p0.xsd): sequencingRuleType" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-sn> .

foxxi-scorm-sn:PreConditionRule a owl:Class ;
    rdfs:label "Pre-condition rule"@en ;
    skos:notation "imsss:preConditionRule" ;
    rdfs:comment "A sequencing rule evaluated before an activity is delivered or traversed: it may skip, disable or hide the activity, or stop forward traversal."@en ;
    skos:definition "A sequencing rule evaluated before an activity is delivered or traversed: it may skip, disable or hide the activity, or stop forward traversal."@en ;
    rdfs:subClassOf foxxi-scorm-sn:SequencingRule ;
    dct:source "IMS Simple Sequencing 1.0 (imsss_v1p0.xsd): preConditionRuleType" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-sn> .

foxxi-scorm-sn:ExitConditionRule a owl:Class ;
    rdfs:label "Exit-condition rule"@en ;
    skos:notation "imsss:exitConditionRule" ;
    rdfs:comment "A sequencing rule evaluated when an attempt on a descendant of the activity ends: it may exit the activity."@en ;
    skos:definition "A sequencing rule evaluated when an attempt on a descendant of the activity ends: it may exit the activity."@en ;
    rdfs:subClassOf foxxi-scorm-sn:SequencingRule ;
    dct:source "IMS Simple Sequencing 1.0 (imsss_v1p0.xsd): exitConditionRuleType" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-sn> .

foxxi-scorm-sn:PostConditionRule a owl:Class ;
    rdfs:label "Post-condition rule"@en ;
    skos:notation "imsss:postConditionRule" ;
    rdfs:comment "A sequencing rule evaluated when an attempt on the activity ends: it may exit the parent or the whole tree, retry, or continue or go back."@en ;
    skos:definition "A sequencing rule evaluated when an attempt on the activity ends: it may exit the parent or the whole tree, retry, or continue or go back."@en ;
    rdfs:subClassOf foxxi-scorm-sn:SequencingRule ;
    dct:source "IMS Simple Sequencing 1.0 (imsss_v1p0.xsd): postConditionRuleType" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-sn> .

foxxi-scorm-sn:RuleConditions a owl:Class ;
    rdfs:label "Rule conditions"@en ;
    skos:notation "imsss:ruleConditions" ;
    rdfs:comment "The conditions of a sequencing rule, and whether all of them or any must hold."@en ;
    skos:definition "The conditions of a sequencing rule, and whether all of them or any must hold."@en ;
    dct:source "IMS Simple Sequencing 1.0 (imsss_v1p0.xsd): sequencingRuleType (ruleConditions)" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-sn> .

foxxi-scorm-sn:RuleCondition a owl:Class ;
    rdfs:label "Rule condition"@en ;
    skos:notation "imsss:ruleCondition" ;
    rdfs:comment "One condition of a sequencing rule: what is tested, whether it is negated, and for objective conditions the objective and measure threshold tested against."@en ;
    skos:definition "One condition of a sequencing rule: what is tested, whether it is negated, and for objective conditions the objective and measure threshold tested against."@en ;
    dct:source "IMS Simple Sequencing 1.0 (imsss_v1p0.xsd): sequencingRuleType (ruleCondition)" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-sn> .

foxxi-scorm-sn:RuleAction a owl:Class ;
    rdfs:label "Rule action"@en ;
    skos:notation "imsss:ruleAction" ;
    rdfs:comment "The action a sequencing rule takes when its conditions hold; which actions are allowed depends on the kind of rule."@en ;
    skos:definition "The action a sequencing rule takes when its conditions hold; which actions are allowed depends on the kind of rule."@en ;
    dct:source "IMS Simple Sequencing 1.0 (imsss_v1p0.xsd): preConditionRuleType, exitConditionRuleType, postConditionRuleType (ruleAction)" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-sn> .

foxxi-scorm-sn:LimitConditions a owl:Class ;
    rdfs:label "Limit conditions"@en ;
    skos:notation "imsss:limitConditions" ;
    rdfs:comment "Limits on an activity: how many attempts, how long an attempt or the activity may take, and when it may begin and end."@en ;
    skos:definition "Limits on an activity: how many attempts, how long an attempt or the activity may take, and when it may begin and end."@en ;
    dct:source "IMS Simple Sequencing 1.0 (imsss_v1p0.xsd): limitConditionsType" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-sn> .

foxxi-scorm-sn:RollupRules a owl:Class ;
    rdfs:label "Rollup rules"@en ;
    skos:notation "imsss:rollupRules" ;
    rdfs:comment "How an activity's status is derived from its children: its rollup rules, whether it contributes to its parent's satisfaction and completion, and the weight of its measure."@en ;
    skos:definition "How an activity's status is derived from its children: its rollup rules, whether it contributes to its parent's satisfaction and completion, and the weight of its measure."@en ;
    dct:source "IMS Simple Sequencing 1.0 (imsss_v1p0.xsd): rollupRulesType" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-sn> .

foxxi-scorm-sn:RollupRule a owl:Class ;
    rdfs:label "Rollup rule"@en ;
    skos:notation "imsss:rollupRule" ;
    rdfs:comment "A rule that sets an activity's status when its conditions hold for a given set of its children."@en ;
    skos:definition "A rule that sets an activity's status when its conditions hold for a given set of its children."@en ;
    dct:source "IMS Simple Sequencing 1.0 (imsss_v1p0.xsd): rollupRuleType" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-sn> .

foxxi-scorm-sn:RollupConditions a owl:Class ;
    rdfs:label "Rollup conditions"@en ;
    skos:notation "imsss:rollupConditions" ;
    rdfs:comment "The conditions of a rollup rule, and whether all of them or any must hold for a child."@en ;
    skos:definition "The conditions of a rollup rule, and whether all of them or any must hold for a child."@en ;
    dct:source "IMS Simple Sequencing 1.0 (imsss_v1p0.xsd): rollupRuleType (rollupConditions)" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-sn> .

foxxi-scorm-sn:RollupCondition a owl:Class ;
    rdfs:label "Rollup condition"@en ;
    skos:notation "imsss:rollupCondition" ;
    rdfs:comment "One condition of a rollup rule, tested on each child: what is tested, and whether it is negated."@en ;
    skos:definition "One condition of a rollup rule, tested on each child: what is tested, and whether it is negated."@en ;
    dct:source "IMS Simple Sequencing 1.0 (imsss_v1p0.xsd): rollupRuleType (rollupCondition)" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-sn> .

foxxi-scorm-sn:RollupAction a owl:Class ;
    rdfs:label "Rollup action"@en ;
    skos:notation "imsss:rollupAction" ;
    rdfs:comment "The status a rollup rule sets on the activity when it applies."@en ;
    skos:definition "The status a rollup rule sets on the activity when it applies."@en ;
    dct:source "IMS Simple Sequencing 1.0 (imsss_v1p0.xsd): rollupRuleType (rollupAction)" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-sn> .

foxxi-scorm-sn:Objectives a owl:Class ;
    rdfs:label "Objectives"@en ;
    skos:notation "imsss:objectives" ;
    rdfs:comment "The objectives of an activity: exactly one primary objective, which contributes to rollup, and any number of others, which do not."@en ;
    skos:definition "The objectives of an activity: exactly one primary objective, which contributes to rollup, and any number of others, which do not."@en ;
    dct:source "IMS Simple Sequencing 1.0 (imsss_v1p0.xsd): objectivesType" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-sn> .

foxxi-scorm-sn:Objective a owl:Class ;
    rdfs:label "Objective"@en ;
    skos:notation "imsss:objective" ;
    rdfs:comment "A learning objective of an activity: its ID, whether it is satisfied by measure and with what minimum, and its maps to global objectives."@en ;
    skos:definition "A learning objective of an activity: its ID, whether it is satisfied by measure and with what minimum, and its maps to global objectives."@en ;
    dct:source "IMS Simple Sequencing 1.0 (imsss_v1p0.xsd): objectiveType" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-sn> .

foxxi-scorm-sn:ObjectiveMapping a owl:Class ;
    rdfs:label "Objective mapping"@en ;
    skos:notation "imsss:mapInfo" ;
    rdfs:comment "A map from an objective to a global objective: whether the objective reads and writes the global objective's satisfaction status and normalized measure."@en ;
    skos:definition "A map from an objective to a global objective: whether the objective reads and writes the global objective's satisfaction status and normalized measure."@en ;
    dct:source "IMS Simple Sequencing 1.0 (imsss_v1p0.xsd): objectiveMappingType" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-sn> .

foxxi-scorm-sn:RandomizationControls a owl:Class ;
    rdfs:label "Randomization controls"@en ;
    skos:notation "imsss:randomizationControls" ;
    rdfs:comment "Whether, and when, an activity's children are selected and reordered at random."@en ;
    skos:definition "Whether, and when, an activity's children are selected and reordered at random."@en ;
    dct:source "IMS Simple Sequencing 1.0 (imsss_v1p0.xsd): randomizationType" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-sn> .

foxxi-scorm-sn:DeliveryControls a owl:Class ;
    rdfs:label "Delivery controls"@en ;
    skos:notation "imsss:deliveryControls" ;
    rdfs:comment "Whether an activity is tracked, and whether its content, rather than the LMS, sets its completion and objective status."@en ;
    skos:definition "Whether an activity is tracked, and whether its content, rather than the LMS, sets its completion and objective status."@en ;
    dct:source "IMS Simple Sequencing 1.0 (imsss_v1p0.xsd): deliveryControlsType" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-sn> .

foxxi-scorm-sn:AuxiliaryResources a owl:Class ;
    rdfs:label "Auxiliary resources"@en ;
    skos:notation "imsss:auxiliaryResources" ;
    rdfs:comment "The auxiliary resources available during an activity."@en ;
    skos:definition "The auxiliary resources available during an activity."@en ;
    dct:source "IMS Simple Sequencing 1.0 (imsss_v1p0.xsd): auxiliaryResourcesType" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-sn> .

foxxi-scorm-sn:AuxiliaryResource a owl:Class ;
    rdfs:label "Auxiliary resource"@en ;
    skos:notation "imsss:auxiliaryResource" ;
    rdfs:comment "A resource offered alongside an activity, by its ID and purpose."@en ;
    skos:definition "A resource offered alongside an activity, by its ID and purpose."@en ;
    dct:source "IMS Simple Sequencing 1.0 (imsss_v1p0.xsd): auxiliaryResourceType" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-sn> .

foxxi-scorm-sn:RollupConsiderations a owl:Class ;
    rdfs:label "Rollup considerations"@en ;
    skos:notation "adlseq:rollupConsiderations" ;
    rdfs:comment "When an activity counts in its parent's rollup, for each of the four rollup statuses, and whether its measure counts while it is active."@en ;
    skos:definition "When an activity counts in its parent's rollup, for each of the four rollup statuses, and whether its measure counts while it is active."@en ;
    dct:source "ADL sequencing extensions, SCORM 2004 4th Edition (adlseq_v1p3.xsd): rollupConsiderationsType" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-sn> .

foxxi-scorm-sn:ConstrainedChoiceConsiderations a owl:Class ;
    rdfs:label "Constrained choice considerations"@en ;
    skos:notation "adlseq:constrainedChoiceConsiderations" ;
    rdfs:comment "Limits on choice navigation relative to an activity: whether choosing into it out of order is prevented, and whether choice is constrained to the activities next to it in flow."@en ;
    skos:definition "Limits on choice navigation relative to an activity: whether choosing into it out of order is prevented, and whether choice is constrained to the activities next to it in flow."@en ;
    dct:source "ADL sequencing extensions, SCORM 2004 4th Edition (adlseq_v1p3.xsd): constrainChoiceConsiderationsType" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-sn> .

foxxi-scorm-sn:AdlObjective a owl:Class ;
    rdfs:label "ADL objective"@en ;
    skos:notation "adlseq:objective" ;
    rdfs:comment "The 4th Edition's further global-objective maps for one of an activity's objectives, named by its objective ID."@en ;
