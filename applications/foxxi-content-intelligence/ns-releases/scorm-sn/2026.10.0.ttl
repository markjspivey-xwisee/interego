    skos:definition "Whether the objective is satisfied is known."@en ;
    rdfs:comment "Whether the objective is satisfied is known."@en ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-sn> .

foxxi-scorm-sn:SequencingRuleConditionName-objectiveMeasureKnown a skos:Concept ;
    skos:inScheme foxxi-scorm-sn:SequencingRuleConditionName ;
