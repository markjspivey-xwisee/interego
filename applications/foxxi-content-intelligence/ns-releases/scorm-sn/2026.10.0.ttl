foxxi-scorm-sn:SequencingRuleConditionName a skos:ConceptScheme ;
    rdfs:label "Sequencing rule conditions"@en ;
    skos:prefLabel "Sequencing rule conditions"@en ;
    skos:definition "What a sequencing rule condition tests (sequencingRuleConditionType). Objective conditions test the referenced objective, or the primary objective."@en ;
    rdfs:comment "What a sequencing rule condition tests (sequencingRuleConditionType). Objective conditions test the referenced objective, or the primary objective."@en ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-sn> ;
    skos:hasTopConcept foxxi-scorm-sn:SequencingRuleConditionName-satisfied ,
        foxxi-scorm-sn:SequencingRuleConditionName-objectiveStatusKnown ,
        foxxi-scorm-sn:SequencingRuleConditionName-objectiveMeasureKnown ,
        foxxi-scorm-sn:SequencingRuleConditionName-objectiveMeasureGreaterThan ,
        foxxi-scorm-sn:SequencingRuleConditionName-objectiveMeasureLessThan ,
        foxxi-scorm-sn:SequencingRuleConditionName-completed ,
        foxxi-scorm-sn:SequencingRuleConditionName-activityProgressKnown ,
        foxxi-scorm-sn:SequencingRuleConditionName-attempted ,
        foxxi-scorm-sn:SequencingRuleConditionName-attemptLimitExceeded ,
        foxxi-scorm-sn:SequencingRuleConditionName-timeLimitExceeded ,
        foxxi-scorm-sn:SequencingRuleConditionName-outsideAvailableTimeRange ,
        foxxi-scorm-sn:SequencingRuleConditionName-always .

foxxi-scorm-sn:SequencingRuleConditionName-satisfied a skos:Concept ;
    skos:inScheme foxxi-scorm-sn:SequencingRuleConditionName ;
    skos:topConceptOf foxxi-scorm-sn:SequencingRuleConditionName ;
    skos:prefLabel "satisfied"@en ;
    rdfs:label "satisfied (Sequencing rule conditions)"@en ;
    skos:notation "satisfied" ;
    skos:definition "The objective is satisfied."@en ;
    rdfs:comment "The objective is satisfied."@en ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-sn> .

