    dct:source "ADL navigation extensions (adlnav_v1p3.xsd): navigationInterfaceType" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-sn> .

foxxi-scorm-sn:sequencing a owl:ObjectProperty ;
    rdfs:label "sequencing"@en ;
    skos:notation "imsss:sequencing" ;
    rdfs:comment "The sequencing definition of an item or organization, or one of the definitions in a sequencing collection."@en ;
    skos:definition "The sequencing definition of an item or organization, or one of the definitions in a sequencing collection."@en ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf ( foxxi-scorm-cam:Item foxxi-scorm-cam:Organization foxxi-scorm-sn:SequencingCollection )
    ] ;
    rdfs:range foxxi-scorm-sn:Sequencing ;
    dct:source "IMS Simple Sequencing 1.0 (imsss_v1p0.xsd): sequencing" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-sn> .

foxxi-scorm-sn:sequencingCollection a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "sequencing collection"@en ;
    skos:notation "imsss:sequencingCollection" ;
    rdfs:comment "The sequencing definitions a manifest shares."@en ;
    skos:definition "The sequencing definitions a manifest shares."@en ;
    rdfs:domain foxxi-scorm-cam:Manifest ;
    rdfs:range foxxi-scorm-sn:SequencingCollection ;
    dct:source "IMS Simple Sequencing 1.0 (imsss_v1p0.xsd): sequencingCollection" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-sn> .

foxxi-scorm-sn:objectivesGlobalToSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "objectives global to system"@en ;
    skos:notation "adlseq:objectivesGlobalToSystem" ;
    rdfs:comment "Whether the global objectives an organization's activities map to are global to the LMS, shared with other packages for the same learner (true, the default), or belong to this package (false). An attribute of the organization."@en ;
    skos:definition "Whether the global objectives an organization's activities map to are global to the LMS, shared with other packages for the same learner (true, the default), or belong to this package (false). An attribute of the organization."@en ;
    skos:changeNote "2026.10.0: its comment names the organization, on which adlseq_v1p3.xsd declares the attribute; it had named the item. It has no domain, as it was published, so that data that followed the earlier comment stays consistent."@en ;
    rdfs:range xsd:boolean ;
    dct:source "ADL sequencing extensions, SCORM 2004 4th Edition (adlseq_v1p3.xsd): objectivesGlobalToSystem" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-sn> .

foxxi-scorm-sn:presentation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "presentation"@en ;
    skos:notation "adlnav:presentation" ;
    rdfs:comment "How an item is presented: which LMS navigation controls are hidden while it is delivered. A child of the item, not of its sequencing."@en ;
    skos:definition "How an item is presented: which LMS navigation controls are hidden while it is delivered. A child of the item, not of its sequencing."@en ;
    skos:changeNote "2026.10.0: its domain, the sequencing definition, is removed: adlnav:presentation is a child of the item, and the domain made an item's presentation a sequencing definition's. It is not replaced by the item, so that data written with the earlier domain stays consistent."@en ;
    rdfs:range foxxi-scorm-sn:Presentation ;
    dct:source "ADL navigation extensions (adlnav_v1p3.xsd): presentation" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-sn> .

