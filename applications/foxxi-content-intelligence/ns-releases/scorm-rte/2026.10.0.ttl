        <https://standards.ieee.org/ieee/1484.11.1/10324/> ,
        <https://standards.ieee.org/ieee/1484.11.2/7698/> ;
    prov:wasDerivedFrom <https://github.com/markjspivey-xwisee/interego/blob/foxxi-ns-2026.10.0/applications/foxxi-content-intelligence/src/spec/scorm-rte.model.ts> ,
        <https://github.com/markjspivey-xwisee/interego/blob/foxxi-ns-2026.10.0/applications/foxxi-content-intelligence/src/spec-ontology.ts> ;
    rdfs:seeAlso <https://foxxi-bridge.interego.xwisee.com/ns/scorm-rte/shapes/2026.10.0> ,
        <https://foxxi-bridge.interego.xwisee.com/ns/scorm-rte/context/2026.10.0> .

foxxi-scorm-rte:TimeInterval a rdfs:Datatype ;
    rdfs:label "Time interval"@en ;
    rdfs:comment "SCORM's timeinterval (second,10,2): an ISO 8601 duration P[yY][mM][dD][T[hH][nM][s[.s]S]], with integer components and the seconds to a hundredth; at least one component. Defined on xsd:string because xsd:duration is outside the OWL 2 datatype map."@en ;
    skos:definition "SCORM's timeinterval (second,10,2): an ISO 8601 duration P[yY][mM][dD][T[hH][nM][s[.s]S]], with integer components and the seconds to a hundredth; at least one component. Defined on xsd:string because xsd:duration is outside the OWL 2 datatype map."@en ;
    dct:source "SCORM 2004 4th Edition Run-Time Environment: timeinterval (second,10,2)" ;
    owl:equivalentClass [
        a rdfs:Datatype ;
        owl:onDatatype xsd:string ;
        owl:withRestrictions (
            [
                xsd:pattern "P(([0-9]+Y([0-9]+M)?([0-9]+D)?|[0-9]+M([0-9]+D)?|[0-9]+D)(T([0-9]+H([0-9]+M)?([0-9]+(\\.[0-9]{1,2})?S)?|[0-9]+M([0-9]+(\\.[0-9]{1,2})?S)?|[0-9]+(\\.[0-9]{1,2})?S))?|T([0-9]+H([0-9]+M)?([0-9]+(\\.[0-9]{1,2})?S)?|[0-9]+M([0-9]+(\\.[0-9]{1,2})?S)?|[0-9]+(\\.[0-9]{1,2})?S))"
            ]
        )
    ] ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-rte> .

foxxi-scorm-rte:Time a rdfs:Datatype ;
    rdfs:label "Time"@en ;
    rdfs:comment "SCORM's time (second,10,0): an ISO 8601 point in time, YYYY[-MM[-DD[Thh[:mm[:ss[.s[TZD]]]]]]], to a hundredth of a second, any trailing part omitted. Defined on xsd:string because its partial forms are not xsd:dateTime values."@en ;
    skos:definition "SCORM's time (second,10,0): an ISO 8601 point in time, YYYY[-MM[-DD[Thh[:mm[:ss[.s[TZD]]]]]]], to a hundredth of a second, any trailing part omitted. Defined on xsd:string because its partial forms are not xsd:dateTime values."@en ;
    dct:source "SCORM 2004 4th Edition Run-Time Environment: time (second,10,0)" ;
    owl:equivalentClass [
        a rdfs:Datatype ;
        owl:onDatatype xsd:string ;
        owl:withRestrictions (
            [
                xsd:pattern "[0-9]{4}(-[0-9]{2}(-[0-9]{2}(T[0-9]{2}(:[0-9]{2}(:[0-9]{2}(\\.[0-9]{1,2})?(Z|[+-][0-9]{2}(:[0-9]{2})?)?)?)?)?)?)?"
            ]
        )
    ] ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-rte> .

foxxi-scorm-rte:Real a rdfs:Datatype ;
    rdfs:label "Real number"@en ;
    rdfs:comment "SCORM's real (10,7): a decimal, or a double, which is what JSON-LD 1.1 (§8.6) makes of a JSON number with a fraction."@en ;
    skos:definition "SCORM's real (10,7): a decimal, or a double, which is what JSON-LD 1.1 (§8.6) makes of a JSON number with a fraction."@en ;
    dct:source "SCORM 2004 4th Edition Run-Time Environment: real (10,7)" ;
    owl:equivalentClass [ a rdfs:Datatype ; owl:unionOf ( xsd:decimal xsd:double ) ] ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-rte> .

foxxi-scorm-rte:ScaledReal a rdfs:Datatype ;
    rdfs:label "Scaled real number"@en ;
    rdfs:comment "A real (10,7) from -1 to 1."@en ;
    skos:definition "A real (10,7) from -1 to 1."@en ;
    dct:source "SCORM 2004 4th Edition Run-Time Environment: cmi.score.scaled, cmi.scaled_passing_score" ;
    owl:equivalentClass [
        a rdfs:Datatype ;
        owl:unionOf (
            [
                a rdfs:Datatype ;
                owl:onDatatype xsd:decimal ;
                owl:withRestrictions ( [ xsd:minInclusive -1 ] [ xsd:maxInclusive 1 ] )
            ]
            [
                a rdfs:Datatype ;
                owl:onDatatype xsd:double ;
                owl:withRestrictions ( [ xsd:minInclusive "-1.0E0"^^xsd:double ] [ xsd:maxInclusive "1.0E0"^^xsd:double ] )
            ]
        )
    ] ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-rte> .

foxxi-scorm-rte:UnitInterval a rdfs:Datatype ;
    rdfs:label "Unit interval"@en ;
    rdfs:comment "A real (10,7) from 0 to 1."@en ;
    skos:definition "A real (10,7) from 0 to 1."@en ;
    dct:source "SCORM 2004 4th Edition Run-Time Environment: cmi.progress_measure, cmi.completion_threshold" ;
    owl:equivalentClass [
        a rdfs:Datatype ;
        owl:unionOf (
            [
                a rdfs:Datatype ;
                owl:onDatatype xsd:decimal ;
                owl:withRestrictions ( [ xsd:minInclusive 0 ] [ xsd:maxInclusive 1 ] )
            ]
            [
                a rdfs:Datatype ;
                owl:onDatatype xsd:double ;
                owl:withRestrictions ( [ xsd:minInclusive "0.0E0"^^xsd:double ] [ xsd:maxInclusive "1.0E0"^^xsd:double ] )
            ]
        )
    ] ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-rte> .

foxxi-scorm-rte:NonNegativeReal a rdfs:Datatype ;
    rdfs:label "Non-negative real number"@en ;
    rdfs:comment "A real (10,7) of 0 or more."@en ;
    skos:definition "A real (10,7) of 0 or more."@en ;
    dct:source "SCORM 2004 4th Edition Run-Time Environment: cmi.learner_preference.audio_level, cmi.learner_preference.delivery_speed" ;
    owl:equivalentClass [
        a rdfs:Datatype ;
        owl:unionOf (
            [
                a rdfs:Datatype ;
                owl:onDatatype xsd:decimal ;
                owl:withRestrictions ( [ xsd:minInclusive 0 ] )
            ]
            [
                a rdfs:Datatype ;
                owl:onDatatype xsd:double ;
                owl:withRestrictions ( [ xsd:minInclusive "0.0E0"^^xsd:double ] )
            ]
        )
    ] ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-rte> .

foxxi-scorm-rte:DataModel a owl:Class ;
    rdfs:label "Run-time data"@en ;
    rdfs:comment "The run-time data of one learner attempt on a SCO, which the SCO reads and writes through API_1484_11: the cmi data model, and ADL's navigation (adl.nav) and shared data (adl.data) data models."@en ;
    skos:definition "The run-time data of one learner attempt on a SCO, which the SCO reads and writes through API_1484_11: the cmi data model, and ADL's navigation (adl.nav) and shared data (adl.data) data models."@en ;
    dct:source "SCORM 2004 4th Edition Run-Time Environment: cmi; adl.nav; adl.data" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-rte> .

foxxi-scorm-rte:Comment a owl:Class ;
    rdfs:label "Comment"@en ;
    rdfs:comment "A comment on a SCO, with the location in the SCO it applies to and when it was made: from the learner, or from the LMS."@en ;
    skos:definition "A comment on a SCO, with the location in the SCO it applies to and when it was made: from the learner, or from the LMS."@en ;
    owl:disjointUnionOf ( foxxi-scorm-rte:CommentFromLearner foxxi-scorm-rte:CommentFromLMS ) ;
    dct:source "SCORM 2004 4th Edition Run-Time Environment: cmi.comments_from_learner, cmi.comments_from_lms" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-rte> .

foxxi-scorm-rte:CommentFromLearner a owl:Class ;
    rdfs:label "Comment from learner"@en ;
    skos:notation "cmi.comments_from_learner.n" ;
    rdfs:comment "A comment the learner makes on the SCO. [RW]"@en ;
    skos:definition "A comment the learner makes on the SCO. [RW]"@en ;
    rdfs:subClassOf foxxi-scorm-rte:Comment ;
    dct:source "SCORM 2004 4th Edition Run-Time Environment: cmi.comments_from_learner" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-rte> .

foxxi-scorm-rte:CommentFromLMS a owl:Class ;
    rdfs:label "Comment from LMS"@en ;
    skos:notation "cmi.comments_from_lms.n" ;
    rdfs:comment "A comment the LMS gives the SCO to show the learner. [RO]"@en ;
    skos:definition "A comment the LMS gives the SCO to show the learner. [RO]"@en ;
    rdfs:subClassOf foxxi-scorm-rte:Comment ;
    dct:source "SCORM 2004 4th Edition Run-Time Environment: cmi.comments_from_lms" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-rte> .

foxxi-scorm-rte:LearnerPreference a owl:Class ;
    rdfs:label "Learner preference"@en ;
    skos:notation "cmi.learner_preference" ;
    rdfs:comment "The learner's preferences for the SCO: audio level, language, delivery speed and audio captioning. [RW]"@en ;
    skos:definition "The learner's preferences for the SCO: audio level, language, delivery speed and audio captioning. [RW]"@en ;
    dct:source "SCORM 2004 4th Edition Run-Time Environment: cmi.learner_preference" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-rte> .

foxxi-scorm-rte:Interaction a owl:Class ;
    rdfs:label "Interaction"@en ;
    skos:notation "cmi.interactions.n" ;
    rdfs:comment "A recognized interaction the learner responded to, such as a question: its ID, type, objectives, timestamp, correct responses, weighting, learner response, result, latency and description."@en ;
    skos:definition "A recognized interaction the learner responded to, such as a question: its ID, type, objectives, timestamp, correct responses, weighting, learner response, result, latency and description."@en ;
    dct:source "SCORM 2004 4th Edition Run-Time Environment: cmi.interactions" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-rte> .

foxxi-scorm-rte:InteractionObjective a owl:Class ;
    rdfs:label "Interaction objective"@en ;
    skos:notation "cmi.interactions.n.objectives.m" ;
    rdfs:comment "An objective an interaction is associated with, by the objective's ID."@en ;
    skos:definition "An objective an interaction is associated with, by the objective's ID."@en ;
    dct:source "SCORM 2004 4th Edition Run-Time Environment: cmi.interactions.n.objectives" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-rte> .

foxxi-scorm-rte:CorrectResponse a owl:Class ;
    rdfs:label "Correct response"@en ;
    skos:notation "cmi.interactions.n.correct_responses.m" ;
    rdfs:comment "A correct response to an interaction, as a pattern whose form depends on the interaction type."@en ;
    skos:definition "A correct response to an interaction, as a pattern whose form depends on the interaction type."@en ;
    dct:source "SCORM 2004 4th Edition Run-Time Environment: cmi.interactions.n.correct_responses" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-rte> .

foxxi-scorm-rte:Objective a owl:Class ;
    rdfs:label "Objective"@en ;
    skos:notation "cmi.objectives.n" ;
    rdfs:comment "A learning objective the SCO tracks: its ID, score, success status, completion status, progress measure and description."@en ;
    skos:definition "A learning objective the SCO tracks: its ID, score, success status, completion status, progress measure and description."@en ;
    dct:source "SCORM 2004 4th Edition Run-Time Environment: cmi.objectives" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-rte> .

foxxi-scorm-rte:Score a owl:Class ;
    rdfs:label "Score"@en ;
    rdfs:comment "A score: scaled, raw, minimum and maximum — of the SCO (cmi.score) or of an objective (cmi.objectives.n.score)."@en ;
    skos:definition "A score: scaled, raw, minimum and maximum — of the SCO (cmi.score) or of an objective (cmi.objectives.n.score)."@en ;
    dct:source "SCORM 2004 4th Edition Run-Time Environment: cmi.score, cmi.objectives.n.score" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-rte> .

foxxi-scorm-rte:TargetedRequestValidity a owl:Class ;
    rdfs:label "Targeted request validity"@en ;
    rdfs:comment "Whether a choice or jump navigation request to a target activity would be valid now: the target's activity identifier, and true, false or unknown. [RO]"@en ;
    skos:definition "Whether a choice or jump navigation request to a target activity would be valid now: the target's activity identifier, and true, false or unknown. [RO]"@en ;
    dct:source "SCORM 2004 4th Edition Run-Time Environment: adl.nav.request_valid.choice, adl.nav.request_valid.jump" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-rte> .

foxxi-scorm-rte:SharedData a owl:Class ;
    rdfs:label "Shared data store"@en ;
    skos:notation "adl.data.n" ;
    rdfs:comment "A shared data store the SCO has access to, as its item's adlcp:map in the content package grants: its ID, and its content, which the SCO may read or write as the map allows. Added in the 4th Edition."@en ;
    skos:definition "A shared data store the SCO has access to, as its item's adlcp:map in the content package grants: its ID, and its content, which the SCO may read or write as the map allows. Added in the 4th Edition."@en ;
    dct:source "SCORM 2004 4th Edition Run-Time Environment: adl.data" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-rte> .

foxxi-scorm-rte:version a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data model version"@en ;
    skos:notation "cmi._version" ;
    rdfs:comment "[RO] The version of the data model the LMS supports: \"1.0\"."@en ;
    skos:definition "[RO] The version of the data model the LMS supports: \"1.0\"."@en ;
    rdfs:domain foxxi-scorm-rte:DataModel ;
    rdfs:range xsd:string ;
    dct:source "SCORM 2004 4th Edition Run-Time Environment: cmi._version" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-rte> .

foxxi-scorm-rte:completionStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "completion status"@en ;
    skos:notation "cmi.completion_status" ;
    rdfs:comment "[RW] Whether the learner has completed the SCO: completed, incomplete, not attempted or unknown."@en ;
    skos:definition "[RW] Whether the learner has completed the SCO: completed, incomplete, not attempted or unknown."@en ;
    rdfs:domain foxxi-scorm-rte:DataModel ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "completed" "incomplete" "not attempted" "unknown" ) ] ;
    dct:source "SCORM 2004 4th Edition Run-Time Environment: cmi.completion_status" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-rte> .

foxxi-scorm-rte:completionThreshold a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "completion threshold"@en ;
    skos:notation "cmi.completion_threshold" ;
    rdfs:comment "[RO] The progress measure, from 0 to 1, at or above which the SCO is complete — the item's minimum progress measure in the content package (adlcp:completionThreshold)."@en ;
    skos:definition "[RO] The progress measure, from 0 to 1, at or above which the SCO is complete — the item's minimum progress measure in the content package (adlcp:completionThreshold)."@en ;
    rdfs:domain foxxi-scorm-rte:DataModel ;
    rdfs:range foxxi-scorm-rte:UnitInterval ;
    dct:source "SCORM 2004 4th Edition Run-Time Environment: cmi.completion_threshold" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-rte> .

foxxi-scorm-rte:credit a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "credit"@en ;
    skos:notation "cmi.credit" ;
    rdfs:comment "[RO] Whether the learner is credited for performance in the SCO: credit or no-credit."@en ;
    skos:definition "[RO] Whether the learner is credited for performance in the SCO: credit or no-credit."@en ;
    rdfs:domain foxxi-scorm-rte:DataModel ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "credit" "no-credit" ) ] ;
    dct:source "SCORM 2004 4th Edition Run-Time Environment: cmi.credit" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-rte> .

foxxi-scorm-rte:entry a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "entry"@en ;
    skos:notation "cmi.entry" ;
    rdfs:comment "[RO] Whether the learner has been in the SCO before in this attempt: ab-initio (first time), resume (after a suspension), or empty."@en ;
    skos:definition "[RO] Whether the learner has been in the SCO before in this attempt: ab-initio (first time), resume (after a suspension), or empty."@en ;
    rdfs:domain foxxi-scorm-rte:DataModel ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "ab-initio" "resume" "" ) ] ;
    dct:source "SCORM 2004 4th Edition Run-Time Environment: cmi.entry" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-rte> .

foxxi-scorm-rte:exit a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "exit"@en ;
    skos:notation "cmi.exit" ;
    rdfs:comment "[WO] How or why the learner left the SCO: time-out, suspend, normal, empty, or the deprecated logout. Anything but suspend ends the attempt."@en ;
    skos:definition "[WO] How or why the learner left the SCO: time-out, suspend, normal, empty, or the deprecated logout. Anything but suspend ends the attempt."@en ;
    rdfs:domain foxxi-scorm-rte:DataModel ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "time-out" "suspend" "logout" "normal" "" ) ] ;
    dct:source "SCORM 2004 4th Edition Run-Time Environment: cmi.exit" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-rte> .

foxxi-scorm-rte:launchData a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "launch data"@en ;
    skos:notation "cmi.launch_data" ;
    rdfs:comment "[RO] Data the SCO needs to start, from its item's adlcp:dataFromLMS in the content package; characterstring, SPM 4000."@en ;
