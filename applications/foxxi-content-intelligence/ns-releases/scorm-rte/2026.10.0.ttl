    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-rte> .

foxxi-scorm-rte:NavigationRequestType-exitAll a skos:Concept ;
    skos:inScheme foxxi-scorm-rte:NavigationRequestType ;
    skos:topConceptOf foxxi-scorm-rte:NavigationRequestType ;
    skos:prefLabel "exit all"@en ;
    rdfs:label "exit all (Navigation requests)"@en ;
    skos:notation "exitAll" ;
    skos:definition "End the whole activity tree."@en ;
    rdfs:comment "End the whole activity tree."@en ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-rte> .

foxxi-scorm-rte:NavigationRequestType-abandon a skos:Concept ;
    skos:inScheme foxxi-scorm-rte:NavigationRequestType ;
    skos:topConceptOf foxxi-scorm-rte:NavigationRequestType ;
    skos:prefLabel "abandon"@en ;
    rdfs:label "abandon (Navigation requests)"@en ;
    skos:notation "abandon" ;
    skos:definition "Abandon the current activity."@en ;
    rdfs:comment "Abandon the current activity."@en ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-rte> .

foxxi-scorm-rte:NavigationRequestType-abandonAll a skos:Concept ;
    skos:inScheme foxxi-scorm-rte:NavigationRequestType ;
    skos:topConceptOf foxxi-scorm-rte:NavigationRequestType ;
    skos:prefLabel "abandon all"@en ;
    rdfs:label "abandon all (Navigation requests)"@en ;
    skos:notation "abandonAll" ;
    skos:definition "Abandon the whole activity tree."@en ;
    rdfs:comment "Abandon the whole activity tree."@en ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-rte> .

foxxi-scorm-rte:NavigationRequestType-suspendAll a skos:Concept ;
    skos:inScheme foxxi-scorm-rte:NavigationRequestType ;
    skos:topConceptOf foxxi-scorm-rte:NavigationRequestType ;
    skos:prefLabel "suspend all"@en ;
    rdfs:label "suspend all (Navigation requests)"@en ;
    skos:notation "suspendAll" ;
    skos:definition "Suspend the whole activity tree, to resume later."@en ;
    rdfs:comment "Suspend the whole activity tree, to resume later."@en ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-rte> .

foxxi-scorm-rte:NavigationRequestType-_none_ a skos:Concept ;
    skos:inScheme foxxi-scorm-rte:NavigationRequestType ;
    skos:topConceptOf foxxi-scorm-rte:NavigationRequestType ;
    skos:prefLabel "none"@en ;
    rdfs:label "none (Navigation requests)"@en ;
    skos:notation "_none_" ;
    skos:definition "No request: the default."@en ;
    rdfs:comment "No request: the default."@en ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-rte> .

foxxi-scorm-rte:RequestValidity a skos:ConceptScheme ;
    rdfs:label "Request validities"@en ;
    skos:prefLabel "Request validities"@en ;
    rdfs:comment "The values of adl.nav.request_valid."@en ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-rte> ;
    skos:hasTopConcept foxxi-scorm-rte:RequestValidity-true ,
        foxxi-scorm-rte:RequestValidity-false ,
        foxxi-scorm-rte:RequestValidity-unknown .

foxxi-scorm-rte:RequestValidity-true a skos:Concept ;
    skos:inScheme foxxi-scorm-rte:RequestValidity ;
    skos:topConceptOf foxxi-scorm-rte:RequestValidity ;
    skos:prefLabel "true"@en ;
    rdfs:label "true (Request validities)"@en ;
    skos:notation "true" ;
    skos:definition "The request would be valid."@en ;
    rdfs:comment "The request would be valid."@en ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-rte> .

foxxi-scorm-rte:RequestValidity-false a skos:Concept ;
    skos:inScheme foxxi-scorm-rte:RequestValidity ;
    skos:topConceptOf foxxi-scorm-rte:RequestValidity ;
    skos:prefLabel "false"@en ;
    rdfs:label "false (Request validities)"@en ;
    skos:notation "false" ;
    skos:definition "The request would not be valid."@en ;
    rdfs:comment "The request would not be valid."@en ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-rte> .

foxxi-scorm-rte:RequestValidity-unknown a skos:Concept ;
    skos:inScheme foxxi-scorm-rte:RequestValidity ;
    skos:topConceptOf foxxi-scorm-rte:RequestValidity ;
    skos:prefLabel "unknown"@en ;
    rdfs:label "unknown (Request validities)"@en ;
    skos:notation "unknown" ;
    skos:definition "Whether the request would be valid cannot be determined now."@en ;
    rdfs:comment "Whether the request would be valid cannot be determined now."@en ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-rte> .

[
    a owl:AllDisjointClasses ;
    owl:members (
        foxxi-scorm-rte:DataModel
        foxxi-scorm-rte:Comment
        foxxi-scorm-rte:LearnerPreference
        foxxi-scorm-rte:Interaction
        foxxi-scorm-rte:InteractionObjective
        foxxi-scorm-rte:CorrectResponse
        foxxi-scorm-rte:Objective
        foxxi-scorm-rte:Score
        foxxi-scorm-rte:TargetedRequestValidity
        foxxi-scorm-rte:SharedData
    )
] .

prov:wasDerivedFrom a owl:ObjectProperty ;
    rdfs:label "was derived from"@en ;
    rdfs:comment "A transformation of an entity into another, an update of an entity resulting in a new one, or the construction of a new entity based on a pre-existing one. (PROV-O)"@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o> ;
    rdfs:domain prov:Entity ;
    rdfs:range prov:Entity .

skos:ConceptScheme a owl:Class ;
    rdfs:label "Concept Scheme"@en ;
    rdfs:comment "A set of concepts, optionally including statements about semantic relationships between those concepts. (SKOS)"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    owl:disjointWith skos:Concept .

skos:hasTopConcept a owl:ObjectProperty ;
    rdfs:label "has top concept"@en ;
    rdfs:comment "Relates, by convention, a concept scheme to a concept which is topmost in the broader/narrower concept hierarchies for that scheme. (SKOS)"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:domain skos:ConceptScheme ;
    rdfs:range skos:Concept .

skos:Concept a owl:Class ;
    rdfs:label "Concept"@en ;
    rdfs:comment "An idea or notion; a unit of thought. (SKOS)"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> .

skos:inScheme a owl:ObjectProperty ;
    rdfs:label "is in scheme"@en ;
    rdfs:comment "Relates a resource (for example a concept) to a concept scheme in which it is included. (SKOS)"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:range skos:ConceptScheme .

skos:topConceptOf a owl:ObjectProperty ;
    rdfs:label "is top concept in scheme"@en ;
    rdfs:comment "Relates a concept to the concept scheme that it is a top level concept of. (SKOS)"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:inScheme ;
    owl:inverseOf skos:hasTopConcept .

prov:Entity a owl:Class ;
    rdfs:label "Entity"@en ;
    rdfs:comment "A physical, digital, conceptual, or other kind of thing with some fixed aspects. (PROV-O)"@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o> .

