shapes:TargetedRequestValidityShape-requestValidity a sh:PropertyShape ;
    sh:path foxxi-scorm-rte:requestValidity ;
    sh:name "requestValidity" ;
    sh:description "true, false or unknown"@en ;
    sh:message "Targeted request validity conformance — requestValidity: exactly 1 value, of type xsd:string, one of \"true\", \"false\", \"unknown\" — true, false or unknown"@en ;
