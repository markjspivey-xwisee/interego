shapes:SharedDataShape a sh:NodeShape ;
    sh:targetClass foxxi-scorm-rte:SharedData ;
    rdfs:label "Shared data conformance"@en ;
    rdfs:comment "A shared data store has an ID; content beyond its SPM is reported as a warning (SCORM 2004 4th Edition Run-Time Environment: adl.data)."@en ;
    sh:property shapes:SharedDataShape-sharedDataId , shapes:SharedDataShape-sharedDataStore ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-rte/shapes> .

shapes:SharedDataShape-sharedDataId a sh:PropertyShape ;
    sh:path foxxi-scorm-rte:sharedDataId ;
    sh:name "sharedDataId" ;
    sh:description "adl.data.n.id"@en ;
    sh:message "Shared data conformance — sharedDataId: exactly 1 value, of type xsd:string — adl.data.n.id"@en ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 .

shapes:SharedDataShape-sharedDataStore a sh:PropertyShape ;
    sh:path foxxi-scorm-rte:sharedDataStore ;
    sh:name "sharedDataStore" ;
    sh:description "adl.data.n.store, within its SPM of 64000 characters to be portable"@en ;
    sh:message "Shared data conformance — sharedDataStore: at most 1 value, of type xsd:string, matching ^[\\s\\S]{0,64000}$ — adl.data.n.store, within its SPM of 64000 characters to be portable"@en ;
    sh:severity sh:Warning ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:pattern "^[\\s\\S]{0,64000}$" .
