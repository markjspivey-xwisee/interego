shapes:DataModelShape a sh:NodeShape ;
    sh:targetClass foxxi-scorm-rte:DataModel ;
    rdfs:label "Run-time data conformance"@en ;
    rdfs:comment "Every element has at most one value; the statuses, credit, entry, exit, mode and time limit action are from their vocabularies; measures and scores are in range; the times are timeintervals; suspend data beyond its SPM is reported as a warning; the navigation request is a navigation request (SCORM 2004 4th Edition Run-Time Environment)."@en ;
    sh:property shapes:DataModelShape-completionStatus ,
        shapes:DataModelShape-successStatus ,
        shapes:DataModelShape-credit ,
        shapes:DataModelShape-entry ,
        shapes:DataModelShape-exit ,
        shapes:DataModelShape-mode ,
        shapes:DataModelShape-timeLimitAction ,
        shapes:DataModelShape-completionThreshold ,
        shapes:DataModelShape-progressMeasure ,
        shapes:DataModelShape-scaledPassingScore ,
        shapes:DataModelShape-sessionTime ,
        shapes:DataModelShape-totalTime ,
        shapes:DataModelShape-maxTimeAllowed ,
        shapes:DataModelShape-suspendData ,
        shapes:DataModelShape-navRequest ,
        shapes:DataModelShape-navRequestValidContinue ,
        shapes:DataModelShape-navRequestValidPrevious ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-rte/shapes> .

shapes:DataModelShape-completionStatus a sh:PropertyShape ;
    sh:path foxxi-scorm-rte:completionStatus ;
    sh:name "completionStatus" ;
    sh:description "cmi.completion_status"@en ;
    sh:message "Run-time data conformance — completionStatus: at most 1 value, of type xsd:string, one of \"completed\", \"incomplete\", \"not attempted\", \"unknown\" — cmi.completion_status"@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:in ( "completed" "incomplete" "not attempted" "unknown" ) .

shapes:DataModelShape-successStatus a sh:PropertyShape ;
    sh:path foxxi-scorm-rte:successStatus ;
    sh:name "successStatus" ;
    sh:description "cmi.success_status"@en ;
    sh:message "Run-time data conformance — successStatus: at most 1 value, of type xsd:string, one of \"passed\", \"failed\", \"unknown\" — cmi.success_status"@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:in ( "passed" "failed" "unknown" ) .

shapes:DataModelShape-credit a sh:PropertyShape ;
    sh:path foxxi-scorm-rte:credit ;
    sh:name "credit" ;
    sh:description "cmi.credit"@en ;
    sh:message "Run-time data conformance — credit: at most 1 value, of type xsd:string, one of \"credit\", \"no-credit\" — cmi.credit"@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:in ( "credit" "no-credit" ) .

shapes:DataModelShape-entry a sh:PropertyShape ;
    sh:path foxxi-scorm-rte:entry ;
    sh:name "entry" ;
    sh:description "cmi.entry"@en ;
    sh:message "Run-time data conformance — entry: at most 1 value, of type xsd:string, one of \"ab-initio\", \"resume\", \"\" — cmi.entry"@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:in ( "ab-initio" "resume" "" ) .

shapes:DataModelShape-exit a sh:PropertyShape ;
    sh:path foxxi-scorm-rte:exit ;
    sh:name "exit" ;
    sh:description "cmi.exit (logout is deprecated)"@en ;
    sh:message "Run-time data conformance — exit: at most 1 value, of type xsd:string, one of \"time-out\", \"suspend\", \"logout\", \"normal\", \"\" — cmi.exit (logout is deprecated)"@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:in ( "time-out" "suspend" "logout" "normal" "" ) .

shapes:DataModelShape-mode a sh:PropertyShape ;
    sh:path foxxi-scorm-rte:mode ;
    sh:name "mode" ;
    sh:description "cmi.mode"@en ;
    sh:message "Run-time data conformance — mode: at most 1 value, of type xsd:string, one of \"browse\", \"normal\", \"review\" — cmi.mode"@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:in ( "browse" "normal" "review" ) .

shapes:DataModelShape-timeLimitAction a sh:PropertyShape ;
    sh:path foxxi-scorm-rte:timeLimitAction ;
    sh:name "timeLimitAction" ;
    sh:description "cmi.time_limit_action"@en ;
    sh:message "Run-time data conformance — timeLimitAction: at most 1 value, of type xsd:string, one of \"exit,message\", \"exit,no message\", \"continue,message\", \"continue,no message\" — cmi.time_limit_action"@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:in ( "exit,message" "exit,no message" "continue,message" "continue,no message" ) .

shapes:DataModelShape-completionThreshold a sh:PropertyShape ;
    sh:path foxxi-scorm-rte:completionThreshold ;
    sh:name "completionThreshold" ;
    sh:description "cmi.completion_threshold, from 0 to 1"@en ;
    sh:message "Run-time data conformance — completionThreshold: at most 1 value, of type xsd:integer or xsd:decimal or xsd:double, between 0 and 1 — cmi.completion_threshold, from 0 to 1"@en ;
    sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:decimal ] [ sh:datatype xsd:double ] ) ;
    sh:maxCount 1 ;
    sh:minInclusive 0 ;
    sh:maxInclusive 1 .

shapes:DataModelShape-progressMeasure a sh:PropertyShape ;
    sh:path foxxi-scorm-rte:progressMeasure ;
    sh:name "progressMeasure" ;
    sh:description "cmi.progress_measure, from 0 to 1"@en ;
    sh:message "Run-time data conformance — progressMeasure: at most 1 value, of type xsd:integer or xsd:decimal or xsd:double, between 0 and 1 — cmi.progress_measure, from 0 to 1"@en ;
    sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:decimal ] [ sh:datatype xsd:double ] ) ;
    sh:maxCount 1 ;
    sh:minInclusive 0 ;
    sh:maxInclusive 1 .

shapes:DataModelShape-scaledPassingScore a sh:PropertyShape ;
    sh:path foxxi-scorm-rte:scaledPassingScore ;
    sh:name "scaledPassingScore" ;
    sh:description "cmi.scaled_passing_score, from -1 to 1"@en ;
    sh:message "Run-time data conformance — scaledPassingScore: at most 1 value, of type xsd:integer or xsd:decimal or xsd:double, between -1 and 1 — cmi.scaled_passing_score, from -1 to 1"@en ;
    sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:decimal ] [ sh:datatype xsd:double ] ) ;
    sh:maxCount 1 ;
    sh:minInclusive -1 ;
    sh:maxInclusive 1 .

shapes:DataModelShape-sessionTime a sh:PropertyShape ;
    sh:path foxxi-scorm-rte:sessionTime ;
    sh:name "sessionTime" ;
    sh:description "cmi.session_time, timeinterval (second,10,2)"@en ;
    sh:message "Run-time data conformance — sessionTime: at most 1 value, of type xsd:string, matching ^P(([0-9]+Y([0-9]+M)?([0-9]+D)?|[0-9]+M([0-9]+D)?|[0-9]+D)(T([0-9]+H([0-9]+M)?([0-9]+(\\.[0-9]{1,2})?S)?|[0-9]+M([0-9]+(\\.[0-9]{1,2})?S)?|[0-9]+(\\.[0-9]{1,2})?S))?|T([0-9]+H([0-9]+M)?([0-9]+(\\.[0-9]{1,2})?S)?|[0-9]+M([0-9]+(\\.[0-9]{1,2})?S)?|[0-9]+(\\.[0-9]{1,2})?S))$ — cmi.session_time, timeinterval (second,10,2)"@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:pattern "^P(([0-9]+Y([0-9]+M)?([0-9]+D)?|[0-9]+M([0-9]+D)?|[0-9]+D)(T([0-9]+H([0-9]+M)?([0-9]+(\\.[0-9]{1,2})?S)?|[0-9]+M([0-9]+(\\.[0-9]{1,2})?S)?|[0-9]+(\\.[0-9]{1,2})?S))?|T([0-9]+H([0-9]+M)?([0-9]+(\\.[0-9]{1,2})?S)?|[0-9]+M([0-9]+(\\.[0-9]{1,2})?S)?|[0-9]+(\\.[0-9]{1,2})?S))$" .

shapes:DataModelShape-totalTime a sh:PropertyShape ;
    sh:path foxxi-scorm-rte:totalTime ;
    sh:name "totalTime" ;
    sh:description "cmi.total_time, timeinterval (second,10,2)"@en ;
    sh:message "Run-time data conformance — totalTime: at most 1 value, of type xsd:string, matching ^P(([0-9]+Y([0-9]+M)?([0-9]+D)?|[0-9]+M([0-9]+D)?|[0-9]+D)(T([0-9]+H([0-9]+M)?([0-9]+(\\.[0-9]{1,2})?S)?|[0-9]+M([0-9]+(\\.[0-9]{1,2})?S)?|[0-9]+(\\.[0-9]{1,2})?S))?|T([0-9]+H([0-9]+M)?([0-9]+(\\.[0-9]{1,2})?S)?|[0-9]+M([0-9]+(\\.[0-9]{1,2})?S)?|[0-9]+(\\.[0-9]{1,2})?S))$ — cmi.total_time, timeinterval (second,10,2)"@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:pattern "^P(([0-9]+Y([0-9]+M)?([0-9]+D)?|[0-9]+M([0-9]+D)?|[0-9]+D)(T([0-9]+H([0-9]+M)?([0-9]+(\\.[0-9]{1,2})?S)?|[0-9]+M([0-9]+(\\.[0-9]{1,2})?S)?|[0-9]+(\\.[0-9]{1,2})?S))?|T([0-9]+H([0-9]+M)?([0-9]+(\\.[0-9]{1,2})?S)?|[0-9]+M([0-9]+(\\.[0-9]{1,2})?S)?|[0-9]+(\\.[0-9]{1,2})?S))$" .

shapes:DataModelShape-maxTimeAllowed a sh:PropertyShape ;
    sh:path foxxi-scorm-rte:maxTimeAllowed ;
    sh:name "maxTimeAllowed" ;
    sh:description "cmi.max_time_allowed, timeinterval (second,10,2)"@en ;
    sh:message "Run-time data conformance — maxTimeAllowed: at most 1 value, of type xsd:string, matching ^P(([0-9]+Y([0-9]+M)?([0-9]+D)?|[0-9]+M([0-9]+D)?|[0-9]+D)(T([0-9]+H([0-9]+M)?([0-9]+(\\.[0-9]{1,2})?S)?|[0-9]+M([0-9]+(\\.[0-9]{1,2})?S)?|[0-9]+(\\.[0-9]{1,2})?S))?|T([0-9]+H([0-9]+M)?([0-9]+(\\.[0-9]{1,2})?S)?|[0-9]+M([0-9]+(\\.[0-9]{1,2})?S)?|[0-9]+(\\.[0-9]{1,2})?S))$ — cmi.max_time_allowed, timeinterval (second,10,2)"@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:pattern "^P(([0-9]+Y([0-9]+M)?([0-9]+D)?|[0-9]+M([0-9]+D)?|[0-9]+D)(T([0-9]+H([0-9]+M)?([0-9]+(\\.[0-9]{1,2})?S)?|[0-9]+M([0-9]+(\\.[0-9]{1,2})?S)?|[0-9]+(\\.[0-9]{1,2})?S))?|T([0-9]+H([0-9]+M)?([0-9]+(\\.[0-9]{1,2})?S)?|[0-9]+M([0-9]+(\\.[0-9]{1,2})?S)?|[0-9]+(\\.[0-9]{1,2})?S))$" .

shapes:DataModelShape-suspendData a sh:PropertyShape ;
    sh:path foxxi-scorm-rte:suspendData ;
    sh:name "suspendData" ;
    sh:description "cmi.suspend_data, within its SPM of 64000 characters to be portable"@en ;
    sh:message "Run-time data conformance — suspendData: at most 1 value, of type xsd:string, matching ^[\\s\\S]{0,64000}$ — cmi.suspend_data, within its SPM of 64000 characters to be portable"@en ;
    sh:severity sh:Warning ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:pattern "^[\\s\\S]{0,64000}$" .

shapes:DataModelShape-navRequest a sh:PropertyShape ;
    sh:path foxxi-scorm-rte:navRequest ;
    sh:name "navRequest" ;
    sh:description "adl.nav.request"@en ;
    sh:message "Run-time data conformance — navRequest: at most 1 value, of type xsd:string, matching ^(continue|previous|exit|exitAll|abandon|abandonAll|suspendAll|_none_|\\{target=[^}]+\\}(choice|jump))$ — adl.nav.request"@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:pattern "^(continue|previous|exit|exitAll|abandon|abandonAll|suspendAll|_none_|\\{target=[^}]+\\}(choice|jump))$" .

shapes:DataModelShape-navRequestValidContinue a sh:PropertyShape ;
    sh:path foxxi-scorm-rte:navRequestValidContinue ;
    sh:name "navRequestValidContinue" ;
    sh:description "adl.nav.request_valid.continue"@en ;
    sh:message "Run-time data conformance — navRequestValidContinue: at most 1 value, of type xsd:string, one of \"true\", \"false\", \"unknown\" — adl.nav.request_valid.continue"@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:in ( "true" "false" "unknown" ) .

shapes:DataModelShape-navRequestValidPrevious a sh:PropertyShape ;
    sh:path foxxi-scorm-rte:navRequestValidPrevious ;
    sh:name "navRequestValidPrevious" ;
    sh:description "adl.nav.request_valid.previous"@en ;
    sh:message "Run-time data conformance — navRequestValidPrevious: at most 1 value, of type xsd:string, one of \"true\", \"false\", \"unknown\" — adl.nav.request_valid.previous"@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:in ( "true" "false" "unknown" ) .

shapes:ScoreShape a sh:NodeShape ;
    sh:targetClass foxxi-scorm-rte:Score ;
    rdfs:label "Score conformance"@en ;
    rdfs:comment "A scaled score is from -1 to 1; raw, minimum and maximum are real numbers (SCORM 2004 4th Edition Run-Time Environment: cmi.score)."@en ;
    sh:property shapes:ScoreShape-scoreScaled ,
        shapes:ScoreShape-scoreRaw ,
        shapes:ScoreShape-scoreMin ,
        shapes:ScoreShape-scoreMax ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-rte/shapes> .

shapes:ScoreShape-scoreScaled a sh:PropertyShape ;
    sh:path foxxi-scorm-rte:scoreScaled ;
    sh:name "scoreScaled" ;
    sh:description "score.scaled, from -1 to 1"@en ;
    sh:message "Score conformance — scoreScaled: at most 1 value, of type xsd:integer or xsd:decimal or xsd:double, between -1 and 1 — score.scaled, from -1 to 1"@en ;
    sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:decimal ] [ sh:datatype xsd:double ] ) ;
    sh:maxCount 1 ;
    sh:minInclusive -1 ;
    sh:maxInclusive 1 .

shapes:ScoreShape-scoreRaw a sh:PropertyShape ;
    sh:path foxxi-scorm-rte:scoreRaw ;
    sh:name "scoreRaw" ;
    sh:description "score.raw, real (10,7)"@en ;
    sh:message "Score conformance — scoreRaw: at most 1 value, of type xsd:integer or xsd:decimal or xsd:double — score.raw, real (10,7)"@en ;
    sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:decimal ] [ sh:datatype xsd:double ] ) ;
    sh:maxCount 1 .

shapes:ScoreShape-scoreMin a sh:PropertyShape ;
    sh:path foxxi-scorm-rte:scoreMin ;
    sh:name "scoreMin" ;
    sh:description "score.min, real (10,7)"@en ;
    sh:message "Score conformance — scoreMin: at most 1 value, of type xsd:integer or xsd:decimal or xsd:double — score.min, real (10,7)"@en ;
    sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:decimal ] [ sh:datatype xsd:double ] ) ;
    sh:maxCount 1 .

shapes:ScoreShape-scoreMax a sh:PropertyShape ;
    sh:path foxxi-scorm-rte:scoreMax ;
    sh:name "scoreMax" ;
    sh:description "score.max, real (10,7)"@en ;
    sh:message "Score conformance — scoreMax: at most 1 value, of type xsd:integer or xsd:decimal or xsd:double — score.max, real (10,7)"@en ;
    sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:decimal ] [ sh:datatype xsd:double ] ) ;
    sh:maxCount 1 .

shapes:InteractionShape a sh:NodeShape ;
    sh:targetClass foxxi-scorm-rte:Interaction ;
    rdfs:label "Interaction conformance"@en ;
    rdfs:comment "An interaction has an ID and a type from the vocabulary; its weighting is a real number, its result a judgement or a number, its latency a timeinterval and its timestamp a SCORM time (SCORM 2004 4th Edition Run-Time Environment: cmi.interactions)."@en ;
    sh:property shapes:InteractionShape-interactionId ,
        shapes:InteractionShape-interactionType ,
        shapes:InteractionShape-weighting ,
        shapes:InteractionShape-result ,
        shapes:InteractionShape-latency ,
        shapes:InteractionShape-interactionTimestamp ,
        shapes:InteractionShape-interactionDescription ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-rte/shapes> .

shapes:InteractionShape-interactionId a sh:PropertyShape ;
    sh:path foxxi-scorm-rte:interactionId ;
    sh:name "interactionId" ;
    sh:description "cmi.interactions.n.id, required"@en ;
    sh:message "Interaction conformance — interactionId: exactly 1 value, of type xsd:string — cmi.interactions.n.id, required"@en ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 .

shapes:InteractionShape-interactionType a sh:PropertyShape ;
    sh:path foxxi-scorm-rte:interactionType ;
    sh:name "interactionType" ;
    sh:description "cmi.interactions.n.type"@en ;
    sh:message "Interaction conformance — interactionType: exactly 1 value, of type xsd:string, one of \"true-false\", \"choice\", \"fill-in\", \"long-fill-in\", \"likert\", \"matching\", \"performance\", \"sequencing\", \"numeric\", \"other\" — cmi.interactions.n.type"@en ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in (
        "true-false"
        "choice"
        "fill-in"
        "long-fill-in"
        "likert"
        "matching"
        "performance"
        "sequencing"
        "numeric"
        "other"
    ) .

shapes:InteractionShape-weighting a sh:PropertyShape ;
    sh:path foxxi-scorm-rte:weighting ;
    sh:name "weighting" ;
    sh:description "cmi.interactions.n.weighting, real (10,7)"@en ;
    sh:message "Interaction conformance — weighting: at most 1 value, of type xsd:integer or xsd:decimal or xsd:double — cmi.interactions.n.weighting, real (10,7)"@en ;
    sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:decimal ] [ sh:datatype xsd:double ] ) ;
    sh:maxCount 1 .

shapes:InteractionShape-result a sh:PropertyShape ;
    sh:path foxxi-scorm-rte:result ;
    sh:name "result" ;
    sh:description "cmi.interactions.n.result: correct, incorrect, unanticipated, neutral, or a number"@en ;
    sh:message "Interaction conformance — result: at most 1 value, of type xsd:string, matching ^(correct|incorrect|unanticipated|neutral|-?([0-9]+(\\.[0-9]+)?|\\.[0-9]+))$ — cmi.interactions.n.result: correct, incorrect, unanticipated, neutral, or a number"@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:pattern "^(correct|incorrect|unanticipated|neutral|-?([0-9]+(\\.[0-9]+)?|\\.[0-9]+))$" .

shapes:InteractionShape-latency a sh:PropertyShape ;
    sh:path foxxi-scorm-rte:latency ;
    sh:name "latency" ;
    sh:description "cmi.interactions.n.latency, timeinterval (second,10,2)"@en ;
    sh:message "Interaction conformance — latency: at most 1 value, of type xsd:string, matching ^P(([0-9]+Y([0-9]+M)?([0-9]+D)?|[0-9]+M([0-9]+D)?|[0-9]+D)(T([0-9]+H([0-9]+M)?([0-9]+(\\.[0-9]{1,2})?S)?|[0-9]+M([0-9]+(\\.[0-9]{1,2})?S)?|[0-9]+(\\.[0-9]{1,2})?S))?|T([0-9]+H([0-9]+M)?([0-9]+(\\.[0-9]{1,2})?S)?|[0-9]+M([0-9]+(\\.[0-9]{1,2})?S)?|[0-9]+(\\.[0-9]{1,2})?S))$ — cmi.interactions.n.latency, timeinterval (second,10,2)"@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:pattern "^P(([0-9]+Y([0-9]+M)?([0-9]+D)?|[0-9]+M([0-9]+D)?|[0-9]+D)(T([0-9]+H([0-9]+M)?([0-9]+(\\.[0-9]{1,2})?S)?|[0-9]+M([0-9]+(\\.[0-9]{1,2})?S)?|[0-9]+(\\.[0-9]{1,2})?S))?|T([0-9]+H([0-9]+M)?([0-9]+(\\.[0-9]{1,2})?S)?|[0-9]+M([0-9]+(\\.[0-9]{1,2})?S)?|[0-9]+(\\.[0-9]{1,2})?S))$" .

shapes:InteractionShape-interactionTimestamp a sh:PropertyShape ;
    sh:path foxxi-scorm-rte:interactionTimestamp ;
    sh:name "interactionTimestamp" ;
    sh:description "cmi.interactions.n.timestamp, time (second,10,0)"@en ;
    sh:message "Interaction conformance — interactionTimestamp: at most 1 value, of type xsd:string, matching ^[0-9]{4}(-[0-9]{2}(-[0-9]{2}(T[0-9]{2}(:[0-9]{2}(:[0-9]{2}(\\.[0-9]{1,2})?(Z|[+-][0-9]{2}(:[0-9]{2})?)?)?)?)?)?)?$ — cmi.interactions.n.timestamp, time (second,10,0)"@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:pattern "^[0-9]{4}(-[0-9]{2}(-[0-9]{2}(T[0-9]{2}(:[0-9]{2}(:[0-9]{2}(\\.[0-9]{1,2})?(Z|[+-][0-9]{2}(:[0-9]{2})?)?)?)?)?)?)?$" .

shapes:InteractionShape-interactionDescription a sh:PropertyShape ;
    sh:path foxxi-scorm-rte:interactionDescription ;
    sh:name "interactionDescription" ;
    sh:description "cmi.interactions.n.description, localized_string_type"@en ;
    sh:message "Interaction conformance — interactionDescription: at most 1 value, of type rdf:langString — cmi.interactions.n.description, localized_string_type"@en ;
    sh:datatype rdf:langString ;
    sh:maxCount 1 .

shapes:ObjectiveShape a sh:NodeShape ;
    sh:targetClass foxxi-scorm-rte:Objective ;
    rdfs:label "Objective conformance"@en ;
    rdfs:comment "An objective has an ID; its statuses are from their vocabularies; its progress measure is from 0 to 1 (SCORM 2004 4th Edition Run-Time Environment: cmi.objectives)."@en ;
    sh:property shapes:ObjectiveShape-objectiveId ,
        shapes:ObjectiveShape-objectiveSuccessStatus ,
        shapes:ObjectiveShape-objectiveCompletionStatus ,
        shapes:ObjectiveShape-objectiveProgressMeasure ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-rte/shapes> .

shapes:ObjectiveShape-objectiveId a sh:PropertyShape ;
    sh:path foxxi-scorm-rte:objectiveId ;
    sh:name "objectiveId" ;
    sh:description "cmi.objectives.n.id, required"@en ;
    sh:message "Objective conformance — objectiveId: exactly 1 value, of type xsd:string — cmi.objectives.n.id, required"@en ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 .

shapes:ObjectiveShape-objectiveSuccessStatus a sh:PropertyShape ;
    sh:path foxxi-scorm-rte:objectiveSuccessStatus ;
    sh:name "objectiveSuccessStatus" ;
    sh:description "cmi.objectives.n.success_status"@en ;
    sh:message "Objective conformance — objectiveSuccessStatus: at most 1 value, of type xsd:string, one of \"passed\", \"failed\", \"unknown\" — cmi.objectives.n.success_status"@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:in ( "passed" "failed" "unknown" ) .

shapes:ObjectiveShape-objectiveCompletionStatus a sh:PropertyShape ;
    sh:path foxxi-scorm-rte:objectiveCompletionStatus ;
    sh:name "objectiveCompletionStatus" ;
    sh:description "cmi.objectives.n.completion_status"@en ;
    sh:message "Objective conformance — objectiveCompletionStatus: at most 1 value, of type xsd:string, one of \"completed\", \"incomplete\", \"not attempted\", \"unknown\" — cmi.objectives.n.completion_status"@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:in ( "completed" "incomplete" "not attempted" "unknown" ) .

shapes:ObjectiveShape-objectiveProgressMeasure a sh:PropertyShape ;
    sh:path foxxi-scorm-rte:objectiveProgressMeasure ;
    sh:name "objectiveProgressMeasure" ;
    sh:description "cmi.objectives.n.progress_measure, from 0 to 1"@en ;
    sh:message "Objective conformance — objectiveProgressMeasure: at most 1 value, of type xsd:integer or xsd:decimal or xsd:double, between 0 and 1 — cmi.objectives.n.progress_measure, from 0 to 1"@en ;
    sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:decimal ] [ sh:datatype xsd:double ] ) ;
    sh:maxCount 1 ;
    sh:minInclusive 0 ;
    sh:maxInclusive 1 .

shapes:LearnerPreferenceShape a sh:NodeShape ;
    sh:targetClass foxxi-scorm-rte:LearnerPreference ;
    rdfs:label "Learner preference conformance"@en ;
    rdfs:comment "The audio level and delivery speed are 0 or more; audio captioning is -1, 0 or 1; a language beyond its SPM is reported as a warning (SCORM 2004 4th Edition Run-Time Environment: cmi.learner_preference)."@en ;
    sh:property shapes:LearnerPreferenceShape-audioLevel ,
        shapes:LearnerPreferenceShape-deliverySpeed ,
        shapes:LearnerPreferenceShape-audioCaptioning ,
        shapes:LearnerPreferenceShape-preferenceLanguage ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-rte/shapes> .

shapes:LearnerPreferenceShape-audioLevel a sh:PropertyShape ;
    sh:path foxxi-scorm-rte:audioLevel ;
    sh:name "audioLevel" ;
    sh:description "audio_level, 0 or more"@en ;
    sh:message "Learner preference conformance — audioLevel: at most 1 value, of type xsd:integer or xsd:decimal or xsd:double, at least 0 — audio_level, 0 or more"@en ;
    sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:decimal ] [ sh:datatype xsd:double ] ) ;
    sh:maxCount 1 ;
    sh:minInclusive 0 .

shapes:LearnerPreferenceShape-deliverySpeed a sh:PropertyShape ;
    sh:path foxxi-scorm-rte:deliverySpeed ;
    sh:name "deliverySpeed" ;
    sh:description "delivery_speed, 0 or more"@en ;
    sh:message "Learner preference conformance — deliverySpeed: at most 1 value, of type xsd:integer or xsd:decimal or xsd:double, at least 0 — delivery_speed, 0 or more"@en ;
    sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:decimal ] [ sh:datatype xsd:double ] ) ;
    sh:maxCount 1 ;
    sh:minInclusive 0 .

shapes:LearnerPreferenceShape-audioCaptioning a sh:PropertyShape ;
    sh:path foxxi-scorm-rte:audioCaptioning ;
    sh:name "audioCaptioning" ;
    sh:description "audio_captioning: -1, 0 or 1"@en ;
    sh:message "Learner preference conformance — audioCaptioning: at most 1 value, of type xsd:integer, between -1 and 1 — audio_captioning: -1, 0 or 1"@en ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:minInclusive -1 ;
    sh:maxInclusive 1 .

shapes:LearnerPreferenceShape-preferenceLanguage a sh:PropertyShape ;
    sh:path foxxi-scorm-rte:preferenceLanguage ;
    sh:name "preferenceLanguage" ;
    sh:description "language, within its SPM of 250 characters to be portable"@en ;
    sh:message "Learner preference conformance — preferenceLanguage: at most 1 value, of type xsd:string, matching ^[\\s\\S]{0,250}$ — language, within its SPM of 250 characters to be portable"@en ;
    sh:severity sh:Warning ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:pattern "^[\\s\\S]{0,250}$" .

