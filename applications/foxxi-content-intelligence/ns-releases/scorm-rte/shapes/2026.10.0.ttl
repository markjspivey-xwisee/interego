shapes:TargetedRequestValidityShape a sh:NodeShape ;
    sh:targetClass foxxi-scorm-rte:TargetedRequestValidity ;
    rdfs:label "Targeted request validity conformance"@en ;
    rdfs:comment "A targeted request validity names its target and is true, false or unknown (SCORM 2004 4th Edition Run-Time Environment: adl.nav.request_valid)."@en ;
    sh:property shapes:TargetedRequestValidityShape-requestTarget ,
        shapes:TargetedRequestValidityShape-requestValidity ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/scorm-rte/shapes> .

shapes:TargetedRequestValidityShape-requestTarget a sh:PropertyShape ;
    sh:path foxxi-scorm-rte:requestTarget ;
    sh:name "requestTarget" ;
    sh:description "the target activity's identifier"@en ;
    sh:message "Targeted request validity conformance — requestTarget: exactly 1 value, of type xsd:string — the target activity's identifier"@en ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
