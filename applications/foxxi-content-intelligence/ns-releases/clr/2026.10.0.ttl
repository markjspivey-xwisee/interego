foxxi-clr:ClrCredential a owl:Class ;
    rdfs:label "obsolete CLR Credential"@en ;
    rdfs:comment "Formerly this document's own name for a CLR 2.0 credential; 1EdTech's class, which a credential's JSON-LD context maps it to, replaces it."@en ;
    owl:deprecated true ;
    dct:isReplacedBy clr:ClrCredential ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/clr> .

