shapes:ClrCredentialShape a sh:NodeShape ;
    sh:targetClass clr:ClrCredential ;
    rdfs:label "CLR credential shape"@en ;
    rdfs:comment "A CLR 2.0 credential (CLR 2.0 B.1.1, ClrCredential): its @context begins with the W3C VC 2.0, CLR 2.0 and OB 3.0 contexts; it is identified by an IRI; it is a VerifiableCredential; it has a name, one issuer identified by an IRI, one validFrom date-time with its time zone, and one subject, a ClrSubject. A proof is optional: a credential secured by an enveloping proof (VC-JOSE-COSE, VC-JWT) carries none, and an embedded proof is a graph of its own, which Data Integrity verification checks rather than these shapes."@en ,
        "Requirements on the JSON document that have no property path in this RDF graph, checked by the Foxxi validator (JSON-LD-keyword requirements such as @context are consumed before the graph exists; a Verifiable Credential's proof is a graph of its own): @context (minCount 3, beginning \"^https://www\\\\.w3\\\\.org/ns/credentials/v2$\", \"^https://purl\\\\.imsglobal\\\\.org/spec/clr/v2p0/context(-2\\\\.[0-9]+\\\\.[0-9]+)?\\\\.json$\", \"^https://purl\\\\.imsglobal\\\\.org/spec/ob/v3p0/context(-3\\\\.[0-9]+\\\\.[0-9]+)?\\\\.json$\") — the W3C VC 2.0, CLR 2.0 and OB 3.0 contexts, in that order (CLR 2.0: @context [3..*])"@en ;
    sh:nodeKind sh:IRI ;
    sh:message "CLR credential shape: the node must be identified by an IRI — an unambiguous reference to the credential (CLR 2.0: id [1])"@en ;
    sh:property shapes:ClrCredentialShape-type ,
        shapes:ClrCredentialShape-issuer ,
        shapes:ClrCredentialShape-validFrom ,
        shapes:ClrCredentialShape-credentialSubject ,
        shapes:ClrCredentialShape-name ,
        shapes:ClrCredentialShape-credentialSubject-type ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/clr/shapes> .

shapes:ClrCredentialShape-type a sh:PropertyShape ;
    sh:path rdf:type ;
    sh:name "type" ;
    sh:description "a VerifiableCredential (VC 2.0 §4.5)"@en ;
    sh:message "CLR credential shape — type: including vc:VerifiableCredential — a VerifiableCredential (VC 2.0 §4.5)"@en ;
    sh:hasValue vc:VerifiableCredential .

shapes:ClrCredentialShape-issuer a sh:PropertyShape ;
    sh:path vc:issuer ;
    sh:name "issuer" ;
    sh:description "one issuer: an IRI, or a Profile identified by one (CLR 2.0: issuer [1] ProfileRef)"@en ;
    sh:message "CLR credential shape — issuer: exactly 1 value, an IRI — one issuer: an IRI, or a Profile identified by one (CLR 2.0: issuer [1] ProfileRef)"@en ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 .

shapes:ClrCredentialShape-validFrom a sh:PropertyShape ;
    sh:path vc:validFrom ;
    sh:name "validFrom" ;
    sh:description "when the credential becomes valid, with its time zone (CLR 2.0: validFrom [1] DateTimeZ)"@en ;
    sh:message "CLR credential shape — validFrom: exactly 1 value, of type xsd:dateTime, matching ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$ — when the credential becomes valid, with its time zone (CLR 2.0: validFrom [1] DateTimeZ)"@en ;
    sh:datatype xsd:dateTime ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:pattern "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$" .

shapes:ClrCredentialShape-credentialSubject a sh:PropertyShape ;
    sh:path vc:credentialSubject ;
    sh:name "credentialSubject" ;
    sh:description "one subject (CLR 2.0: credentialSubject [1])"@en ;
    sh:message "CLR credential shape — credentialSubject: exactly 1 value — one subject (CLR 2.0: credentialSubject [1])"@en ;
    sh:minCount 1 ;
    sh:maxCount 1 .

shapes:ClrCredentialShape-name a sh:PropertyShape ;
    sh:path schema:name ;
    sh:name "name" ;
    sh:description "the name of the CLR (name [1]; several values are one name in several languages)"@en ;
    sh:message "CLR credential shape — name: at least 1 value — the name of the CLR (name [1]; several values are one name in several languages)"@en ;
    sh:minCount 1 .

shapes:ClrCredentialShape-credentialSubject-type a sh:PropertyShape ;
    sh:path ( vc:credentialSubject rdf:type ) ;
    sh:name "credentialSubject.type" ;
    sh:description "the subject is a ClrSubject (CLR 2.0: credentialSubject ClrSubject)"@en ;
    sh:message "CLR credential shape — credentialSubject.type: including clr-vocab:ClrSubject — the subject is a ClrSubject (CLR 2.0: credentialSubject ClrSubject)"@en ;
    sh:hasValue clr:ClrSubject .

shapes:ClrSubjectShape a sh:NodeShape ;
    sh:targetClass clr:ClrSubject ;
    rdfs:label "CLR subject shape"@en ;
    rdfs:comment "The learner a CLR 2.0 credential is about (CLR 2.0 B.1.2, ClrSubject): identified by its id or by at least one identifier, with the credentials the learner has been awarded."@en ;
    sh:property shapes:ClrSubjectShape-verifiableCredential ;
    sh:or ( [ sh:nodeKind sh:IRI ] [ sh:path clr:identifier-1 ; sh:minCount 1 ] ) ;
    sh:message "CLR subject shape: the subject is identified by its id, or by at least one identifier"@en ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/clr/shapes> .

shapes:ClrSubjectShape-verifiableCredential a sh:PropertyShape ;
    sh:path clr:verifiableCredential ;
    sh:name "verifiableCredential" ;
    sh:description "the credentials the learner has been awarded (verifiableCredential [1..*])"@en ;
    sh:message "CLR subject shape — verifiableCredential: at least 1 value — the credentials the learner has been awarded (verifiableCredential [1..*])"@en ;
    sh:minCount 1 .
