    skos:prefLabel "considered"@en ;
    rdfs:label "considered"@en ;
    skos:notation "considered" ;
    skos:definition "An agent recorded a Counterfactual (or Retracted) context descriptor — a road not taken / a withdrawn claim."@en ;
