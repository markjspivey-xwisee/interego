<https://foxxi-bridge.interego.xwisee.com/ns/foxxi#verbs/asserted> a skos:Concept , xapi:Verb ;
    skos:prefLabel "asserted"@en ;
    rdfs:label "asserted"@en ;
    skos:notation "asserted" ;
    skos:definition "An agent asserted a settled context descriptor (modal status Asserted; groundTruth true). The work was committed."@en ;
    rdfs:comment "An agent asserted a settled context descriptor (modal status Asserted; groundTruth true). The work was committed."@en ;
    skos:inScheme foxxi:VerbScheme ;
