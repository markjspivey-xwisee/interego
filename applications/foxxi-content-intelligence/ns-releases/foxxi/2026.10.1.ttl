    skos:prefLabel "intended"@en ;
    rdfs:label "intended"@en ;
    skos:notation "intended" ;
    skos:definition "An agent recorded a Hypothetical context descriptor — an intention / plan (groundTruth undefined). No completion is claimed."@en ;
    rdfs:comment "An agent recorded a Hypothetical context descriptor — an intention / plan (groundTruth undefined). No completion is claimed."@en ;
    skos:inScheme foxxi:VerbScheme ;
