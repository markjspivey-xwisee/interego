foxxi-adl-tla:PerformanceProficiencyFramework a foxxi-adl-tla:ProficiencyScale , skos:ConceptScheme ;
    rdfs:label "Foxxi Production-Performance Proficiency Framework"@en ;
    skos:prefLabel "Foxxi Production-Performance Proficiency Framework"@en ;
    rdfs:comment "A published proficiency scale for on-the-job production performance, using the Dreyfus five-stage model of skill acquisition. The tla:Level individuals below are the dereferenceable scale an ELR competency assertion is measured against (ler:atProficiency)."@en ;
    dct:source "Dreyfus, S.E. & Dreyfus, H.L. (1980) — A Five-Stage Model of the Mental Activities Involved in Directed Skill Acquisition" ;
    foxxi-ieee-ler:construction "minted" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla> ;
    skos:hasTopConcept foxxi-adl-tla:LevelNovice ,
        foxxi-adl-tla:LevelAdvancedBeginner ,
        foxxi-adl-tla:LevelCompetent ,
        foxxi-adl-tla:LevelProficient ,
        foxxi-adl-tla:LevelExpert .

foxxi-adl-tla:LevelNovice a foxxi-adl-tla:Level , foxxi-ieee-ler:ProficiencyLevel , skos:Concept ;
    rdfs:label "Novice"@en ;
    skos:prefLabel "Novice"@en ;
    rdfs:comment "Rule-bound, relies on instruction. Inferred from training completion only — not yet demonstrated in production."@en ;
    skos:inScheme foxxi-adl-tla:PerformanceProficiencyFramework ;
    skos:topConceptOf foxxi-adl-tla:PerformanceProficiencyFramework ;
    skos:notation "1" ;
    foxxi-ieee-ler:construction "concept" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla> .

foxxi-adl-tla:LevelAdvancedBeginner a foxxi-adl-tla:Level , foxxi-ieee-ler:ProficiencyLevel , skos:Concept ;
    rdfs:label "Advanced Beginner"@en ;
    skos:prefLabel "Advanced Beginner"@en ;
    rdfs:comment "Has demonstrated the competency in production at least once with an asserted successful outcome; limited situational judgment."@en ;
    skos:inScheme foxxi-adl-tla:PerformanceProficiencyFramework ;
    skos:topConceptOf foxxi-adl-tla:PerformanceProficiencyFramework ;
    skos:notation "2" ;
    foxxi-ieee-ler:construction "concept" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla> .

foxxi-adl-tla:LevelCompetent a foxxi-adl-tla:Level , foxxi-ieee-ler:ProficiencyLevel , skos:Concept ;
    rdfs:label "Competent"@en ;
    skos:prefLabel "Competent"@en ;
    rdfs:comment "Consistent successful production performance over a meaningful sample; plans deliberately and handles the typical case."@en ;
    skos:inScheme foxxi-adl-tla:PerformanceProficiencyFramework ;
    skos:topConceptOf foxxi-adl-tla:PerformanceProficiencyFramework ;
    skos:notation "3" ;
    foxxi-ieee-ler:construction "concept" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla> .

foxxi-adl-tla:LevelProficient a foxxi-adl-tla:Level , foxxi-ieee-ler:ProficiencyLevel , skos:Concept ;
    rdfs:label "Proficient"@en ;
    skos:prefLabel "Proficient"@en ;
    rdfs:comment "Reliable, high-quality production performance across many executions; perceives situations holistically."@en ;
    skos:inScheme foxxi-adl-tla:PerformanceProficiencyFramework ;
    skos:topConceptOf foxxi-adl-tla:PerformanceProficiencyFramework ;
    skos:notation "4" ;
    foxxi-ieee-ler:construction "concept" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla> .

foxxi-adl-tla:LevelExpert a foxxi-adl-tla:Level , foxxi-ieee-ler:ProficiencyLevel , skos:Concept ;
    rdfs:label "Expert"@en ;
    skos:prefLabel "Expert"@en ;
    rdfs:comment "Sustained, near-flawless, high-quality production performance at scale; fluid, intuitive mastery."@en ;
    skos:inScheme foxxi-adl-tla:PerformanceProficiencyFramework ;
    skos:topConceptOf foxxi-adl-tla:PerformanceProficiencyFramework ;
    skos:notation "5" ;
    foxxi-ieee-ler:construction "concept" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla> .

foxxi-adl-tla:PerformanceProficiencyRollupRule a foxxi-adl-tla:RollupRule ;
    rdfs:label "Production-performance proficiency roll-up rule"@en ;
    rdfs:comment "Maps a subject's production-performance evidence to a proficiency level in the Foxxi Production-Performance Proficiency Framework, with a confidence. Cited by every performance-basis ler:CompetencyAssertion the ELR emits."@en ;
    foxxi-adl-tla:rollupRule "Given production performance evidence (n executions carrying an asserted outcome, k successes, mean scored quality q in 0..1): reliability is the Wilson score interval lower bound (z=1.96) on k/n, which rises with evidence and FALLS when a failure is added — so it carries both how often the work succeeded and how much of it there is, and no separate execution count is gated on. Expert if reliability>=0.75 and mean quality q is recorded and q>=0.85; Proficient if reliability>=0.6 and mean quality q is recorded and q>=0.7; Competent if reliability>=0.4; Advanced Beginner if k>=1; else Novice. Quality is a FLOOR, not a scale: every value at or above a band's floor ranks alike. A verified credential with no production evidence maps to Competent; training completion only maps to Novice (Hypothetical). The reported confidence IS the reliability above. This rule is DATA: it is parsed at runtime from docs/ns/adl-tla-proficiency.ttl, and this sentence is generated from the same triples the evaluator walks." ;
    foxxi-adl-tla:onScale foxxi-adl-tla:PerformanceProficiencyFramework ;
    foxxi-ieee-ler:construction "minted" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla> ;
    foxxi-adl-tla:hasBand foxxi-adl-tla:BandExpert , foxxi-adl-tla:BandProficient , foxxi-adl-tla:BandCompetent .

foxxi-adl-tla:ProficiencyBand a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Proficiency band"@en ;
    rdfs:comment "One band of the production-performance roll-up rule: the reliability and quality a subject's evidence must reach to be assigned a tla:Level. Bands are evaluated highest rank first and the first satisfied one wins."@en ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla> .

foxxi-adl-tla:hasBand a owl:ObjectProperty ;
    rdfs:label "has band"@en ;
    rdfs:comment "Relates a roll-up rule to one of the bands it evaluates."@en ;
    rdfs:domain foxxi-adl-tla:RollupRule ;
    rdfs:range foxxi-adl-tla:ProficiencyBand ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla> .

foxxi-adl-tla:minReliability a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "minimum reliability"@en ;
    rdfs:comment "The Wilson score interval lower bound (z=1.96) on the success rate that this band requires. Chosen over a raw execution count deliberately: the Wilson bound already rises with sample size and FALLS when a failure is added, so one number carries both 'how often it worked' and 'how much evidence there is'. Gating on a bare count alongside it let a failing record promote a subject."@en ;
    rdfs:domain foxxi-adl-tla:ProficiencyBand ;
    rdfs:range xsd:decimal ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla> .

foxxi-adl-tla:minQuality a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "minimum mean quality"@en ;
    rdfs:comment "Floor on the mean scored outcome quality (0..1). A FLOOR, not a scale — every value at or above it ranks alike."@en ;
    rdfs:domain foxxi-adl-tla:ProficiencyBand ;
    rdfs:range xsd:decimal ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla> .

foxxi-adl-tla:requiresQuality a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "requires recorded quality"@en ;
    rdfs:comment "Whether quality must have been RECORDED at all to win this band. A band whose published level speaks of high-quality performance may not be reached on unscored work."@en ;
    rdfs:domain foxxi-adl-tla:ProficiencyBand ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla> .

foxxi-adl-tla:awardsLevel a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "awards level"@en ;
    rdfs:comment "The tla:Level a subject satisfying this band is assigned."@en ;
    rdfs:domain foxxi-adl-tla:ProficiencyBand ;
    rdfs:range foxxi-adl-tla:Level ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla> .

foxxi-adl-tla:BandExpert a foxxi-adl-tla:ProficiencyBand ;
    rdfs:label "Expert band"@en ;
    foxxi-adl-tla:awardsLevel foxxi-adl-tla:LevelExpert ;
    foxxi-adl-tla:minReliability 0.75 ;
    foxxi-adl-tla:minQuality 0.85 ;
    foxxi-adl-tla:requiresQuality true ;
    skos:notation "5" ;
    rdfs:comment "Reached at 12 consecutive successes (Wilson 0.757) and not before, matching the previous rule's transition exactly."@en ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla> .

foxxi-adl-tla:BandProficient a foxxi-adl-tla:ProficiencyBand ;
    rdfs:label "Proficient band"@en ;
    foxxi-adl-tla:awardsLevel foxxi-adl-tla:LevelProficient ;
    foxxi-adl-tla:minReliability 0.60 ;
    foxxi-adl-tla:minQuality 0.70 ;
    foxxi-adl-tla:requiresQuality true ;
    skos:notation "4" ;
    rdfs:comment "Reached at 6 consecutive successes (Wilson 0.610). Six executions with one failure scores 0.436 and does NOT reach it — the case the previous count-gated rule promoted."@en ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla> .

foxxi-adl-tla:BandCompetent a foxxi-adl-tla:ProficiencyBand ;
    rdfs:label "Competent band"@en ;
    foxxi-adl-tla:awardsLevel foxxi-adl-tla:LevelCompetent ;
    foxxi-adl-tla:minReliability 0.40 ;
    foxxi-adl-tla:requiresQuality false ;
    skos:notation "3" ;
    rdfs:comment "Reached at 3 consecutive successes (Wilson 0.438). Asks nothing of quality, because the level's own definition asks nothing of it."@en ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla> .

[
    a owl:AllDisjointClasses ;
    owl:members (
        foxxi-adl-tla:Competency
        foxxi-adl-tla:CompetencyFramework
        foxxi-adl-tla:ProficiencyScale
        foxxi-adl-tla:Relation
        foxxi-adl-tla:Level
        foxxi-adl-tla:RollupRule
        foxxi-adl-tla:MoveOnRule
        foxxi-adl-tla:Assertion
        foxxi-adl-tla:ProficiencyBand
    )
] .

[
    a owl:AllDisjointClasses ;
    owl:members ( foxxi-adl-tla:NoisyLRS foxxi-adl-tla:TransactionalLRS foxxi-adl-tla:AuthoritativeLRS )
] .

[
    a owl:AllDisjointClasses ;
    owl:members (
        foxxi-adl-tla:LearnerActivityState
        foxxi-adl-tla:LearnerEventState
        foxxi-adl-tla:LearnerCareerState
    )
] .

prov:wasDerivedFrom a owl:ObjectProperty ;
    rdfs:label "was derived from"@en ;
    rdfs:comment "A transformation of an entity into another, an update of an entity resulting in a new one, or the construction of a new entity based on a pre-existing one. (PROV-O)"@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o> ;
    rdfs:domain prov:Entity ;
    rdfs:range prov:Entity .

skos:Concept a owl:Class ;
    rdfs:label "Concept"@en ;
    rdfs:comment "An idea or notion; a unit of thought. (SKOS)"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> .

skos:ConceptScheme a owl:Class ;
    rdfs:label "Concept Scheme"@en ;
    rdfs:comment "A set of concepts, optionally including statements about semantic relationships between those concepts. (SKOS)"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    owl:disjointWith skos:Concept .

amta:Attestation a owl:Class ;
    rdfs:label "AMTA Attestation"@en ;
    rdfs:comment "A multi-dimensional trust attestation by one agent (the attestor) about another agent or claim (the subject). (Interego AMTA)"@en ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/amta> .

iep:constructedFrom a owl:ObjectProperty ;
    rdfs:label "constructed from"@en ;
    rdfs:comment "Declares that the subject class or property is constructed at runtime from the named Interego Protocol primitives. (Interego Protocol)"@en ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep> .

iep:ContextDescriptor a owl:Class ;
    rdfs:label "Context Descriptor"@en ;
    rdfs:comment "A metadata envelope that annotates one or more RDF named graphs with typed context facets: provenance, temporal validity, semiotic frame, trust level and federation metadata. (Interego Protocol)"@en ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep> .

iep:ComposedDescriptor a owl:Class ;
    rdfs:label "Composed Descriptor"@en ;
    rdfs:comment "A context descriptor produced by applying a composition operator (union, intersection, restriction, override) to two or more source descriptors. (Interego Protocol)"@en ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep> .

iep:Affordance a owl:Class ;
    rdfs:label "Affordance"@en ;
    rdfs:comment "A capability that a pod or manifest supports, for HATEOAS-style agent discovery of what operations are available. (Interego Protocol)"@en ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/iep> .

hela:Statement a owl:Class ;
    rdfs:label "HELA Statement"@en ;
    rdfs:comment "An xAPI-style (actor, verb, object) statement — the atomic unit of HELA's presheaf category. (Interego HELA)"@en ;
    rdfs:isDefinedBy <https://markjspivey-xwisee.github.io/interego/ns/hela> .

skos:Collection a owl:Class ;
    rdfs:label "Collection"@en ;
    rdfs:comment "A meaningful collection of concepts. (SKOS)"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> .

skos:member a owl:ObjectProperty ;
    rdfs:label "has member"@en ;
    rdfs:comment "Relates a collection to one of its members. (SKOS)"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:domain skos:Collection .

skos:inScheme a owl:ObjectProperty ;
    rdfs:label "is in scheme"@en ;
    rdfs:comment "Relates a resource (for example a concept) to a concept scheme in which it is included. (SKOS)"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:range skos:ConceptScheme .

skos:topConceptOf a owl:ObjectProperty ;
    rdfs:label "is top concept in scheme"@en ;
    rdfs:comment "Relates a concept to the concept scheme that it is a top level concept of. (SKOS)"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:inScheme ;
    owl:inverseOf skos:hasTopConcept .

skos:hasTopConcept a owl:ObjectProperty ;
    rdfs:label "has top concept"@en ;
    rdfs:comment "Relates, by convention, a concept scheme to a concept which is topmost in the broader/narrower concept hierarchies for that scheme. (SKOS)"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:domain skos:ConceptScheme ;
    rdfs:range skos:Concept .

prov:Entity a owl:Class ;
    rdfs:label "Entity"@en ;
    rdfs:comment "A physical, digital, conceptual, or other kind of thing with some fixed aspects. (PROV-O)"@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o> .

dct:title a owl:AnnotationProperty .

dct:description a owl:AnnotationProperty .

skos:historyNote a owl:AnnotationProperty .

dct:creator a owl:AnnotationProperty .

dct:contributor a owl:AnnotationProperty .

dct:publisher a owl:AnnotationProperty .

dct:license a owl:AnnotationProperty .

dct:rights a owl:AnnotationProperty .

dct:created a owl:AnnotationProperty .

dct:modified a owl:AnnotationProperty .

dct:issued a owl:AnnotationProperty .

dct:language a owl:AnnotationProperty .

bibo:status a owl:AnnotationProperty .

dct:bibliographicCitation a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

dct:source a owl:AnnotationProperty .

foxxi-ieee-ler:construction a owl:AnnotationProperty ;
    rdfs:label "construction"@en ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/ieee-ler> .

skos:closeMatch a owl:AnnotationProperty .

foxxi-ieee-ler:Learner a owl:Class ;
    rdfs:label "Learner"@en ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/ieee-ler> .

skos:prefLabel a owl:AnnotationProperty .

skos:definition a owl:AnnotationProperty .

skos:notation a owl:AnnotationProperty .

skos:editorialNote a owl:AnnotationProperty .

skos:exactMatch a owl:AnnotationProperty .

foxxi-ieee-ler:ProficiencyLevel a owl:Class ;
    rdfs:label "Proficiency Level"@en ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/ieee-ler> .
