@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix iep: <https://markjspivey-xwisee.github.io/interego/ns/iep#> .
@prefix amta: <https://markjspivey-xwisee.github.io/interego/ns/amta#> .
@prefix hela: <https://markjspivey-xwisee.github.io/interego/ns/hela#> .
@prefix foxxi-ieee-ler: <https://foxxi-bridge.interego.xwisee.com/ns/ieee-ler#> .
@prefix foxxi-adl-tla: <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla#> .

<https://foxxi-bridge.interego.xwisee.com/ns/adl-tla> a owl:Ontology ;
    dct:title "ADL Total Learning Architecture (TLA) — Foxxi composable ontology"@en ;
    dct:description "An OWL 2 DL vocabulary for the ADL Total Learning Architecture: the four data pillars (competency, learning-activity metadata, learning performance, learner profile), the Master Object Model (MOM) xAPI vocabulary, the CaSS competency model, the federated LRS tiers and the learner-state machines — modelled as compositions over the Interego substrate. The three LRS tiers and the learner-state machines are views over the statement stream, not stores. Also publishes the Foxxi production-performance proficiency framework (Dreyfus) and the roll-up rule, whose bands are data the evaluator reads."@en ;
    rdfs:comment "Independent formalization by Mark Spivey (Foxxi Mediums Inc.). Not affiliated with or endorsed by ADL, IEEE or the CaSS project. Where this document and the published standard differ, the standard governs."@en ,
        "Cross-standard alignments to the IEEE LER ontology, CaSS and the ADL xAPI verb registry are SKOS mapping relations, never owl:equivalentClass. They are also published as an SSSOM mapping set at https://foxxi-bridge.interego.xwisee.com/ns/adl-tla/mappings."@en ,
        "The proficiency roll-up rule is DATA: its bands (foxxi-adl-tla:ProficiencyBand) are published here and parsed at runtime from the same triples by the evaluator; the human-readable rule text is generated from them."@en ;
    owl:versionIRI <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla/2026.10.0> ;
    owl:versionInfo "2026.10.0" ;
    skos:historyNote "Versioned by calendar (YYYY.MM.PATCH) from 2026.10.0: the version numbers this document, not the standard it formalizes. Every released version stays resolvable at its version IRI, and the content there never changes. Earlier publications carried no version IRI, and their owl:versionInfo restated the version of the standard."@en ;
    dct:creator "Mark Spivey" ;
    dct:contributor "Claude (Anthropic)" ;
    dct:publisher "Foxxi Mediums Inc." ;
    dct:license <https://opensource.org/licenses/MIT> ;
    dct:rights "© 2026 Mark Spivey (Foxxi Mediums Inc.). Released under the MIT License."@en ;
    dct:created "2026-05-20"^^xsd:date ;
    dct:modified "2026-10-12"^^xsd:date ;
    dct:issued "2026-10-12"^^xsd:date ;
    dct:language <http://id.loc.gov/vocabulary/iso639-1/en> ;
    bibo:status <http://purl.org/ontology/bibo/status/published> ;
    dct:bibliographicCitation "Spivey, M. (2026). ADL Total Learning Architecture (TLA) — Foxxi composable ontology (Version 2026.10.0) [Ontology]. Foxxi Mediums Inc. https://foxxi-bridge.interego.xwisee.com/ns/adl-tla/2026.10.0" ;
    vann:preferredNamespacePrefix "foxxi-adl-tla" ;
    vann:preferredNamespaceUri "https://foxxi-bridge.interego.xwisee.com/ns/adl-tla#" ;
    dct:source <https://adlnet.gov/projects/tla/> ,
        <https://standards.ieee.org/ieee/2881/11719/> ,
        <https://schema.cassproject.org/0.4/> ;
    prov:wasDerivedFrom <https://github.com/markjspivey-xwisee/interego/blob/master/applications/foxxi-content-intelligence/src/ler-tla-vocab.ts> ,
        <https://github.com/markjspivey-xwisee/interego/blob/master/docs/ns/adl-tla-proficiency.ttl> ;
    rdfs:seeAlso <https://foxxi-bridge.interego.xwisee.com/ns/ieee-ler> ,
        <https://foxxi-bridge.interego.xwisee.com/ns/ieee-ler/shapes> ,
        <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla/mappings> ,
        iep: .

foxxi-adl-tla:Competency a owl:Class ;
    rdfs:label "Competency"@en ;
    rdfs:comment "A skill, knowledge, ability, trait, or combination required to perform a task or job — the common currency that gives the four TLA data pillars a shared semantics."@en ;
    dct:source "ADL TLA Competency pillar; CaSS schema 0.4 (Competency)" ;
    foxxi-ieee-ler:construction "minted" ;
    rdfs:subClassOf skos:Concept ;
    skos:closeMatch foxxi-ieee-ler:CompetencyDefinition , <https://schema.cassproject.org/0.4/Competency> ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla> .

foxxi-adl-tla:CompetencyFramework a owl:Class ;
    rdfs:label "Competency Framework"@en ;
    rdfs:comment "A structured, directed graph of competencies with typed relations, levels and roll-up rules."@en ;
    dct:source "ADL TLA Competency pillar; CaSS schema 0.4 (Framework)" ;
    foxxi-ieee-ler:construction "minted" ;
    rdfs:subClassOf skos:ConceptScheme ;
    skos:closeMatch foxxi-ieee-ler:CompetencyFramework , <https://schema.cassproject.org/0.4/Framework> ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla> .

foxxi-adl-tla:Relation a owl:Class ;
    rdfs:label "Competency Relation"@en ;
    rdfs:comment "A typed edge between two competencies — narrows, broadens, requires, is-related-to, is-equivalent-to — with an optional validity window."@en ;
    dct:source "CaSS schema 0.4 (Relation)" ;
    foxxi-ieee-ler:construction "minted" ;
    skos:closeMatch foxxi-ieee-ler:CompetencyRelationship , <https://schema.cassproject.org/0.4/Relation> ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla> .

foxxi-adl-tla:Level a owl:Class ;
    rdfs:label "Competency Level"@en ;
    rdfs:comment "A named proficiency level or assessment criterion attached to a competency."@en ;
    dct:source "CaSS schema 0.4 (Level)" ;
    foxxi-ieee-ler:construction "minted" ;
    skos:closeMatch foxxi-ieee-ler:ProficiencyLevel , <https://schema.cassproject.org/0.4/Level> ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla> .

foxxi-adl-tla:ProficiencyScale a owl:Class ;
    rdfs:label "Proficiency Scale"@en ;
    rdfs:comment "A published, ordered scale of proficiency levels that competency assertions are measured against — a scheme of levels, not of competencies."@en ;
    dct:source "CaSS schema 0.4 (Level); IEEE 1484.20.3-2022 (proficiency scale)" ;
    foxxi-ieee-ler:construction "minted" ;
    rdfs:subClassOf skos:ConceptScheme ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla> .

foxxi-adl-tla:RollupRule a owl:Class ;
    rdfs:label "Roll-up Rule"@en ;
    rdfs:comment "A rule for deriving a competency's attainment state from the states of its sub-competencies — the competency-graph analogue of cmi5 move-on logic."@en ;
    dct:source "CaSS schema 0.4 (RollupRule)" ;
    foxxi-ieee-ler:construction "minted" ;
    skos:closeMatch <https://schema.cassproject.org/0.4/RollupRule> ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla> .

foxxi-adl-tla:MoveOnRule a owl:Class ;
    rdfs:label "Move-On Rule"@en ;
    rdfs:comment "The criterion (Passed, Completed, CompletedAndPassed, CompletedOrPassed, NotApplicable) that decides whether a learner has satisfied an activity well enough to advance. TLA generalises cmi5 move-on into its Control Loop 2."@en ;
    dct:source "cmi5 (Quartz) §13.1.4 (AU moveOn); ADL TLA control loops" ;
    foxxi-ieee-ler:construction "minted" ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla> .

foxxi-adl-tla:Assertion a owl:Class ;
    rdfs:label "Competency Assertion"@en ;
    rdfs:comment "A CaSS assertion: a declaration by one party that a subject can perform a competency at a level, with a confidence, over a timespan, backed by evidence. The same attestation primitive as an IEEE record entry — confidence and evidence are facets, not new shapes."@en ;
    dct:source "CaSS schema 0.4 (Assertion); MOM `asserted` verb" ;
    foxxi-ieee-ler:construction "composed" ;
    rdfs:subClassOf amta:Attestation ;
    skos:closeMatch foxxi-ieee-ler:CompetencyAssertion , <https://schema.cassproject.org/0.4/Assertion> ;
    iep:constructedFrom amta:Attestation , amta:CompetenceRating , iep:modalStatus ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla> .

foxxi-adl-tla:LearningActivityMetadata a owl:Class ;
    rdfs:label "Learning Activity Metadata"@en ;
    rdfs:comment "A typed metadata descriptor of a learning resource — course, section, activity or content object. The substrate's resource-descriptor primitive specialised for learning resources."@en ;
    dct:source "IEEE 2881-2025 (Standard for Learning Metadata Terms), the outcome of the P2881 learning-activity-metadata project, which builds on IEEE 1484.12.1 (LOM)" ;
    foxxi-ieee-ler:construction "composed" ;
    rdfs:subClassOf iep:ContextDescriptor ;
    iep:constructedFrom iep:ContextDescriptor , iep:SemioticFacet ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla> .

foxxi-adl-tla:ExperienceIndex a owl:Class ;
    rdfs:label "Experience Index"@en ;
    rdfs:comment "The server-side index of learning-activity metadata, federating local catalogs. Not a store of new vocabulary — a query view over Learning Activity Metadata descriptors."@en ;
    dct:source "ADL TLA Experience Index (XI)" ;
    foxxi-ieee-ler:construction "view" ;
    iep:constructedFrom foxxi-adl-tla:LearningActivityMetadata , iep:CompositionOperator ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla> .

foxxi-adl-tla:EnterpriseCourseCatalog a owl:Class ;
    rdfs:label "Enterprise Course Catalog"@en ;
    rdfs:comment "A network of federated course catalogs — an aggregation of learning-activity metadata descriptors across providers."@en ;
    dct:source "ADL TLA Enterprise Course Catalog (ECC)" ;
    foxxi-ieee-ler:construction "composed" ;
    rdfs:subClassOf iep:ComposedDescriptor ;
    iep:constructedFrom foxxi-adl-tla:LearningActivityMetadata , iep:FederationFacet ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla> .

foxxi-adl-tla:MasterObjectModel a owl:Class ;
    rdfs:label "Master Object Model"@en ;
    rdfs:comment "TLA's xAPI profile (https://w3id.org/xapi/tla): the MOM verb set (organised in this vocabulary into five thematic levels — our own pedagogical grouping, not ADL-numbered conformance tiers), 11 activity types, three learner-state machines, and a set of context extensions. Every MOM record is an xAPI Statement."@en ;
    dct:source "ADL Master Object Model (MOM) specification" ;
    foxxi-ieee-ler:construction "composed" ;
    rdfs:subClassOf iep:ContextDescriptor ;
    iep:constructedFrom hela:Statement , hela:Verb ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla> .

foxxi-adl-tla:LearnerProfile a owl:Class ;
    rdfs:label "Learner Profile"@en ;
    rdfs:comment "Each learner's aggregate competency level, credentials, aptitudes, preferences, goals and career trajectory. The TLA pillar from which the IEEE P2997 Enterprise Learner Record work grew, and the counterpart of that record."@en ;
    dct:source "ADL TLA Learner Profile pillar; ADL ELRR" ;
    foxxi-ieee-ler:construction "composed" ;
    rdfs:subClassOf iep:ComposedDescriptor ;
    skos:closeMatch foxxi-ieee-ler:EnterpriseLearnerRecord , foxxi-ieee-ler:LearnerProfile ;
    iep:constructedFrom hela:Statement , iep:AgentFacet ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla> .

foxxi-adl-tla:FederatedLRSTier a owl:Class ;
    rdfs:label "Federated LRS Tier"@en ;
    rdfs:comment "One tier of the TLA federated LRS layer: a partition of the xAPI statement stream selected by verb set, trust tier and signature. A view over the statements, not a separate store."@en ;
    dct:source "ADL TLA federated LRS layer" ;
    foxxi-ieee-ler:construction "view" ;
    iep:constructedFrom hela:Statement , iep:CompositionOperator ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla> .

foxxi-adl-tla:NoisyLRS a owl:Class ;
    rdfs:label "Noisy LRS"@en ;
    rdfs:comment "The tier holding every raw xAPI statement, with data ownership retained by the activity owner. A view over the statement set — the unfiltered partition."@en ;
    dct:source "ADL TLA federated LRS layer" ;
    foxxi-ieee-ler:construction "view" ;
    rdfs:subClassOf foxxi-adl-tla:FederatedLRSTier ;
    iep:constructedFrom hela:Statement , hela:Trace ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla> .

foxxi-adl-tla:TransactionalLRS a owl:Class ;
    rdfs:label "Transactional LRS"@en ;
    rdfs:comment "The tier holding only the normalised MOM roll-up verbs — the evidence base for competency inference. A restriction view over the statement set, partitioned by verb set."@en ;
    dct:source "ADL TLA federated LRS layer" ;
    foxxi-ieee-ler:construction "view" ;
    rdfs:subClassOf foxxi-adl-tla:FederatedLRSTier ;
    iep:constructedFrom hela:Statement , hela:Verb , iep:CompositionOperator ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla> .

foxxi-adl-tla:AuthoritativeLRS a owl:Class ;
    rdfs:label "Authoritative LRS"@en ;
    rdfs:comment "The tier holding only digitally-signed competency-assertion and career verbs, access-restricted. A restriction view partitioned by verb set, trust tier and signature."@en ;
    dct:source "ADL TLA federated LRS layer" ;
    foxxi-ieee-ler:construction "view" ;
    rdfs:subClassOf foxxi-adl-tla:FederatedLRSTier ;
    iep:constructedFrom hela:Statement , iep:TrustFacet , iep:CompositionOperator ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla> .

foxxi-adl-tla:LearnerState a owl:Class ;
    rdfs:label "Learner State"@en ;
    rdfs:comment "A learner's current state — the materialised projection of the latest MOM statement per state dimension. A function of the event log, not stored vocabulary."@en ;
    dct:source "ADL MOM learner-state machines" ;
    foxxi-ieee-ler:construction "view" ;
    iep:constructedFrom hela:Statement , iep:TemporalFacet , iep:supersedes ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla> .

foxxi-adl-tla:LearnerActivityState a owl:Class ;
    rdfs:label "Learner Activity State"@en ;
    rdfs:comment "The cmi5-aligned tactical state machine: launched → initialized → attended → suspended/resumed → completed/abandoned/terminated."@en ;
    dct:source "ADL MOM learner-state machines" ;
    foxxi-ieee-ler:construction "view" ;
    rdfs:subClassOf foxxi-adl-tla:LearnerState ;
    iep:constructedFrom hela:Statement , iep:TemporalFacet ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla> .

foxxi-adl-tla:LearnerEventState a owl:Class ;
    rdfs:label "Learner Event State"@en ;
    rdfs:comment "The pre-activity / post-evidence state machine: requested → approved → scheduled → recommended, and validated / qualified / conferred / inferred."@en ;
    dct:source "ADL MOM learner-state machines" ;
    foxxi-ieee-ler:construction "view" ;
    rdfs:subClassOf foxxi-adl-tla:LearnerState ;
    iep:constructedFrom hela:Statement , iep:TemporalFacet ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla> .

foxxi-adl-tla:LearnerCareerState a owl:Class ;
    rdfs:label "Learner Career State"@en ;
    rdfs:comment "The slow, strategic human-capital state machine: recruited → appraised → screened/selected → promoted → detailed → transitioned → released."@en ;
    dct:source "ADL MOM learner-state machines" ;
    foxxi-ieee-ler:construction "view" ;
    rdfs:subClassOf foxxi-adl-tla:LearnerState ;
    iep:constructedFrom hela:Statement , iep:TemporalFacet ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla> .

foxxi-adl-tla:CompetencyManagementService a owl:Class ;
    rdfs:label "Competency Management Service"@en ;
    rdfs:comment "The service (CaSS, in the reference implementation) that reads MOM statements from the Transactional LRS, joins actor to learner and object to activity-metadata-to-competency, estimates proficiency and emits signed assertions."@en ;
    dct:source "ADL TLA competency management (CaSS)" ;
    foxxi-ieee-ler:construction "role" ;
    rdfs:subClassOf iep:Affordance ;
    iep:constructedFrom iep:Affordance ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla> .

foxxi-adl-tla:LearningEventManager a owl:Class ;
    rdfs:label "Learning Event Manager"@en ;
    rdfs:comment "The service that manages xAPI statement generation per profile, bridging learning activities into the LRS layer."@en ;
    dct:source "ADL TLA Learning Event Manager (LEM)" ;
    foxxi-ieee-ler:construction "role" ;
    rdfs:subClassOf iep:Affordance ;
    iep:constructedFrom iep:Affordance ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla> .

foxxi-adl-tla:aboutCompetency a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "about competency"@en ;
    rdfs:comment "Relates a CaSS assertion to the one competency it asserts."@en ;
    dct:source "CaSS schema 0.4 (Assertion)" ;
    foxxi-ieee-ler:construction "minted" ;
    rdfs:domain foxxi-adl-tla:Assertion ;
    rdfs:range foxxi-adl-tla:Competency ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla> .

foxxi-adl-tla:confidence a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "confidence"@en ;
    rdfs:comment "The asserting party's confidence in a competency assertion, a decimal."@en ;
    dct:source "CaSS schema 0.4 (Assertion); MOM confidence context extension" ;
    foxxi-ieee-ler:construction "minted" ;
    rdfs:domain foxxi-adl-tla:Assertion ;
    rdfs:range xsd:decimal ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla> .

foxxi-adl-tla:decayFunction a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "decay function"@en ;
    rdfs:comment "An expression describing how the confidence of a competency assertion decays over time."@en ;
    dct:source "CaSS schema 0.4 (Assertion)" ;
    foxxi-ieee-ler:construction "minted" ;
    rdfs:domain foxxi-adl-tla:Assertion ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla> .

foxxi-adl-tla:relationType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "relation type"@en ;
    rdfs:comment "The type of a competency relation, as a token — for example narrows, broadens, requires, isEnabledBy, isRelatedTo, isEquivalentTo."@en ;
    dct:source "CaSS schema 0.4 (Relation)" ;
    foxxi-ieee-ler:construction "minted" ;
    rdfs:domain foxxi-adl-tla:Relation ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla> .

foxxi-adl-tla:rollupRule a owl:DatatypeProperty ;
    rdfs:label "roll-up rule expression"@en ;
    rdfs:comment "The rule expression a roll-up rule evaluates against sub-competency states."@en ;
    dct:source "CaSS schema 0.4 (RollupRule)" ;
    foxxi-ieee-ler:construction "minted" ;
    rdfs:domain foxxi-adl-tla:RollupRule ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla> .

foxxi-adl-tla:onScale a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "on scale"@en ;
    rdfs:comment "Relates a roll-up rule to the proficiency scale whose levels it assigns."@en ;
    dct:source "CaSS schema 0.4 (RollupRule, Level)" ;
    foxxi-ieee-ler:construction "minted" ;
    rdfs:domain foxxi-adl-tla:RollupRule ;
    rdfs:range foxxi-adl-tla:ProficiencyScale ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla> .

foxxi-adl-tla:moveOnCriterion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "move-on criterion"@en ;
    rdfs:comment "The criterion a move-on rule applies — one of the five values cmi5 defines for an assignable unit's moveOn."@en ;
    dct:source "cmi5 (Quartz) §13.1.4 (AU moveOn)" ;
    foxxi-ieee-ler:construction "minted" ;
    rdfs:domain foxxi-adl-tla:MoveOnRule ;
    rdfs:range [
        a rdfs:Datatype ;
        owl:oneOf ( "Passed" "Completed" "CompletedAndPassed" "CompletedOrPassed" "NotApplicable" )
    ] ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla> .

foxxi-adl-tla:governsActivity a owl:ObjectProperty ;
    rdfs:label "governs activity"@en ;
    rdfs:comment "Relates a move-on rule to the learning activity (identified by its metadata descriptor) whose satisfaction it decides."@en ;
    dct:source "cmi5 (Quartz) §13.1.4 (AU moveOn); ADL TLA control loops" ;
    foxxi-ieee-ler:construction "minted" ;
    rdfs:domain foxxi-adl-tla:MoveOnRule ;
    rdfs:range foxxi-adl-tla:LearningActivityMetadata ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla> .

foxxi-adl-tla:indexes a owl:ObjectProperty ;
    rdfs:label "indexes"@en ;
    rdfs:comment "Relates an experience index or an enterprise course catalog to a learning-activity metadata descriptor it federates."@en ;
    dct:source "ADL TLA Experience Index (XI); ADL TLA Enterprise Course Catalog (ECC)" ;
    foxxi-ieee-ler:construction "minted" ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf ( foxxi-adl-tla:ExperienceIndex foxxi-adl-tla:EnterpriseCourseCatalog )
    ] ;
    rdfs:range foxxi-adl-tla:LearningActivityMetadata ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/adl-tla> .

foxxi-adl-tla:admitsVerb a owl:ObjectProperty ;
    rdfs:label "admits verb"@en ;
    rdfs:comment "Relates a federated LRS tier to a MOM verb whose statements the tier admits — the verb set that defines the partition."@en ;
    dct:source "ADL TLA federated LRS layer" ;
    foxxi-ieee-ler:construction "minted" ;
    rdfs:domain foxxi-adl-tla:FederatedLRSTier ;
