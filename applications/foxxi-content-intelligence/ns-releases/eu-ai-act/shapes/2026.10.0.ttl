shapes:ObligationConformanceShape a sh:NodeShape ;
    sh:targetClass foxxi-eu-ai-act:Obligation ,
        foxxi-eu-ai-act:RecordKeeping ,
        foxxi-eu-ai-act:HumanOversight ,
        foxxi-eu-ai-act:Transparency ,
        foxxi-eu-ai-act:RiskManagement ,
        foxxi-eu-ai-act:DataGovernance ,
        foxxi-eu-ai-act:InteractionTransparency ,
        foxxi-eu-ai-act:TechnicalDocumentation ,
        foxxi-eu-ai-act:AccuracyRobustness ;
    sh:targetSubjectsOf foxxi-eu-ai-act:article ;
    rdfs:label "AI Act obligation conformance"@en ;
    rdfs:comment "An obligation names the Article that imposes it, one of those this document defines. Every Article concept of this document does; so does any obligation a record names by RDFS inference from conformsToArticle's range, when it is one of them."@en ;
    sh:property shapes:ObligationConformanceShape-article ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/eu-ai-act/shapes> .

shapes:ObligationConformanceShape-article a sh:PropertyShape ;
    sh:path foxxi-eu-ai-act:article ;
    sh:name "article" ;
    sh:description "the Article number"@en ;
    sh:message "AI Act obligation conformance — article: exactly 1 value, of type xsd:string, one of \"9\", \"10\", \"11\", \"12\", \"13\", \"14\", \"15\", \"50\" — the Article number"@en ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in ( "9" "10" "11" "12" "13" "14" "15" "50" ) .

shapes:ConformanceClaimShape a sh:NodeShape ;
    sh:targetSubjectsOf foxxi-eu-ai-act:conformsToArticle ;
    rdfs:label "AI Act conformance claim"@en ;
    rdfs:comment "A record offered as evidence of meeting an obligation names one this document defines: one of its Article concepts, by its token (\"Article12\") or its IRI."@en ;
    sh:property shapes:ConformanceClaimShape-conformsToArticle ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/eu-ai-act/shapes> .

shapes:ConformanceClaimShape-conformsToArticle a sh:PropertyShape ;
    sh:path foxxi-eu-ai-act:conformsToArticle ;
    sh:name "conformsToArticle" ;
    sh:description "an obligation of this document's Article list"@en ;
    sh:message "AI Act conformance claim — conformsToArticle: one of the concepts of EU AI Act Articles (Article9, Article10, Article11, Article12, Article13, Article14, Article15, Article50) — an obligation of this document's Article list"@en ;
    sh:in (
        foxxi-eu-ai-act:Article-Article9
        foxxi-eu-ai-act:Article-Article10
        foxxi-eu-ai-act:Article-Article11
        foxxi-eu-ai-act:Article-Article12
        foxxi-eu-ai-act:Article-Article13
        foxxi-eu-ai-act:Article-Article14
        foxxi-eu-ai-act:Article-Article15
        foxxi-eu-ai-act:Article-Article50
    ) .

shapes:RecordKeepingCodeShape a sh:NodeShape ;
    sh:targetClass foxxi-eu-ai-act:RecordKeeping ;
    rdfs:label "Record-Keeping (Art.12): its article"@en ;
    rdfs:comment "An instance of RecordKeeping is one of the concepts of EU AI Act Articles typed with it, so its article is theirs: 12."@en ;
    sh:not [
        sh:or (
            [ sh:class foxxi-eu-ai-act:HumanOversight ]
            [ sh:class foxxi-eu-ai-act:Transparency ]
            [ sh:class foxxi-eu-ai-act:RiskManagement ]
            [ sh:class foxxi-eu-ai-act:DataGovernance ]
            [ sh:class foxxi-eu-ai-act:TechnicalDocumentation ]
            [ sh:class foxxi-eu-ai-act:AccuracyRobustness ]
            [ sh:class foxxi-eu-ai-act:InteractionTransparency ]
        )
    ] ;
    sh:message "Record-Keeping (Art.12): its article: a RecordKeeping is not also of a kind this document declares disjoint with it"@en ;
    sh:property shapes:RecordKeepingCodeShape-article ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/eu-ai-act/shapes> .

shapes:RecordKeepingCodeShape-article a sh:PropertyShape ;
    sh:path foxxi-eu-ai-act:article ;
    sh:name "article" ;
    sh:description "the article of a RecordKeeping"@en ;
    sh:message "Record-Keeping (Art.12): its article — article: one of \"12\" — the article of a RecordKeeping"@en ;
    sh:in ( "12" ) .

