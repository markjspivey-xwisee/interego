    dct:modified "2026-10-12"^^xsd:date ;
    dct:issued "2026-10-12"^^xsd:date ;
    dct:language <http://id.loc.gov/vocabulary/iso639-1/en> ;
    bibo:status <http://purl.org/ontology/bibo/status/published> ;
    dct:bibliographicCitation "Spivey, M. (2026). EU AI Act (Regulation (EU) 2024/1689) — obligation mapping (Version 2026.10.0) [Ontology]. Foxxi Mediums Inc. https://foxxi-bridge.interego.xwisee.com/ns/eu-ai-act/2026.10.0" ;
    vann:preferredNamespacePrefix "foxxi-eu-ai-act" ;
