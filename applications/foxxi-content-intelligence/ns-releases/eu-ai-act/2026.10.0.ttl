foxxi-eu-ai-act:Obligation a owl:Class ;
    rdfs:label "AI Act Obligation"@en ;
    rdfs:comment "A provider or deployer obligation under the EU AI Act for high-risk AI systems. An action descriptor declaring conformsToArticle asserts it satisfies the named obligation."@en ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/eu-ai-act> .

foxxi-eu-ai-act:RecordKeeping a owl:Class ;
    rdfs:label "Record-Keeping (Art.12)"@en ;
    rdfs:comment "Art.12: high-risk AI systems shall technically allow for the automatic recording of events (logs) over their lifetime, ensuring traceability of functioning."@en ;
    rdfs:subClassOf foxxi-eu-ai-act:Obligation ;
    skos:relatedMatch eu-ai-act:LoggedAction ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/eu-ai-act> .

foxxi-eu-ai-act:HumanOversight a owl:Class ;
    rdfs:label "Human Oversight (Art.14)"@en ;
    rdfs:comment "Art.14: high-risk AI systems shall be designed so they can be effectively overseen by natural persons, including the ability to intervene or interrupt."@en ;
    rdfs:subClassOf foxxi-eu-ai-act:Obligation ;
    skos:relatedMatch eu-ai-act:HumanOversightCheckpoint ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/eu-ai-act> .

foxxi-eu-ai-act:Transparency a owl:Class ;
    rdfs:label "Transparency to Deployers (Art.13)"@en ;
    rdfs:comment "Art.13: high-risk AI systems shall be sufficiently transparent to enable deployers to interpret output and use it appropriately, accompanied by instructions for use."@en ;
    rdfs:subClassOf foxxi-eu-ai-act:Obligation ;
    skos:relatedMatch eu-ai-act:TransparencyDisclosure ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/eu-ai-act> .

foxxi-eu-ai-act:RiskManagement a owl:Class ;
    rdfs:label "Risk Management (Art.9)"@en ;
    rdfs:comment "Art.9: a risk-management system shall be established, implemented, documented and maintained across the lifecycle of the high-risk AI system."@en ;
    rdfs:subClassOf foxxi-eu-ai-act:Obligation ;
    skos:relatedMatch eu-ai-act:RiskManagementRecord ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/eu-ai-act> .

foxxi-eu-ai-act:DataGovernance a owl:Class ;
    rdfs:label "Data & Data Governance (Art.10)"@en ;
    rdfs:comment "Art.10: training, validation and testing data sets shall be subject to appropriate data-governance and management practices."@en ;
    rdfs:subClassOf foxxi-eu-ai-act:Obligation ;
    skos:relatedMatch eu-ai-act:DataGovernanceAttestation ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/eu-ai-act> .

foxxi-eu-ai-act:InteractionTransparency a owl:Class ;
    rdfs:label "Transparency to Persons (Art.50)"@en ;
    rdfs:comment "Art.50: providers shall ensure that AI systems intended to interact directly with natural persons are designed so that those persons are informed that they are interacting with an AI system, unless that is obvious; and providers and deployers shall mark or disclose AI-generated or manipulated content as the Article sets out. Applies to such systems whether or not they are high-risk."@en ;
    rdfs:subClassOf foxxi-eu-ai-act:Obligation ;
    skos:relatedMatch eu-ai-act:Article50Disclosure ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/eu-ai-act> .

foxxi-eu-ai-act:AccuracyRobustness a owl:Class ;
    rdfs:label "Accuracy, Robustness, Cybersecurity (Art.15)"@en ;
    rdfs:comment "Art.15: high-risk AI systems shall achieve appropriate levels of accuracy, robustness and cybersecurity, consistent throughout their lifecycle."@en ;
    rdfs:subClassOf foxxi-eu-ai-act:Obligation ;
    skos:relatedMatch eu-ai-act:AccuracyAttestation ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/eu-ai-act> .

foxxi-eu-ai-act:conformsToArticle a owl:ObjectProperty ;
    rdfs:label "conforms to article"@en ;
    skos:notation "conformsToArticle" ;
    rdfs:comment "Asserts that the subject action / system satisfies the named EU AI Act Obligation, with the cited evidence."@en ;
    rdfs:range foxxi-eu-ai-act:Obligation ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/eu-ai-act> .

foxxi-eu-ai-act:article a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "article"@en ;
    rdfs:comment "The Article number of the obligation (e.g. \"12\")."@en ;
    rdfs:domain foxxi-eu-ai-act:Obligation ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/eu-ai-act> .

foxxi-eu-ai-act:Article a skos:ConceptScheme ;
    rdfs:label "EU AI Act Articles"@en ;
    skos:prefLabel "EU AI Act Articles"@en ;
    rdfs:comment "The Articles this mapping covers — Articles 9 to 15 for high-risk AI systems, and Article 50 for systems that interact with people; each is realized as an Obligation subclass above."@en ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/eu-ai-act> ;
    skos:hasTopConcept foxxi-eu-ai-act:Article-Article9 ,
        foxxi-eu-ai-act:Article-Article10 ,
        foxxi-eu-ai-act:Article-Article12 ,
        foxxi-eu-ai-act:Article-Article13 ,
        foxxi-eu-ai-act:Article-Article14 ,
        foxxi-eu-ai-act:Article-Article15 ,
        foxxi-eu-ai-act:Article-Article50 .

foxxi-eu-ai-act:Article-Article9 a skos:Concept ;
    skos:inScheme foxxi-eu-ai-act:Article ;
    skos:topConceptOf foxxi-eu-ai-act:Article ;
    skos:prefLabel "Article 9 — Risk management system"@en ;
    rdfs:label "Article 9 — Risk management system (EU AI Act Articles)"@en ;
    skos:notation "Article9" ;
    skos:definition "Establish/maintain a risk-management system across the lifecycle."@en ;
    skos:exactMatch eu-ai-act:Article9 ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/eu-ai-act> .

foxxi-eu-ai-act:Article-Article10 a skos:Concept ;
    skos:inScheme foxxi-eu-ai-act:Article ;
    skos:topConceptOf foxxi-eu-ai-act:Article ;
    skos:prefLabel "Article 10 — Data and data governance"@en ;
    rdfs:label "Article 10 — Data and data governance (EU AI Act Articles)"@en ;
    skos:notation "Article10" ;
    skos:definition "Data-governance practices for training/validation/testing data."@en ;
    skos:exactMatch eu-ai-act:Article10 ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/eu-ai-act> .

foxxi-eu-ai-act:Article-Article12 a skos:Concept ;
    skos:inScheme foxxi-eu-ai-act:Article ;
    skos:topConceptOf foxxi-eu-ai-act:Article ;
    skos:prefLabel "Article 12 — Record-keeping"@en ;
    rdfs:label "Article 12 — Record-keeping (EU AI Act Articles)"@en ;
    skos:notation "Article12" ;
    skos:definition "Automatic, lifetime logging ensuring traceability of functioning."@en ;
    skos:exactMatch eu-ai-act:Article12 ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/eu-ai-act> .

foxxi-eu-ai-act:Article-Article13 a skos:Concept ;
    skos:inScheme foxxi-eu-ai-act:Article ;
    skos:topConceptOf foxxi-eu-ai-act:Article ;
    skos:prefLabel "Article 13 — Transparency and provision of information to deployers"@en ;
    rdfs:label "Article 13 — Transparency and provision of information to deployers (EU AI Act Articles)"@en ;
    skos:notation "Article13" ;
    skos:definition "Transparent operation + instructions for use."@en ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/eu-ai-act> .

foxxi-eu-ai-act:Article-Article14 a skos:Concept ;
    skos:inScheme foxxi-eu-ai-act:Article ;
    skos:topConceptOf foxxi-eu-ai-act:Article ;
    skos:prefLabel "Article 14 — Human oversight"@en ;
    rdfs:label "Article 14 — Human oversight (EU AI Act Articles)"@en ;
    skos:notation "Article14" ;
    skos:definition "Effective human oversight, intervention and interruption."@en ;
    skos:exactMatch eu-ai-act:Article14 ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/eu-ai-act> .

foxxi-eu-ai-act:Article-Article15 a skos:Concept ;
    skos:inScheme foxxi-eu-ai-act:Article ;
    skos:topConceptOf foxxi-eu-ai-act:Article ;
    skos:prefLabel "Article 15 — Accuracy, robustness and cybersecurity"@en ;
    rdfs:label "Article 15 — Accuracy, robustness and cybersecurity (EU AI Act Articles)"@en ;
    skos:notation "Article15" ;
    skos:definition "Appropriate accuracy, robustness and cybersecurity over the lifecycle."@en ;
    skos:exactMatch eu-ai-act:Article15 ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/eu-ai-act> .

foxxi-eu-ai-act:Article-Article50 a skos:Concept ;
    skos:inScheme foxxi-eu-ai-act:Article ;
    skos:topConceptOf foxxi-eu-ai-act:Article ;
    skos:prefLabel "Article 50 — Transparency obligations for providers and deployers of certain AI systems"@en ;
    rdfs:label "Article 50 — Transparency obligations for providers and deployers of certain AI systems (EU AI Act Articles)"@en ;
    skos:notation "Article50" ;
    skos:definition "Informing people that they are interacting with an AI system, and marking or disclosing AI-generated or manipulated content."@en ;
    rdfs:isDefinedBy <https://foxxi-bridge.interego.xwisee.com/ns/eu-ai-act> .

[
    a owl:AllDisjointClasses ;
    owl:members (
        foxxi-eu-ai-act:RecordKeeping
        foxxi-eu-ai-act:HumanOversight
        foxxi-eu-ai-act:Transparency
        foxxi-eu-ai-act:RiskManagement
        foxxi-eu-ai-act:DataGovernance
        foxxi-eu-ai-act:AccuracyRobustness
        foxxi-eu-ai-act:InteractionTransparency
    )
] .

prov:wasDerivedFrom a owl:ObjectProperty ;
    rdfs:label "was derived from"@en ;
    rdfs:comment "A transformation of an entity into another, an update of an entity resulting in a new one, or the construction of a new entity based on a pre-existing one. (PROV-O)"@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o> ;
    rdfs:domain prov:Entity ;
    rdfs:range prov:Entity .

skos:ConceptScheme a owl:Class ;
    rdfs:label "Concept Scheme"@en ;
    rdfs:comment "A set of concepts, optionally including statements about semantic relationships between those concepts. (SKOS)"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    owl:disjointWith skos:Concept .

skos:hasTopConcept a owl:ObjectProperty ;
    rdfs:label "has top concept"@en ;
    rdfs:comment "Relates, by convention, a concept scheme to a concept which is topmost in the broader/narrower concept hierarchies for that scheme. (SKOS)"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:domain skos:ConceptScheme ;
    rdfs:range skos:Concept .

skos:Concept a owl:Class ;
    rdfs:label "Concept"@en ;
    rdfs:comment "An idea or notion; a unit of thought. (SKOS)"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> .

skos:inScheme a owl:ObjectProperty ;
    rdfs:label "is in scheme"@en ;
    rdfs:comment "Relates a resource (for example a concept) to a concept scheme in which it is included. (SKOS)"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:range skos:ConceptScheme .

skos:topConceptOf a owl:ObjectProperty ;
    rdfs:label "is top concept in scheme"@en ;
    rdfs:comment "Relates a concept to the concept scheme that it is a top level concept of. (SKOS)"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:inScheme ;
    owl:inverseOf skos:hasTopConcept .

prov:Entity a owl:Class ;
    rdfs:label "Entity"@en ;
    rdfs:comment "A physical, digital, conceptual, or other kind of thing with some fixed aspects. (PROV-O)"@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o> .

