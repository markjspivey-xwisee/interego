{
  "manifest_version": 3,
  "name": "Interego Wallet",
  "version": "0.4.0",
  "description": "Use a local sign-in key, link an existing Interego account, and review private captures for your chosen pod.",
  "minimum_chrome_version": "120",
  "permissions": ["identity", "storage", "activeTab", "scripting", "nativeMessaging"],
  "optional_host_permissions": ["https://*/*"],
  "action": {"default_title": "Review selection in Interego Wallet"},
  "background": {"service_worker": "src/service-worker.mjs", "type": "module"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"}
}
