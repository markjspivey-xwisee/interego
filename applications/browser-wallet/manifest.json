{
  "manifest_version": 3,
  "name": "Interego Wallet",
  "version": "0.1.0",
  "description": "Choose an Interego identity, inspect context, and review selected text before saving it privately to your pod.",
  "minimum_chrome_version": "120",
  "permissions": ["identity", "storage", "activeTab", "scripting"],
  "optional_host_permissions": ["https://*/*"],
  "action": {"default_title": "Review selection in Interego Wallet"},
  "background": {"service_worker": "src/service-worker.mjs", "type": "module"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"}
}
