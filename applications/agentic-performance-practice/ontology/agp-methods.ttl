@prefix agp: <https://markjspivey-xwisee.github.io/interego/applications/agentic-performance-practice/agp#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Canonical method data consumed by the planner and evidence review.
# Project-authored practice profiles, informed by the linked primary guidance.
# No certification, universal best method, or causal-effect claim is implied.

agp:ContextEvidence a agp:QualityCriterion ; rdfs:label "Context and regime" ;
    rdfs:comment "Describe the work, performers, stakeholders, constraints and observed evidence; record the regime and its provenance before choosing a method." ; agp:workProduct "Situation record and regime rationale" ; dct:source <https://www.opm.gov/policy-data-oversight/training-and-development/planning-evaluating/> .

agp:OutcomeOwnership a agp:QualityCriterion ; rdfs:label "Purpose and ownership" ;
    rdfs:comment "Name the accountable owner, intended work outcome, scope, constraints and review cadence; distinguish an outcome hypothesis from a measured result." ; agp:workProduct "Engagement brief and outcome measures" ; dct:source <https://www.opm.gov/policy-data-oversight/training-and-development/planning-evaluating/> .

agp:SelectionRationale a agp:QualityCriterion ; rdfs:label "Intervention rationale" ;
    rdfs:comment "Link the selection and rejected alternatives to the regime-appropriate diagnosis. Use gap analysis only for Knowable work; retain environmental options and a no-intervention decision." ; agp:workProduct "Diagnosis and intervention decision" ; dct:source <https://www.opm.gov/policy-data-oversight/training-and-development/planning-evaluating/> .

agp:EvaluationPlan a agp:QualityCriterion ; rdfs:label "Evaluation and attribution" ;
    rdfs:comment "Define the observations, baseline or comparison where appropriate, timing and decision rules. Separate usability, demonstrated capability, transfer and work outcomes; report causal and identity limitations." ; agp:workProduct "Evaluation and measurement plan" ; dct:source <https://www.cdc.gov/training-development/php/qts/index.html> .

agp:MaintenancePlan a agp:QualityCriterion ; rdfs:label "Management and maintenance" ;
    rdfs:comment "Assign an owner, version, review date, support route and triggers to revise, retire or re-contextualize the intervention." ; agp:workProduct "Maintenance and follow-up plan" ; dct:source <https://www.cdc.gov/training-development/php/qts/index.html> .

agp:PerformanceConsultingCycle a agp:Methodology ; rdfs:label "Performance consulting and management cycle" ;
    agp:profileToken "consulting" ; dct:hasVersion "1.0.0" ;
    agp:appliesWhen "Begin with a performance situation for a human, agent or team; the work regime determines the diagnosis, and evidence governs iteration." ;
    agp:entryStep agp:ConsultingContract ;
    agp:hasStep agp:ConsultingContract, agp:ConsultingContextualize, agp:ConsultingSelect, agp:ConsultingDesign, agp:ConsultingImplement, agp:ConsultingEvaluate, agp:ConsultingManage ;
    agp:requiresCriterion agp:ContextEvidence, agp:OutcomeOwnership, agp:SelectionRationale, agp:EvaluationPlan, agp:MaintenancePlan .

agp:ConsultingContract a agp:MethodStep ; rdfs:label "Agree purpose and scope" ;
    rdfs:comment "Agree stakeholders, performers, owner, constraints, work outcomes and the engagement boundary." ; agp:sequence 1 ; agp:requiresCriterion agp:OutcomeOwnership ; agp:nextStep agp:ConsultingContextualize .

agp:ConsultingContextualize a agp:MethodStep ; rdfs:label "Contextualize the work" ;
    rdfs:comment "Read the work regime with provenance. Evident applies practice; Knowable may analyse a gap; Emergent reads dispositions; Turbulent stabilizes; unclassified work must be classified first." ; agp:sequence 2 ; agp:requiresCriterion agp:ContextEvidence ; agp:nextStep agp:ConsultingSelect ; agp:branchesToMethod agp:ApplyPractice, agp:GapAnalysis, agp:DispositionalRead, agp:StabiliseFirst, agp:ClassifyFirst .

agp:ConsultingSelect a agp:MethodStep ; rdfs:label "Select and justify interventions" ;
    rdfs:comment "Use the regime-appropriate diagnosis to select, combine or rule out interventions, including leaving the situation alone." ; agp:sequence 3 ; agp:requiresCriterion agp:SelectionRationale ; agp:nextStep agp:ConsultingDesign .

agp:ConsultingDesign a agp:MethodStep ; rdfs:label "Design the intervention and evaluation" ;
    rdfs:comment "Follow the selected method profiles. Define evidence and decision rules before implementation; revise the selection if design reveals a wrong diagnosis." ; agp:sequence 4 ; agp:requiresCriterion agp:EvaluationPlan ; agp:nextStep agp:ConsultingImplement ; agp:revisitsStep agp:ConsultingContextualize .

agp:ConsultingImplement a agp:MethodStep ; rdfs:label "Pilot and implement" ;
    rdfs:comment "Inspect representative use, resolve defects, provide support and record what was actually implemented." ; agp:sequence 5 ; agp:requiresCriterion agp:SelectionRationale ; agp:nextStep agp:ConsultingEvaluate .

agp:ConsultingEvaluate a agp:MethodStep ; rdfs:label "Evaluate observed effects" ;
    rdfs:comment "Compare observed evidence to the stated decision rules, report limitations and decide whether to continue, adapt, stop or re-contextualize." ; agp:sequence 6 ; agp:requiresCriterion agp:EvaluationPlan ; agp:nextStep agp:ConsultingManage ; agp:revisitsStep agp:ConsultingContextualize .

agp:ConsultingManage a agp:MethodStep ; rdfs:label "Manage and maintain performance" ;
    rdfs:comment "Review outcomes and conditions on an assigned cadence; maintain or retire interventions and reopen contextualization when signals change." ; agp:sequence 7 ; agp:requiresCriterion agp:MaintenancePlan ; agp:nextStep agp:ConsultingContextualize ; agp:revisitsStep agp:ConsultingContextualize .

agp:LearnerTaskAnalysis a agp:QualityCriterion ; rdfs:label "Analyse tasks and prerequisites" ;
    rdfs:comment "Analyse target tasks, prior capability, language, accessibility, tool access and performance conditions. Verify that instruction addresses the diagnosed cause." ; agp:workProduct "Task and audience analysis" ; dct:source <https://www.cdc.gov/training-development/php/qts/index.html> .

agp:ObjectiveAlignment a agp:QualityCriterion ; rdfs:label "Align objectives, practice and assessment" ;
    rdfs:comment "State observable objectives with conditions and success criteria. Map every objective to worked content, realistic practice, feedback and an assessment item or task." ; agp:workProduct "Objective-to-practice-to-assessment alignment map" ; dct:source <https://www.cdc.gov/training-development/php/qts/index.html> .

agp:InstructionSequence a agp:QualityCriterion ; rdfs:label "Design and develop learning" ;
    rdfs:comment "Sequence prerequisites and worked examples into supported practice, then independent performance; check content accuracy, relevance, cognitive demand and source currency." ; agp:workProduct "Reviewed learning sequence and prototype" ; dct:source <https://www.cdc.gov/training-development/php/qts/index.html> .

agp:AssessmentContract a agp:QualityCriterion ; rdfs:label "Validate the assessment contract" ;
    rdfs:comment "Define answer keys or rubrics, acceptable formats and ranges, partial credit, pass threshold and retry policy. Exercise invalid, wrong, partly correct and correct submissions; invalid input must not record a score." ; agp:workProduct "Assessment specification and scoring test evidence" ; dct:source <https://www.w3.org/WAI/tutorials/forms/validation/> .

agp:UsabilityAccess a agp:QualityCriterion ; rdfs:label "Check usability and access" ;
    rdfs:comment "Test keyboard access, labels, instructions, errors, feedback, functional resource links and the supported delivery environment with representative performers." ; agp:workProduct "Accessibility and usability review evidence" ; dct:source <https://www.w3.org/WAI/tutorials/forms/validation/> .

agp:RuntimeRecording a agp:QualityCriterion ; rdfs:label "Verify delivery and recording" ;
    rdfs:comment "For tracked delivery, verify launch, resume, response recording, completion, success and failure recovery in the target runtime. Distinguish technical delivery success from learning success." ; agp:workProduct "Runtime verification evidence or a justified untracked-delivery decision" ; dct:source <https://www.cdc.gov/training-development/php/qts/index.html> .

agp:PilotRevision a agp:QualityCriterion ; rdfs:label "Pilot and revise" ;
    rdfs:comment "Pilot with representative performers, collect objective-linked results and feedback, document defects and revisions, and repeat the affected checks." ; agp:workProduct "Pilot findings and revision log" ; dct:source <https://www.cdc.gov/training-development/php/qts/index.html> .

agp:TransferSupport a agp:QualityCriterion ; rdfs:label "Support transfer and follow-up" ;
    rdfs:comment "Provide in-flow aids, practice opportunities, coaching or environmental support as needed; schedule observation of performance on fresh work and identify what remains unmeasured." ; agp:workProduct "Transfer support and follow-up evidence" ; dct:source <https://www.cdc.gov/training-development/php/qts/index.html> .

agp:InstructionalDesign a agp:Methodology, agp:InterventionMethodology ; rdfs:label "Instructional design" ;
    agp:interventionToken "instruction" ; agp:profileToken "instruction" ; dct:hasVersion "1.0.0" ;
    agp:appliesWhen "Use after a Knowable diagnosis warrants learning a knowledge or skill capability; design for the actual performer and delivery context." ; agp:consultingProcess agp:PerformanceConsultingCycle ;
    agp:entryStep agp:LearnerTaskAnalysisStep ;
    agp:hasStep agp:LearnerTaskAnalysisStep, agp:ObjectiveAlignmentStep, agp:InstructionSequenceStep, agp:AssessmentContractStep, agp:UsabilityAccessStep, agp:RuntimeRecordingStep, agp:PilotRevisionStep, agp:TransferSupportStep ;
    agp:requiresCriterion agp:ContextEvidence, agp:OutcomeOwnership, agp:SelectionRationale, agp:EvaluationPlan, agp:MaintenancePlan, agp:LearnerTaskAnalysis, agp:ObjectiveAlignment, agp:InstructionSequence, agp:AssessmentContract, agp:UsabilityAccess, agp:RuntimeRecording, agp:PilotRevision, agp:TransferSupport .

agp:LearnerTaskAnalysisStep a agp:MethodStep ; rdfs:label "Analyse tasks and prerequisites" ; rdfs:comment "Analyse target tasks, prior capability, language, accessibility, tool access and performance conditions. Verify that instruction addresses the diagnosed cause." ;
    agp:sequence 1 ; agp:requiresCriterion agp:LearnerTaskAnalysis ; agp:nextStep agp:ObjectiveAlignmentStep .

agp:ObjectiveAlignmentStep a agp:MethodStep ; rdfs:label "Align objectives, practice and assessment" ; rdfs:comment "State observable objectives with conditions and success criteria. Map every objective to worked content, realistic practice, feedback and an assessment item or task." ;
    agp:sequence 2 ; agp:requiresCriterion agp:ObjectiveAlignment ; agp:nextStep agp:InstructionSequenceStep .

agp:InstructionSequenceStep a agp:MethodStep ; rdfs:label "Design and develop learning" ; rdfs:comment "Sequence prerequisites and worked examples into supported practice, then independent performance; check content accuracy, relevance, cognitive demand and source currency." ;
    agp:sequence 3 ; agp:requiresCriterion agp:InstructionSequence ; agp:nextStep agp:AssessmentContractStep .

agp:AssessmentContractStep a agp:MethodStep ; rdfs:label "Validate the assessment contract" ; rdfs:comment "Define answer keys or rubrics, acceptable formats and ranges, partial credit, pass threshold and retry policy. Exercise invalid, wrong, partly correct and correct submissions; invalid input must not record a score." ;
    agp:sequence 4 ; agp:requiresCriterion agp:AssessmentContract ; agp:nextStep agp:UsabilityAccessStep .

agp:UsabilityAccessStep a agp:MethodStep ; rdfs:label "Check usability and access" ; rdfs:comment "Test keyboard access, labels, instructions, errors, feedback, functional resource links and the supported delivery environment with representative performers." ;
    agp:sequence 5 ; agp:requiresCriterion agp:UsabilityAccess ; agp:nextStep agp:RuntimeRecordingStep .

agp:RuntimeRecordingStep a agp:MethodStep ; rdfs:label "Verify delivery and recording" ; rdfs:comment "For tracked delivery, verify launch, resume, response recording, completion, success and failure recovery in the target runtime. Distinguish technical delivery success from learning success." ;
    agp:sequence 6 ; agp:requiresCriterion agp:RuntimeRecording ; agp:nextStep agp:PilotRevisionStep .

agp:PilotRevisionStep a agp:MethodStep ; rdfs:label "Pilot and revise" ; rdfs:comment "Pilot with representative performers, collect objective-linked results and feedback, document defects and revisions, and repeat the affected checks." ;
    agp:sequence 7 ; agp:requiresCriterion agp:PilotRevision ; agp:nextStep agp:TransferSupportStep .

agp:TransferSupportStep a agp:MethodStep ; rdfs:label "Support transfer and follow-up" ; rdfs:comment "Provide in-flow aids, practice opportunities, coaching or environmental support as needed; schedule observation of performance on fresh work and identify what remains unmeasured." ;
    agp:sequence 8 ; agp:requiresCriterion agp:TransferSupport ; agp:nextStep agp:ConsultingEvaluate ; agp:revisitsStep agp:LearnerTaskAnalysisStep .

agp:SupportTrigger a agp:QualityCriterion ; rdfs:label "Locate the moment of need" ;
    rdfs:comment "Identify the task trigger, decision, user, device, tool context and cost of interruption; confirm that looking up guidance is feasible." ; agp:workProduct "Point-of-work task and access map" ; dct:source <https://www.cdc.gov/training-development/php/qts/index.html> .

agp:SupportContent a agp:QualityCriterion ; rdfs:label "Make guidance actionable" ;
    rdfs:comment "Provide concise steps or decision rules, examples, exceptions and escalation routes. State prerequisites and limits; link authoritative sources." ; agp:workProduct "Versioned job aid or embedded guidance" ; dct:source <https://www.cdc.gov/training-development/php/qts/index.html> .

agp:SupportTrial a agp:QualityCriterion ; rdfs:label "Test on representative work" ;
    rdfs:comment "Observe whether performers can find and use the aid on fresh tasks; measure errors, time, success and unintended effects, then revise." ; agp:workProduct "Usability and task-performance trial" ; dct:source <https://www.cdc.gov/training-development/php/qts/index.html> .

agp:SupportRetention a agp:QualityCriterion ; rdfs:label "Keep support available" ;
    rdfs:comment "Verify discovery, access and retained use in the real work environment, including agent-readable links where relevant." ; agp:workProduct "Access and retention checks" ; dct:source <https://www.cdc.gov/training-development/php/qts/index.html> .

agp:InFlowSupport a agp:Methodology, agp:InterventionMethodology ; rdfs:label "Performance support design" ;
    agp:interventionToken "performance-support" ; agp:profileToken "performance-support" ; dct:hasVersion "1.0.0" ;
    agp:appliesWhen "Use when guidance can be consulted at the point of work, independently or alongside instruction, coaching or an environmental change." ; agp:consultingProcess agp:PerformanceConsultingCycle ;
    agp:entryStep agp:SupportTriggerStep ;
    agp:hasStep agp:SupportTriggerStep, agp:SupportContentStep, agp:SupportTrialStep, agp:SupportRetentionStep ;
    agp:requiresCriterion agp:ContextEvidence, agp:OutcomeOwnership, agp:SelectionRationale, agp:EvaluationPlan, agp:MaintenancePlan, agp:SupportTrigger, agp:SupportContent, agp:SupportTrial, agp:SupportRetention .

agp:SupportTriggerStep a agp:MethodStep ; rdfs:label "Locate the moment of need" ; rdfs:comment "Identify the task trigger, decision, user, device, tool context and cost of interruption; confirm that looking up guidance is feasible." ;
    agp:sequence 1 ; agp:requiresCriterion agp:SupportTrigger ; agp:nextStep agp:SupportContentStep .

agp:SupportContentStep a agp:MethodStep ; rdfs:label "Make guidance actionable" ; rdfs:comment "Provide concise steps or decision rules, examples, exceptions and escalation routes. State prerequisites and limits; link authoritative sources." ;
    agp:sequence 2 ; agp:requiresCriterion agp:SupportContent ; agp:nextStep agp:SupportTrialStep .

agp:SupportTrialStep a agp:MethodStep ; rdfs:label "Test on representative work" ; rdfs:comment "Observe whether performers can find and use the aid on fresh tasks; measure errors, time, success and unintended effects, then revise." ;
    agp:sequence 3 ; agp:requiresCriterion agp:SupportTrial ; agp:nextStep agp:SupportRetentionStep .

agp:SupportRetentionStep a agp:MethodStep ; rdfs:label "Keep support available" ; rdfs:comment "Verify discovery, access and retained use in the real work environment, including agent-readable links where relevant." ;
    agp:sequence 4 ; agp:requiresCriterion agp:SupportRetention ; agp:nextStep agp:ConsultingEvaluate ; agp:revisitsStep agp:SupportTriggerStep .

agp:ReferenceScope a agp:QualityCriterion ; rdfs:label "Define retrieval needs" ;
    rdfs:comment "List the real questions, terms, context and access constraints that the reference must support." ; agp:workProduct "Reference scope and retrieval tasks" ; dct:source <https://www.cdc.gov/training-development/php/qts/index.html> .

agp:ReferenceAuthority a agp:QualityCriterion ; rdfs:label "Curate and structure knowledge" ;
    rdfs:comment "Record source authority, provenance, date, applicability and contradictions; organize entries using the terms performers actually use." ; agp:workProduct "Structured reference with provenance" ; dct:source <https://www.cdc.gov/training-development/php/qts/index.html> .

agp:ReferenceTrial a agp:QualityCriterion ; rdfs:label "Test retrieval and correctness" ;
    rdfs:comment "Test realistic queries, findability, broken links, stale answers and access restrictions with representative users or agents." ; agp:workProduct "Retrieval and content review evidence" ; dct:source <https://www.cdc.gov/training-development/php/qts/index.html> .

agp:ReferenceDesign a agp:Methodology, agp:InterventionMethodology ; rdfs:label "Reference design and stewardship" ;
    agp:interventionToken "reference" ; agp:profileToken "reference" ; dct:hasVersion "1.0.0" ;
    agp:appliesWhen "Use for information that can be retrieved when needed; do not assume it must be memorized." ; agp:consultingProcess agp:PerformanceConsultingCycle ;
    agp:entryStep agp:ReferenceScopeStep ;
    agp:hasStep agp:ReferenceScopeStep, agp:ReferenceAuthorityStep, agp:ReferenceTrialStep ;
    agp:requiresCriterion agp:ContextEvidence, agp:OutcomeOwnership, agp:SelectionRationale, agp:EvaluationPlan, agp:MaintenancePlan, agp:ReferenceScope, agp:ReferenceAuthority, agp:ReferenceTrial .

agp:ReferenceScopeStep a agp:MethodStep ; rdfs:label "Define retrieval needs" ; rdfs:comment "List the real questions, terms, context and access constraints that the reference must support." ;
    agp:sequence 1 ; agp:requiresCriterion agp:ReferenceScope ; agp:nextStep agp:ReferenceAuthorityStep .

agp:ReferenceAuthorityStep a agp:MethodStep ; rdfs:label "Curate and structure knowledge" ; rdfs:comment "Record source authority, provenance, date, applicability and contradictions; organize entries using the terms performers actually use." ;
    agp:sequence 2 ; agp:requiresCriterion agp:ReferenceAuthority ; agp:nextStep agp:ReferenceTrialStep .

agp:ReferenceTrialStep a agp:MethodStep ; rdfs:label "Test retrieval and correctness" ; rdfs:comment "Test realistic queries, findability, broken links, stale answers and access restrictions with representative users or agents." ;
    agp:sequence 3 ; agp:requiresCriterion agp:ReferenceTrial ; agp:nextStep agp:ConsultingEvaluate ; agp:revisitsStep agp:ReferenceScopeStep .

agp:PracticeTarget a agp:QualityCriterion ; rdfs:label "Define performance and progression" ;
    rdfs:comment "Specify the capability, representative task conditions, success rubric and progression from supported to independent performance." ; agp:workProduct "Practice specification and rubric" ; dct:source <https://www.cdc.gov/training-development/php/qts/index.html> .

agp:PracticeFeedback a agp:QualityCriterion ; rdfs:label "Build varied practice with feedback" ;
    rdfs:comment "Use realistic varied tasks, timely explanatory feedback and opportunities to correct errors; schedule repeated practice and adjust support from observed performance." ; agp:workProduct "Practice sequence and feedback design" ; dct:source <https://www.cdc.gov/training-development/php/qts/index.html> .

agp:PracticeTransfer a agp:QualityCriterion ; rdfs:label "Check retention and fresh-task transfer" ;
    rdfs:comment "Assess on fresh tasks after support is reduced and at a later time; distinguish rehearsal of known answers from independent capability." ; agp:workProduct "Retention and transfer results" ; dct:source <https://www.cdc.gov/training-development/php/qts/index.html> .

agp:PracticeDesign a agp:Methodology, agp:InterventionMethodology ; rdfs:label "Practice and simulation design" ;
    agp:interventionToken "practice" ; agp:profileToken "practice" ; dct:hasVersion "1.0.0" ;
    agp:appliesWhen "Use when a capability needs fluency, retention or application across conditions; establish prerequisites and safe boundaries." ; agp:consultingProcess agp:PerformanceConsultingCycle ;
    agp:entryStep agp:PracticeTargetStep ;
    agp:hasStep agp:PracticeTargetStep, agp:PracticeFeedbackStep, agp:PracticeTransferStep ;
    agp:requiresCriterion agp:ContextEvidence, agp:OutcomeOwnership, agp:SelectionRationale, agp:EvaluationPlan, agp:MaintenancePlan, agp:PracticeTarget, agp:PracticeFeedback, agp:PracticeTransfer .

agp:PracticeTargetStep a agp:MethodStep ; rdfs:label "Define performance and progression" ; rdfs:comment "Specify the capability, representative task conditions, success rubric and progression from supported to independent performance." ;
    agp:sequence 1 ; agp:requiresCriterion agp:PracticeTarget ; agp:nextStep agp:PracticeFeedbackStep .

agp:PracticeFeedbackStep a agp:MethodStep ; rdfs:label "Build varied practice with feedback" ; rdfs:comment "Use realistic varied tasks, timely explanatory feedback and opportunities to correct errors; schedule repeated practice and adjust support from observed performance." ;
    agp:sequence 2 ; agp:requiresCriterion agp:PracticeFeedback ; agp:nextStep agp:PracticeTransferStep .

agp:PracticeTransferStep a agp:MethodStep ; rdfs:label "Check retention and fresh-task transfer" ; rdfs:comment "Assess on fresh tasks after support is reduced and at a later time; distinguish rehearsal of known answers from independent capability." ;
    agp:sequence 3 ; agp:requiresCriterion agp:PracticeTransfer ; agp:nextStep agp:ConsultingEvaluate ; agp:revisitsStep agp:PracticeTargetStep .

agp:AssessmentPurpose a agp:QualityCriterion ; rdfs:label "Define the interpretation and decision" ;
    rdfs:comment "Specify the capability, intended use, stakes, population and evidence needed for the decision; limit claims to that scope." ; agp:workProduct "Assessment purpose and blueprint" ; dct:source <https://www.cdc.gov/training-development/php/qts/index.html> .

agp:AssessmentAlignment a agp:QualityCriterion ; rdfs:label "Sample representative performance" ;
    rdfs:comment "Align items and tasks to objectives and work conditions. Review content accuracy, ambiguity, accessibility and opportunities for guessing or answer leakage." ; agp:workProduct "Item-to-capability alignment and review" ; dct:source <https://www.cdc.gov/training-development/php/qts/index.html> .

agp:AssessmentScoring a agp:QualityCriterion ; rdfs:label "Specify and test scoring" ;
    rdfs:comment "Define answer rules or rubrics, allowable inputs, weighting, threshold and retries; test blank, malformed, out-of-range, wrong and correct responses plus recording failures." ; agp:workProduct "Scoring contract and test evidence" ; dct:source <https://www.w3.org/WAI/tutorials/forms/validation/> .

agp:AssessmentPilot a agp:QualityCriterion ; rdfs:label "Pilot and review evidence quality" ;
    rdfs:comment "Pilot the assessment and review consistency, item behavior, fairness and relevant work outcomes before using scores for consequential decisions." ; agp:workProduct "Pilot and evidence-quality review" ; dct:source <https://www.cdc.gov/training-development/php/qts/index.html> .

agp:AssessmentDesign a agp:Methodology, agp:InterventionMethodology ; rdfs:label "Assessment design and validation" ;
    agp:interventionToken "assessment" ; agp:profileToken "assessment" ; dct:hasVersion "1.0.0" ;
    agp:appliesWhen "Use to gather evidence for a specified decision; passing a quiz alone does not establish work performance or causal improvement." ; agp:consultingProcess agp:PerformanceConsultingCycle ;
    agp:entryStep agp:AssessmentPurposeStep ;
    agp:hasStep agp:AssessmentPurposeStep, agp:AssessmentAlignmentStep, agp:AssessmentScoringStep, agp:AssessmentPilotStep ;
    agp:requiresCriterion agp:ContextEvidence, agp:OutcomeOwnership, agp:SelectionRationale, agp:EvaluationPlan, agp:MaintenancePlan, agp:AssessmentPurpose, agp:AssessmentAlignment, agp:AssessmentScoring, agp:AssessmentPilot .

agp:AssessmentPurposeStep a agp:MethodStep ; rdfs:label "Define the interpretation and decision" ; rdfs:comment "Specify the capability, intended use, stakes, population and evidence needed for the decision; limit claims to that scope." ;
    agp:sequence 1 ; agp:requiresCriterion agp:AssessmentPurpose ; agp:nextStep agp:AssessmentAlignmentStep .

agp:AssessmentAlignmentStep a agp:MethodStep ; rdfs:label "Sample representative performance" ; rdfs:comment "Align items and tasks to objectives and work conditions. Review content accuracy, ambiguity, accessibility and opportunities for guessing or answer leakage." ;
    agp:sequence 2 ; agp:requiresCriterion agp:AssessmentAlignment ; agp:nextStep agp:AssessmentScoringStep .

agp:AssessmentScoringStep a agp:MethodStep ; rdfs:label "Specify and test scoring" ; rdfs:comment "Define answer rules or rubrics, allowable inputs, weighting, threshold and retries; test blank, malformed, out-of-range, wrong and correct responses plus recording failures." ;
    agp:sequence 3 ; agp:requiresCriterion agp:AssessmentScoring ; agp:nextStep agp:AssessmentPilotStep .

agp:AssessmentPilotStep a agp:MethodStep ; rdfs:label "Pilot and review evidence quality" ; rdfs:comment "Pilot the assessment and review consistency, item behavior, fairness and relevant work outcomes before using scores for consequential decisions." ;
    agp:sequence 4 ; agp:requiresCriterion agp:AssessmentPilot ; agp:nextStep agp:ConsultingEvaluate ; agp:revisitsStep agp:AssessmentPurposeStep .

agp:CoachingAgreement a agp:QualityCriterion ; rdfs:label "Agree purpose and boundaries" ;
    rdfs:comment "Agree the working relationship, confidentiality, observations, decision rights, intended direction and review timing." ; agp:workProduct "Coaching agreement" ; dct:source <https://github.com/markjspivey-xwisee/interego/blob/master/applications/foxxi-content-intelligence/PERFORMANCE-ARCHITECTURE.md> .

agp:CoachingObservation a agp:QualityCriterion ; rdfs:label "Observe and reflect on work" ;
    rdfs:comment "Use concrete episodes and performer reflection; separate observations from interpretations and examine environmental constraints." ; agp:workProduct "Observation and reflection record" ; dct:source <https://github.com/markjspivey-xwisee/interego/blob/master/applications/foxxi-content-intelligence/PERFORMANCE-ARCHITECTURE.md> .

agp:CoachingAction a agp:QualityCriterion ; rdfs:label "Try an action and review" ;
    rdfs:comment "Agree a feasible action or bounded experiment, provide feedback, observe what happens and adapt the next conversation to evidence." ; agp:workProduct "Action and follow-up record" ; dct:source <https://github.com/markjspivey-xwisee/interego/blob/master/applications/foxxi-content-intelligence/PERFORMANCE-ARCHITECTURE.md> .

agp:CoachingProcess a agp:Methodology, agp:InterventionMethodology ; rdfs:label "Coaching and feedback process" ;
    agp:interventionToken "coaching" ; agp:profileToken "coaching" ; dct:hasVersion "1.0.0" ;
    agp:appliesWhen "Use for situated reflection, feedback and supported action, including work where responses must adapt as patterns emerge." ; agp:consultingProcess agp:PerformanceConsultingCycle ;
    agp:entryStep agp:CoachingAgreementStep ;
    agp:hasStep agp:CoachingAgreementStep, agp:CoachingObservationStep, agp:CoachingActionStep ;
    agp:requiresCriterion agp:ContextEvidence, agp:OutcomeOwnership, agp:SelectionRationale, agp:EvaluationPlan, agp:MaintenancePlan, agp:CoachingAgreement, agp:CoachingObservation, agp:CoachingAction .

agp:CoachingAgreementStep a agp:MethodStep ; rdfs:label "Agree purpose and boundaries" ; rdfs:comment "Agree the working relationship, confidentiality, observations, decision rights, intended direction and review timing." ;
    agp:sequence 1 ; agp:requiresCriterion agp:CoachingAgreement ; agp:nextStep agp:CoachingObservationStep .

agp:CoachingObservationStep a agp:MethodStep ; rdfs:label "Observe and reflect on work" ; rdfs:comment "Use concrete episodes and performer reflection; separate observations from interpretations and examine environmental constraints." ;
    agp:sequence 2 ; agp:requiresCriterion agp:CoachingObservation ; agp:nextStep agp:CoachingActionStep .

agp:CoachingActionStep a agp:MethodStep ; rdfs:label "Try an action and review" ; rdfs:comment "Agree a feasible action or bounded experiment, provide feedback, observe what happens and adapt the next conversation to evidence." ;
    agp:sequence 3 ; agp:requiresCriterion agp:CoachingAction ; agp:nextStep agp:ConsultingEvaluate ; agp:revisitsStep agp:CoachingAgreementStep .

agp:ProbeQuestion a agp:QualityCriterion ; rdfs:label "Frame the uncertainty" ;
    rdfs:comment "State the pattern or uncertainty to explore, observations already available and competing interpretations." ; agp:workProduct "Probe question and context" ; dct:source <https://github.com/markjspivey-xwisee/interego/blob/master/applications/foxxi-content-intelligence/PERFORMANCE-ARCHITECTURE.md> .

agp:ProbeBounds a agp:QualityCriterion ; rdfs:label "Bound exposure and stopping" ;
    rdfs:comment "Set scope, resources, duration, consent or permissions as applicable, downside limits, stopping signals and recovery actions." ; agp:workProduct "Probe boundaries and stop rules" ; dct:source <https://github.com/markjspivey-xwisee/interego/blob/master/applications/foxxi-content-intelligence/PERFORMANCE-ARCHITECTURE.md> .

agp:ProbeObservation a agp:QualityCriterion ; rdfs:label "Observe without overclaiming" ;
    rdfs:comment "Collect observations, surprises and side effects using explicit measures; retain contrary evidence and attribution limits." ; agp:workProduct "Probe observation log" ; dct:source <https://github.com/markjspivey-xwisee/interego/blob/master/applications/foxxi-content-intelligence/PERFORMANCE-ARCHITECTURE.md> .

agp:ProbeAdaptation a agp:QualityCriterion ; rdfs:label "Adapt and re-contextualize" ;
    rdfs:comment "Review patterns and decide whether to amplify, modify, stop or try another probe; reassess the work regime when conditions change." ; agp:workProduct "Adaptation decision and rationale" ; dct:source <https://github.com/markjspivey-xwisee/interego/blob/master/applications/foxxi-content-intelligence/PERFORMANCE-ARCHITECTURE.md> .

agp:BoundedProbe a agp:Methodology, agp:InterventionMethodology ; rdfs:label "Bounded probe and adaptation" ;
    agp:interventionToken "probe" ; agp:profileToken "probe" ; dct:hasVersion "1.0.0" ;
    agp:appliesWhen "Use in Emergent work to learn about dispositions and interactions; do not claim a predictable solution or impose a gap target." ; agp:consultingProcess agp:PerformanceConsultingCycle ;
    agp:entryStep agp:ProbeQuestionStep ;
    agp:hasStep agp:ProbeQuestionStep, agp:ProbeBoundsStep, agp:ProbeObservationStep, agp:ProbeAdaptationStep ;
    agp:requiresCriterion agp:ContextEvidence, agp:OutcomeOwnership, agp:SelectionRationale, agp:EvaluationPlan, agp:MaintenancePlan, agp:ProbeQuestion, agp:ProbeBounds, agp:ProbeObservation, agp:ProbeAdaptation .

agp:ProbeQuestionStep a agp:MethodStep ; rdfs:label "Frame the uncertainty" ; rdfs:comment "State the pattern or uncertainty to explore, observations already available and competing interpretations." ;
    agp:sequence 1 ; agp:requiresCriterion agp:ProbeQuestion ; agp:nextStep agp:ProbeBoundsStep .

agp:ProbeBoundsStep a agp:MethodStep ; rdfs:label "Bound exposure and stopping" ; rdfs:comment "Set scope, resources, duration, consent or permissions as applicable, downside limits, stopping signals and recovery actions." ;
    agp:sequence 2 ; agp:requiresCriterion agp:ProbeBounds ; agp:nextStep agp:ProbeObservationStep .

agp:ProbeObservationStep a agp:MethodStep ; rdfs:label "Observe without overclaiming" ; rdfs:comment "Collect observations, surprises and side effects using explicit measures; retain contrary evidence and attribution limits." ;
    agp:sequence 3 ; agp:requiresCriterion agp:ProbeObservation ; agp:nextStep agp:ProbeAdaptationStep .

agp:ProbeAdaptationStep a agp:MethodStep ; rdfs:label "Adapt and re-contextualize" ; rdfs:comment "Review patterns and decide whether to amplify, modify, stop or try another probe; reassess the work regime when conditions change." ;
    agp:sequence 4 ; agp:requiresCriterion agp:ProbeAdaptation ; agp:nextStep agp:ConsultingEvaluate ; agp:revisitsStep agp:ProbeQuestionStep .

agp:EnvironmentConstraint a agp:QualityCriterion ; rdfs:label "Identify the constraint" ;
    rdfs:comment "Describe the affected workflow, tools, resources, incentives or task demands and the evidence linking them to performance." ; agp:workProduct "Constraint and dependency analysis" ; dct:source <https://github.com/markjspivey-xwisee/interego/blob/master/applications/foxxi-content-intelligence/PERFORMANCE-ARCHITECTURE.md> .

agp:EnvironmentDesign a agp:QualityCriterion ; rdfs:label "Design the change" ;
    rdfs:comment "Specify ownership, requirements, affected groups, intended effects, dependencies, implementation boundaries and recovery arrangements." ; agp:workProduct "Change specification and implementation plan" ; dct:source <https://github.com/markjspivey-xwisee/interego/blob/master/applications/foxxi-content-intelligence/PERFORMANCE-ARCHITECTURE.md> .

agp:EnvironmentPilot a agp:QualityCriterion ; rdfs:label "Implement and inspect effects" ;
    rdfs:comment "Test the change at an appropriate scale or stabilize urgently where required; inspect actual effects and unintended consequences before extending it." ; agp:workProduct "Implementation and observation evidence" ; dct:source <https://github.com/markjspivey-xwisee/interego/blob/master/applications/foxxi-content-intelligence/PERFORMANCE-ARCHITECTURE.md> .

agp:EnvironmentSustain a agp:QualityCriterion ; rdfs:label "Sustain and reassess" ;
    rdfs:comment "Confirm access, adoption, operational ownership and monitoring; re-contextualize when the environment or outcomes change." ; agp:workProduct "Operational handover and monitoring record" ; dct:source <https://github.com/markjspivey-xwisee/interego/blob/master/applications/foxxi-content-intelligence/PERFORMANCE-ARCHITECTURE.md> .

agp:EnvironmentChange a agp:Methodology, agp:InterventionMethodology ; rdfs:label "Work environment and process change" ;
    agp:interventionToken "environmental-fix" ; agp:profileToken "environmental-fix" ; dct:hasVersion "1.0.0" ;
    agp:appliesWhen "Use for tools, access, workflow, information, incentives or task fit. In Turbulent work, stabilize immediate conditions before broader redesign." ; agp:consultingProcess agp:PerformanceConsultingCycle ;
    agp:entryStep agp:EnvironmentConstraintStep ;
    agp:hasStep agp:EnvironmentConstraintStep, agp:EnvironmentDesignStep, agp:EnvironmentPilotStep, agp:EnvironmentSustainStep ;
    agp:requiresCriterion agp:ContextEvidence, agp:OutcomeOwnership, agp:SelectionRationale, agp:EvaluationPlan, agp:MaintenancePlan, agp:EnvironmentConstraint, agp:EnvironmentDesign, agp:EnvironmentPilot, agp:EnvironmentSustain .

agp:EnvironmentConstraintStep a agp:MethodStep ; rdfs:label "Identify the constraint" ; rdfs:comment "Describe the affected workflow, tools, resources, incentives or task demands and the evidence linking them to performance." ;
    agp:sequence 1 ; agp:requiresCriterion agp:EnvironmentConstraint ; agp:nextStep agp:EnvironmentDesignStep .

agp:EnvironmentDesignStep a agp:MethodStep ; rdfs:label "Design the change" ; rdfs:comment "Specify ownership, requirements, affected groups, intended effects, dependencies, implementation boundaries and recovery arrangements." ;
    agp:sequence 2 ; agp:requiresCriterion agp:EnvironmentDesign ; agp:nextStep agp:EnvironmentPilotStep .

agp:EnvironmentPilotStep a agp:MethodStep ; rdfs:label "Implement and inspect effects" ; rdfs:comment "Test the change at an appropriate scale or stabilize urgently where required; inspect actual effects and unintended consequences before extending it." ;
    agp:sequence 3 ; agp:requiresCriterion agp:EnvironmentPilot ; agp:nextStep agp:EnvironmentSustainStep .

agp:EnvironmentSustainStep a agp:MethodStep ; rdfs:label "Sustain and reassess" ; rdfs:comment "Confirm access, adoption, operational ownership and monitoring; re-contextualize when the environment or outcomes change." ;
    agp:sequence 4 ; agp:requiresCriterion agp:EnvironmentSustain ; agp:nextStep agp:ConsultingEvaluate ; agp:revisitsStep agp:EnvironmentConstraintStep .

agp:NoInterventionReason a agp:QualityCriterion ; rdfs:label "Record the decision" ;
    rdfs:comment "Record why an intervention is unwarranted, disproportionate or premature, including uncertainty and alternatives considered." ; agp:workProduct "Decision rationale" ; dct:source <https://github.com/markjspivey-xwisee/interego/blob/master/applications/foxxi-content-intelligence/PERFORMANCE-ARCHITECTURE.md> .

agp:NoInterventionMonitor a agp:QualityCriterion ; rdfs:label "Set observation and revisit triggers" ;
    rdfs:comment "Name who will observe what, when the decision will be reviewed and which signals would trigger renewed contextualization." ; agp:workProduct "Monitoring and revisit plan" ; dct:source <https://github.com/markjspivey-xwisee/interego/blob/master/applications/foxxi-content-intelligence/PERFORMANCE-ARCHITECTURE.md> .

agp:MonitorWithoutIntervention a agp:Methodology, agp:InterventionMethodology ; rdfs:label "Monitor without intervention" ;
    agp:interventionToken "no-intervention" ; agp:profileToken "no-intervention" ; dct:hasVersion "1.0.0" ;
    agp:appliesWhen "Use when evidence supports leaving the situation alone or the proposed intervention is not justified; it remains an accountable decision." ; agp:consultingProcess agp:PerformanceConsultingCycle ;
    agp:entryStep agp:NoInterventionReasonStep ;
    agp:hasStep agp:NoInterventionReasonStep, agp:NoInterventionMonitorStep ;
    agp:requiresCriterion agp:ContextEvidence, agp:OutcomeOwnership, agp:SelectionRationale, agp:EvaluationPlan, agp:MaintenancePlan, agp:NoInterventionReason, agp:NoInterventionMonitor .

agp:NoInterventionReasonStep a agp:MethodStep ; rdfs:label "Record the decision" ; rdfs:comment "Record why an intervention is unwarranted, disproportionate or premature, including uncertainty and alternatives considered." ;
    agp:sequence 1 ; agp:requiresCriterion agp:NoInterventionReason ; agp:nextStep agp:NoInterventionMonitorStep .

agp:NoInterventionMonitorStep a agp:MethodStep ; rdfs:label "Set observation and revisit triggers" ; rdfs:comment "Name who will observe what, when the decision will be reviewed and which signals would trigger renewed contextualization." ;
    agp:sequence 2 ; agp:requiresCriterion agp:NoInterventionMonitor ; agp:nextStep agp:ConsultingEvaluate ; agp:revisitsStep agp:NoInterventionReasonStep .

