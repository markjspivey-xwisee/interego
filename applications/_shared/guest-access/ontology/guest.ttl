# guest: — attributes and actions of a provisional guest (deployment vocabulary)
#
# Non-normative. Layer: implementation (L3), deployment-scoped. It names what the hosted identity
# service states about a provisional guest account and the actions the shared guest-access helper
# decides, so that policies over them are data. It extends no L1, L2 or L3 ontology and is not part
# of the Interego protocol: nothing in `iep:` or `abac:` depends on it. Policies that use these
# terms are `iep:AccessControlPolicy` records evaluated as `abac:` describes.

@prefix guest: <https://markjspivey-xwisee.github.io/interego/applications/_shared/guest-access/guest#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

<https://markjspivey-xwisee.github.io/interego/applications/_shared/guest-access/guest> a owl:Ontology ;
  dct:title "guest: — provisional guest attributes" ;
  rdfs:comment "Attributes an identity provider states about a provisional (browser-key) guest account, and the actions decided from them. Deployment vocabulary. Not protocol." .

guest:provisional a owl:DatatypeProperty ; rdfs:range xsd:boolean ; rdfs:label "provisional" ;
  rdfs:comment "True while the subject acts under a provisional guest authority: possession of a browser key, bounded by a fixed deadline. It identifies no person." .
guest:claimed a owl:DatatypeProperty ; rdfs:range xsd:boolean ; rdfs:label "claimed" ;
  rdfs:comment "True once the account holds an enrolled credential (a passkey, wallet or DID key)." .
guest:createdAt a owl:DatatypeProperty ; rdfs:range xsd:integer ; rdfs:label "created at" ;
  rdfs:comment "When the guest was first admitted, in Unix seconds." .
guest:expiresAt a owl:DatatypeProperty ; rdfs:range xsd:integer ; rdfs:label "expires at" ;
  rdfs:comment "The guest's fixed deadline, in Unix seconds. Never extended." .
guest:ageSeconds a owl:DatatypeProperty ; rdfs:range xsd:integer ; rdfs:label "age in seconds" ;
  rdfs:comment "Derived by the verifier: its clock minus guest:createdAt, never below zero." .
guest:secondsRemaining a owl:DatatypeProperty ; rdfs:range xsd:integer ; rdfs:label "seconds remaining" ;
  rdfs:comment "Derived by the verifier: guest:expiresAt minus its clock. Zero or less once the deadline has passed." .
guest:admittedBy a owl:DatatypeProperty ; rdfs:range xsd:anyURI ; rdfs:label "admitted by" ;
  rdfs:comment "The origin of an application that admitted the guest or that the guest has since used. Many-valued." .
guest:hostedTermsVersion a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "hosted terms version" ;
  rdfs:comment "The version of the hosted terms the guest agreed to when it was admitted." .
guest:proofKeyThumbprint a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "proof key thumbprint" ;
  rdfs:comment "The RFC 7638 thumbprint of the guest's P-256 proof key." .

guest:UseApplication a owl:NamedIndividual ; rdfs:label "use application" ;
  rdfs:comment "Action: use an application as this guest." .
guest:WriteCheckpoint a owl:NamedIndividual ; rdfs:label "write checkpoint" ;
  rdfs:comment "Action: write the application's bounded checkpoint documents in the guest's own pod." .
