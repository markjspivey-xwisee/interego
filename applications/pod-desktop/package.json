{
  "name": "@interego/pod-desktop",
  "version": "0.1.0-preview.7",
  "description": "Interego for Windows: a personal local pod with private notes, scoped agent connections and encrypted backup.",
  "author": "Mark Spivey",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/main.mjs",
  "homepage": "https://github.com/markjspivey-xwisee/interego",
  "repository": {
    "type": "git",
    "url": "https://github.com/markjspivey-xwisee/interego.git"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "stage": "npm run build && node tools/stage.mjs",
    "package:win": "npm run stage && node tools/package-win.mjs",
    "package:win:refresh": "npm run build && node tools/refresh-staged-app.mjs && node tools/package-win.mjs",
    "smoke:packaged": "node tools/smoke-packaged.mjs",
    "start": "npm run build && electron ."
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@interego/local-node": "*",
    "@interego/deployment-config": "*",
    "@interego/core": "*",
    "@interego/solid": "*",
    "@interego/pod-federation": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.0"
  }
}
