<https://relay.interego.xwisee.com/ns/u-pk-0d4144c0c851/phone-roleplay-xapi> a profile:Profile ;
    dct:conformsTo <https://w3id.org/xapi/profiles#1.0> ;
    schemaorg:author [ a schemaorg:Person ;
            schemaorg:name "Mark Spivey" ] ;
    rdfs:seeAlso <https://foxxi-bridge.interego.xwisee.com/xapi/profile> ;
    skos:definition "xAPI Profile for phone role-play training on Interego and Foxxi: an AI voice agent plays a customer on a live phone call, the participant plays the support rep, the call is scored against a rubric, and performance-consulting interventions follow. Identity is the participant's phone number, recorded only as a keyed pseudonym; consent is taken on the call. Statements go to the Foxxi LRS; authoritative records live in Interego graphs; activities align to the I2IDL Digital Learning Glossary through I2IDL-X. v3 is a generic projection: one criterion-scored template and one turn template, with the attempt's rubric named in context, so the profile can follow any ratified practice-evidence rubric. It does not hard-code a set of criterion keys or a fixed scoring order. Turns live in the LRS under the LMS registration."@en ;
    skos:prefLabel "Phone Role-Play Training — xAPI Profile"@en ;
    profile:concepts <http://adlnet.gov/expapi/verbs/asked>,
        <http://adlnet.gov/expapi/verbs/completed>,
        <http://adlnet.gov/expapi/verbs/failed>,
        <http://adlnet.gov/expapi/verbs/initialized>,
