<http://adlnet.gov/expapi/verbs/failed> a xapi:Verb ;
    skos:definition "Reused ADL/cmi5 verb. The attempt did not meet the pass rule, or a reviewer recorded it as not passed."@en ;
    skos:inScheme <https://relay.interego.xwisee.com/ns/u-pk-0d4144c0c851/phone-roleplay-xapi/v/1> ;
    skos:prefLabel "failed"@en .

<http://adlnet.gov/expapi/verbs/passed> a xapi:Verb ;
    skos:definition "Reused ADL/cmi5 verb. The attempt met the pass rule of the named rubric, or a reviewer countersigned or overrode it as a pass. The review record IRI SHOULD appear in the review context extension when the judgment is a review."@en ;
    skos:inScheme <https://relay.interego.xwisee.com/ns/u-pk-0d4144c0c851/phone-roleplay-xapi/v/1> ;
    skos:prefLabel "passed"@en .

<http://adlnet.gov/expapi/verbs/scored> a xapi:Verb ;
    skos:definition "Reused ADL verb. A rubric criterion of the role-play was scored for this attempt; result.score carries the criterion score. Which criteria apply is named by the attempt's rubric, not by this profile."@en ;
    skos:inScheme <https://relay.interego.xwisee.com/ns/u-pk-0d4144c0c851/phone-roleplay-xapi/v/1> ;
    skos:prefLabel "scored"@en .

