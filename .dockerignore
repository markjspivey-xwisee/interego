node_modules
**/node_modules
.git
# dist/ is no longer excluded: build-ghcr.yml restores the built packages into the context so the
# bridge recipes can skip their build (PREBUILT=1). A local build with stale dist/ builds anyway.
*.tsbuildinfo
benchmarks/LongMemEval
benchmarks/locomo
.claude
relay-agent-key-prod.json
# The native I2IDL-X builder restores these byte-pinned inputs; local caches must not enter bridge-base.
# That includes .cache/upper-seed, where build-ghcr.yml keeps the verified upper-ontology sources it
# passes to the Foxxi build as its own `upper-seed` context: they reach i2idlx-builder only that way.
applications/foxxi-content-intelligence/i2idlx/.cache
